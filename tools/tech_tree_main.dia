# Appended by tools/check-tech-tree.sh after stripping exports from the data
# tables and shared.dia. Exercises the catalog, bitset state, prerequisites,
# mode effects, and progress helpers.

fn tech_probe_world(state: Text) -> World:
  with_tech_state(new_world(7), state)

fn main() -> Text:
  let s0 = empty_tech_state()
  let s45 = tech_advance(s0, 45)
  let s110 = tech_advance(s45, 110)
  let s220 = tech_advance(s110, 220)
  let w0 = tech_probe_world(s0)
  let w220 = tech_probe_world(s220)
  let mode_bits = [bool_int(tech_unlocks_mode(s45, Road)), bool_int(tech_unlocks_mode(s110, River)), bool_int(tech_unlocks_mode(s220, Rail))]
  let nexts = [tech_next_index(s0), tech_next_index(s45), tech_next_index(s110), tech_next_index(s220)]
  int_text(tech_row_count()) + "|" + int_text(tech_discovered_count(s0)) + "," + int_text(tech_discovered_count(s45)) + "," + int_text(tech_discovered_count(s110)) + "," + int_text(tech_discovered_count(s220)) + "|" + int_text(len(tech_discovery_messages(s0, s220))) + "|" + int_text(world_era(w0)) + "," + int_text(world_era(w220)) + "|" + tech_summary(w220) + "|" + int_text(total(mode_bits)) + "|" + int_text(nth_int(nexts, 0)) + "," + int_text(nth_int(nexts, 1)) + "," + int_text(nth_int(nexts, 2)) + "," + int_text(nth_int(nexts, 3)) + "|" + tech_next_text(w220)
