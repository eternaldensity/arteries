# Appended by tools/check-tech-tree.sh after stripping exports from the data
# tables and shared.dia. Checks the catalog size and rich-stock discovery.

fn tech_probe_stock() -> List<Int>:
  [9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9, 9]

fn main() -> Text:
  let all = tech_advance_stock(empty_tech_state(), 999, tech_probe_stock())
  int_text(tech_row_count()) + "|" + int_text(tech_discovered_count(all))
