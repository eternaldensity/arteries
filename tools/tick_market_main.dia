# Appended by tools/check-tick-market.sh after stripping `export` from
# app/shared.dia. Prints the market state for one fixed two-town frontier.

fn market_town(base: Town, endow: List<Int>, stock: List<Int>, pop: Int, prosperity: Int) -> Town:
  Town(id: base.id, name: base.name, x: base.x, y: base.y, terrain: base.terrain, endow: endow, state: TownState(pop: pop, prosperity: prosperity, research: 0, stock: stock))

fn stock_line(t: Town) -> Text:
  let values = for value in t.state.stock:
    int_text(value)
  join_text(values, ",")

fn main() -> Text:
  let base = new_world(7)
  let a = market_town(nth_town(base.towns, 0), [4, 0, 0, 0, 1, 0, 0, 0], [16, 4, 4, 4, 2, 0, 0, 4], 4, 6)
  let b = market_town(nth_town(base.towns, 1), [0, 3, 1, 0, 0, 0, 0, 0], [8, 6, 2, 0, 0, 0, 0, 0], 4, 6)
  let route = Route(id: "r0", a: a.id, b: b.id, a_name: a.name, b_name: b.name, mode: Road, plan: empty_plan(), fee: 1, traffic: 0, capacity: 20, upkeep: 1)
  let world = World(seed: 7, tick: 0, money: 160, towns: [a, b], sites: [], routes: [route], log: [], history: [], tech_road: false, tech_river: false, tech_rail: false)
  let result = market_period(world, 7, 100)
  let t0 = nth_town(result.towns, 0)
  let t1 = nth_town(result.towns, 1)
  let r = route_by_id(result.routes, "r0", 0)
  int_text(result.money) + "|" + int_text(t0.state.pop) + "," + int_text(t0.state.prosperity) + "," + int_text(t0.state.research) + "," + stock_line(t0) + "|" + int_text(t1.state.pop) + "," + int_text(t1.state.prosperity) + "," + int_text(t1.state.research) + "," + stock_line(t1) + "|" + int_text(r.traffic)
