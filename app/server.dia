# ---------------------------------------------------------------- row mapping

fn town_from_row(row: TownRow) -> Town:
  Town(id: row.key, name: row.name, x: row.x, y: row.y, terrain: row.terrain, endow: [row.endow0, row.endow1, row.endow2, row.endow3, row.endow4, row.endow5, row.endow6, row.endow7], state: TownState(pop: row.pop, prosperity: row.prosperity, research: row.research, stock: [row.stock0, row.stock1, row.stock2, row.stock3, row.stock4, row.stock5, row.stock6, row.stock7]))

fn site_from_row(row: SiteRow) -> Site:
  Site(id: row.key, name: row.name, x: row.x, y: row.y, terrain: row.terrain, resource: row.resource, richness: row.richness, founded: row.founded)

# Packed terrain and features come from the baked worldgen table, so the map,
# markers, and route planner all use the same generation.
fn packed_terrain(world: World) -> Text:
  terrain_grid(world.seed)

# A kernel-planned corridor is a pure function of the world and endpoints, so
# persisted rows only need the sentinel bend; loading recomputes the same path.
fn concat_ints(xs: List<Int>, ys: List<Int>) -> List<Int>:
  match len(ys) == 0:
    true => xs
    false => concat_ints(list_append(xs, nth_int(ys, 0)), list_slice(ys, 1, len(ys) - 1))

# One A* leg between two consecutive waypoints. An unreachable or malformed leg
# falls back to the straight segment between the pair, so the surveyed corridor
# is always connected: the player never sees a jump the pathfinder refused.
fn leg_path(grid: Text, features: Text, a: Point, b: Point) -> List<Int>:
  let start = int_text(a.x) + "," + int_text(a.y)
  let goal = int_text(b.x) + "," + int_text(b.y)
  match host.compute<List<Int>>("arteries", "pathfind_features", grid, features, start, goal, "road"):
    Err(_) => [a.x, a.y, b.x, b.y]
    Ok(flat) => match len(flat) >= 4:
      true => flat
      false => [a.x, a.y, b.x, b.y]

# Concatenate the per-leg corridors. The first leg contributes every cell; each
# later leg drops its first cell because that cell closes the previous leg.
fn path_through(grid: Text, features: Text, points: List<Point>, i: Int, acc: List<Int>) -> List<Int>:
  match list_get(points, i):
    None => acc
    Some(a) => match list_get(points, i + 1):
      None => acc
      Some(b) =>
        let flat = leg_path(grid, features, a, b)
        let next = match i == 0:
          true => flat
          false => concat_ints(acc, list_slice(flat, 2, len(flat) - 2))
        path_through(grid, features, points, i + 1, next)

fn auto_plan(world: World, from: Text, to: Text) -> RoutePlan:
  let start = marker_point(world, from)
  let goal = marker_point(world, to)
  match start.x < 0 or goal.x < 0 or from == to:
    true => empty_plan()
    false =>
      let grid = packed_terrain(world)
      let features = feature_grid(world.seed)
      let start_text = int_text(start.x) + "," + int_text(start.y)
      let goal_text = int_text(goal.x) + "," + int_text(goal.y)
      match host.compute<List<Int>>("arteries", "pathfind_features", grid, features, start_text, goal_text, "road"):
        Err(_) => empty_plan()
        Ok(flat) =>
          match host.compute<List<Int>>("arteries", "route_cost_features", grid, features, flat, "road"):
            Err(_) => empty_plan()
            Ok(stats) => plan_from_path(flat, stats)

fn plan_via(world: World, from: Text, to: Text, via: List<Int>) -> RoutePlan:
  match len(via) == 0:
    true => auto_plan(world, from, to)
    false =>
      let start = marker_point(world, from)
      let goal = marker_point(world, to)
      match start.x < 0 or goal.x < 0 or from == to:
        true => empty_plan()
        false =>
          let vias = via_from_flat(via)
          match len(vias) > via_max():
            true => empty_plan()
            false =>
              let points = concat_points(concat_points([start], vias), [goal])
              let grid = packed_terrain(world)
              let features = feature_grid(world.seed)
              # Survey each leg with A* and charge the concatenated corridor, so
              # the drawn line and the crowns, timber, and stone it costs always
              # describe the same cells.
              let corridor = path_through(grid, features, points, 0, [])
              let flat = match len(corridor) >= 4:
                true => corridor
                false => via_flat(points)
              match host.compute<List<Int>>("arteries", "route_cost_features", grid, features, flat, "road"):
                Err(_) => empty_plan()
                Ok(stats) => plan_from_path(flat, stats)

fn snap_via(world: World, via: List<Int>) -> List<Int>:
  let points = via_from_flat(via)
  let snapped = for p in points:
    let s = near_marker_point(world, p.x, p.y)
    Point(x: s.x, y: s.y)
  via_flat(snapped)

fn route_plan(world: World, from: Text, to: Text, bend: Int) -> RoutePlan:
  match bend == auto_bend():
    true => auto_plan(world, from, to)
    false => plan_route_bend(world, from, to, bend)

# Saved plans carry their own path and stats; only rows created before the
# waypoints column fall back to recomputing from the world and bend.
fn stored_plan(world: World, from: Text, to: Text, bend: Int, waypoints: Text) -> RoutePlan:
  let stored = decode_plan(waypoints, bend)
  match len(stored.path) > 0:
    true => stored
    false => route_plan(world, from, to, bend)

fn route_from_row(world: World, row: RouteRow) -> Route:
  Route(id: row.key, a: row.a, b: row.b, a_name: row.a_name, b_name: row.b_name, mode: row.mode, plan: stored_plan(world, row.a, row.b, row.bend, row.waypoints), fee: row.fee, traffic: row.traffic, capacity: row.capacity, upkeep: row.upkeep, rules: decode_link_rules(row.rules), pipeline: decode_pipeline(row.pipeline))

fn project_from_row(world: World, row: ProjectRow) -> Project:
  Project(id: row.key, kind: row.kind, a: row.a, b: row.b, a_name: row.a_name, b_name: row.b_name, mode: row.mode, route_id: row.route_id, plan: stored_plan(world, row.a, row.b, row.bend, row.waypoints), start_tick: row.start_tick, ready_tick: row.ready_tick)

# ---------------------------------------------------------------- loading

fn initial_selection(world: World) -> Selection:
  Selection(selected: "t0", from: "", to: "", draft: empty_plan(), ready: false, routing: false, notice: "Click any settlement or site to inspect it, or use Survey route to begin.")

fn load_world(row: WorldRow) -> Result<Loaded, DataError>:
  match row.generation_version == generation_version():
    false => Err("World generation version " + int_text(row.generation_version) + " is not supported by this build; start a new world.")
    true =>
      load_world_current(row)

fn load_world_current(row: WorldRow) -> Result<Loaded, DataError>:
  let town_rows = towns.page(world: row.id, order: "ord", after: "", limit: 100)?
  let site_rows = sites.page(world: row.id, order: "ord", after: "", limit: 100)?
  let route_rows = routes.page(world: row.id, order: "ord", after: "", limit: 100)?
  let project_rows = projects.page(world: row.id, order: "ord", after: "", limit: 100)?
  let loaded_towns = for r in town_rows:
    town_from_row(r)
  let loaded_sites = for r in site_rows:
    site_from_row(r)
  let empty_routes = []
  let base = World(seed: row.seed, tick: row.tick, money: row.money, towns: loaded_towns, sites: loaded_sites, routes: empty_routes, log: [], history: [], tech_road: row.tech_road, tech_river: row.tech_river, tech_rail: row.tech_rail)
  let loaded_routes = for r in route_rows:
    route_from_row(base, r)
  let world = World(seed: base.seed, tick: base.tick, money: base.money, towns: base.towns, sites: base.sites, routes: loaded_routes, log: [], history: [], tech_road: base.tech_road, tech_river: base.tech_river, tech_rail: base.tech_rail)
  let loaded_projects = for r in project_rows:
    project_from_row(world, r)
  Ok(Loaded(id: row.id, world: world, projects: loaded_projects, auto_upkeep: row.auto_upkeep, last_paid_tick: row.last_paid_tick, upkeep_per_cycle: row.upkeep_per_cycle, phase: row.phase, epoch: row.epoch, settle_days: row.settle_days, settle_from: row.settle_from))

fn state_game(loaded: Loaded, notice: Text) -> Game:
  raw_game(loaded.world, loaded.projects, loaded.auto_upkeep, loaded.last_paid_tick, loaded.upkeep_per_cycle, initial_selection(loaded.world), notice, true)

fn ensure_world_version(row: WorldRow) -> Result<WorldRow, DataError>:
  match row.generation_version == generation_version():
    true => Ok(row)
    false =>
      let world = new_world(row.seed)
      let fresh = raw_game(world, [], false, 0, 0, initial_selection(world), "World generation changed; the frontier was regenerated from seed " + int_text(row.seed) + ".", true)
      let _ = save_game_window(fresh, 0, row.epoch + 1, 0, 0)?
      let refreshed = worlds.select(limit: 1)?
      match list_get(refreshed, 0):
        None => Err("World regeneration failed.")
        Some(next) => Ok(next)

fn load_state() -> Result<Loaded, DataError>:
  let rows = worlds.select(limit: 1)?
  match list_get(rows, 0):
    None =>
      let world = new_world(7)
      let fresh = raw_game(world, [], false, 0, 0, initial_selection(world), "New world generated. Connect complementary settlements to start the economy.", true)
      save_game(fresh, 0, 0)?
      let saved_rows = worlds.select(limit: 1)?
      let id = match list_get(saved_rows, 0):
        Some(row) => row.id
        None => WorldId("missing")
      Ok(Loaded(id: id, world: World(seed: world.seed, tick: world.tick, money: world.money, towns: world.towns, sites: world.sites, routes: world.routes, log: [], history: [], tech_road: world.tech_road, tech_river: world.tech_river, tech_rail: world.tech_rail), projects: [], auto_upkeep: false, last_paid_tick: 0, upkeep_per_cycle: 0, phase: 0, epoch: 0, settle_days: 0, settle_from: 0))
    Some(row) => load_world(ensure_world_version(row)?)

export fn load_game() -> Result<Game, DataError>:
  let loaded = load_state()?
  let game = state_game(loaded, "World loaded.")
  attach_streams(loaded.id, loaded.epoch, game)

# ---------------------------------------------------------------- saving

fn clear_towns(rows: List<TownRow>, i: Int) -> Result<Bool, DataError>:
  match list_get(rows, i):
    None => Ok(true)
    Some(row) =>
      let removed = towns.delete(row.id)?
      clear_towns(rows, i + 1)

fn clear_sites(rows: List<SiteRow>, i: Int) -> Result<Bool, DataError>:
  match list_get(rows, i):
    None => Ok(true)
    Some(row) =>
      let removed = sites.delete(row.id)?
      clear_sites(rows, i + 1)

fn clear_routes(rows: List<RouteRow>, i: Int) -> Result<Bool, DataError>:
  match list_get(rows, i):
    None => Ok(true)
    Some(row) =>
      let removed = routes.delete(row.id)?
      clear_routes(rows, i + 1)

fn clear_projects(rows: List<ProjectRow>, i: Int) -> Result<Bool, DataError>:
  match list_get(rows, i):
    None => Ok(true)
    Some(row) =>
      let removed = projects.delete(row.id)?
      clear_projects(rows, i + 1)

fn new_town_row(t: Town, world: WorldId, ord: Int) -> NewTownRow:
  let e = t.endow
  let s = t.state.stock
  NewTownRow(world: world, ord: ord, key: t.id, name: t.name, x: t.x, y: t.y, terrain: t.terrain, pop: t.state.pop, prosperity: t.state.prosperity, research: t.state.research, endow0: nth_int(e, 0), endow1: nth_int(e, 1), endow2: nth_int(e, 2), endow3: nth_int(e, 3), endow4: nth_int(e, 4), endow5: nth_int(e, 5), endow6: nth_int(e, 6), endow7: nth_int(e, 7), stock0: nth_int(s, 0), stock1: nth_int(s, 1), stock2: nth_int(s, 2), stock3: nth_int(s, 3), stock4: nth_int(s, 4), stock5: nth_int(s, 5), stock6: nth_int(s, 6), stock7: nth_int(s, 7))

fn edit_town_row(t: Town, ord: Int) -> EditTownRow:
  let e = t.endow
  let s = t.state.stock
  EditTownRow(ord: ord, key: t.id, name: t.name, x: t.x, y: t.y, terrain: t.terrain, pop: t.state.pop, prosperity: t.state.prosperity, research: t.state.research, endow0: nth_int(e, 0), endow1: nth_int(e, 1), endow2: nth_int(e, 2), endow3: nth_int(e, 3), endow4: nth_int(e, 4), endow5: nth_int(e, 5), endow6: nth_int(e, 6), endow7: nth_int(e, 7), stock0: nth_int(s, 0), stock1: nth_int(s, 1), stock2: nth_int(s, 2), stock3: nth_int(s, 3), stock4: nth_int(s, 4), stock5: nth_int(s, 5), stock6: nth_int(s, 6), stock7: nth_int(s, 7))

fn new_site_row(x: Site, world: WorldId, ord: Int) -> NewSiteRow:
  NewSiteRow(world: world, ord: ord, key: x.id, name: x.name, x: x.x, y: x.y, terrain: x.terrain, resource: x.resource, richness: x.richness, founded: x.founded)

fn edit_site_row(x: Site, ord: Int) -> EditSiteRow:
  EditSiteRow(ord: ord, key: x.id, name: x.name, x: x.x, y: x.y, terrain: x.terrain, resource: x.resource, richness: x.richness, founded: x.founded)

fn new_route_row(x: Route, world: WorldId, ord: Int, towns: List<Town>) -> NewRouteRow:
  NewRouteRow(world: world, ord: ord, key: x.id, a: x.a, b: x.b, a_name: x.a_name, b_name: x.b_name, mode: x.mode, bend: x.plan.bend, fee: x.fee, traffic: x.traffic, capacity: x.capacity, upkeep: x.upkeep, waypoints: encode_plan(x.plan), a_ord: town_position(towns, x.a), b_ord: town_position(towns, x.b), rules: encode_link_rules(x.rules), pipeline: encode_pipeline(x.pipeline))

fn edit_route_row(x: Route, ord: Int, towns: List<Town>) -> EditRouteRow:
  EditRouteRow(ord: ord, key: x.id, a: x.a, b: x.b, a_name: x.a_name, b_name: x.b_name, mode: x.mode, bend: x.plan.bend, fee: x.fee, traffic: x.traffic, capacity: x.capacity, upkeep: x.upkeep, waypoints: encode_plan(x.plan), a_ord: town_position(towns, x.a), b_ord: town_position(towns, x.b), rules: encode_link_rules(x.rules), pipeline: encode_pipeline(x.pipeline))

fn new_project_row(x: Project, world: WorldId, ord: Int) -> NewProjectRow:
  NewProjectRow(world: world, ord: ord, key: x.id, kind: x.kind, a: x.a, b: x.b, a_name: x.a_name, b_name: x.b_name, mode: x.mode, route_id: x.route_id, bend: x.plan.bend, start_tick: x.start_tick, ready_tick: x.ready_tick, waypoints: encode_plan(x.plan))

fn edit_project_row(x: Project, ord: Int) -> EditProjectRow:
  EditProjectRow(ord: ord, key: x.id, kind: x.kind, a: x.a, b: x.b, a_name: x.a_name, b_name: x.b_name, mode: x.mode, route_id: x.route_id, bend: x.plan.bend, start_tick: x.start_tick, ready_tick: x.ready_tick, waypoints: encode_plan(x.plan))

fn save_towns(items: List<Town>, world: WorldId, existing: List<TownRow>, i: Int) -> Result<Bool, DataError>:
  match list_get(items, i):
    None => match len(existing) <= i:
      true => Ok(true)
      false => clear_towns(list_slice(existing, i, len(existing) - i), 0)
    Some(t) =>
      match list_get(existing, i):
        Some(row) =>
          let updated = towns.update(row.id, edit_town_row(t, i))?
          save_towns(items, world, existing, i + 1)
        None =>
          let created = towns.create(new_town_row(t, world, i))?
          save_towns(items, world, existing, i + 1)

fn save_sites(items: List<Site>, world: WorldId, existing: List<SiteRow>, i: Int) -> Result<Bool, DataError>:
  match list_get(items, i):
    None => match len(existing) <= i:
      true => Ok(true)
      false => clear_sites(list_slice(existing, i, len(existing) - i), 0)
    Some(s) =>
      match list_get(existing, i):
        Some(row) =>
          let updated = sites.update(row.id, edit_site_row(s, i))?
          save_sites(items, world, existing, i + 1)
        None =>
          let created = sites.create(new_site_row(s, world, i))?
          save_sites(items, world, existing, i + 1)

fn save_routes(items: List<Route>, world: WorldId, existing: List<RouteRow>, i: Int, towns: List<Town>) -> Result<Bool, DataError>:
  match list_get(items, i):
    None => match len(existing) <= i:
      true => Ok(true)
      false => clear_routes(list_slice(existing, i, len(existing) - i), 0)
    Some(r) =>
      match list_get(existing, i):
        Some(row) =>
          let updated = routes.update(row.id, edit_route_row(r, i, towns))?
          save_routes(items, world, existing, i + 1, towns)
        None =>
          let created = routes.create(new_route_row(r, world, i, towns))?
          save_routes(items, world, existing, i + 1, towns)

fn save_projects(items: List<Project>, world: WorldId, existing: List<ProjectRow>, i: Int) -> Result<Bool, DataError>:
  match list_get(items, i):
    None => match len(existing) <= i:
      true => Ok(true)
      false => clear_projects(list_slice(existing, i, len(existing) - i), 0)
    Some(p) =>
      match list_get(existing, i):
        Some(row) =>
          let updated = projects.update(row.id, edit_project_row(p, i))?
          save_projects(items, world, existing, i + 1)
        None =>
          let created = projects.create(new_project_row(p, world, i))?
          save_projects(items, world, existing, i + 1)

fn save_logs(items: List<Text>, world: WorldId, epoch: Int, base: Int, i: Int) -> Result<Bool, DataError>:
  match list_get(items, i):
    None => Ok(true)
    Some(message) =>
      let created = logs.create(NewLogRow(world: world, epoch: epoch, seq: base + i, message: message))?
      save_logs(items, world, epoch, base, i + 1)

fn save_history(items: List<Int>, world: WorldId, epoch: Int, base: Int, i: Int) -> Result<Bool, DataError>:
  match list_get(items, i):
    None => Ok(true)
    Some(value) =>
      let created = history.create(NewHistoryRow(world: world, epoch: epoch, seq: base + i, value: value))?
      save_history(items, world, epoch, base, i + 1)

fn save_children(world: WorldId, game: Game) -> Result<Bool, DataError>:
  let town_rows = towns.page(world: world, order: "ord", after: "", limit: 100)?
  let site_rows = sites.page(world: world, order: "ord", after: "", limit: 100)?
  let route_rows = routes.page(world: world, order: "ord", after: "", limit: 100)?
  let project_rows = projects.page(world: world, order: "ord", after: "", limit: 100)?
  save_towns(game.world.towns, world, town_rows, 0)?
  save_sites(game.world.sites, world, site_rows, 0)?
  save_routes(game.world.routes, world, route_rows, 0, game.world.towns)?
  save_projects(game.projects, world, project_rows, 0)?
  Ok(true)

# ---------------------------------------------------------------- compact tick

fn town_row_index_small(rows: List<TownRow>, key: Text, start: Int, count: Int) -> Int:
  match count <= 0:
    true => -1
    false => match list_get(rows, start):
      None => -1
      Some(row) => match row.key == key:
        true => start
        false => town_row_index_small(rows, key, start + 1, count - 1)

fn town_row_index_range(rows: List<TownRow>, key: Text, start: Int, count: Int) -> Int:
  match count <= 0:
    true => -1
    false => match count <= 8:
      true => town_row_index_small(rows, key, start, count)
      false =>
        let half = count / 2
        let left = town_row_index_range(rows, key, start, half)
        match left >= 0:
          true => left
          false => town_row_index_range(rows, key, start + half, count - half)

fn town_row_index(rows: List<TownRow>, key: Text) -> Int:
  town_row_index_range(rows, key, 0, len(rows))

fn town_ord_index_small(rows: List<TownRow>, ord: Int, start: Int, count: Int) -> Int:
  match count <= 0:
    true => -1
    false => match list_get(rows, start):
      None => -1
      Some(row) => match row.ord == ord:
        true => start
        false => town_ord_index_small(rows, ord, start + 1, count - 1)

fn town_ord_index_range(rows: List<TownRow>, ord: Int, start: Int, count: Int) -> Int:
  match count <= 0:
    true => -1
    false => match count <= 8:
      true => town_ord_index_small(rows, ord, start, count)
      false =>
        let half = count / 2
        let left = town_ord_index_range(rows, ord, start, half)
        match left >= 0:
          true => left
          false => town_ord_index_range(rows, ord, start + half, count - half)

fn town_ord_index(rows: List<TownRow>, ord: Int) -> Int:
  town_ord_index_range(rows, ord, 0, len(rows))

fn town_state_row(row: TownRow, seed: Int) -> List<Int>:
  [row.pop, row.prosperity, row.research, row.endow0, row.endow1, row.endow2, row.endow3, row.endow4, row.endow5, row.endow6, row.endow7, row.stock0, row.stock1, row.stock2, row.stock3, row.stock4, row.stock5, row.stock6, row.stock7, town_climate(seed, row.x, row.y)]

fn route_state_row(row: RouteRow, a: Int, b: Int) -> List<Int>:
  let rules = decode_link_rules(row.rules)
  let base = [a, b, row.fee, row.traffic, row.capacity, row.upkeep, route_mode_code(row.mode)]
  concat_ints(concat_ints(concat_ints(base, rules.allow), rules.fee), decode_pipeline(row.pipeline))

fn compact_town_edit(row: TownRow, values: List<Int>) -> EditTownRow:
  let has_endow = len(values) > 11
  let stock_base = match has_endow:
    true => 11
    false => 3
  let endow0 = match has_endow:
    true => nth_int(values, 3)
    false => row.endow0
  let endow1 = match has_endow:
    true => nth_int(values, 4)
    false => row.endow1
  let endow2 = match has_endow:
    true => nth_int(values, 5)
    false => row.endow2
  let endow3 = match has_endow:
    true => nth_int(values, 6)
    false => row.endow3
  let endow4 = match has_endow:
    true => nth_int(values, 7)
    false => row.endow4
  let endow5 = match has_endow:
    true => nth_int(values, 8)
    false => row.endow5
  let endow6 = match has_endow:
    true => nth_int(values, 9)
    false => row.endow6
  let endow7 = match has_endow:
    true => nth_int(values, 10)
    false => row.endow7
  EditTownRow(ord: row.ord, key: row.key, name: row.name, x: row.x, y: row.y, terrain: row.terrain, pop: nth_int(values, 0), prosperity: nth_int(values, 1), research: nth_int(values, 2), endow0: endow0, endow1: endow1, endow2: endow2, endow3: endow3, endow4: endow4, endow5: endow5, endow6: endow6, endow7: endow7, stock0: nth_int(values, stock_base), stock1: nth_int(values, stock_base + 1), stock2: nth_int(values, stock_base + 2), stock3: nth_int(values, stock_base + 3), stock4: nth_int(values, stock_base + 4), stock5: nth_int(values, stock_base + 5), stock6: nth_int(values, stock_base + 6), stock7: nth_int(values, stock_base + 7))

fn compact_route_edit(row: RouteRow, values: List<Int>) -> EditRouteRow:
  EditRouteRow(ord: row.ord, key: row.key, a: row.a, b: row.b, a_name: row.a_name, b_name: row.b_name, mode: row.mode, bend: row.bend, fee: row.fee, traffic: nth_int(values, 0), capacity: row.capacity, upkeep: row.upkeep, waypoints: row.waypoints, a_ord: row.a_ord, b_ord: row.b_ord, rules: row.rules, pipeline: row.pipeline)

fn save_compact_towns_small(rows: List<TownRow>, values: List<List<Int>>, start: Int, end: Int) -> Result<Bool, DataError>:
  match start >= end:
    true => Ok(true)
    false => match list_get(rows, start):
      None => Ok(true)
      Some(row) => match list_get(values, start):
        Some(row_values) =>
          let updated = towns.update(row.id, compact_town_edit(row, row_values))?
          save_compact_towns_small(rows, values, start + 1, end)
        None => Ok(true)

fn save_compact_towns(rows: List<TownRow>, values: List<List<Int>>, start: Int, end: Int) -> Result<Bool, DataError>:
  match end <= start:
    true => Ok(true)
    false => match end - start <= 8:
      true => save_compact_towns_small(rows, values, start, end)
      false =>
        let half = (end - start) / 2
        save_compact_towns(rows, values, start, start + half)?
        save_compact_towns(rows, values, start + half, end)

fn save_compact_routes_small(rows: List<RouteRow>, values: List<List<Int>>, start: Int, end: Int) -> Result<Bool, DataError>:
  match start >= end:
    true => Ok(true)
    false => match list_get(rows, start):
      None => Ok(true)
      Some(row) => match list_get(values, start):
        Some(row_values) =>
          let updated = routes.update(row.id, compact_route_edit(row, row_values))?
          save_compact_routes_small(rows, values, start + 1, end)
        None => Ok(true)

fn save_compact_routes(rows: List<RouteRow>, values: List<List<Int>>, start: Int, end: Int) -> Result<Bool, DataError>:
  match end <= start:
    true => Ok(true)
    false => match end - start <= 8:
      true => save_compact_routes_small(rows, values, start, end)
      false =>
        let half = (end - start) / 2
        save_compact_routes(rows, values, start, start + half)?
        save_compact_routes(rows, values, start + half, end)

fn compact_scale_at(row: WorldRow, tick: Int) -> Int:
  match row.auto_upkeep:
    true => 100
    false => match tick / hours_per_week() - row.last_paid_tick / hours_per_week() >= 2:
      true => 50
      false => 100

fn compact_scale(row: WorldRow) -> Int:
  compact_scale_at(row, row.tick)

fn town_cursor(rows: List<TownRow>) -> Result<Text, DataError>:
  match list_get(rows, len(rows) - 1):
    Some(row) => towns.cursor(row: row, order: "ord")
    None => Ok("")

fn route_cursor(rows: List<RouteRow>) -> Result<Text, DataError>:
  match list_get(rows, len(rows) - 1):
    Some(row) => routes.cursor(row: row, order: "ord")
    None => Ok("")

fn has_routes(world: WorldId) -> Result<Bool, DataError>:
  let rows = routes.page(world: world, order: "ord", after: "", limit: 1)?
  Ok(len(rows) > 0)

fn compact_summary(row: WorldRow, town_rows: List<TownRow>, route_rows: List<RouteRow>) -> List<Int>:
  let pops = for t in town_rows:
    t.pop
  let props = for t in town_rows:
    t.prosperity
  let traffic = for r in route_rows:
    r.traffic
  [row.tick, row.money, total(pops), total(props), total(traffic)]

fn with_streams(world: World, entries: List<Text>, values: List<Int>) -> World:
  World(seed: world.seed, tick: world.tick, money: world.money, towns: world.towns, sites: world.sites, routes: world.routes, log: entries, history: values, tech_road: world.tech_road, tech_river: world.tech_river, tech_rail: world.tech_rail)

fn attach_streams(world: WorldId, epoch: Int, game: Game) -> Result<Game, DataError>:
  let log_rows = logs.page(world: world, epoch: epoch, order: "seq", descending: true, after: "", limit: 12)?
  let history_rows = history.page(world: world, epoch: epoch, order: "seq", descending: true, after: "", limit: 24)?
  let messages = for r in log_rows:
    r.message
  let numbers = for r in history_rows:
    r.value
  let entries = list_reverse(messages)
  let values = list_reverse(numbers)
  let streamed = with_streams(game.world, entries, values)
  Ok(raw_game(streamed, game.projects, game.auto_upkeep, game.last_paid_tick, game.upkeep_per_cycle, game.sel, game.notice, game.last_ok))

fn save_game(game: Game, phase: Int, epoch: Int) -> Result<Game, DataError>:
  save_game_window(game, phase, epoch, 0, 0)

fn draft_or_empty(value: Text, keep: Bool) -> Text:
  match keep:
    true => value
    false => ""

fn save_game_window(game: Game, phase: Int, epoch: Int, settle_days: Int, settle_from: Int) -> Result<Game, DataError>:
  let rows = worlds.select(limit: 1)?
  match list_get(rows, 0):
    None =>
      let created = worlds.create(NewWorldRow(seed: game.world.seed, generation_version: generation_version(), tick: game.world.tick, money: game.world.money, tech_road: game.world.tech_road, tech_river: game.world.tech_river, tech_rail: game.world.tech_rail, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, phase: phase, epoch: epoch, settle_days: settle_days, settle_from: settle_from, draft_from: "", draft_to: "", draft_via: ""))?
      save_children(created.id, game)?
      let log_base = logs.count(world: created.id, epoch: epoch)?
      save_logs(game.world.log, created.id, epoch, log_base, 0)?
      let history_base = history.count(world: created.id, epoch: epoch)?
      save_history(game.world.history, created.id, epoch, history_base, 0)?
      attach_streams(created.id, epoch, game)
    Some(row) =>
      let updated = worlds.update(row.id, EditWorldRow(seed: game.world.seed, generation_version: generation_version(), tick: game.world.tick, money: game.world.money, tech_road: game.world.tech_road, tech_river: game.world.tech_river, tech_rail: game.world.tech_rail, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, phase: phase, epoch: epoch, settle_days: settle_days, settle_from: settle_from, draft_from: draft_or_empty(row.draft_from, epoch == row.epoch), draft_to: draft_or_empty(row.draft_to, epoch == row.epoch), draft_via: draft_or_empty(row.draft_via, epoch == row.epoch)))?
      save_children(row.id, game)?
      let log_base = logs.count(world: row.id, epoch: epoch)?
      save_logs(game.world.log, row.id, epoch, log_base, 0)?
      let history_base = history.count(world: row.id, epoch: epoch)?
      save_history(game.world.history, row.id, epoch, history_base, 0)?
      attach_streams(row.id, epoch, game)

# ---------------------------------------------------------------- actions

export fn main() -> Text:
  "Arteries authoritative simulation"

fn bounded_steps(n: Int) -> Int:
  match n < 1:
    true => 1
    false => match n > 10:
      true => 10
      false => n

fn bounded_hours(hours: Int) -> Int:
  match hours < 1:
    true => 1
    false => match hours > 672:
      true => 672
      false => hours

fn bounded_limit(limit: Int) -> Int:
  match limit < 1:
    true => 1
    false => match limit > 100:
      true => 100
      false => limit

fn settlement_days(start: Int, target: Int, cadence: Text) -> Int:
  match cadence == "weekly":
    true => (target / hours_per_week() - start / hours_per_week()) * days_per_week()
    false => match cadence == "monthly":
      true => (target / hours_per_month() - start / hours_per_month()) * days_per_month()
      false => target / hours_per_day() - start / hours_per_day()

fn compact_with_row(row: WorldRow, hours: Int, cadence: Text) -> Result<List<Int>, DataError>:
  let town_rows = towns.page(world: row.id, order: "ord", after: "", limit: 100)?
  let route_rows = routes.page(world: row.id, order: "ord", after: "", limit: 100)?
  let start = row.tick
  let target = start + bounded_hours(hours)
  let days = settlement_days(start, target, cadence)
  match row.phase == 1 or days <= 0:
    true => Ok(compact_summary(row, town_rows, route_rows))
    false =>
      let town_values = for t in town_rows:
        town_state_row(t, row.seed)
      let route_values = for r in route_rows:
        route_state_row(r, town_row_index(town_rows, r.a), town_row_index(town_rows, r.b))
      let pipeline_values = for r in route_rows:
        r.pipeline
      let result = host.compute<List<List<Int>>>("arteries", "market", row.money, town_values, route_values, pipeline_values, days, compact_scale(row))?
      let money_row = match list_get(result, 0):
        Some(values) => values
        None => []
      let money = nth_int(money_row, 0)
      let updated_towns = list_slice(result, 1, len(town_rows))
      let updated_routes = list_slice(result, 1 + len(town_rows), len(route_rows))
      save_compact_towns(town_rows, updated_towns, 0, len(town_rows))?
      save_compact_routes(route_rows, updated_routes, 0, len(route_rows))?
      let updated = worlds.update(row.id, EditWorldRow(seed: row.seed, generation_version: row.generation_version, tick: target, money: money, tech_road: row.tech_road, tech_river: row.tech_river, tech_rail: row.tech_rail, auto_upkeep: row.auto_upkeep, last_paid_tick: row.last_paid_tick, upkeep_per_cycle: row.upkeep_per_cycle, phase: 1, epoch: row.epoch, settle_days: days, settle_from: start, draft_from: row.draft_from, draft_to: row.draft_to, draft_via: row.draft_via))?
      let pops = for values in updated_towns:
        nth_int(values, 0)
      let props = for values in updated_towns:
        nth_int(values, 1)
      let traffic = for values in updated_routes:
        nth_int(values, 0)
      let summary = [target, money, total(pops), total(props), total(traffic)]
      Ok(summary)

# Market phase for large frontiers: rows go to the Rust kernel and back without
# constructing a World. Returns [tick, money, total_pop, total_prosperity,
# total_traffic]. The existing advance_finish can finish the staged phase.
export fn advance_compact(hours: Int, cadence: Text) -> Result<List<Int>, DataError>:
  let rows = worlds.select(limit: 1)?
  match list_get(rows, 0):
    Some(row) => compact_with_row(row, hours, cadence)
    None =>
      let loaded = load_state()?
      match list_get(worlds.select(limit: 1)?, 0):
        Some(row) => compact_with_row(row, hours, cadence)
        None => Ok([loaded.world.tick, loaded.world.money, total_pop(loaded.world), total_prosperity(loaded.world), 0])

fn compact_edit_world(row: WorldRow, tick: Int, money: Int, phase: Int, settle_days: Int, settle_from: Int) -> EditWorldRow:
  EditWorldRow(seed: row.seed, generation_version: row.generation_version, tick: tick, money: money, tech_road: row.tech_road, tech_river: row.tech_river, tech_rail: row.tech_rail, auto_upkeep: row.auto_upkeep, last_paid_tick: row.last_paid_tick, upkeep_per_cycle: row.upkeep_per_cycle, phase: phase, epoch: row.epoch, settle_days: settle_days, settle_from: settle_from, draft_from: row.draft_from, draft_to: row.draft_to, draft_via: row.draft_via)

fn compact_start(row: WorldRow, hours: Int, cadence: Text) -> Result<WorldRow, DataError>:
  let start = row.tick
  let target = start + bounded_hours(hours)
  let days = settlement_days(start, target, cadence)
  worlds.update(row.id, compact_edit_world(row, target, row.money, 2, days, start))

fn add_endpoint(rows: List<TownRow>, world: WorldId, ord: Int) -> Result<List<TownRow>, DataError>:
  match town_ord_index(rows, ord) >= 0:
    true => Ok(rows)
    false =>
      let found = towns.select(world: world, ord: ord, limit: 1)?
      match list_get(found, 0):
        Some(row) => Ok(list_append(rows, row))
        None => Ok(rows)

fn trade_page_values(route_rows: List<RouteRow>, world: WorldId, i: Int, towns_acc: List<TownRow>, route_acc: List<List<Int>>) -> Result<TradePage, DataError>:
  match list_get(route_rows, i):
    None => Ok(TradePage(towns: towns_acc, routes: route_acc))
    Some(route) =>
      let towns1 = add_endpoint(towns_acc, world, route.a_ord)?
      let towns2 = add_endpoint(towns1, world, route.b_ord)?
      let a = town_ord_index(towns2, route.a_ord)
      let b = town_ord_index(towns2, route.b_ord)
      trade_page_values(route_rows, world, i + 1, towns2, list_append(route_acc, route_state_row(route, a, b)))

# Multi-hop flow needs the whole network, so the trade phase sends every route
# and its endpoint towns in one kernel call instead of paging five routes at a
# time. The route cap keeps that well inside the declared wire limits.
fn trade_chunk_page(row: WorldRow, after: Text, limit: Int) -> Result<List<Text>, DataError>:
  let route_rows = routes.page(world: row.id, order: "ord", after: "", limit: 100)?
  match len(route_rows) == 0:
    true =>
      let done = worlds.update(row.id, compact_edit_world(row, row.tick, row.money, 1, row.settle_days, row.settle_from))?
      Ok(["", "1", int_text(done.tick), int_text(done.money), "0", "0"])
    false =>
      let page = trade_page_values(route_rows, row.id, 0, [], [])?
      let town_values = for t in page.towns:
        town_state_row(t, row.seed)
      let pipeline_values = for r in route_rows:
        r.pipeline
      let result = host.compute<List<List<Int>>>("arteries", "trade", row.money, town_values, page.routes, pipeline_values, row.settle_days, compact_scale_at(row, row.settle_from))?
      let money_row = match list_get(result, 0):
        Some(values) => values
        None => []
      let money = nth_int(money_row, 0)
      let updated_towns = list_slice(result, 1, len(page.towns))
      save_compact_towns(page.towns, updated_towns, 0, len(page.towns))?
      let updated_routes = list_slice(result, 1 + len(page.towns), len(route_rows))
      save_compact_routes(route_rows, updated_routes, 0, len(route_rows))?
      let traffic = for values in updated_routes:
        nth_int(values, 0)
      let done = worlds.update(row.id, compact_edit_world(row, row.tick, money, 1, row.settle_days, row.settle_from))?
      Ok(["", "1", int_text(done.tick), int_text(money), int_text(total(traffic)), "0"])

fn compact_chunk_page(row: WorldRow, after: Text, limit: Int) -> Result<List<Text>, DataError>:
  let town_rows = towns.page(world: row.id, order: "ord", after: after, limit: limit)?
  match len(town_rows) == 0:
    true => match has_routes(row.id)?:
      true =>
        let routed = worlds.update(row.id, compact_edit_world(row, row.tick, row.money, 3, row.settle_days, row.settle_from))?
        Ok(["", "3", int_text(routed.tick), int_text(routed.money), "0", "0"])
      false =>
        let done = worlds.update(row.id, compact_edit_world(row, row.tick, row.money, 1, row.settle_days, row.settle_from))?
        Ok(["", "1", int_text(done.tick), int_text(done.money), "0", "0"])
    false =>
      let town_values = for t in town_rows:
        town_state_row(t, row.seed)
      let no_routes = []
      let no_pipelines = []
      let result = host.compute<List<List<Int>>>("arteries", "market", row.money, town_values, no_routes, no_pipelines, row.settle_days, compact_scale_at(row, row.settle_from))?
      let money_row = match list_get(result, 0):
        Some(values) => values
        None => []
      let money = nth_int(money_row, 0)
      let updated_towns = list_slice(result, 1, len(town_rows))
      save_compact_towns(town_rows, updated_towns, 0, len(town_rows))?
      let pops = for values in updated_towns:
        nth_int(values, 0)
      let props = for values in updated_towns:
        nth_int(values, 1)
      let cursor = town_cursor(town_rows)?
      Ok([cursor, "2", int_text(row.tick), int_text(money), int_text(total(pops)), int_text(total(props))])

# One bounded production page for a large frontier. The client calls this with
# after="" and then with each returned cursor until phase=1. Market trade and
# finish remain on the staged path until their chunked slices land.
export fn advance_compact_chunk(hours: Int, cadence: Text, after: Text, limit: Int) -> Result<List<Text>, DataError>:
  let rows = worlds.select(limit: 1)?
  match list_get(rows, 0):
    None => Ok(["", "1", "0", "0", "0", "0"])
    Some(row) =>
      let page_limit = bounded_limit(limit)
      let start_row = match row.phase == 0:
        true => compact_start(row, hours, cadence)?
        false => row
      match start_row.phase == 1:
        true => Ok(["", "1", int_text(start_row.tick), int_text(start_row.money), "0", "0"])
        false => match start_row.phase == 3:
          true => trade_chunk_page(start_row, after, page_limit)
          false => compact_chunk_page(start_row, after, page_limit)

fn boundary_in_period_server(start: Int, days: Int, cadence: Int) -> Bool:
  let remainder = start - (start / cadence) * cadence
  let offset = match remainder == 0:
    true => 0
    false => cadence - remainder
  offset < days

fn finish_chunk_page(row: WorldRow, after: Text, limit: Int) -> Result<List<Text>, DataError>:
  let town_count = towns.count(world: row.id)?
  let town_rows = towns.page(world: row.id, order: "ord", after: after, limit: limit)?
  match len(town_rows) == 0:
    true => Ok(["", "5", "0", "0"])
    false =>
      let start_index = match list_get(town_rows, 0):
        Some(town) => town.ord
        None => 0
      let town_values = for t in town_rows:
        town_state_row(t, row.seed)
      let result = host.compute<List<List<Int>>>("arteries", "finish", row.seed, row.settle_from, row.settle_days, town_count, start_index, town_values)?
      let summary = match list_get(result, 0):
        Some(values) => values
        None => []
      let updated_towns = list_slice(result, 1, len(town_rows))
      save_compact_towns(town_rows, updated_towns, 0, len(town_rows))?
      let cursor = town_cursor(town_rows)?
      Ok([cursor, "4", int_text(nth_int(summary, 0)), int_text(nth_int(summary, 1))])

# Apply one bounded finish page. The caller accumulates max research and total
# prosperity, then calls advance_finish_commit.
export fn advance_finish_chunk(after: Text, limit: Int) -> Result<List<Text>, DataError>:
  let rows = worlds.select(limit: 1)?
  match list_get(rows, 0):
    None => Ok(["", "0", "0", "0"])
    Some(row) =>
      let page_limit = bounded_limit(limit)
      match row.phase == 0:
        true => Ok(["", "0", "0", "0"])
        false => match row.phase == 1:
          true =>
            let started = worlds.update(row.id, compact_edit_world(row, row.tick, row.money, 4, row.settle_days, row.settle_from))?
            finish_chunk_page(started, after, page_limit)
          false => match row.phase == 4:
            true => finish_chunk_page(row, after, page_limit)
            false => Ok(["", int_text(row.phase), "0", "0"])

fn finish_road(row: WorldRow, max_research: Int) -> Bool:
  row.tech_road or max_research >= road_research()

fn finish_river(row: WorldRow, max_research: Int) -> Bool:
  row.tech_river or max_research >= river_research()

fn finish_rail(row: WorldRow, max_research: Int) -> Bool:
  row.tech_rail or max_research >= rail_research()

fn finish_tech_message(row: WorldRow, max_research: Int) -> Text:
  match finish_road(row, max_research) and not row.tech_road:
    true => "Discovery: improved carts. Roads can now be built."
    false => match finish_river(row, max_research) and not row.tech_river:
      true => "Discovery: river navigation. Barges can now be built."
      false => match finish_rail(row, max_research) and not row.tech_rail:
        true => "Discovery: steam power. Rail can now be built."
        false => ""

fn finish_event_messages(row: WorldRow) -> List<Text>:
  let start_day = row.settle_from / hours_per_day()
  let harvest = boundary_in_period_server(start_day, row.settle_days, 6)
  let storm = boundary_in_period_server(start_day, row.settle_days, 9)
  let caravan = boundary_in_period_server(start_day, row.settle_days, 11)
  let log1 = match harvest:
    true => ["A generous harvest adds grain across the frontier."]
    false => []
  let log2 = match storm:
    true => list_append(log1, "A storm damages stores on the frontier.")
    false => log1
  match caravan:
    true => list_append(log2, "A caravan brings timber and stone to the frontier.")
    false => log2

fn finish_messages(row: WorldRow, max_research: Int) -> List<Text>:
  let events = finish_event_messages(row)
  let tech = finish_tech_message(row, max_research)
  match tech == "":
    true => events
    false => list_append(events, tech)

fn finish_upkeep(row: WorldRow) -> List<Int>:
  let raw_weeks = row.tick / hours_per_week() - row.settle_from / hours_per_week()
  let weeks = match raw_weeks > 0:
    true => raw_weeks
    false => 0
  let money = match row.auto_upkeep:
    true => row.money - row.upkeep_per_cycle * weeks
    false => row.money
  let paid = match row.auto_upkeep and weeks > 0:
    true => (row.tick / hours_per_week()) * hours_per_week()
    false => row.last_paid_tick
  [money, paid]

fn finish_apply(row: WorldRow, max_research: Int, total_prosperity: Int) -> Result<List<Text>, DataError>:
  let log_base = logs.count(world: row.id, epoch: row.epoch)?
  save_logs(finish_messages(row, max_research), row.id, row.epoch, log_base, 0)?
  let history_base = history.count(world: row.id, epoch: row.epoch)?
  save_history([total_prosperity], row.id, row.epoch, history_base, 0)?
  let upkeep = finish_upkeep(row)
  let updated = worlds.update(row.id, EditWorldRow(seed: row.seed, generation_version: row.generation_version, tick: row.tick, money: nth_int(upkeep, 0), tech_road: finish_road(row, max_research), tech_river: finish_river(row, max_research), tech_rail: finish_rail(row, max_research), auto_upkeep: row.auto_upkeep, last_paid_tick: nth_int(upkeep, 1), upkeep_per_cycle: row.upkeep_per_cycle, phase: 0, epoch: row.epoch, settle_days: 0, settle_from: 0, draft_from: row.draft_from, draft_to: row.draft_to, draft_via: row.draft_via))?
  Ok([int_text(updated.tick), int_text(updated.money), int_text(max_research), int_text(total_prosperity)])

export fn advance_finish_commit(max_research: Int, total_prosperity: Int) -> Result<List<Text>, DataError>:
  let rows = worlds.select(limit: 1)?
  match list_get(rows, 0):
    None => Ok(["0", "0", "0", "0"])
    Some(row) =>
      match row.phase == 0:
        true => Ok([int_text(row.tick), int_text(row.money), int_text(max_research), int_text(total_prosperity)])
        false => match row.phase == 4 or row.phase == 5:
          true => finish_apply(row, max_research, total_prosperity)
          false => Ok([int_text(row.tick), int_text(row.money), int_text(max_research), int_text(total_prosperity)])

fn planet_vertices() -> List<List<Int>>:
  for i in indices(rt_vertex_count()):
    let v = rt_vertex(i)
    [v.x, v.y, v.z]

fn planet_faces() -> List<List<Int>>:
  for i in indices(rt_face_count()):
    let f = rt_face(i)
    [f.a, f.b, f.c, f.d]

export fn planet_chunk(seed: Int, detail: Int, start: Int, count: Int) -> Result<List<List<Int>>, DataError>:
  host.compute<List<List<Int>>>("arteries", "planet", seed, detail, start, count, planet_vertices(), planet_faces())

fn planet_summary_chunks(seed: Int, detail: Int, start: Int, vertices: List<List<Int>>, faces: List<List<Int>>, faces_acc: Int, cells_acc: Int, checksum_acc: Int) -> Result<List<Int>, DataError>:
  match start >= len(faces):
    true => Ok([faces_acc, cells_acc, checksum_acc])
    false =>
      let chunk = host.compute<List<Int>>("arteries", "planet_summary", seed, detail, start, 5, vertices, faces)?
      planet_summary_chunks(seed, detail, start + 5, vertices, faces, faces_acc + nth_int(chunk, 0), cells_acc + nth_int(chunk, 1), checksum_acc + nth_int(chunk, 2))

export fn planet_summary(seed: Int, detail: Int) -> Result<PlanetSummary, DataError>:
  let vertices = planet_vertices()
  let faces = planet_faces()
  let result = planet_summary_chunks(seed, detail, 0, vertices, faces, 0, 0, 0)?
  Ok(PlanetSummary(seed: seed, detail: detail, faces: nth_int(result, 0), cells: nth_int(result, 1), checksum: nth_int(result, 2)))

export fn worldgen_summary(seed: Int, width: Int, height: Int) -> Result<WorldgenSummary, DataError>:
  let values = host.compute<List<Int>>("arteries", "worldgen_summary", seed, width, height)?
  Ok(WorldgenSummary(version: nth_int(values, 0), width: nth_int(values, 1), height: nth_int(values, 2), valid: nth_int(values, 3) == 1, cells: nth_int(values, 4), water: nth_int(values, 5), forest: nth_int(values, 6), dry: nth_int(values, 7), cold: nth_int(values, 8), other_land: nth_int(values, 9), rivers: nth_int(values, 10), passes: nth_int(values, 11), fords: nth_int(values, 12), harbors: nth_int(values, 13), checksum: nth_int(values, 14)))

export fn load_compact() -> Result<ScaleSummary, DataError>:
  let rows = worlds.select(limit: 1)?
  match list_get(rows, 0):
    None => Ok(ScaleSummary(seed: 0, tick: 0, money: 0, towns: 0, routes: 0, phase: 0))
    Some(row) =>
      let current = ensure_world_version(row)?
      let town_count = towns.count(world: current.id)?
      let route_count = routes.count(world: current.id)?
      Ok(ScaleSummary(seed: current.seed, tick: current.tick, money: current.money, towns: town_count, routes: route_count, phase: current.phase))

fn scale_done_step(done: List<Text>, pop: Int, prosperity: Int, traffic: Int) -> ScaleStep:
  ScaleStep(phase: 0, cursor: "", tick: text_int(nth_text(done, 0)), money: text_int(nth_text(done, 1)), pop: pop, prosperity: prosperity, max_research: text_int(nth_text(done, 2)), traffic: traffic, finish: text_int(nth_text(done, 3)), status: "Cycle complete")

fn scale_market_step(hours: Int, cadence: Text, cursor: Text, pop: Int, prosperity: Int, max_research: Int, traffic: Int, finish: Int) -> Result<ScaleStep, DataError>:
  let result = advance_compact_chunk(hours, cadence, cursor, 20)?
  let next_phase = text_int(nth_text(result, 1))
  let next_cursor = nth_text(result, 0)
  let tick = text_int(nth_text(result, 2))
  let money = text_int(nth_text(result, 3))
  let amount = text_int(nth_text(result, 4))
  let other = text_int(nth_text(result, 5))
  let pop2 = match next_phase == 2:
    true => pop + amount
    false => pop
  let prosperity2 = match next_phase == 2:
    true => prosperity + other
    false => prosperity
  let traffic2 = match next_phase == 3:
    true => traffic + amount
    false => traffic
  let status = match next_phase == 2:
    true => "Settling market"
    false => match next_phase == 3:
      true => "Trading routes"
      false => match next_phase == 1:
        true => "Market done"
        false => "Running"
  Ok(ScaleStep(phase: next_phase, cursor: next_cursor, tick: tick, money: money, pop: pop2, prosperity: prosperity2, max_research: max_research, traffic: traffic2, finish: finish, status: status))

fn scale_finish_step(row: WorldRow, phase: Int, cursor: Text, pop: Int, prosperity: Int, max_research: Int, traffic: Int, finish: Int) -> Result<ScaleStep, DataError>:
  match phase == 5:
    true =>
      let done = advance_finish_commit(max_research, finish)?
      Ok(scale_done_step(done, pop, prosperity, traffic))
    false =>
      let result = advance_finish_chunk(cursor, 20)?
      let next_phase = text_int(nth_text(result, 1))
      let next_cursor = nth_text(result, 0)
      let page_max = text_int(nth_text(result, 2))
      let page_finish = text_int(nth_text(result, 3))
      let finish2 = finish + page_finish
      let max2 = match page_max > max_research:
        true => page_max
        false => max_research
      match next_phase == 5:
        true =>
          let done = advance_finish_commit(max2, finish2)?
          Ok(scale_done_step(done, pop, prosperity, traffic))
        false => Ok(ScaleStep(phase: next_phase, cursor: next_cursor, tick: row.tick, money: row.money, pop: pop, prosperity: prosperity, max_research: max2, traffic: traffic, finish: finish2, status: "Applying events"))

export fn advance_scale(hours: Int, cadence: Text, phase: Int, cursor: Text, pop: Int, prosperity: Int, max_research: Int, traffic: Int, finish: Int) -> Result<ScaleStep, DataError>:
  let rows = worlds.select(limit: 1)?
  match list_get(rows, 0):
    None => Ok(ScaleStep(phase: 0, cursor: "", tick: 0, money: 0, pop: pop, prosperity: prosperity, max_research: max_research, traffic: traffic, finish: finish, status: "No world."))
    Some(row) =>
      match phase == 0 or phase == 2 or phase == 3:
        true => scale_market_step(hours, cadence, cursor, pop, prosperity, max_research, traffic, finish)
        false => match phase == 1 or phase == 4 or phase == 5:
          true => scale_finish_step(row, phase, cursor, pop, prosperity, max_research, traffic, finish)
          false =>
            let summary = load_compact()?
            Ok(ScaleStep(phase: summary.phase, cursor: "", tick: summary.tick, money: summary.money, pop: pop, prosperity: prosperity, max_research: max_research, traffic: traffic, finish: finish, status: "Idle"))

# Whole-world market phase through the Rust flow kernel. `market_period` in
# shared.dia stays as the readable reference implementation for the fixtures; a
# Dijkstra-style pass is far too heavy for the interpreter, so the app path runs
# the same algorithm in `arteries.trade`.
fn market_flow_period(world: World, days: Int, scale: Int) -> Result<World, DataError>:
  let towns0 = flow_advance_towns(world, days)
  let town_values = for t in towns0:
    trade_town_row(t, world.seed)
  let route_values = for r in world.routes:
    trade_route_row(towns0, r)
  let pipeline_values = for r in world.routes:
    encode_pipeline(r.pipeline)
  let result = host.compute<List<List<Int>>>("arteries", "trade", world.money, town_values, route_values, pipeline_values, days, scale)?
  let money_row = match list_get(result, 0):
    Some(values) => values
    None => []
  let towns1 = flow_apply_towns(towns0, result)
  let routes1 = flow_apply_routes(world.routes, result, len(towns0))
  Ok(World(seed: world.seed, tick: world.tick, money: nth_int(money_row, 0), towns: towns1, sites: world.sites, routes: routes1, log: world.log, history: world.history, tech_road: world.tech_road, tech_river: world.tech_river, tech_rail: world.tech_rail))

export fn advance_market(hours: Int, cadence: Text) -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  match state.phase == 0:
    false => attach_streams(state.id, state.epoch, current)
    true =>
      let start = current.world.tick
      let target = start + bounded_hours(hours)
      let days = settlement_days(start, target, cadence)
      let ready = advance_projects(with_tick(current.world, target), current.projects, 0, [], [])
      let upkeep = total_upkeep(ready.world.routes)
      let done = match len(ready.messages) > 0:
        true => " " + nth_text(ready.messages, 0)
        false => ""
      let notice = "Advanced to " + calendar_text(ready.world) + "." + done
      match days <= 0:
        true =>
          let base = raw_game(ready.world, ready.projects, current.auto_upkeep, current.last_paid_tick, upkeep, current.sel, notice, true)
          save_game_window(base, 0, state.epoch, 0, 0)
        false =>
          let unpaid = neglect_ticks(current)
          let scale = match current.auto_upkeep:
            true => 100
            false => match unpaid >= 2:
              true => 50
              false => 100
          let market = market_flow_period(ready.world, days, scale)?
          let summary = notice + " Market settled for " + int_text(days) + " day" + match days == 1:
            true => ""
            false => "s"
          + "."
          let staged = raw_game(market, ready.projects, current.auto_upkeep, current.last_paid_tick, upkeep, current.sel, summary, true)
          save_game_window(staged, 1, state.epoch, days, start)

export fn advance_finish() -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  match state.phase == 1:
    false => attach_streams(state.id, state.epoch, state_game(state, "Advanced to " + calendar_text(current.world) + "."))
    true =>
      let game = game_finish_period(current, state.settle_days, state.settle_from)
      save_game_window(game, 0, state.epoch, 0, 0)

# Survey reads only need the seed, the town rows, and the site rows. Building a
# compact World avoids materialising route groups, projects, logs, and history
# on every keystroke-sized preview request.
fn survey_world(seed: Int, town_rows: List<TownRow>, site_rows: List<SiteRow>) -> World:
  let towns = for r in town_rows:
    town_from_row(r)
  let sites = for r in site_rows:
    site_from_row(r)
  World(seed: seed, tick: 0, money: 0, towns: towns, sites: sites, routes: [], log: [], history: [], tech_road: false, tech_river: false, tech_rail: false)

fn survey_context() -> Result<World, DataError>:
  let rows = worlds.select(limit: 1)?
  match list_get(rows, 0):
    None => Err("No world.")
    Some(row) =>
      let current = ensure_world_version(row)?
      let town_rows = towns.page(world: current.id, order: "ord", after: "", limit: 100)?
      let site_rows = sites.page(world: current.id, order: "ord", after: "", limit: 100)?
      Ok(survey_world(current.seed, town_rows, site_rows))

export fn survey_options(from: Text, to: Text) -> Result<List<SurveyOption>, DataError>:
  let world = survey_context()?
  let plans = survey_alternatives(world, from, to)
  let options = for i in indices(len(plans)):
    let plan = nth_plan(plans, i)
    SurveyOption(index: i, bend: plan.bend, label: survey_alt_text(plan, i), length: plan.length, money: plan.money, water: plan.water)
  Ok(options)

export fn survey_corridor_plan(from: Text, to: Text, bend: Int) -> Result<RoutePlan, DataError>:
  let world = survey_context()?
  let _ = clear_draft()?
  Ok(plan_route_bend(world, from, to, bend))

# The preview panel must describe the corridor the player will actually build.
# With a staged waypoint draft that is the via corridor, not the plain auto
# survey, otherwise the numbers under "Preview details" disagree with both the
# plan grid and the crowns construction charges.
fn preview_plan(world: World, from: Text, to: Text, bend: Int) -> RoutePlan:
  match bend == auto_bend():
    false => plan_route_bend(world, from, to, bend)
    true => match worlds.select(limit: 1):
      Err(_) => auto_plan(world, from, to)
      Ok(rows) => match list_get(rows, 0):
        None => auto_plan(world, from, to)
        Some(row) =>
          let via = draft_via(row, from, to)
          match len(via) > 0:
            true => plan_via(world, from, to, snap_via(world, via))
            false => auto_plan(world, from, to)

export fn survey_preview(from: Text, to: Text, bend: Int) -> Result<SurveyPreview, DataError>:
  let world = survey_context()?
  let plan = preview_plan(world, from, to, bend)
  Ok(SurveyPreview(capacity: route_capacity(Path, plan), upkeep: route_upkeep(Path, plan), trade: survey_trade_volume(world, from, to, plan), found: survey_found_text(world, plan), material: material_split_text(world, from, to, plan), warning: material_warning(world, from, to, plan)))

# Fill the survey draft from the native pathfinding kernel.
export fn survey_path_plan(from: Text, to: Text) -> Result<RoutePlan, DataError>:
  let world = survey_context()?
  let _ = clear_draft()?
  Ok(auto_plan(world, from, to))

# Stage the desk's whole waypoint list in one round trip: snap every cell to a
# town, site, or nearby route cell, persist the draft, and return the surveyed
# corridor so the browser draws exactly the cells construction will charge. The
# desk always sends the complete list, so a draft left by an earlier survey can
# never merge into an edit the player did not make.
export fn survey_waypoint_edit(from: Text, to: Text, via: List<Int>) -> Result<WaypointState, DataError>:
  let world = survey_context()?
  let rows = worlds.select(limit: 1)?
  match list_get(rows, 0):
    None => Err("No world.")
    Some(row) =>
      let points = via_from_flat(via)
      match len(points) > via_max():
        true => Ok(WaypointState(count: len(points), ok: false, via: via_flat(points), plan: empty_plan()))
        false =>
          let snapped = for p in points:
            waypoint_snap(world, p)
          # start_route re-snaps the stored cells before it plans, so the
          # preview applies the same transform to stay byte-identical with it.
          let flat = snap_via(world, via_flat(snapped))
          let saved = save_draft(row, from, to, flat)?
          Ok(WaypointState(count: len(flat) / 2, ok: saved, via: flat, plan: plan_via(world, from, to, flat)))

fn edit_world_draft(row: WorldRow, from: Text, to: Text, via: Text) -> EditWorldRow:
  EditWorldRow(seed: row.seed, generation_version: row.generation_version, tick: row.tick, money: row.money, tech_road: row.tech_road, tech_river: row.tech_river, tech_rail: row.tech_rail, auto_upkeep: row.auto_upkeep, last_paid_tick: row.last_paid_tick, upkeep_per_cycle: row.upkeep_per_cycle, phase: row.phase, epoch: row.epoch, settle_days: row.settle_days, settle_from: row.settle_from, draft_from: from, draft_to: to, draft_via: via)

fn save_draft(row: WorldRow, from: Text, to: Text, via: List<Int>) -> Result<Bool, DataError>:
  let updated = worlds.update(row.id, edit_world_draft(row, from, to, encode_waypoints(via)))?
  Ok(true)

fn clear_draft() -> Result<Bool, DataError>:
  let rows = worlds.select(limit: 1)?
  match list_get(rows, 0):
    None => Ok(true)
    Some(row) => save_draft(row, "", "", [])

fn draft_via(row: WorldRow, from: Text, to: Text) -> List<Int>:
  match row.draft_from == from and row.draft_to == to:
    true => decode_waypoints(row.draft_via)
    false => []

export fn start_route(from: Text, to: Text, bend: Int) -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let rows = worlds.select(limit: 1)?
  let via = match bend == auto_bend():
    true => match list_get(rows, 0):
      None => []
      Some(row) => draft_via(row, from, to)
    false => []
  let plan = match len(via) > 0:
    true => plan_via(current.world, from, to, snap_via(current.world, via))
    false => route_plan(current.world, from, to, bend)
  let sel = survey_selection_plan(from, to, plan)
  let prepared = raw_game(current.world, current.projects, current.auto_upkeep, current.last_paid_tick, current.upkeep_per_cycle, sel, "", true)
  match can_build_route(prepared):
    false =>
      let blocked = raw_game(current.world, current.projects, current.auto_upkeep, current.last_paid_tick, current.upkeep_per_cycle, current.sel, build_blocker(prepared), false)
      attach_streams(state.id, state.epoch, blocked)
    true =>
      let _ = clear_draft()?
      let game = game_build(prepared)
      save_game(game, 0, state.epoch)

export fn start_route_via(from: Text, to: Text, via: List<Int>) -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let plan = plan_via(current.world, from, to, snap_via(current.world, via))
  let sel = survey_selection_plan(from, to, plan)
  let prepared = raw_game(current.world, current.projects, current.auto_upkeep, current.last_paid_tick, current.upkeep_per_cycle, sel, "", true)
  match can_build_route(prepared):
    false =>
      let blocked = raw_game(current.world, current.projects, current.auto_upkeep, current.last_paid_tick, current.upkeep_per_cycle, current.sel, build_blocker(prepared), false)
      attach_streams(state.id, state.epoch, blocked)
    true =>
      let _ = clear_draft()?
      let game = game_build(prepared)
      save_game(game, 0, state.epoch)

