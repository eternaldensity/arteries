  let state = load_state()?
  let current = state_game(state, "")
  let game = game_fee(current, route, delta)
  save_game(game, 0, state.epoch)

export fn pay_upkeep() -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let game = game_pay_upkeep(current)
  save_game(game, 0, state.epoch)

export fn toggle_auto() -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let game = game_toggle_auto(current)
