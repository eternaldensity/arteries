# ---------------------------------------------------------------- resources

resource Worlds: WorldRow
resource CurrentWorlds: CurrentWorldRow
resource Towns: TownRow
resource Sites: SiteRow
resource Routes: RouteRow
resource Projects: ProjectRow
resource Logs: LogRow
resource History: HistoryRow
resource Snapshots: SnapshotRow

policy Worlds:
  read(row, by principal):
    principal.is_user(row.owner)
  create(row, by principal):
    principal.is_user(row.owner)
  update(before, after, by principal):
    before.owner == after.owner and principal.is_user(before.owner)

policy CurrentWorlds:
  read(row, by principal):
    principal.is_user(row.owner)
  create(row, by principal):
    principal.is_user(row.owner)
  update(before, after, by principal):
    before.owner == after.owner and principal.is_user(before.owner)

policy Towns:
  read(row, by principal):
    principal.is_user(row.owner)
  create(row, by principal):
    principal.is_user(row.owner)
  update(before, after, by principal):
    before.owner == after.owner and principal.is_user(before.owner)
  delete(row, by principal):
    principal.is_user(row.owner)

policy Sites:
