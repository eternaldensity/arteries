fn encode_rules_server(rules: LinkRules) -> Result<Text, DataError>:
  host.compute<Text>("arteries", "encode_link_rules", rules.allow, rules.fee)

fn new_route_row(x: Route, world: WorldId, ord: Int, towns: List<Town>) -> Result<NewRouteRow, DataError>:
  let rules = encode_rules_server(x.rules)?
  Ok(NewRouteRow(world: world, ord: ord, key: x.id, a: x.a, b: x.b, a_name: x.a_name, b_name: x.b_name, mode: x.mode, bend: x.plan.bend, fee: x.fee, traffic: x.traffic, capacity: x.capacity, upkeep: x.upkeep, waypoints: encode_plan(x.plan), a_ord: x.a_ord, b_ord: x.b_ord, rules: rules, pipeline: x.pipeline, flow: x.flow))

fn edit_route_row(x: Route, ord: Int, towns: List<Town>) -> Result<EditRouteRow, DataError>:
  let rules = encode_rules_server(x.rules)?
  Ok(EditRouteRow(ord: ord, key: x.id, a: x.a, b: x.b, a_name: x.a_name, b_name: x.b_name, mode: x.mode, bend: x.plan.bend, fee: x.fee, traffic: x.traffic, capacity: x.capacity, upkeep: x.upkeep, waypoints: encode_plan(x.plan), a_ord: x.a_ord, b_ord: x.b_ord, rules: rules, pipeline: x.pipeline, flow: x.flow))

fn new_project_row(x: Project, world: WorldId, ord: Int) -> NewProjectRow:
  NewProjectRow(world: world, ord: ord, key: x.id, kind: x.kind, a: x.a, b: x.b, a_name: x.a_name, b_name: x.b_name, mode: x.mode, route_id: x.route_id, bend: x.plan.bend, start_tick: x.start_tick, ready_tick: x.ready_tick, waypoints: encode_plan(x.plan))

fn edit_project_row(x: Project, ord: Int) -> EditProjectRow:
  EditProjectRow(ord: ord, key: x.id, kind: x.kind, a: x.a, b: x.b, a_name: x.a_name, b_name: x.b_name, mode: x.mode, route_id: x.route_id, bend: x.plan.bend, start_tick: x.start_tick, ready_tick: x.ready_tick, waypoints: encode_plan(x.plan))

fn save_towns(items: List<Town>, world: WorldId, existing: List<TownRow>, i: Int) -> Result<Bool, DataError>:
  match list_get(items, i):
    None => match len(existing) <= i:
      true => Ok(true)
      false => clear_towns(list_slice(existing, i, len(existing) - i), 0)
    Some(t) =>
      match list_get(existing, i):
        Some(row) =>
          let updated = towns.update(row.id, edit_town_row(t, row, i))?
          save_towns(items, world, existing, i + 1)
        None =>
          let created = towns.create(new_town_row(t, world, i))?
          save_towns(items, world, existing, i + 1)

fn save_sites(items: List<Site>, world: WorldId, existing: List<SiteRow>, i: Int) -> Result<Bool, DataError>:
  match list_get(items, i):
    None => match len(existing) <= i:
      true => Ok(true)
      false => clear_sites(list_slice(existing, i, len(existing) - i), 0)
    Some(s) =>
      match list_get(existing, i):
        Some(row) =>
          let updated = sites.update(row.id, edit_site_row(s, i))?
          save_sites(items, world, existing, i + 1)
        None =>
          let created = sites.create(new_site_row(s, world, i))?
          save_sites(items, world, existing, i + 1)

fn save_routes(items: List<Route>, world: WorldId, existing: List<RouteRow>, i: Int, towns: List<Town>) -> Result<Bool, DataError>:
  match list_get(items, i):
    None => match len(existing) <= i:
      true => Ok(true)
      false => clear_routes(list_slice(existing, i, len(existing) - i), 0)
    Some(r) =>
      match list_get(existing, i):
        Some(row) =>
          let updated = routes.update(row.id, edit_route_row(r, i, towns)?)?
          save_routes(items, world, existing, i + 1, towns)
        None =>
          let created = routes.create(new_route_row(r, world, i, towns)?)?
          save_routes(items, world, existing, i + 1, towns)

fn save_projects(items: List<Project>, world: WorldId, existing: List<ProjectRow>, i: Int) -> Result<Bool, DataError>:
  match list_get(items, i):
    None => match len(existing) <= i:
      true => Ok(true)
      false => clear_projects(list_slice(existing, i, len(existing) - i), 0)
    Some(p) =>
      match list_get(existing, i):
        Some(row) =>
          let updated = projects.update(row.id, edit_project_row(p, i))?
          save_projects(items, world, existing, i + 1)
        None =>
          let created = projects.create(new_project_row(p, world, i))?
          save_projects(items, world, existing, i + 1)

fn save_logs(items: List<Text>, world: WorldId, epoch: Int, base: Int, i: Int) -> Result<Bool, DataError>:
  match list_get(items, i):
    None => Ok(true)
    Some(message) =>
      let created = logs.create(NewLogRow(world: world, epoch: epoch, seq: base + i, message: message))?
      save_logs(items, world, epoch, base, i + 1)

fn save_history(items: List<Int>, world: WorldId, epoch: Int, base: Int, i: Int) -> Result<Bool, DataError>:
  match list_get(items, i):
    None => Ok(true)
    Some(value) =>
      let created = history.create(NewHistoryRow(world: world, epoch: epoch, seq: base + i, value: value))?
      save_history(items, world, epoch, base, i + 1)

fn save_snapshot(world_id: WorldId, tick: Int, money: Int, pop: Int, prosperity: Int, traffic: Int, research: Int) -> Result<Bool, DataError>:
  let seq = snapshots.count(world: world_id)?
  let _ = snapshots.create(NewSnapshotRow(world: world_id, seq: seq, tick: tick, money: money, pop: pop, prosperity: prosperity, traffic: traffic, research: research))?
  Ok(true)

fn save_snapshot_from_world(world_id: WorldId, world: World) -> Result<Bool, DataError>:
  let traffic_values = for r in world.routes:
    r.traffic
  save_snapshot(world_id, world.tick, world.money, total_pop(world), total_prosperity(world), total(traffic_values), max_town_research(world))

fn save_children(world: WorldId, game: Game) -> Result<Bool, DataError>:
  let town_rows = towns.page(world: world, order: "ord", after: "", limit: 100)?
  let site_rows = sites.page(world: world, order: "ord", after: "", limit: 100)?
  let route_rows = routes.page(world: world, order: "ord", after: "", limit: 100)?
  let project_rows = projects.page(world: world, order: "ord", after: "", limit: 100)?
  save_towns(game.world.towns, world, town_rows, 0)?
  save_sites(game.world.sites, world, site_rows, 0)?
  save_routes(game.world.routes, world, route_rows, 0, game.world.towns)?
  save_projects(game.projects, world, project_rows, 0)?
  Ok(true)

# ---------------------------------------------------------------- compact tick

fn town_row_index_small(rows: List<TownRow>, key: Text, start: Int, count: Int) -> Int:
  match count <= 0:
    true => -1
    false => match list_get(rows, start):
      None => -1
      Some(row) => match row.key == key:
        true => start
        false => town_row_index_small(rows, key, start + 1, count - 1)

fn town_row_index_range(rows: List<TownRow>, key: Text, start: Int, count: Int) -> Int:
  match count <= 0:
    true => -1
    false => match count <= 8:
      true => town_row_index_small(rows, key, start, count)
      false =>
        let half = count / 2
        let left = town_row_index_range(rows, key, start, half)
        match left >= 0:
          true => left
          false => town_row_index_range(rows, key, start + half, count - half)

fn town_row_index(rows: List<TownRow>, key: Text) -> Int:
  town_row_index_range(rows, key, 0, len(rows))

fn town_ord_index_small(rows: List<TownRow>, ord: Int, start: Int, count: Int) -> Int:
  match count <= 0:
    true => -1
    false => match list_get(rows, start):
      None => -1
      Some(row) => match row.ord == ord:
        true => start
        false => town_ord_index_small(rows, ord, start + 1, count - 1)

fn town_ord_index_range(rows: List<TownRow>, ord: Int, start: Int, count: Int) -> Int:
  match count <= 0:
    true => -1
    false => match count <= 8:
      true => town_ord_index_small(rows, ord, start, count)
      false =>
        let half = count / 2
        let left = town_ord_index_range(rows, ord, start, half)
        match left >= 0:
          true => left
          false => town_ord_index_range(rows, ord, start + half, count - half)

fn town_ord_index(rows: List<TownRow>, ord: Int) -> Int:
  town_ord_index_range(rows, ord, 0, len(rows))

fn town_state_row(row: TownRow, seed: Int) -> List<Int>:
  [row.pop, row.prosperity, row.research, row.endow0, row.endow1, row.endow2, row.endow3, row.endow4, row.endow5, row.endow6, row.endow7, row.endow8, row.endow9, row.endow10, row.endow11, row.endow12, row.endow13, row.endow14, row.endow15, row.endow16, row.endow17, row.stock0, row.stock1, row.stock2, row.stock3, row.stock4, row.stock5, row.stock6, row.stock7, row.stock8, row.stock9, row.stock10, row.stock11, row.stock12, row.stock13, row.stock14, row.stock15, row.stock16, row.stock17, town_climate(seed, row.x, row.y)]

fn route_state_row(row: RouteRow, a: Int, b: Int) -> List<Int>:
  let rules = decode_link_rules(row.rules)
  let base = [a, b, row.fee, row.traffic, row.capacity, row.upkeep, route_mode_code(row.mode)]
  concat_ints(concat_ints(concat_ints(base, rules.allow), rules.fee), decode_pipeline(row.pipeline))

fn compact_town_edit(row: TownRow, values: List<Int>) -> EditTownRow:
  let has_endow = len(values) > 21
  let stock_base = match has_endow:
    true => 21
    false => 3
  let endow0 = match has_endow:
    true => nth_int(values, 3)
    false => row.endow0
  let endow1 = match has_endow:
    true => nth_int(values, 4)
    false => row.endow1
  let endow2 = match has_endow:
    true => nth_int(values, 5)
    false => row.endow2
  let endow3 = match has_endow:
    true => nth_int(values, 6)
    false => row.endow3
  let endow4 = match has_endow:
    true => nth_int(values, 7)
    false => row.endow4
  let endow5 = match has_endow:
    true => nth_int(values, 8)
    false => row.endow5
  let endow6 = match has_endow:
    true => nth_int(values, 9)
    false => row.endow6
  let endow7 = match has_endow:
    true => nth_int(values, 10)
    false => row.endow7
  let endow8 = match has_endow:
    true => nth_int(values, 11)
    false => row.endow8
  let endow9 = match has_endow:
    true => nth_int(values, 12)
    false => row.endow9
  let endow10 = match has_endow:
    true => nth_int(values, 13)
    false => row.endow10
  let endow11 = match has_endow:
    true => nth_int(values, 14)
    false => row.endow11
  let endow12 = match has_endow:
    true => nth_int(values, 15)
    false => row.endow12
  let endow13 = match has_endow:
    true => nth_int(values, 16)
    false => row.endow13
  let endow14 = match has_endow:
    true => nth_int(values, 17)
    false => row.endow14
  let endow15 = match has_endow:
    true => nth_int(values, 18)
    false => row.endow15
  let endow16 = match has_endow:
    true => nth_int(values, 19)
    false => row.endow16
  let endow17 = match has_endow:
    true => nth_int(values, 20)
    false => row.endow17
  EditTownRow(ord: row.ord, key: row.key, name: row.name, x: row.x, y: row.y, terrain: row.terrain, pop: nth_int(values, 0), prosperity: nth_int(values, 1), research: nth_int(values, 2), endow0: endow0, endow1: endow1, endow2: endow2, endow3: endow3, endow4: endow4, endow5: endow5, endow6: endow6, endow7: endow7, endow8: endow8, endow9: endow9, endow10: endow10, endow11: endow11, endow12: endow12, endow13: endow13, endow14: endow14, endow15: endow15, endow16: endow16, endow17: endow17, stock0: nth_int(values, stock_base), stock1: nth_int(values, stock_base + 1), stock2: nth_int(values, stock_base + 2), stock3: nth_int(values, stock_base + 3), stock4: nth_int(values, stock_base + 4), stock5: nth_int(values, stock_base + 5), stock6: nth_int(values, stock_base + 6), stock7: nth_int(values, stock_base + 7), stock8: nth_int(values, stock_base + 8), stock9: nth_int(values, stock_base + 9), stock10: nth_int(values, stock_base + 10), stock11: nth_int(values, stock_base + 11), stock12: nth_int(values, stock_base + 12), stock13: nth_int(values, stock_base + 13), stock14: nth_int(values, stock_base + 14), stock15: nth_int(values, stock_base + 15), stock16: nth_int(values, stock_base + 16), stock17: nth_int(values, stock_base + 17), tech: row.tech, exposure: row.exposure)

fn compact_route_edit(row: RouteRow, values: List<Int>) -> EditRouteRow:
  EditRouteRow(ord: row.ord, key: row.key, a: row.a, b: row.b, a_name: row.a_name, b_name: row.b_name, mode: row.mode, bend: row.bend, fee: row.fee, traffic: nth_int(values, 0), capacity: row.capacity, upkeep: row.upkeep, waypoints: row.waypoints, a_ord: row.a_ord, b_ord: row.b_ord, rules: row.rules, pipeline: row.pipeline, flow: encode_flow(flow_from_result(values)))

fn save_compact_towns_small(rows: List<TownRow>, values: List<List<Int>>, start: Int, end: Int) -> Result<Bool, DataError>:
  match start >= end:
    true => Ok(true)
    false => match list_get(rows, start):
      None => Ok(true)
      Some(row) => match list_get(values, start):
        Some(row_values) =>
          let updated = towns.update(row.id, compact_town_edit(row, row_values))?
          save_compact_towns_small(rows, values, start + 1, end)
        None => Ok(true)

fn save_compact_towns(rows: List<TownRow>, values: List<List<Int>>, start: Int, end: Int) -> Result<Bool, DataError>:
  match end <= start:
    true => Ok(true)
    false => match end - start <= 8:
      true => save_compact_towns_small(rows, values, start, end)
      false =>
        let half = (end - start) / 2
        save_compact_towns(rows, values, start, start + half)?
        save_compact_towns(rows, values, start + half, end)

fn save_compact_routes_small(rows: List<RouteRow>, values: List<List<Int>>, start: Int, end: Int) -> Result<Bool, DataError>:
  match start >= end:
    true => Ok(true)
    false => match list_get(rows, start):
      None => Ok(true)
      Some(row) => match list_get(values, start):
        Some(row_values) =>
          let updated = routes.update(row.id, compact_route_edit(row, row_values))?
          save_compact_routes_small(rows, values, start + 1, end)
        None => Ok(true)

fn save_compact_routes(rows: List<RouteRow>, values: List<List<Int>>, start: Int, end: Int) -> Result<Bool, DataError>:
  match end <= start:
    true => Ok(true)
    false => match end - start <= 8:
      true => save_compact_routes_small(rows, values, start, end)
      false =>
        let half = (end - start) / 2
        save_compact_routes(rows, values, start, start + half)?
        save_compact_routes(rows, values, start + half, end)

fn compact_scale_at(row: WorldRow, tick: Int) -> Int:
  match row.auto_upkeep:
    true => 100
    false => match tick / hours_per_week() - row.last_paid_tick / hours_per_week() >= 2:
      true => 50
      false => 100

fn compact_scale(row: WorldRow) -> Int:
  compact_scale_at(row, row.tick)

fn town_cursor(rows: List<TownRow>) -> Result<Text, DataError>:
  match list_get(rows, len(rows) - 1):
    Some(row) => towns.cursor(row: row, order: "ord")
    None => Ok("")

fn route_cursor(rows: List<RouteRow>) -> Result<Text, DataError>:
  match list_get(rows, len(rows) - 1):
    Some(row) => routes.cursor(row: row, order: "ord")
    None => Ok("")

fn has_routes(world: WorldId) -> Result<Bool, DataError>:
  let rows = routes.page(world: world, order: "ord", after: "", limit: 1)?
  Ok(len(rows) > 0)

fn compact_summary(row: WorldRow, town_rows: List<TownRow>, route_rows: List<RouteRow>) -> List<Int>:
  let pops = for t in town_rows:
    t.pop
  let props = for t in town_rows:
    t.prosperity
  let traffic = for r in route_rows:
    r.traffic
  [row.tick, row.money, total(pops), total(props), total(traffic)]

fn with_streams(world: World, entries: List<Text>, values: List<Int>) -> World:
  World(seed: world.seed, tick: world.tick, money: world.money, towns: world.towns, sites: world.sites, routes: world.routes, log: entries, history: values, tech: world.tech)

fn attach_streams(world: WorldId, epoch: Int, game: Game) -> Result<Game, DataError>:
  match len(game.world.log) > 0 or len(game.world.history) > 0:
    true => Ok(game)
    false =>
      let log_rows = logs.page(world: world, epoch: epoch, order: "seq", descending: true, after: "", limit: 8)?
      let history_rows = history.page(world: world, epoch: epoch, order: "seq", descending: true, after: "", limit: 16)?
      let messages = for r in log_rows:
        r.message
      let numbers = for r in history_rows:
        r.value
      let entries = list_reverse(messages)
      let values = list_reverse(numbers)
      let streamed = with_streams(game.world, entries, values)
      Ok(raw_game(streamed, game.projects, game.auto_upkeep, game.last_paid_tick, game.upkeep_per_cycle, game.sel, game.notice, game.last_ok))

fn save_game(game: Game, phase: Int, epoch: Int) -> Result<Game, DataError>:
  save_game_window(game, phase, epoch, 0, 0)

fn draft_or_empty(value: Text, keep: Bool) -> Text:
  match keep:
    true => value
    false => ""

fn world_edit_row(row: WorldRow, game: Game, phase: Int, epoch: Int, settle_days: Int, settle_from: Int) -> EditWorldRow:
  EditWorldRow(seed: game.world.seed, generation_version: generation_version(), tick: game.world.tick, money: game.world.money, tech_road: false, tech_river: false, tech_rail: false, tech: game.world.tech, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, phase: phase, epoch: epoch, settle_days: settle_days, settle_from: settle_from, settle_cursor: row.settle_cursor, draft_from: draft_or_empty(row.draft_from, epoch == row.epoch), draft_to: draft_or_empty(row.draft_to, epoch == row.epoch), draft_via: draft_or_empty(row.draft_via, epoch == row.epoch))

fn save_game_window(game: Game, phase: Int, epoch: Int, settle_days: Int, settle_from: Int) -> Result<Game, DataError>:
  let all = worlds.select(limit: 100)?
  match list_get(all, 0):
    None =>
      let created = worlds.create(NewWorldRow(seed: game.world.seed, generation_version: generation_version(), tick: game.world.tick, money: game.world.money, tech_road: false, tech_river: false, tech_rail: false, tech: game.world.tech, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, phase: phase, epoch: epoch, settle_days: settle_days, settle_from: settle_from, draft_from: "", draft_to: "", draft_via: ""))?
      let _ = ensure_current_world(created.id)?
      save_children(created.id, game)?
      let log_base = logs.count(world: created.id, epoch: epoch)?
      save_logs(game.world.log, created.id, epoch, log_base, 0)?
      let history_base = history.count(world: created.id, epoch: epoch)?
      save_history(game.world.history, created.id, epoch, history_base, 0)?
      Ok(game)
    Some(first) =>
      let current_rows = currentworlds.select(limit: 1)?
      let idx = match list_get(current_rows, 0):
        Some(cw) => find_world_index(all, cw.world, 0)
        None => 0
      let i = match idx < 0:
        true => 0
        false => idx
      let row = match list_get(all, i):
        Some(r) => r
        None => first
      let _ = ensure_current_world(row.id)?
      let updated = worlds.update(row.id, world_edit_row(row, game, phase, epoch, settle_days, settle_from))?
      save_children(row.id, game)?
      let log_base = logs.count(world: row.id, epoch: epoch)?
      save_logs(game.world.log, row.id, epoch, log_base, 0)?
      let history_base = history.count(world: row.id, epoch: epoch)?
      save_history(game.world.history, row.id, epoch, history_base, 0)?
      Ok(game)

# ---------------------------------------------------------------- actions

export fn main() -> Text:
  "Arteries authoritative simulation"

fn bounded_steps(n: Int) -> Int:
  match n < 1:
    true => 1
    false => match n > 10:
      true => 10
      false => n

fn bounded_hours(hours: Int) -> Int:
  match hours < 1:
    true => 1
    false => match hours > 672:
      true => 672
      false => hours

fn bounded_limit(limit: Int) -> Int:
  match limit < 1:
    true => 1
    false => match limit > 100:
      true => 100
      false => limit

fn settlement_days(start: Int, target: Int, cadence: Text) -> Int:
  match cadence == "weekly":
    true => (target / hours_per_week() - start / hours_per_week()) * days_per_week()
    false => match cadence == "monthly":
      true => (target / hours_per_month() - start / hours_per_month()) * days_per_month()
      false => target / hours_per_day() - start / hours_per_day()

fn compact_with_row(row: WorldRow, hours: Int, cadence: Text) -> Result<List<Int>, DataError>:
  let town_rows = towns.page(world: row.id, order: "ord", after: "", limit: 100)?
  let route_rows = routes.page(world: row.id, order: "ord", after: "", limit: 100)?
  let start = row.tick
  let target = start + bounded_hours(hours)
  let days = settlement_days(start, target, cadence)
  match row.phase == 1 or days <= 0:
    true => Ok(compact_summary(row, town_rows, route_rows))
    false =>
      let town_values = for t in town_rows:
        town_state_row(t, row.seed)
      let route_values = for r in route_rows:
        route_state_row(r, town_row_index(town_rows, r.a), town_row_index(town_rows, r.b))
      let pipeline_values = for r in route_rows:
        r.pipeline
      let techs = for t in town_rows:
        t.tech
      let effects = tech_effect_masks_server(techs)?
      let result = host.compute<List<List<Int>>>("arteries", "market", row.money, town_values, route_values, pipeline_values, days, compact_scale(row), effects)?
      let money_row = match list_get(result, 0):
        Some(values) => values
        None => []
      let money = nth_int(money_row, 0)
      let updated_towns = list_slice(result, 1, len(town_rows))
      let updated_routes = list_slice(result, 1 + len(town_rows), len(route_rows))
      save_compact_towns(town_rows, updated_towns, 0, len(town_rows))?
      save_compact_routes(route_rows, updated_routes, 0, len(route_rows))?
      let updated = worlds.update(row.id, EditWorldRow(seed: row.seed, generation_version: row.generation_version, tick: target, money: money, tech_road: false, tech_river: false, tech_rail: false, tech: row_tech(row), auto_upkeep: row.auto_upkeep, last_paid_tick: row.last_paid_tick, upkeep_per_cycle: row.upkeep_per_cycle, phase: 1, epoch: row.epoch, settle_days: days, settle_from: start, settle_cursor: "", draft_from: row.draft_from, draft_to: row.draft_to, draft_via: row.draft_via))?
      let pops = for values in updated_towns:
        nth_int(values, 0)
      let props = for values in updated_towns:
        nth_int(values, 1)
      let traffic = for values in updated_routes:
        nth_int(values, 0)
      let summary = [target, money, total(pops), total(props), total(traffic)]
      Ok(summary)

# Market phase for large frontiers: rows go to the Rust kernel and back without
# constructing a World. Returns [tick, money, total_pop, total_prosperity,
# total_traffic]. The existing advance_finish can finish the staged phase.
export fn advance_compact(hours: Int, cadence: Text) -> Result<List<Int>, DataError>:
  let rows = current_world_rows()?
  match list_get(rows, 0):
    Some(row) => compact_with_row(row, hours, cadence)
    None =>
      let loaded = load_state()?
      match list_get(current_world_rows()?, 0):
        Some(row) => compact_with_row(row, hours, cadence)
        None => Ok([loaded.world.tick, loaded.world.money, total_pop(loaded.world), total_prosperity(loaded.world), 0])

fn max_research_rows(rows: List<TownRow>, i: Int, best: Int) -> Int:
  match list_get(rows, i):
    None => best
    Some(row) =>
      let next = match row.research > best:
        true => row.research
        false => best
      max_research_rows(rows, i + 1, next)

fn any_congested_rows(rows: List<RouteRow>, i: Int) -> Bool:
  match list_get(rows, i):
    None => false
    Some(row) =>
      match row.capacity > 0 and row.traffic * 4 > row.capacity * 3:
        true => true
        false => any_congested_rows(rows, i + 1)

fn any_hungry_rows(rows: List<TownRow>, i: Int) -> Bool:
  match list_get(rows, i):
    None => false
    Some(row) =>
      match food_ok(town_from_row(row)) == 0:
        true => true
        false => any_hungry_rows(rows, i + 1)

fn alert_if(alerts: List<CompactAlert>, ok: Bool, kind: Text, tone: Text, text: Text) -> List<CompactAlert>:
  match ok:
    true => list_append(alerts, CompactAlert(kind: kind, tone: tone, text: text))
    false => alerts

export fn compact_network() -> Result<CompactNetwork, DataError>:
  let rows = current_world_rows()?
  match list_get(rows, 0):
    None => Ok(CompactNetwork(towns: [], routes: []))
    Some(row) =>
      let town_rows = towns.page(world: row.id, order: "ord", after: "", limit: 100)?
      let route_rows = routes.page(world: row.id, order: "ord", after: "", limit: 100)?
      let town_values = for r in town_rows:
        CompactTown(id: r.key, name: r.name, x: r.x, y: r.y, pop: r.pop, prosperity: r.prosperity, research: r.research)
      let route_values = for r in route_rows:
        CompactRoute(id: r.key, a: r.a, b: r.b, a_name: r.a_name, b_name: r.b_name, mode: r.mode, traffic: r.traffic, capacity: r.capacity)
      Ok(CompactNetwork(towns: town_values, routes: route_values))

export fn compact_history(limit: Int) -> Result<List<CompactHistoryRow>, DataError>:
  let rows = current_world_rows()?
  match list_get(rows, 0):
    None => Ok([])
    Some(row) =>
      let page_limit = match limit < 1:
        true => 1
        false => match limit > 24:
          true => 24
          false => limit
      let history_rows = snapshots.page(world: row.id, order: "seq", descending: true, after: "", limit: page_limit)?
      let ordered = list_reverse(history_rows)
      let values = for r in ordered:
        CompactHistoryRow(tick: r.tick, money: r.money, pop: r.pop, prosperity: r.prosperity, traffic: r.traffic, research: r.research)
      Ok(values)

# Capture the current completed world as a rich history point. The full-map
# finish path is already at the managed-value budget, so it cannot traverse the
# World to build this row. The external UI calls this bounded read/write after a
# full-map cycle and before it reads compact history.
export fn compact_capture() -> Result<Bool, DataError>:
  let rows = current_world_rows()?
  match list_get(rows, 0):
    None => Ok(false)
    Some(row) =>
      match row.phase != 0:
        true => Ok(false)
        false =>
          let latest = snapshots.page(world: row.id, order: "seq", descending: true, after: "", limit: 1)?
          let already = match list_get(latest, 0):
            Some(last) => last.tick == row.tick and last.money == row.money
            None => false
          match already:
            true => Ok(false)
            false =>
              let town_rows = towns.page(world: row.id, order: "ord", after: "", limit: 100)?
              let route_rows = routes.page(world: row.id, order: "ord", after: "", limit: 100)?
              let pops = for t in town_rows:
                t.pop
              let props = for t in town_rows:
                t.prosperity
              let traffics = for r in route_rows:
                r.traffic
              let _ = save_snapshot(row.id, row.tick, row.money, total(pops), total(props), total(traffics), max_research_rows(town_rows, 0, 0))?
              Ok(true)

export fn compact_alerts() -> Result<List<CompactAlert>, DataError>:
  let rows = current_world_rows()?
  match list_get(rows, 0):
    None => Ok([])
    Some(row) =>
      let town_rows = towns.page(world: row.id, order: "ord", after: "", limit: 100)?
      let route_rows = routes.page(world: row.id, order: "ord", after: "", limit: 100)?
      let upkeeps = for r in route_rows:
        r.upkeep
      let upkeep = total(upkeeps)
      let weeks_raw = row.tick / hours_per_week() - row.last_paid_tick / hours_per_week()
      let weeks = match weeks_raw < 0:
        true => 0
        false => weeks_raw
      let due = match row.auto_upkeep:
        true => 0
        false => upkeep * weeks
      let alerts0 = alert_if([], row.money < 0, "treasury", "danger", "Treasury is negative. Upkeep is eating the network.")
      let alerts1 = alert_if(alerts0, due > 0, "upkeep", "warn", "Upkeep due: " + int_text(due) + " crowns.")
      let alerts2 = alert_if(alerts1, any_congested_rows(route_rows, 0), "congestion", "warn", "A route is past three quarters of its capacity.")
      let alerts3 = alert_if(alerts2, any_hungry_rows(town_rows, 0), "food", "danger", "At least one settlement is out of food.")
      let alerts4 = alert_if(alerts3, row.phase != 0, "phase", "info", "Cycle is mid-phase (" + int_text(row.phase) + ").")
      Ok(alerts4)

export fn compact_overview() -> Result<CompactOverview, DataError>:
  let summary = load_compact()?
  let rows = current_world_rows()?
  match list_get(rows, 0):
    None => Ok(CompactOverview(summary: summary, tech_count: 0, tech_total: tech_row_count(), era: 1, auto_upkeep: false, projects: 0, pop: 0, prosperity: 0, traffic: 0, max_research: 0, upkeep_due: 0))
    Some(row) =>
      let town_rows = towns.page(world: row.id, order: "ord", after: "", limit: 100)?
      let route_rows = routes.page(world: row.id, order: "ord", after: "", limit: 100)?
      let tech = row_tech(row)
      let pops = for t in town_rows:
        t.pop
      let props = for t in town_rows:
        t.prosperity
      let traffics = for r in route_rows:
        r.traffic
      let upkeeps = for r in route_rows:
        r.upkeep
      let pop = total(pops)
      let prosperity = total(props)
      let traffic = total(traffics)
      let upkeep = total(upkeeps)
      let weeks_raw = row.tick / hours_per_week() - row.last_paid_tick / hours_per_week()
      let weeks = match weeks_raw < 0:
        true => 0
        false => weeks_raw
      let due = match row.auto_upkeep:
        true => 0
        false => upkeep * weeks
      Ok(CompactOverview(summary: summary, tech_count: tech_state_count(tech), tech_total: tech_row_count(), era: tech_state_era(tech), auto_upkeep: row.auto_upkeep, projects: projects.count(world: row.id)?, pop: pop, prosperity: prosperity, traffic: traffic, max_research: max_research_rows(town_rows, 0, 0), upkeep_due: due))

export fn switch_world_compact(id: Text) -> Result<ScaleSummary, DataError>:
  let rows = worlds.select(limit: 100)?
  let idx = find_world_index(rows, WorldId(id), 0)
  match idx < 0:
    true => Err("World not found.")
    false =>
      let target = world_at(rows, idx)?
      let _ = ensure_current_world(target.id)?
      load_compact()

export fn new_seed_compact() -> Result<ScaleSummary, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let game = game_new_seed(current)
  let id = create_world(game, state.epoch + 1)?
  let _ = ensure_current_world(id)?
  load_compact()

fn compact_edit_world(row: WorldRow, tick: Int, money: Int, phase: Int, settle_days: Int, settle_from: Int, cursor: Text) -> EditWorldRow:
  EditWorldRow(seed: row.seed, generation_version: row.generation_version, tick: tick, money: money, tech_road: false, tech_river: false, tech_rail: false, tech: row_tech(row), auto_upkeep: row.auto_upkeep, last_paid_tick: row.last_paid_tick, upkeep_per_cycle: row.upkeep_per_cycle, phase: phase, epoch: row.epoch, settle_days: settle_days, settle_from: settle_from, settle_cursor: cursor, draft_from: row.draft_from, draft_to: row.draft_to, draft_via: row.draft_via)

fn compact_start(row: WorldRow, hours: Int, cadence: Text) -> Result<WorldRow, DataError>:
  let start = row.tick
  let target = start + bounded_hours(hours)
  let days = settlement_days(start, target, cadence)
  worlds.update(row.id, compact_edit_world(row, target, row.money, 2, days, start, ""))

fn add_endpoint(rows: List<TownRow>, world: WorldId, ord: Int) -> Result<List<TownRow>, DataError>:
  match town_ord_index(rows, ord) >= 0:
    true => Ok(rows)
    false =>
      let found = towns.select(world: world, ord: ord, limit: 1)?
      match list_get(found, 0):
        Some(row) => Ok(list_append(rows, row))
        None => Ok(rows)

fn trade_page_values(route_rows: List<RouteRow>, world: WorldId, i: Int, towns_acc: List<TownRow>, route_acc: List<List<Int>>) -> Result<TradePage, DataError>:
  match list_get(route_rows, i):
    None => Ok(TradePage(towns: towns_acc, routes: route_acc))
    Some(route) =>
      let towns1 = add_endpoint(towns_acc, world, route.a_ord)?
      let towns2 = add_endpoint(towns1, world, route.b_ord)?
      let a = town_ord_index(towns2, route.a_ord)
      let b = town_ord_index(towns2, route.b_ord)
      trade_page_values(route_rows, world, i + 1, towns2, list_append(route_acc, route_state_row(route, a, b)))

# Multi-hop flow needs the whole network, so the trade phase sends every route
# and its endpoint towns in one kernel call instead of paging five routes at a
# time. The route cap keeps that well inside the declared wire limits.
fn trade_chunk_page(row: WorldRow, after: Text, limit: Int) -> Result<List<Text>, DataError>:
  let route_rows = routes.page(world: row.id, order: "ord", after: "", limit: 100)?
  match len(route_rows) == 0:
    true =>
      let done = worlds.update(row.id, compact_edit_world(row, row.tick, row.money, 1, row.settle_days, row.settle_from, ""))?
      Ok(["", "1", int_text(done.tick), int_text(done.money), "0", "0"])
    false =>
      let page = trade_page_values(route_rows, row.id, 0, [], [])?
      let town_values = for t in page.towns:
        town_state_row(t, row.seed)
      let pipeline_values = for r in route_rows:
        r.pipeline
      let techs = for t in page.towns:
        t.tech
      let effects = tech_effect_masks_server(techs)?
      let result = host.compute<List<List<Int>>>("arteries", "trade", row.money, town_values, page.routes, pipeline_values, row.settle_days, compact_scale_at(row, row.settle_from), effects)?
      let money_row = match list_get(result, 0):
        Some(values) => values
        None => []
      let money = nth_int(money_row, 0)
      let updated_towns = list_slice(result, 1, len(page.towns))
      save_compact_towns(page.towns, updated_towns, 0, len(page.towns))?
      let updated_routes = list_slice(result, 1 + len(page.towns), len(route_rows))
      save_compact_routes(route_rows, updated_routes, 0, len(route_rows))?
      let traffic = for values in updated_routes:
        nth_int(values, 0)
      let done = worlds.update(row.id, compact_edit_world(row, row.tick, money, 1, row.settle_days, row.settle_from, ""))?
      Ok(["", "1", int_text(done.tick), int_text(money), int_text(total(traffic)), "0"])

fn compact_chunk_page(row: WorldRow, after: Text, limit: Int) -> Result<List<Text>, DataError>:
  let town_rows = towns.page(world: row.id, order: "ord", after: after, limit: limit)?
  match len(town_rows) == 0:
    true => match has_routes(row.id)?:
      true =>
        let routed = worlds.update(row.id, compact_edit_world(row, row.tick, row.money, 3, row.settle_days, row.settle_from, ""))?
        Ok(["", "3", int_text(routed.tick), int_text(routed.money), "0", "0"])
      false =>
        let done = worlds.update(row.id, compact_edit_world(row, row.tick, row.money, 1, row.settle_days, row.settle_from, ""))?
        Ok(["", "1", int_text(done.tick), int_text(done.money), "0", "0"])
    false =>
      let town_values = for t in town_rows:
        town_state_row(t, row.seed)
      let no_routes = []
      let no_pipelines = []
      let techs = for t in town_rows:
        t.tech
      let effects = tech_effect_masks_server(techs)?
      let result = host.compute<List<List<Int>>>("arteries", "market", row.money, town_values, no_routes, no_pipelines, row.settle_days, compact_scale_at(row, row.settle_from), effects)?
      let money_row = match list_get(result, 0):
        Some(values) => values
        None => []
      let money = nth_int(money_row, 0)
      let updated_towns = list_slice(result, 1, len(town_rows))
      save_compact_towns(town_rows, updated_towns, 0, len(town_rows))?
      let pops = for values in updated_towns:
        nth_int(values, 0)
      let props = for values in updated_towns:
        nth_int(values, 1)
      let cursor = town_cursor(town_rows)?
      let done = worlds.update(row.id, compact_edit_world(row, row.tick, money, 2, row.settle_days, row.settle_from, cursor))?
      Ok([cursor, "2", int_text(done.tick), int_text(done.money), int_text(total(pops)), int_text(total(props))])

# One bounded production page for a large frontier. The client calls this with
# after="" and then with each returned cursor until phase=1. Market trade and
# finish remain on the staged path until their chunked slices land.
export fn advance_compact_chunk(hours: Int, cadence: Text, after: Text, limit: Int) -> Result<List<Text>, DataError>:
  let rows = current_world_rows()?
  match list_get(rows, 0):
    None => Ok(["", "1", "0", "0", "0", "0"])
    Some(row) =>
      let page_limit = bounded_limit(limit)
      let start_row = match row.phase == 0:
        true => compact_start(row, hours, cadence)?
        false => row
      match start_row.phase == 1:
        true => Ok(["", "1", int_text(start_row.tick), int_text(start_row.money), "0", "0"])
        false => match start_row.phase == 3:
          true => trade_chunk_page(start_row, after, page_limit)
          false => compact_chunk_page(start_row, after, page_limit)

fn boundary_in_period_server(start: Int, days: Int, cadence: Int) -> Bool:
  let remainder = start - (start / cadence) * cadence
  let offset = match remainder == 0:
    true => 0
    false => cadence - remainder
  offset < days

fn finish_chunk_page(row: WorldRow, after: Text, limit: Int) -> Result<List<Text>, DataError>:
  let town_count = towns.count(world: row.id)?
  let town_rows = towns.page(world: row.id, order: "ord", after: after, limit: limit)?
  match len(town_rows) == 0:
    true =>
      let _ = worlds.update(row.id, compact_edit_world(row, row.tick, row.money, 5, row.settle_days, row.settle_from, ""))?
      Ok(["", "5", "0", "0"])
    false =>
      let start_index = match list_get(town_rows, 0):
        Some(town) => town.ord
        None => 0
      let town_values = for t in town_rows:
        town_state_row(t, row.seed)
      let result = host.compute<List<List<Int>>>("arteries", "finish", row.seed, row.settle_from, row.settle_days, town_count, start_index, town_values)?
      let summary = match list_get(result, 0):
        Some(values) => values
        None => []
      let updated_towns = list_slice(result, 1, len(town_rows))
      save_compact_towns(town_rows, updated_towns, 0, len(town_rows))?
      let cursor = town_cursor(town_rows)?
      let _ = worlds.update(row.id, compact_edit_world(row, row.tick, row.money, 4, row.settle_days, row.settle_from, cursor))?
      Ok([cursor, "4", int_text(nth_int(summary, 0)), int_text(nth_int(summary, 1))])

# Apply one bounded finish page. The caller accumulates max research and total
# prosperity, then calls advance_finish_commit.
export fn advance_finish_chunk(after: Text, limit: Int) -> Result<List<Text>, DataError>:
  let rows = current_world_rows()?
  match list_get(rows, 0):
    None => Ok(["", "0", "0", "0"])
    Some(row) =>
      let page_limit = bounded_limit(limit)
      match row.phase == 0:
        true => Ok(["", "0", "0", "0"])
        false => match row.phase == 1:
          true =>
            let started = worlds.update(row.id, compact_edit_world(row, row.tick, row.money, 4, row.settle_days, row.settle_from, ""))?
            finish_chunk_page(started, after, page_limit)
          false => match row.phase == 4:
            true => finish_chunk_page(row, after, page_limit)
            false => Ok(["", int_text(row.phase), "0", "0"])

fn finish_tech_messages(row: WorldRow, union: Text) -> List<Text>:
  let tech = row_tech(row)
  match union == tech:
    true => []
    false => tech_discovery_messages(tech, union)


fn finish_event_messages(row: WorldRow) -> List<Text>:
  let start_day = row.settle_from / hours_per_day()
  let harvest = boundary_in_period_server(start_day, row.settle_days, 6)
  let storm = boundary_in_period_server(start_day, row.settle_days, 9)
  let caravan = boundary_in_period_server(start_day, row.settle_days, 11)
  let log1 = match harvest:
    true => ["A generous harvest adds grain across the frontier."]
    false => []
  let log2 = match storm:
    true => list_append(log1, "A storm damages stores on the frontier.")
    false => log1
  match caravan:
    true => list_append(log2, "A caravan brings timber and stone to the frontier.")
    false => log2

fn finish_messages(row: WorldRow, union: Text) -> List<Text>:
  let events = finish_event_messages(row)
  let tech = finish_tech_messages(row, union)
  append_messages(events, tech, 0)

fn finish_upkeep(row: WorldRow) -> List<Int>:
  let raw_weeks = row.tick / hours_per_week() - row.settle_from / hours_per_week()
  let weeks = match raw_weeks > 0:
    true => raw_weeks
    false => 0
  let money = match row.auto_upkeep:
    true => row.money - row.upkeep_per_cycle * weeks
    false => row.money
  let paid = match row.auto_upkeep and weeks > 0:
    true => (row.tick / hours_per_week()) * hours_per_week()
    false => row.last_paid_tick
  [money, paid]

fn edit_town_tech_row(row: TownRow, tech: Text, exposure: Text) -> EditTownRow:
  EditTownRow(ord: row.ord, key: row.key, name: row.name, x: row.x, y: row.y, terrain: row.terrain, pop: row.pop, prosperity: row.prosperity, research: row.research, endow0: row.endow0, endow1: row.endow1, endow2: row.endow2, endow3: row.endow3, endow4: row.endow4, endow5: row.endow5, endow6: row.endow6, endow7: row.endow7, endow8: row.endow8, endow9: row.endow9, endow10: row.endow10, endow11: row.endow11, endow12: row.endow12, endow13: row.endow13, endow14: row.endow14, endow15: row.endow15, endow16: row.endow16, endow17: row.endow17, stock0: row.stock0, stock1: row.stock1, stock2: row.stock2, stock3: row.stock3, stock4: row.stock4, stock5: row.stock5, stock6: row.stock6, stock7: row.stock7, stock8: row.stock8, stock9: row.stock9, stock10: row.stock10, stock11: row.stock11, stock12: row.stock12, stock13: row.stock13, stock14: row.stock14, stock15: row.stock15, stock16: row.stock16, stock17: row.stock17, tech: tech, exposure: exposure)

fn all_town_tech_empty(rows: List<TownRow>, i: Int) -> Bool:
  match list_get(rows, i):
    None => true
    Some(row) => match row.tech == "":
      true => all_town_tech_empty(rows, i + 1)
      false => false

fn seed_town_tech_rows(rows: List<TownRow>, tech: Text, i: Int) -> Result<Bool, DataError>:
  match list_get(rows, i):
    None => Ok(true)
    Some(row) =>
      let _ = towns.update(row.id, edit_town_tech_row(row, tech, ""))?
      seed_town_tech_rows(rows, tech, i + 1)

fn seed_town_tech(rows: List<TownRow>, tech: Text, i: Int) -> Result<Bool, DataError>:
  match tech == "" or len(rows) == 0 or not all_town_tech_empty(rows, 0):
    true => Ok(true)
    false => seed_town_tech_rows(rows, tech, i)

fn save_town_tech(rows: List<TownRow>, values: List<Text>, town_count: Int, i: Int) -> Result<Bool, DataError>:
  match list_get(rows, i):
    None => Ok(true)
    Some(row) =>
      let tech = nth_text(values, i)
      let exposure = nth_text(values, town_count + i)
      let _ = towns.update(row.id, edit_town_tech_row(row, tech, exposure))?
      save_town_tech(rows, values, town_count, i + 1)

fn town_tech_compute(town_values: List<List<Int>>, techs: List<Text>, exposures: List<Text>, links: List<List<Int>>, days: Int) -> Result<List<Text>, DataError>:
  host.compute<List<Text>>("arteries", "town_tech", town_values, techs, exposures, links, tech_cost_values(), tech_prereq_values(), tech_gate_values(), days, 7)

fn town_tech_apply(row: WorldRow, town_rows: List<TownRow>, route_rows: List<RouteRow>, days: Int) -> Result<List<Text>, DataError>:
  let town_values = for t in town_rows:
    town_state_row(t, row.seed)
  let techs = for t in town_rows:
    t.tech
  let exposures = for t in town_rows:
    t.exposure
  let links = for r in route_rows:
    [r.a_ord, r.b_ord]
  town_tech_compute(town_values, techs, exposures, links, days)

fn town_tech_apply_values(world: World, town_rows: List<TownRow>, route_rows: List<RouteRow>, days: Int) -> Result<List<Text>, DataError>:
  let town_values = for t in world.towns:
    trade_town_row(t, world.seed)
  let techs = for t in town_rows:
    t.tech
  let exposures = for t in town_rows:
    t.exposure
  let links = for r in route_rows:
    [r.a_ord, r.b_ord]
  town_tech_compute(town_values, techs, exposures, links, days)

fn town_tech_apply_game(world_id: WorldId, game: Game, days: Int) -> Result<Game, DataError>:
  let world = game.world
  let town_rows = towns.page(world: world_id, order: "ord", after: "", limit: 100)?
  let route_rows = routes.page(world: world_id, order: "ord", after: "", limit: 100)?
  let values = town_tech_apply_values(world, town_rows, route_rows, days)?
  save_town_tech(town_rows, values, len(town_rows), 0)?
  let union = match list_get(values, len(values) - 1):
    Some(value) => value
    None => world.tech
  let msgs = match union == world.tech:
    true => []
    false => tech_discovery_messages(world.tech, union)
  let log = append_messages(world.log, msgs, 0)
  let updated = World(seed: world.seed, tick: world.tick, money: world.money, towns: world.towns, sites: world.sites, routes: world.routes, log: log, history: world.history, tech: union)
  Ok(Game(world: updated, sel: game.sel, notice: game.notice, last_ok: game.last_ok, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: game.inspect))

fn finish_apply(row: WorldRow, max_research: Int, total_prosperity: Int) -> Result<List<Text>, DataError>:
  let town_rows = towns.page(world: row.id, order: "ord", after: "", limit: 100)?
  let route_rows = routes.page(world: row.id, order: "ord", after: "", limit: 100)?
  let tech_values = match len(town_rows) == 0:
    true => [row_tech(row)]
    false => town_tech_apply(row, town_rows, route_rows, row.settle_days)?
  let union = match list_get(tech_values, len(tech_values) - 1):
    Some(value) => value
    None => row_tech(row)
  let _ = match len(town_rows) == 0:
    true => Ok(true)
    false => save_town_tech(town_rows, tech_values, len(town_rows), 0)
  let log_base = logs.count(world: row.id, epoch: row.epoch)?
  save_logs(finish_messages(row, union), row.id, row.epoch, log_base, 0)?
  let history_base = history.count(world: row.id, epoch: row.epoch)?
  save_history([total_prosperity], row.id, row.epoch, history_base, 0)?
  let upkeep = finish_upkeep(row)
  let updated = worlds.update(row.id, EditWorldRow(seed: row.seed, generation_version: row.generation_version, tick: row.tick, money: nth_int(upkeep, 0), tech_road: false, tech_river: false, tech_rail: false, tech: union, auto_upkeep: row.auto_upkeep, last_paid_tick: nth_int(upkeep, 1), upkeep_per_cycle: row.upkeep_per_cycle, phase: 0, epoch: row.epoch, settle_days: 0, settle_from: 0, settle_cursor: "", draft_from: row.draft_from, draft_to: row.draft_to, draft_via: row.draft_via))?
  let pops = for t in town_rows:
    t.pop
  let traffics = for r in route_rows:
    r.traffic
  let snapshotted = save_snapshot(row.id, updated.tick, updated.money, total(pops), total_prosperity, total(traffics), max_research)?
  Ok([int_text(updated.tick), int_text(updated.money), int_text(max_research), int_text(total_prosperity)])

export fn advance_finish_commit(max_research: Int, total_prosperity: Int) -> Result<List<Text>, DataError>:
  let rows = current_world_rows()?
  match list_get(rows, 0):
    None => Ok(["0", "0", "0", "0"])
    Some(row) =>
      match row.phase == 0:
        true => Ok([int_text(row.tick), int_text(row.money), int_text(max_research), int_text(total_prosperity)])
        false => match row.phase == 4 or row.phase == 5:
          true => finish_apply(row, max_research, total_prosperity)
          false => Ok([int_text(row.tick), int_text(row.money), int_text(max_research), int_text(total_prosperity)])

fn planet_vertices() -> List<List<Int>>:
  for i in indices(rt_vertex_count()):
    let v = rt_vertex(i)
    [v.x, v.y, v.z]

fn planet_faces() -> List<List<Int>>:
  for i in indices(rt_face_count()):
    let f = rt_face(i)
    [f.a, f.b, f.c, f.d]

export fn planet_chunk(seed: Int, detail: Int, start: Int, count: Int) -> Result<List<List<Int>>, DataError>:
  host.compute<List<List<Int>>>("arteries", "planet", seed, detail, start, count, planet_vertices(), planet_faces())

fn planet_summary_chunks(seed: Int, detail: Int, start: Int, vertices: List<List<Int>>, faces: List<List<Int>>, faces_acc: Int, cells_acc: Int, checksum_acc: Int) -> Result<List<Int>, DataError>:
  match start >= len(faces):
    true => Ok([faces_acc, cells_acc, checksum_acc])
    false =>
      let chunk = host.compute<List<Int>>("arteries", "planet_summary", seed, detail, start, 5, vertices, faces)?
      planet_summary_chunks(seed, detail, start + 5, vertices, faces, faces_acc + nth_int(chunk, 0), cells_acc + nth_int(chunk, 1), checksum_acc + nth_int(chunk, 2))

# `rt_seams()` recurses 120 deep and overflows the server stack, so build the
# list with the shallow `indices` helper instead.
fn seam_rows() -> List<List<Int>>:
  for i in indices(rt_seam_count()):
    let s = rt_seam(i)
    [s.face, s.edge, s.neighbor, s.neighbor_edge, s.au, s.bu, s.cu, s.av, s.bv, s.cv]

export fn globe_raster(seed: Int, view: Int) -> Result<List<GlobeRow>, DataError>:
  let vertices = planet_vertices()
  let faces = planet_faces()
  let codes = host.compute<List<Int>>("arteries", "globe_raster", seed, 24, 24, view, vertices, faces)?
  let rows = for r in indices(24):
    GlobeRow(index: r, codes: list_slice(codes, r * 24, 24))
  Ok(rows)

export fn region_trade(seed: Int, lanes: List<Int>) -> Result<RegionTrade, DataError>:
  let vertices = planet_vertices()
  let faces = planet_faces()
  let summaries = host.compute<List<List<Int>>>("arteries", "face_summaries", seed, 8, vertices, faces)?
  let lane_count = len(lanes) / 2
  let lane_rows = host.compute<List<List<Int>>>("arteries", "region_trade", summaries, lanes, 7, 100)?
  let markets = for i in indices(len(summaries)):
    let summary = match list_get(summaries, i):
      Some(row) => row
      None => [0, 0, 0, 0, 0]
    let water = nth_int(summary, 1)
    let land = nth_int(summary, 2)
    let climate = nth_int(summary, 3)
    let biome = nth_int(summary, 4)
    RegionMarket(face: i, pop: region_pop(land, water, climate), prosperity: region_prosperity(land, biome), climate: climate)
  let trade_lanes = for k in indices(lane_count):
    let row = match list_get(lane_rows, k):
      Some(value) => value
      None => [0]
    RegionLane(a: nth_int(lanes, k * 2), b: nth_int(lanes, k * 2 + 1), traffic: nth_int(row, 0))
  let traffic_values = for lane in trade_lanes:
    lane.traffic
  Ok(RegionTrade(markets: markets, lanes: trade_lanes, traffic: total(traffic_values)))

export fn region_map(seed: Int, detail: Int) -> Result<RegionMap, DataError>:
  let vertices = planet_vertices()
  let faces = planet_faces()
  let rows = host.compute<List<List<Int>>>("arteries", "face_summaries", seed, detail, vertices, faces)?
  let tiles = for i in indices(len(rows)):
    let r = match list_get(rows, i):
      Some(row) => row
      None => []
    FaceTile(face: nth_int(r, 0), water: nth_int(r, 1), land: nth_int(r, 2), climate: nth_int(r, 3), biome: nth_int(r, 4))
  let land_flags = for t in tiles:
    match t.land > t.water:
      true => 1
      false => 0
  let summary = host.compute<List<Int>>("arteries", "face_components", seam_rows(), land_flags)?
  let land = total(land_flags)
  Ok(RegionMap(tiles: tiles, land: land, ocean: len(tiles) - land, continents: nth_int(summary, 0), largest: nth_int(summary, 1)))

export fn face_neighbors() -> Result<List<List<Int>>, DataError>:
  host.compute<List<List<Int>>>("arteries", "face_neighbors", seam_rows())

export fn face_path(from: Int, to: Int) -> Result<List<Int>, DataError>:
  host.compute<List<Int>>("arteries", "face_path", seam_rows(), from, to)

export fn planet_summary(seed: Int, detail: Int) -> Result<PlanetSummary, DataError>:
  let vertices = planet_vertices()
  let faces = planet_faces()
  let result = planet_summary_chunks(seed, detail, 0, vertices, faces, 0, 0, 0)?
  Ok(PlanetSummary(seed: seed, detail: detail, faces: nth_int(result, 0), cells: nth_int(result, 1), checksum: nth_int(result, 2)))

export fn worldgen_summary(seed: Int, width: Int, height: Int) -> Result<WorldgenSummary, DataError>:
  let values = host.compute<List<Int>>("arteries", "worldgen_summary", seed, width, height)?
  Ok(WorldgenSummary(version: nth_int(values, 0), width: nth_int(values, 1), height: nth_int(values, 2), valid: nth_int(values, 3) == 1, cells: nth_int(values, 4), water: nth_int(values, 5), forest: nth_int(values, 6), dry: nth_int(values, 7), cold: nth_int(values, 8), other_land: nth_int(values, 9), rivers: nth_int(values, 10), passes: nth_int(values, 11), fords: nth_int(values, 12), harbors: nth_int(values, 13), checksum: nth_int(values, 14)))

export fn load_compact() -> Result<ScaleSummary, DataError>:
  let rows = current_world_rows()?
  match list_get(rows, 0):
    None => Ok(ScaleSummary(seed: 0, tick: 0, money: 0, towns: 0, routes: 0, phase: 0))
    Some(row) =>
      let current = ensure_world_version(row)?
      let town_count = towns.count(world: current.id)?
      let route_count = routes.count(world: current.id)?
      Ok(ScaleSummary(seed: current.seed, tick: current.tick, money: current.money, towns: town_count, routes: route_count, phase: current.phase, cursor: current.settle_cursor))

fn scale_done_step(done: List<Text>, pop: Int, prosperity: Int, traffic: Int) -> ScaleStep:
  ScaleStep(phase: 0, cursor: "", tick: text_int(nth_text(done, 0)), money: text_int(nth_text(done, 1)), pop: pop, prosperity: prosperity, max_research: text_int(nth_text(done, 2)), traffic: traffic, finish: text_int(nth_text(done, 3)), status: "Cycle complete")

fn scale_market_step(hours: Int, cadence: Text, cursor: Text, pop: Int, prosperity: Int, max_research: Int, traffic: Int, finish: Int) -> Result<ScaleStep, DataError>:
  let result = advance_compact_chunk(hours, cadence, cursor, 20)?
  let next_phase = text_int(nth_text(result, 1))
  let next_cursor = nth_text(result, 0)
  let tick = text_int(nth_text(result, 2))
  let money = text_int(nth_text(result, 3))
  let amount = text_int(nth_text(result, 4))
  let other = text_int(nth_text(result, 5))
  let pop2 = match next_phase == 2:
    true => pop + amount
    false => pop
  let prosperity2 = match next_phase == 2:
    true => prosperity + other
    false => prosperity
  let traffic2 = match next_phase == 3 or next_phase == 1:
    true => traffic + amount
    false => traffic
  let status = match next_phase == 2:
    true => "Settling market"
    false => match next_phase == 3:
      true => "Trading routes"
      false => match next_phase == 1:
        true => "Market done"
        false => "Running"
  Ok(ScaleStep(phase: next_phase, cursor: next_cursor, tick: tick, money: money, pop: pop2, prosperity: prosperity2, max_research: max_research, traffic: traffic2, finish: finish, status: status))

fn scale_finish_step(row: WorldRow, phase: Int, cursor: Text, pop: Int, prosperity: Int, max_research: Int, traffic: Int, finish: Int) -> Result<ScaleStep, DataError>:
  match phase == 5:
    true =>
      let done = advance_finish_commit(max_research, finish)?
      Ok(scale_done_step(done, pop, prosperity, traffic))
    false =>
      let result = advance_finish_chunk(cursor, 20)?
      let next_phase = text_int(nth_text(result, 1))
      let next_cursor = nth_text(result, 0)
      let page_max = text_int(nth_text(result, 2))
      let page_finish = text_int(nth_text(result, 3))
      let finish2 = finish + page_finish
      let max2 = match page_max > max_research:
        true => page_max
        false => max_research
      match next_phase == 5:
        true =>
          let done = advance_finish_commit(max2, finish2)?
          Ok(scale_done_step(done, pop, prosperity, traffic))
        false => Ok(ScaleStep(phase: next_phase, cursor: next_cursor, tick: row.tick, money: row.money, pop: pop, prosperity: prosperity, max_research: max2, traffic: traffic, finish: finish2, status: "Applying events"))

export fn advance_scale(hours: Int, cadence: Text, phase: Int, cursor: Text, pop: Int, prosperity: Int, max_research: Int, traffic: Int, finish: Int) -> Result<ScaleStep, DataError>:
  let rows = current_world_rows()?
  match list_get(rows, 0):
    None => Ok(ScaleStep(phase: 0, cursor: "", tick: 0, money: 0, pop: pop, prosperity: prosperity, max_research: max_research, traffic: traffic, finish: finish, status: "No world."))
    Some(row) =>
      let authoritative_phase = row.phase
      let authoritative_cursor = row.settle_cursor
      match authoritative_phase == 0 or authoritative_phase == 2 or authoritative_phase == 3:
        true => scale_market_step(hours, cadence, authoritative_cursor, pop, prosperity, max_research, traffic, finish)
        false => match authoritative_phase == 1 or authoritative_phase == 4 or authoritative_phase == 5:
          true => scale_finish_step(row, authoritative_phase, authoritative_cursor, pop, prosperity, max_research, traffic, finish)
          false =>
            let summary = load_compact()?
            Ok(ScaleStep(phase: summary.phase, cursor: summary.cursor, tick: summary.tick, money: summary.money, pop: pop, prosperity: prosperity, max_research: max_research, traffic: traffic, finish: finish, status: "Idle"))

# Whole-world production and market phase through the Rust kernel. The
# readable Diamond production helpers stay as fixtures, but a Dijkstra-style
# trade pass is far too heavy for the interpreter, so the app path runs both
# production and trade in `arteries.market`.
fn encode_ints4(values: List<Int>) -> Result<Text, DataError>:
  host.compute<Text>("arteries", "encode_ints4", values)

fn tech_effect_masks_server(states: List<Text>) -> Result<List<List<Int>>, DataError>:
  host.compute<List<List<Int>>>("arteries", "tech_effect_masks", states, tech_effect_table())

fn town_tech_states(world_id: WorldId) -> Result<List<Text>, DataError>:
  let rows = towns.page(world: world_id, order: "ord", after: "", limit: 100)?
  let techs = for r in rows:
    r.tech
  Ok(techs)

fn flow_apply_routes_server(routes: List<Route>, result: List<List<Int>>, town_count: Int, i: Int, acc: List<Route>) -> Result<List<Route>, DataError>:
  match list_get(routes, i):
    None => Ok(acc)
    Some(r) =>
      let values = match list_get(result, town_count + 1 + i):
        Some(row) => row
        None => [0]
      let width = 4 * good_count() * 2
      let pipeline_values = list_slice(values, 1, width)
      let pipeline = encode_ints4(pipeline_values)?
      let flow = encode_ints4(flow_from_result(values))?
      let route = Route(id: r.id, a: r.a, b: r.b, a_name: r.a_name, b_name: r.b_name, a_ord: r.a_ord, b_ord: r.b_ord, mode: r.mode, plan: r.plan, fee: r.fee, traffic: nth_int(values, 0), capacity: r.capacity, upkeep: r.upkeep, rules: r.rules, pipeline: pipeline, flow: flow)
      flow_apply_routes_server(routes, result, town_count, i + 1, list_append(acc, route))

fn market_flow_period(world: World, days: Int, scale: Int, techs: List<Text>) -> Result<World, DataError>:
  let town_values = for t in world.towns:
    trade_town_row(t, world.seed)
  let route_values = for r in world.routes:
    trade_route_row(world.towns, r)
  let pipeline_values = for r in world.routes:
    r.pipeline
  # Run production and trade together in Rust. The interpreter only carries
  # the compact rows, so a larger goods list does not inflate managed values.
  let effects = tech_effect_masks_server(techs)?
  let result = host.compute<List<List<Int>>>("arteries", "market", world.money, town_values, route_values, pipeline_values, days, scale, effects)?
  let money_row = match list_get(result, 0):
    Some(values) => values
    None => []
  let towns1 = flow_apply_towns(world.towns, result)
  let routes1 = flow_apply_routes_server(world.routes, result, len(world.towns), 0, [])?
  Ok(World(seed: world.seed, tick: world.tick, money: nth_int(money_row, 0), towns: towns1, sites: world.sites, routes: routes1, log: world.log, history: world.history, tech: world.tech))

export fn forecast_market(hours: Int, cadence: Text) -> Result<Forecast, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let start = current.world.tick
  let target = start + bounded_hours(hours)
  let days = settlement_days(start, target, cadence)
  match days <= 0:
    true => Ok(Forecast(days: 0, money: current.world.money, money_after: current.world.money, prosperity: total_prosperity(current.world), prosperity_after: total_prosperity(current.world), traffic: 0, traffic_after: 0, towns: [], routes: []))
    false =>
      let ready = advance_projects(with_tick(current.world, target), current.projects, 0, [], [])
      let scale = match current.auto_upkeep:
        true => 100
        false => match neglect_ticks(current) >= 2:
          true => 50
          false => 100
      let techs = town_tech_states(state.id)?
      let market = market_flow_period(ready.world, days, scale, techs)?
      let traffic_before = for route in ready.world.routes:
        route.traffic
      let traffic_after = for route in market.routes:
        route.traffic
      Ok(Forecast(days: days, money: ready.world.money, money_after: market.money, prosperity: total_prosperity(ready.world), prosperity_after: total_prosperity(market), traffic: total(traffic_before), traffic_after: total(traffic_after), towns: forecast_towns(ready.world.towns, market.towns), routes: forecast_routes(ready.world.routes, market.routes)))

export fn advance_market(hours: Int, cadence: Text) -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  match state.phase == 0:
    false => attach_streams(state.id, state.epoch, current)
    true =>
      let start = current.world.tick
      let target = start + bounded_hours(hours)
      let days = settlement_days(start, target, cadence)
      let ready = advance_projects(with_tick(current.world, target), current.projects, 0, [], [])
      let upkeep = total_upkeep(ready.world.routes)
      let done = match len(ready.messages) > 0:
        true => " " + nth_text(ready.messages, 0)
        false => ""
      let notice = "Advanced to " + calendar_text(ready.world) + "." + done
      match days <= 0:
        true =>
          let base = raw_game(ready.world, ready.projects, current.auto_upkeep, current.last_paid_tick, upkeep, current.sel, notice, true)
          save_game_window(base, 0, state.epoch, 0, 0)
        false =>
          let unpaid = neglect_ticks(current)
          let scale = match current.auto_upkeep:
            true => 100
            false => match unpaid >= 2:
              true => 50
              false => 100
          let techs = town_tech_states(state.id)?
          let market = market_flow_period(ready.world, days, scale, techs)?
          let summary = notice + " Market settled for " + int_text(days) + " day" + match days == 1:
            true => ""
            false => "s"
          + "."
          let staged = raw_game(market, ready.projects, current.auto_upkeep, current.last_paid_tick, upkeep, current.sel, summary, true)
          save_game_window(staged, 1, state.epoch, days, start)

export fn run_cycle(hours: Int, cadence: Text) -> Result<Game, DataError>:
  let game1 = advance_market(hours, cadence)?
  let game2 = advance_finish()?
  Ok(game2)

export fn advance_finish() -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  match state.phase == 1:
    false => attach_streams(state.id, state.epoch, state_game(state, "Advanced to " + calendar_text(current.world) + "."))
    true =>
      let game = game_finish_period(current, state.settle_days, state.settle_from)
      let tech_game = town_tech_apply_game(state.id, game, state.settle_days)?
      save_game_window(tech_game, 0, state.epoch, 0, 0)

# Survey reads only need the seed, the town rows, and the site rows. Building a
# compact World avoids materialising route groups, projects, logs, and history
# on every keystroke-sized preview request.
fn survey_world(seed: Int, town_rows: List<TownRow>, site_rows: List<SiteRow>) -> World:
  let towns = for r in town_rows:
    town_from_row(r)
  let sites = for r in site_rows:
    site_from_row(r)
  World(seed: seed, tick: 0, money: 0, towns: towns, sites: sites, routes: [], log: [], history: [], tech: empty_tech_state())

fn survey_context() -> Result<World, DataError>:
  let rows = current_world_rows()?
  match list_get(rows, 0):
    None => Err("No world.")
    Some(row) =>
      let current = ensure_world_version(row)?
      let town_rows = towns.page(world: current.id, order: "ord", after: "", limit: 100)?
      let site_rows = sites.page(world: current.id, order: "ord", after: "", limit: 100)?
      Ok(survey_world(current.seed, town_rows, site_rows))

export fn survey_options(from: Text, to: Text) -> Result<List<SurveyOption>, DataError>:
  let world = survey_context()?
  let plans = survey_alternatives(world, from, to)
  let options = for i in indices(len(plans)):
    let plan = nth_plan(plans, i)
    SurveyOption(index: i, bend: plan.bend, label: survey_alt_text(plan, i), length: plan.length, money: plan.money, water: plan.water)
  Ok(options)

export fn survey_corridor_plan(from: Text, to: Text, bend: Int) -> Result<RoutePlan, DataError>:
  let world = survey_context()?
  let _ = clear_draft()?
  Ok(plan_route_bend(world, from, to, bend))

# The preview panel must describe the corridor the player will actually build.
# With a staged waypoint draft that is the via corridor, not the plain auto
# survey, otherwise the numbers under "Preview details" disagree with both the
# plan grid and the crowns construction charges.
fn preview_plan(world: World, from: Text, to: Text, bend: Int) -> RoutePlan:
  match bend == auto_bend():
    false => plan_route_bend(world, from, to, bend)
    true => match current_world_rows():
      Err(_) => auto_plan(world, from, to)
      Ok(rows) => match list_get(rows, 0):
        None => auto_plan(world, from, to)
        Some(row) =>
          let via = draft_via(row, from, to)
          match len(via) > 0:
            true => plan_via(world, from, to, snap_via(world, via))
            false => auto_plan(world, from, to)

export fn survey_preview(from: Text, to: Text, bend: Int) -> Result<SurveyPreview, DataError>:
  let world = survey_context()?
  let plan = preview_plan(world, from, to, bend)
  Ok(SurveyPreview(capacity: route_capacity(Path, plan), upkeep: route_upkeep(Path, plan), trade: survey_trade_volume(world, from, to, plan), found: survey_found_text(world, plan), material: material_split_text(world, from, to, plan), warning: material_warning(world, from, to, plan)))

# Fill the survey draft from the native pathfinding kernel.
export fn survey_path_plan(from: Text, to: Text) -> Result<RoutePlan, DataError>:
  let world = survey_context()?
  let _ = clear_draft()?
  Ok(auto_plan(world, from, to))

# Stage the desk's whole waypoint list in one round trip: snap every cell to a
# town, site, or nearby route cell, persist the draft, and return the surveyed
# corridor so the browser draws exactly the cells construction will charge. The
# desk always sends the complete list, so a draft left by an earlier survey can
# never merge into an edit the player did not make.
export fn survey_waypoint_edit(from: Text, to: Text, via: List<Int>) -> Result<WaypointState, DataError>:
  let world = survey_context()?
  let rows = current_world_rows()?
  match list_get(rows, 0):
    None => Err("No world.")
    Some(row) =>
      let points = via_from_flat(via)
      match len(points) > via_max():
        true => Ok(WaypointState(count: len(points), ok: false, via: via_flat(points), plan: empty_plan()))
        false =>
          let snapped = for p in points:
            waypoint_snap(world, p)
          # start_route re-snaps the stored cells before it plans, so the
          # preview applies the same transform to stay byte-identical with it.
          let flat = snap_via(world, via_flat(snapped))
          let saved = save_draft(row, from, to, flat)?
          Ok(WaypointState(count: len(flat) / 2, ok: saved, via: flat, plan: plan_via(world, from, to, flat)))

fn edit_world_draft(row: WorldRow, from: Text, to: Text, via: Text) -> EditWorldRow:
  EditWorldRow(seed: row.seed, generation_version: row.generation_version, tick: row.tick, money: row.money, tech_road: false, tech_river: false, tech_rail: false, tech: row_tech(row), auto_upkeep: row.auto_upkeep, last_paid_tick: row.last_paid_tick, upkeep_per_cycle: row.upkeep_per_cycle, phase: row.phase, epoch: row.epoch, settle_days: row.settle_days, settle_from: row.settle_from, settle_cursor: row.settle_cursor, draft_from: from, draft_to: to, draft_via: via)

fn save_draft(row: WorldRow, from: Text, to: Text, via: List<Int>) -> Result<Bool, DataError>:
  let updated = worlds.update(row.id, edit_world_draft(row, from, to, encode_waypoints(via)))?
  Ok(true)

fn clear_draft() -> Result<Bool, DataError>:
  let rows = current_world_rows()?
  match list_get(rows, 0):
    None => Ok(true)
    Some(row) => save_draft(row, "", "", [])

fn draft_via(row: WorldRow, from: Text, to: Text) -> List<Int>:
  match row.draft_from == from and row.draft_to == to:
    true => decode_waypoints(row.draft_via)
    false => []

export fn start_route(from: Text, to: Text, bend: Int) -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let rows = current_world_rows()?
  let via = match bend == auto_bend():
    true => match list_get(rows, 0):
      None => []
      Some(row) => draft_via(row, from, to)
    false => []
  let plan = match len(via) > 0:
    true => plan_via(current.world, from, to, snap_via(current.world, via))
    false => route_plan(current.world, from, to, bend)
  let sel = survey_selection_plan(from, to, plan)
  let prepared = raw_game(current.world, current.projects, current.auto_upkeep, current.last_paid_tick, current.upkeep_per_cycle, sel, "", true)
  match can_build_route(prepared):
    false =>
      let blocked = raw_game(current.world, current.projects, current.auto_upkeep, current.last_paid_tick, current.upkeep_per_cycle, current.sel, build_blocker(prepared), false)
      attach_streams(state.id, state.epoch, blocked)
    true =>
      let _ = clear_draft()?
      let game = game_build(prepared)
      save_game(game, 0, state.epoch)

export fn start_route_via(from: Text, to: Text, via: List<Int>) -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let plan = plan_via(current.world, from, to, snap_via(current.world, via))
  let sel = survey_selection_plan(from, to, plan)
  let prepared = raw_game(current.world, current.projects, current.auto_upkeep, current.last_paid_tick, current.upkeep_per_cycle, sel, "", true)
  match can_build_route(prepared):
    false =>
      let blocked = raw_game(current.world, current.projects, current.auto_upkeep, current.last_paid_tick, current.upkeep_per_cycle, current.sel, build_blocker(prepared), false)
      attach_streams(state.id, state.epoch, blocked)
    true =>
      let _ = clear_draft()?
      let game = game_build(prepared)
      save_game(game, 0, state.epoch)

fn town_tech_at(rows: List<TownRow>, key: Text) -> Text:
  match list_get(rows, town_row_index(rows, key)):
    Some(row) => row.tech
    None => ""

export fn order_upgrade(route_id: Text) -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let route = route_by_id(current.world.routes, route_id, 0)
  let rows = towns.page(world: state.id, order: "ord", after: "", limit: 100)?
  let a_tech = town_tech_at(rows, route.a)
  let b_tech = town_tech_at(rows, route.b)
  let game = game_upgrade(current, route_id, a_tech, b_tech)
  save_game(game, 0, state.epoch)

export fn dismantle(route: Text) -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let game = game_demolish(current, route)
  save_game(game, 0, state.epoch)

export fn cancel_project(id: Text) -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let game = game_cancel_project(current, id)
  save_game(game, 0, state.epoch)

export fn terrain_region(seed: Int, u0: Int, v0: Int, w: Int, h: Int) -> Result<Text, DataError>:
  host.compute<Text>("arteries", "terrain_region", seed, 1, 0, u0, v0, w, h)

fn tech_owner_names(rows: List<TownRow>, id: Int, i: Int, acc: List<Text>) -> List<Text>:
  match list_get(rows, i):
    None => acc
    Some(row) => match tech_has(row.tech, id):
      true => tech_owner_names(rows, id, i + 1, list_append(acc, row.name))
      false => tech_owner_names(rows, id, i + 1, acc)

# Narrow read for the external UI: a bounded page of the catalog, the union
# summary, and which settlements actually discovered each technology. The page
# cap keeps the evaluation inside the managed-value budget.
export fn tech_page(start: Int, count: Int) -> Result<TechPage, DataError>:
  let state = load_state()?
  let rows = towns.page(world: state.id, order: "ord", after: "", limit: 100)?
  let total = tech_row_count()
  let from = match start < 0:
    true => 0
    false => match start > total:
      true => total
      false => start
  let remaining = total - from
  let wanted = match count < 0:
    true => 0
    false => match count > 16:
      true => 16
      false => count
  let amount = match wanted > remaining:
    true => remaining
    false => wanted
  let entries = for i in indices(amount):
    tech_entry_with_towns(state.world.tech, from + i, tech_owner_names(rows, from + i, 0, []))
  let next = match from + amount >= total:
    true => total
    false => from + amount
  Ok(TechPage(view: tech_view(state.world.tech), era: world_era(state.world), max_research: max_town_research(state.world), start: from, next: next, total: total, entries: entries))

# Narrow read for the production panel. It reuses InspectView so the external
# UI sees the same status, shortages, needs, endowments, and insight text as
# the inspector.
export fn production_snapshot() -> Result<ProductionPanel, DataError>:
  let state = load_state()?
  Ok(production_view(state.world))

# Narrow read for marker inspection, replacing the selection object that only
# the Diamond browser runtime currently knows how to build.
export fn inspect_marker(id: Text) -> Result<InspectView, DataError>:
  let state = load_state()?
  Ok(inspect_view(state.world, id))

# Replace one link's whole flow policy (allow flags and per-good surcharges).
# The desk sends complete lists so a stale browser copy cannot partially merge.
export fn set_route_rules(route: Text, allow: List<Int>, fees: List<Int>) -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let game = game_link_rules(current, route, normalize_allow(allow), normalize_fees(fees))
  save_game(game, 0, state.epoch)

export fn set_fee(route: Text, delta: Int) -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let game = game_fee(current, route, delta)
  save_game(game, 0, state.epoch)

export fn pay_upkeep() -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let game = game_pay_upkeep(current)
  save_game(game, 0, state.epoch)

export fn toggle_auto() -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let game = game_toggle_auto(current)
  save_game(game, 0, state.epoch)

export fn list_worlds() -> Result<List<WorldSummary>, DataError>:
  let rows = worlds.select(limit: 100)?
  let current_rows = currentworlds.select(limit: 1)?
  let current_id = match list_get(current_rows, 0):
    Some(cw) => cw.world
    None => match list_get(rows, 0):
      Some(first) => first.id
      None => WorldId("")
  let summaries = for r in rows:
    WorldSummary(id: id_text(r.id), seed: r.seed, tick: r.tick, money: r.money, towns: towns.count(world: r.id)?, current: r.id == current_id)
  Ok(summaries)

export fn switch_world(id: Text) -> Result<Game, DataError>:
  let rows = worlds.select(limit: 100)?
  let idx = find_world_index(rows, WorldId(id), 0)
  match idx < 0:
    true => Err("World not found.")
    false =>
      let target = world_at(rows, idx)?
      let _ = ensure_current_world(target.id)?
      load_game()

export fn new_seed() -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let game = game_new_seed(current)
  let id = create_world(game, state.epoch + 1)?
  let _ = ensure_current_world(id)?
  attach_streams(id, state.epoch + 1, game)
