# Arteries authoritative server.
#
# The browser keeps the selection/draft view; the world, settlements, routes,
# projects, chronicle and history live in PostgreSQL. Every action reconstructs
# a checked World, runs the shared pure simulation, and saves the result in one
# serializable RPC transaction.

type UserId = Id<"user">
type WorldId = Id<"world">
type TownId = Id<"town">
type SiteId = Id<"site">
type RouteId = Id<"route">
type ProjectId = Id<"project">
type LogId = Id<"log">
type HistoryId = Id<"history">

