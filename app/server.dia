export fn terrain_region(seed: Int, u0: Int, v0: Int, w: Int, h: Int) -> Result<Text, DataError>:
  host.compute<Text>("arteries", "terrain_region", seed, 1, 0, u0, v0, w, h)

# Replace one link's whole flow policy (allow flags and per-good surcharges).
# The desk sends complete lists so a stale browser copy cannot partially merge.
export fn set_route_rules(route: Text, allow: List<Int>, fees: List<Int>) -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let game = game_link_rules(current, route, normalize_allow(allow), normalize_fees(fees))
  save_game(game, 0, state.epoch)

export fn set_fee(route: Text, delta: Int) -> Result<Game, DataError>:
  let state = load_state()?
  let current = state_game(state, "")
  let game = game_fee(current, route, delta)
  save_game(game, 0, state.epoch)

