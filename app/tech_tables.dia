  [["10", "Milling", "2", "65", "0,4", "602000000000000000", "flour", "15", "Stone mills turn grain into flour."], ["11", "Ropewalk", "2", "70", "2,1", "000040002000000000", "rope", "15", "Long walks braid fiber and planks into rope."], ["12", "Toolmaking", "2", "80", "3,1", "000000002200000000", "tools", "15", "Hardened tools raise tool output."], ["13", "Irrigation", "3", "100", "0,4", "600000000000200000", "food", "1", "Channels raise both grain and fish yields."], ["14", "Mathematics", "3", "100", "6,4", "000002002000000000", "research", "15", "Geometry and accounting speed up research."], ["15", "Customs house", "3", "90", "5,2", "000002200000000000", "toll", "10", "Tolls and tariffs raise trade income."], ["16", "Engineering", "3", "120", "1,4", "000002004000400000", "capacity", "10", "Bridges and embankments raise route capacity."], ["17", "Provisioning", "3", "120", "10,2", "000000220000040000", "growth", "1", "Stores and clothing support settlement growth."], ["18", "Bulk handling", "3", "120", "5", "000002004000000000", "capacity", "15", "Cranes and pallets raise route capacity."], ["19", "Standardized parts", "3", "120", "12", "000002000400000000", "tools_machinery", "25", "Interchangeable parts raise tool and machinery output."]]

