# Tech catalog data.
#
# Each row is a list of fields:
#   [id, name, era, cost, prerequisites, goods_gate, effect, value, description]
#
# IDs are stable and 0-based. Catalog order must stay topological: a tech may
# only list prerequisites that appear earlier in the table. The bitset state in
# a world is indexed by this ID.
#
# `goods_gate` is an 18-character string with one digit per good in `goods()`
# order. A digit is the amount that must be present in the same settlement
# before the technology can be discovered. For example position 1 is Timber and
# position 5 is Tools.
#
# `effect` names a compact effect kind and `value` its percentage or flat
# amount. Discovery unlocks route modes and improves research, production,
# capacity, food, tolls, or growth.
#
# Split into chunks so the catalog can grow beyond one Diamond expression and
# so lookups stay at constant call depth. Add rows to a chunk, or add a new
# `tech_rows_N` plus a dispatch case in `catalog_row_at`.

export fn tech_rows_0() -> List<List<Text>>:
  [["0", "Crop rotation", "1", "25", "", "600000020000000000", "grain", "1", "Rotating fields and fishing grounds raise the grain surplus."], ["1", "Carpentry", "1", "25", "", "040000000000000000", "planks", "15", "Sawmills and framing improve plank output."], ["2", "Weaving", "1", "30", "", "000040000000000000", "cloth", "15", "Looms turn fiber into cloth more efficiently."], ["3", "Smelting", "1", "40", "", "002400000000000000", "steel", "15", "Hot furnaces improve steel output."], ["4", "Masonry", "1", "55", "", "004000000020000000", "bricks", "15", "Kilns and mortar improve brick output."], ["5", "Roads", "2", "45", "1", "042000000000000000", "unlock_road", "1", "Improved carts. Roads can now be upgraded."], ["6", "Writing", "2", "50", "2", "000000202000000000", "research", "10", "Records and ledgers speed up research."], ["7", "Sawmill gearing", "2", "50", "1", "040000002000000000", "planks", "25", "Geared saws raise plank output further."], ["8", "Loom speed", "2", "50", "2", "000040002000000000", "cloth", "25", "Faster looms raise cloth output further."], ["9", "Bloomery", "2", "55", "3", "000400000002000000", "steel", "25", "Coal-fired blooms raise steel output further."]]

