# Tech catalog data.
#
# Each row is a list of fields:
#   [id, name, era, cost, prerequisites, effect, description]
#
# IDs are stable and 0-based. Catalog order must stay topological: a tech may
# only list prerequisites that appear earlier in the table. The bitset state in
# a world is indexed by this ID.
#
# Split into chunks so the catalog can grow beyond one Diamond expression and
# so lookups stay at constant call depth. Add rows to a chunk, or add a new
# `tech_rows_N` plus a dispatch case in `catalog_row_at`.

export fn tech_rows_0() -> List<List<Text>>:
  [["0", "Roads", "2", "45", "", "unlock_road", "Improved carts. Roads can now be upgraded."], ["1", "Carpentry", "2", "60", "", "discount_planks", "Sawmills and framing. Road and barge upgrades need fewer planks."], ["2", "River barges", "3", "110", "0,1", "unlock_river", "River navigation. Barges can now be upgraded."], ["3", "Metallurgy", "3", "140", "0", "discount_steel", "Smelting and steelworking. Rail upgrades need less steel."], ["4", "Rail", "4", "220", "2,3", "unlock_rail", "Steam power. Rail can now be upgraded."]]

export fn tech_rows_1() -> List<List<Text>>:
  []

fn row_at(rows: List<List<Text>>, i: Int) -> List<Text>:
  match list_get(rows, i):
    Some(row) => row
    None => []

fn nth_tech_row(rows: List<List<Text>>, i: Int) -> List<Text>:
  match list_get(rows, i):
    Some(row) => row
    None => []

# Scanning code walks chunks directly; this avoids copying the whole catalog
# through repeated list appends as the tree grows.
export fn catalog_chunks() -> List<List<List<Text>>>:
  [tech_rows_0(), tech_rows_1()]

# Keep chunk width fixed so lookup is arithmetic instead of a chain of length
# checks. A generated catalog can add chunk functions and match arms.
fn chunk_width() -> Int:
  10

export fn catalog_row_count() -> Int:
  5

export fn catalog_row_at(i: Int) -> List<Text>:
  let chunk = i / chunk_width()
  let offset = i - chunk * chunk_width()
  match chunk == 0:
    true => row_at(tech_rows_0(), offset)
    false => match chunk == 1:
      true => row_at(tech_rows_1(), offset)
      false => []
