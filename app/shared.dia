# ---------------------------------------------------------------- constants

export fn map_w() -> Int:
  10

export fn map_h() -> Int:
  6

export fn max_log() -> Int:
  6

export fn max_history() -> Int:
  8

export fn max_settlements() -> Int:
  4

export fn max_routes() -> Int:
  3

export fn max_projects() -> Int:
  2

export fn map_count() -> Int:
  16

export fn road_research() -> Int:
  45

export fn river_research() -> Int:
  110

export fn rail_research() -> Int:
  220

# ---------------------------------------------------------------- calendar

export fn hours_per_day() -> Int:
  24

export fn days_per_week() -> Int:
  7

export fn hours_per_week() -> Int:
  168

export fn days_per_month() -> Int:
  28

export fn hours_per_month() -> Int:
  672

export fn hours_per_year() -> Int:
  8064

fn two_digit(n: Int) -> Text:
  match n < 10:
    true => "0" + int_text(n)
    false => int_text(n)

export fn calendar_text(world: World) -> Text:
  let t = max_int(world.tick, 0)
  let year = t / hours_per_year() + 1
  let month = mod_int(t, hours_per_year()) / hours_per_month() + 1
  let day = mod_int(t, hours_per_month()) / hours_per_day() + 1
  let hour = mod_int(t, hours_per_day())
  "Year " + int_text(year) + " · Month " + int_text(month) + " · Day " + int_text(day) + " · " + two_digit(hour) + ":00"

export fn duration_text(hours: Int) -> Text:
  let h = max_int(hours, 0)
  match h < 24:
    true => int_text(h) + "h"
    false => match h < 168:
      true => int_text(h / 24) + "d " + int_text(mod_int(h, 24)) + "h"
      false => int_text(h / 168) + "w " + int_text(mod_int(h, 168) / 24) + "d"

fn mod_int(a: Int, b: Int) -> Int:
  match b == 0:
    true => 0
    false => a - (a / b) * b

fn abs_int(x: Int) -> Int:
  match x < 0:
    true => -x
    false => x

fn min_int(a: Int, b: Int) -> Int:
  match a < b:
    true => a
    false => b

fn max_int(a: Int, b: Int) -> Int:
  match a > b:
    true => a
    false => b

fn clamp(v: Int, lo: Int, hi: Int) -> Int:
  match v < lo:
    true => lo
    false => match v > hi:
      true => hi
      false => v

fn bool_int(b: Bool) -> Int:
  match b:
    true => 1
    false => 0

fn sign(x: Int) -> Int:
  match x < 0:
    true => -1
    false => match x > 0:
      true => 1
      false => 0

fn hash100(seed: Int, x: Int, y: Int, salt: Int) -> Int:
  let h = ((x + 1) * 7919) + ((y + 1) * 104729) + ((seed + 1) * 15485863) + (salt * 2654435761)
  let m = mod_int(h, 1000003)
  mod_int(m, 100)

export fn nth_int(xs: List<Int>, i: Int) -> Int:
  match list_get(xs, i):
    Some(v) => v
    None => 0

export fn nth_text(xs: List<Text>, i: Int) -> Text:
  match list_get(xs, i):
    Some(v) => v
    None => ""

fn replace_int(xs: List<Int>, i: Int, v: Int) -> List<Int>:
  for x in indices(len(xs)):
    match x == i:
      true => v
      false => nth_int(xs, x)

fn replace_text(xs: List<Text>, i: Int, v: Text) -> List<Text>:
  for x in indices(len(xs)):
    match x == i:
      true => v
      false => nth_text(xs, x)

fn append_index_chunk(acc: List<Int>, start: Int, count: Int) -> List<Int>:
  match count <= 0:
    true => acc
    false => append_index_chunk(list_append(acc, start), start + 1, count - 1)

fn indices_from(start: Int, remaining: Int, acc: List<Int>) -> List<Int>:
  match remaining <= 0:
    true => acc
    false =>
      let take = min_int(remaining, 16)
      indices_from(start + take, remaining - take, append_index_chunk(acc, start, take))

export fn indices(n: Int) -> List<Int>:
  indices_from(0, n, [])

# Balanced list folds keep call depth logarithmic, so 100+ settlements stay
# inside Diamond's depth-64 limit. Each leaf walks at most eight items.
fn sum_small(xs: List<Int>, start: Int, count: Int) -> Int:
  match count <= 0:
    true => 0
    false => nth_int(xs, start) + sum_small(xs, start + 1, count - 1)

fn sum_range(xs: List<Int>, start: Int, count: Int) -> Int:
  match count <= 0:
    true => 0
    false => match count <= 8:
      true => sum_small(xs, start, count)
      false =>
        let half = count / 2
        sum_range(xs, start, half) + sum_range(xs, start + half, count - half)

export fn total(xs: List<Int>) -> Int:
  sum_range(xs, 0, len(xs))

fn concat_lists(xs: List<Text>, ys: List<Text>) -> List<Text>:
  match len(xs) == 0:
    true => ys
    false => concat_lists(list_slice(xs, 1, len(xs) - 1), list_append(ys, nth_text(xs, 0)))

# ---------------------------------------------------------------- goods

export fn goods() -> List<Good>:
  [Grain, Timber, Stone, Ore, Fiber, Tools, Cloth, Fish]

fn good_index(g: Good) -> Int:
  match g:
    Grain => 0
    Timber => 1
    Stone => 2
    Ore => 3
    Fiber => 4
    Tools => 5
    Cloth => 6
    Fish => 7

export fn good_name(g: Good) -> Text:
  match g:
    Grain => "Grain"
    Timber => "Timber"
    Stone => "Stone"
    Ore => "Ore"
    Fiber => "Fiber"
    Tools => "Tools"
    Cloth => "Cloth"
    Fish => "Fish"

export fn good_short(g: Good) -> Text:
  match g:
    Grain => "GRA"
    Timber => "TIM"
    Stone => "STO"
    Ore => "ORE"
    Fiber => "FIB"
    Tools => "TOL"
    Cloth => "CLO"
    Fish => "FSH"

export fn stock(t: Town, g: Good) -> Int:
  nth_int(t.state.stock, good_index(g))

export fn endow_of(t: Town, g: Good) -> Int:
  nth_int(t.endow, good_index(g))

fn endowment(t: Town, g: Good) -> Int:
  nth_int(t.endow, good_index(g))

fn with_stock_list(t: Town, xs: List<Int>) -> Town:
  Town(id: t.id, name: t.name, x: t.x, y: t.y, terrain: t.terrain, endow: t.endow, state: TownState(pop: t.state.pop, prosperity: t.state.prosperity, research: t.state.research, stock: xs))

export fn with_stock(t: Town, g: Good, v: Int) -> Town:
  let next = replace_int(t.state.stock, good_index(g), max_int(v, 0))
  with_stock_list(t, next)

fn add_stock(t: Town, g: Good, v: Int) -> Town:
  with_stock(t, g, stock(t, g) + v)

fn with_state(t: Town, s: TownState) -> Town:
  Town(id: t.id, name: t.name, x: t.x, y: t.y, terrain: t.terrain, endow: t.endow, state: s)

fn set_pop(t: Town, p: Int) -> Town:
  with_state(t, TownState(pop: max_int(p, 1), prosperity: t.state.prosperity, research: t.state.research, stock: t.state.stock))

fn set_prosperity(t: Town, p: Int) -> Town:
  with_state(t, TownState(pop: t.state.pop, prosperity: clamp(p, 0, 30), research: t.state.research, stock: t.state.stock))

fn add_research(t: Town, r: Int) -> Town:
  with_state(t, TownState(pop: t.state.pop, prosperity: t.state.prosperity, research: t.state.research + r, stock: t.state.stock))

export fn need_of(t: Town, g: Good) -> Int:
  match g:
    Grain => t.state.pop
    Fish => t.state.pop / 3 + 1
    Timber => t.state.pop / 2 + 1
    Stone => t.state.pop / 2 + 1
    Ore => t.state.pop / 2 + 1
    Fiber => t.state.pop / 2 + 1
    Tools => t.state.pop / 2 + 1
    Cloth => t.state.pop / 2 + 1

fn variety(t: Town) -> Int:
  let flags = for g in goods():
    bool_int(stock(t, g) > 0)
  total(flags)

export fn food_ok(t: Town) -> Int:
  let need = t.state.pop
  let have = stock(t, Grain) + stock(t, Fish) / 2
  match have >= need:
    true => 2
    false => match have > 0:
      true => 1
      false => 0

export fn status_text(t: Town) -> Text:
  match t.state.prosperity >= 16:
    true => "thriving"
    false => match t.state.prosperity >= 8:
      true => "stable"
      false => match t.state.prosperity >= 4:
        true => "fragile"
        false => "stressed"

export fn status_tone(t: Town) -> Text:
  match t.state.prosperity >= 16:
    true => "good"
    false => match t.state.prosperity >= 8:
      true => "ok"
      false => match t.state.prosperity >= 4:
        true => "warn"
        false => "bad"

# ---------------------------------------------------------------- terrain

export fn terrain_name(t: Terrain) -> Text:
  match t:
    Plains => "Plains"
    Forest => "Forest"
    Hills => "Hills"
    Mountain => "Mountain"
    Water => "Water"
    Coast => "Coast"
    Marsh => "Marsh"

export fn terrain_class(t: Terrain) -> Text:
  match t:
    Plains => "t-plains"
    Forest => "t-forest"
    Hills => "t-hills"
    Mountain => "t-mountain"
    Water => "t-water"
    Coast => "t-coast"
    Marsh => "t-marsh"

fn terrain_cost(t: Terrain) -> Int:
  match t:
    Plains => 1
    Forest => 2
    Hills => 4
    Mountain => 9
    Water => 11
    Coast => 1
    Marsh => 3

export fn terrain_code(t: Terrain) -> Int:
  match t:
    Plains => 1
    Forest => 2
    Hills => 3
    Mountain => 4
    Water => 5
    Coast => 6
    Marsh => 7

fn terrain_from_code(code: Int) -> Terrain:
  match code == 1:
    true => Plains
    false => match code == 2:
      true => Forest
      false => match code == 3:
        true => Hills
        false => match code == 4:
          true => Mountain
          false => match code == 5:
            true => Water
            false => match code == 6:
              true => Coast
              false => match code == 7:
                true => Marsh
                false => Water

fn terrain_of(seed: Int, x: Int, y: Int) -> Terrain:
  let block = mod_int((x / 2) * 7 + (y / 2) * 11 + seed, 17)
  let fine = mod_int(x * 5 + y * 9 + seed * 3, 23)
  let elev = block * 3 + fine + (map_w() - x) * 3 + (map_h() - y) * 2
  let river = 3 + mod_int(y / 3 + seed, 3)
  let lake_x = 4 + mod_int(seed, 2)
  let lake_y = 2 + mod_int(seed / 7, 2)
  let pond = x == lake_x and y == lake_y and not (x == river)
  match x >= map_w() - 1 or x == river or pond:
    true => Water
    false => match x == river - 1 or x == river + 1 or x == map_w() - 2:
      true => Coast
      false => match elev > 112:
        true => Mountain
        false => match elev > 94:
          true => Hills
          false => match fine > 15 and block > 10:
            true => Forest
            false => match fine < 5 and y > map_h() - 3:
              true => Marsh
              false => Plains

fn worldgen_terrain_code(seed: Int, x: Int, y: Int) -> Int:
  let rows = worldgen_terrain_rows(mod_int(seed, map_count()))
  let index = y * map_w() + x
  match index < len(rows):
    true => digit_value(text_slice(rows, index, 1))
    false => terrain_code(terrain_of(seed, x, y))

fn worldgen_feature_code(seed: Int, x: Int, y: Int) -> Int:
  let rows = worldgen_feature_rows(mod_int(seed, map_count()))
  let index = y * map_w() + x
  match index < len(rows):
    true => digit_value(text_slice(rows, index, 1))
    false => 0

fn worldgen_economy_at(seed: Int, x: Int, y: Int) -> Int:
  let rows = worldgen_biome_rows(mod_int(seed, map_count()))
  let index = y * map_w() + x
  match index < len(rows):
    true => digit_value(text_slice(rows, index, 1))
    false => 4

fn worldgen_temperature_at(seed: Int, x: Int, y: Int) -> Int:
  let rows = worldgen_temperature_rows(mod_int(seed, map_count()))
  let index = y * map_w() + x
  match index < len(rows):
    true => digit_value(text_slice(rows, index, 1))
    false => 5

fn worldgen_moisture_at(seed: Int, x: Int, y: Int) -> Int:
  let rows = worldgen_moisture_rows(mod_int(seed, map_count()))
  let index = y * map_w() + x
  match index < len(rows):
    true => digit_value(text_slice(rows, index, 1))
    false => 5

export fn terrain_at(seed: Int, x: Int, y: Int) -> Terrain:
  match x < 0 or y < 0 or x >= map_w() or y >= map_h():
    true => Water
    false => terrain_from_code(worldgen_terrain_code(seed, x, y))

export fn feature_name(code: Int) -> Text:
  match code == 1:
    true => "Pass"
    false => match code == 2:
      true => "Ford"
      false => match code == 3:
        true => "Harbor"
        false => ""

export fn feature_detail(code: Int) -> Text:
  match code == 1:
    true => "roads cross cheaper"
    false => match code == 2:
      true => "shallow crossing"
      false => match code == 3:
        true => "sheltered port"
        false => ""

# Packed grids for the pathfinding kernels.
export fn terrain_grid(seed: Int) -> Text:
  let rows = for y in indices(map_h()):
    let cells = for x in indices(map_w()):
      int_text(terrain_code(terrain_at(seed, x, y)))
    join_text(cells, ",")
  int_text(map_w()) + "," + int_text(map_h()) + "|" + join_text(rows, ";")

export fn feature_grid(seed: Int) -> Text:
  let rows = for y in indices(map_h()):
    let cells = for x in indices(map_w()):
      int_text(worldgen_feature_code(seed, x, y))
    join_text(cells, ",")
  int_text(map_w()) + "," + int_text(map_h()) + "|" + join_text(rows, ";")

# ---------------------------------------------------------------- anchors

fn town_name(i: Int) -> Text:
  match i == 0:
    true => "Riverford"
    false => match i == 1:
      true => "Hillcrest"
      false => match i == 2:
        true => "Greenvale"
        false => match i == 3:
          true => "Portmere"
          false => match i == 4:
            true => "Thornwick"
            false => match i == 5:
              true => "Amberfield"
              false => "Highmoor"

fn town_base_x(i: Int) -> Int:
  match i == 0:
    true => 2
    false => match i == 1:
      true => 6
      false => match i == 2:
        true => 10
        false => match i == 3:
          true => 11
          false => match i == 4:
            true => 3
            false => 7

fn town_base_y(i: Int) -> Int:
  match i < 4:
    true => match i == 1:
      true => 2
      false => match i == 3:
        true => 4
        false => 3
    false => match i == 4:
      true => 6
      false => 5

fn site_name(i: Int) -> Text:
  match i == 0:
    true => "Westwood"
    false => match i == 1:
      true => "Gold Plain"
      false => match i == 2:
        true => "Iron Scar"
        false => match i == 3:
          true => "Tidecove"
          false => "Reedwash"

fn mirror_x(seed: Int, x: Int) -> Int:
  match mod_int(seed, 2) == 1:
    true => map_w() - 1 - x
    false => x

fn mirror_y(seed: Int, y: Int) -> Int:
  match mod_int(seed / 2, 2) == 1:
    true => map_h() - 1 - y
    false => y

fn site_x(seed: Int, i: Int) -> Int:
  let x = match i == 0:
    true => 5
    false => match i == 1:
      true => 8
      false => 1
  mirror_x(seed, x)

fn site_y(seed: Int, i: Int) -> Int:
  let y = match i == 0:
    true => 3
    false => match i == 1:
      true => 4
      false => 3
  mirror_y(seed, y)

fn town_anchor_x(seed: Int, i: Int) -> Int:
  let x = match i == 0:
    true => 1
    false => match i == 1:
      true => 4
      false => match i == 2:
        true => 8
        false => 2
  mirror_x(seed, x)

fn town_anchor_y(seed: Int, i: Int) -> Int:
  let y = match i == 0:
    true => 1
    false => match i == 1:
      true => 1
      false => match i == 2:
        true => 2
        false => 4
  mirror_y(seed, y)

fn primary_terrain(g: Good) -> Terrain:
  match g:
    Timber => Forest
    Stone => Hills
    Ore => Hills
    Fish => Coast
    Fiber => Marsh
    _ => Plains

fn endow_list(g1: Good, v1: Int, g2: Good, v2: Int) -> List<Int>:
  let a = replace_int(zeros(len(goods())), good_index(g1), v1)
  replace_int(a, good_index(g2), v2)

fn zeros(n: Int) -> List<Int>:
  for i in indices(n):
    0

fn initial_stock_for(i: Int) -> List<Int>:
  let endow = town_endow(i)
  initial_stock_from(endow)

fn initial_stock_from(endow: List<Int>) -> List<Int>:
  let doubled = for k in indices(len(endow)):
    nth_int(endow, k) * 2
  let with_food = replace_int(doubled, good_index(Grain), nth_int(doubled, good_index(Grain)) + 8)
  replace_int(with_food, good_index(Fish), nth_int(with_food, good_index(Fish)) + 4)

fn endow_add(endow: List<Int>, g: Good, value: Int) -> List<Int>:
  replace_int(endow, good_index(g), nth_int(endow, good_index(g)) + value)

# Worldgen economy coupling: the town's primary endowment comes from its
# biome, with small temperature/moisture modifiers. Cold highlands add stone;
# wet climates add fiber; dry climates add stone.
fn town_endow_for(biome: Int, temp: Int, moist: Int) -> List<Int>:
  let base0 = replace_int(zeros(len(goods())), good_index(Grain), 2)
  let base = endow_add(endow_add(base0, Timber, 1), Stone, 1)
  let shaped = match biome == 0:
    true => endow_add(endow_add(base, Fish, 4), Grain, 1)
    false => match biome == 1:
      true => endow_add(endow_add(base, Stone, 2), Ore, 2)
      false => match biome == 2:
        true => endow_add(endow_add(base, Timber, 4), Fiber, 1)
        false => match biome == 3:
          true => endow_add(endow_add(endow_add(base, Fiber, 3), Timber, 2), Grain, 1)
          false => match biome == 4:
            true => endow_add(endow_add(base, Grain, 4), Fiber, 1)
            false => match biome == 5:
              true => endow_add(endow_add(base, Grain, 3), Fiber, 2)
              false => match biome == 6:
                true => endow_add(endow_add(base, Stone, 3), Ore, 1)
                false => match biome == 7:
                  true => endow_add(endow_add(base, Fiber, 3), Grain, 2)
                  false => match biome == 8:
                    true => endow_add(endow_add(base, Stone, 3), Ore, 2)
                    false => endow_add(endow_add(base, Ore, 4), Stone, 1)
  let cold = match temp <= 2:
    true => endow_add(shaped, Stone, 1)
    false => shaped
  match moist >= 7:
    true => endow_add(cold, Fiber, 1)
    false => cold

fn outpost_stock(resource: Good, richness: Int) -> List<Int>:
  let a = replace_int(zeros(len(goods())), good_index(resource), richness * 2)
  let b = replace_int(a, good_index(Grain), 2)
  replace_int(b, good_index(Fish), 1)

fn town_endow(i: Int) -> List<Int>:
  match i == 0:
    true => endow_list(Grain, 4, Fiber, 1)
    false => match i == 1:
      true => endow_list(Timber, 3, Stone, 1)
      false => match i == 2:
        true => endow_list(Stone, 3, Ore, 2)
        false => match i == 3:
          true => endow_list(Fish, 4, Grain, 1)
          false => match i == 4:
            true => endow_list(Fiber, 3, Timber, 1)
            false => match i == 5:
              true => endow_list(Grain, 2, Ore, 2)
              false => endow_list(Timber, 2, Stone, 2)

fn main_endow(i: Int) -> Good:
  match i == 0:
    true => Grain
    false => match i == 1:
      true => Timber
      false => match i == 2:
        true => Stone
        false => match i == 3:
          true => Fish
          false => match i == 4:
            true => Fiber
            false => match i == 5:
              true => Grain
              false => Timber

fn point_in(xs: List<Point>, x: Int, y: Int, i: Int) -> Bool:
  match list_get(xs, i):
    None => false
    Some(p) => match p.x == x and p.y == y:
      true => true
      false => point_in(xs, x, y, i + 1)

fn find_land_at(seed: Int, start: Point, occupied: List<Point>, offsets: List<Point>, i: Int) -> Point:
  match list_get(offsets, i):
    None => start
    Some(off) =>
      let x = start.x + off.x
      let y = start.y + off.y
      let inside = x >= 0 and y >= 0 and x < map_w() and y < map_h()
      match inside:
        false => find_land_at(seed, start, occupied, offsets, i + 1)
        true => match terrain_at(seed, x, y):
          Water => find_land_at(seed, start, occupied, offsets, i + 1)
          _ => match point_in(occupied, x, y, 0):
            true => find_land_at(seed, start, occupied, offsets, i + 1)
            false => Point(x: x, y: y)

fn land_offsets() -> List<Point>:
  [Point(x: 0, y: 0), Point(x: 1, y: 0), Point(x: -1, y: 0), Point(x: 0, y: 1), Point(x: 0, y: -1), Point(x: 1, y: 1), Point(x: -1, y: 1), Point(x: 1, y: -1), Point(x: -1, y: -1), Point(x: 2, y: 0), Point(x: -2, y: 0), Point(x: 0, y: 2), Point(x: 0, y: -2), Point(x: 2, y: 1), Point(x: 1, y: 2), Point(x: -2, y: 1), Point(x: -1, y: 2), Point(x: 2, y: -1), Point(x: 1, y: -2), Point(x: -2, y: -1), Point(x: -1, y: -2), Point(x: 2, y: 2), Point(x: -2, y: 2), Point(x: 2, y: -2), Point(x: -2, y: -2)]

fn find_land(seed: Int, start: Point, occupied: List<Point>) -> Point:
  find_land_at(seed, start, occupied, land_offsets(), 0)

fn place_towns(seed: Int, i: Int, occupied: List<Point>) -> List<Point>:
  match i >= 3:
    true => []
    false =>
      let start = Point(x: town_anchor_x(seed, i), y: town_anchor_y(seed, i))
      let p = find_land(seed, start, occupied)
      list_append(place_towns(seed, i + 1, list_append(occupied, p)), p)

fn town_positions(seed: Int) -> List<Point>:
  list_reverse(place_towns(seed, 0, []))

fn place_sites(seed: Int, i: Int, occupied: List<Point>) -> List<Point>:
  match i >= 3:
    true => []
    false =>
      let start = Point(x: site_x(seed, i), y: site_y(seed, i))
      let p = find_land(seed, start, occupied)
      list_append(place_sites(seed, i + 1, list_append(occupied, p)), p)

fn site_positions(seed: Int) -> List<Point>:
  let towns = town_positions(seed)
  list_reverse(place_sites(seed, 0, towns))

fn nth_point(xs: List<Point>, i: Int) -> Point:
  match list_get(xs, i):
    Some(p) => p
    None => Point(x: 1, y: 1)

fn make_town(seed: Int, i: Int, p: Point) -> Town:
  let biome = worldgen_economy_at(seed, p.x, p.y)
  let temp = worldgen_temperature_at(seed, p.x, p.y)
  let moist = worldgen_moisture_at(seed, p.x, p.y)
  let endow = town_endow_for(biome, temp, moist)
  let terrain = terrain_at(seed, p.x, p.y)
  Town(id: "t" + int_text(i), name: town_name(i), x: p.x, y: p.y, terrain: terrain, endow: endow, state: TownState(pop: 2, prosperity: 6, research: 0, stock: initial_stock_from(endow)))

fn site_resource(i: Int) -> Good:
  match i == 0:
    true => Timber
    false => match i == 1:
      true => Grain
      false => match i == 2:
        true => Ore
        false => match i == 3:
          true => Fish
          false => Fiber

fn site_resource_for(i: Int, biome: Int, feature: Int) -> Good:
  match feature == 3:
    true => Fish
    false => match feature == 2:
      true => Grain
      false => match feature == 1:
        true => match biome == 9:
          true => Ore
          false => Stone
        false => match biome == 0:
          true => Fish
          false => match biome == 1:
            true => match mod_int(i, 2) == 0:
              true => Ore
              false => Stone
            false => match biome == 2:
              true => Timber
              false => match biome == 3:
                true => Fiber
                false => match biome == 4:
                  true => Grain
                  false => match biome == 5:
                    true => Grain
                    false => match biome == 6:
                      true => Stone
                      false => match biome == 7:
                        true => Fiber
                        false => match biome == 8:
                          true => match mod_int(i, 2) == 0:
                            true => Stone
                            false => Ore
                          false => Ore

fn make_site(seed: Int, i: Int, p: Point) -> Site:
  let biome = worldgen_economy_at(seed, p.x, p.y)
  let feature = worldgen_feature_code(seed, p.x, p.y)
  let moist = worldgen_moisture_at(seed, p.x, p.y)
  let r = site_resource_for(i, biome, feature)
  let terrain = terrain_at(seed, p.x, p.y)
  Site(id: "s" + int_text(i), name: site_name(i), x: p.x, y: p.y, terrain: terrain, resource: r, richness: 2 + mod_int(hash100(seed, i, 53, 67) + moist, 3), founded: false)

# ---------------------------------------------------------------- world creation

fn empty_town() -> Town:
  Town(id: "", name: "Unknown", x: 0, y: 0, terrain: Plains, endow: zeros(len(goods())), state: TownState(pop: 0, prosperity: 0, research: 0, stock: zeros(len(goods()))))

export fn empty_plan() -> RoutePlan:
  RoutePlan(path: [], bend: 0, length: 0, water: 0, mountain: 0, forest: 0, money: 0, timber: 0, stone: 0, min_y: 0, max_y: 0)

fn make_towns(seed: Int) -> List<Town>:
  let points = town_positions(seed)
  for i in indices(3):
    make_town(seed, i, nth_point(points, i))

fn make_sites(seed: Int) -> List<Site>:
  let points = site_positions(seed)
  for i in indices(3):
    make_site(seed, i, nth_point(points, i))

export fn new_world(seed: Int) -> World:
  let safe_seed = mod_int(seed, map_count())
  World(seed: safe_seed, tick: 0, money: 160, towns: make_towns(safe_seed), sites: make_sites(safe_seed), routes: [], log: ["Seed " + int_text(safe_seed) + ": a new frontier. Survey a route between two settlements."], history: [], tech_road: false, tech_river: false, tech_rail: false)

export fn seed_world(world: World, seed: Int) -> World:
  new_world(seed)

# ---------------------------------------------------------------- town lookup

fn find_town_small(towns: List<Town>, id: Text, start: Int, count: Int) -> Town:
  match count <= 0:
    true => empty_town()
    false => match list_get(towns, start):
      None => empty_town()
      Some(t) => match t.id == id:
        true => t
        false => find_town_small(towns, id, start + 1, count - 1)

fn find_town_range(towns: List<Town>, id: Text, start: Int, count: Int) -> Town:
  match count <= 0:
    true => empty_town()
    false => match count <= 8:
      true => find_town_small(towns, id, start, count)
      false =>
        let half = count / 2
        let left = find_town_range(towns, id, start, half)
        match left.id == "":
          true => find_town_range(towns, id, start + half, count - half)
          false => left

export fn find_town(towns: List<Town>, id: Text) -> Town:
  find_town_range(towns, id, 0, len(towns))

fn town_position_small(towns: List<Town>, id: Text, start: Int, count: Int) -> Int:
  match count <= 0:
    true => -1
    false => match list_get(towns, start):
      None => -1
      Some(t) => match t.id == id:
        true => start
        false => town_position_small(towns, id, start + 1, count - 1)

fn town_position_range(towns: List<Town>, id: Text, start: Int, count: Int) -> Int:
  match count <= 0:
    true => -1
    false => match count <= 8:
      true => town_position_small(towns, id, start, count)
      false =>
        let half = count / 2
        let left = town_position_range(towns, id, start, half)
        match left >= 0:
          true => left
          false => town_position_range(towns, id, start + half, count - half)

export fn town_position(towns: List<Town>, id: Text) -> Int:
  town_position_range(towns, id, 0, len(towns))

export fn town_exists(world: World, id: Text) -> Bool:
  match id == "":
    true => false
    false => find_town(world.towns, id).id != ""

fn find_site_small(sites: List<Site>, id: Text, start: Int, count: Int) -> Site:
  match count <= 0:
    true => Site(id: "", name: "", x: 0, y: 0, terrain: Plains, resource: Grain, richness: 0, founded: false)
    false => match list_get(sites, start):
      None => Site(id: "", name: "", x: 0, y: 0, terrain: Plains, resource: Grain, richness: 0, founded: false)
      Some(s) => match s.id == id:
        true => s
        false => find_site_small(sites, id, start + 1, count - 1)

fn find_site_range(sites: List<Site>, id: Text, start: Int, count: Int) -> Site:
  match count <= 0:
    true => Site(id: "", name: "", x: 0, y: 0, terrain: Plains, resource: Grain, richness: 0, founded: false)
    false => match count <= 8:
      true => find_site_small(sites, id, start, count)
      false =>
        let half = count / 2
        let left = find_site_range(sites, id, start, half)
        match left.id == "":
          true => find_site_range(sites, id, start + half, count - half)
          false => left

export fn find_site(sites: List<Site>, id: Text) -> Site:
  find_site_range(sites, id, 0, len(sites))

export fn replace_town(towns: List<Town>, t: Town) -> List<Town>:
  for x in towns:
    match x.id == t.id:
      true => t
      false => x

fn with_towns(world: World, towns: List<Town>) -> World:
  World(seed: world.seed, tick: world.tick, money: world.money, towns: towns, sites: world.sites, routes: world.routes, log: world.log, history: world.history, tech_road: world.tech_road, tech_river: world.tech_river, tech_rail: world.tech_rail)

fn with_resources(world: World, money: Int, log: List<Text>) -> World:
  World(seed: world.seed, tick: world.tick, money: money, towns: world.towns, sites: world.sites, routes: world.routes, log: log, history: world.history, tech_road: world.tech_road, tech_river: world.tech_river, tech_rail: world.tech_rail)

fn set_money(world: World, money: Int) -> World:
  World(seed: world.seed, tick: world.tick, money: money, towns: world.towns, sites: world.sites, routes: world.routes, log: world.log, history: world.history, tech_road: world.tech_road, tech_river: world.tech_river, tech_rail: world.tech_rail)

fn with_routes(world: World, routes: List<Route>) -> World:
  World(seed: world.seed, tick: world.tick, money: world.money, towns: world.towns, sites: world.sites, routes: routes, log: world.log, history: world.history, tech_road: world.tech_road, tech_river: world.tech_river, tech_rail: world.tech_rail)

fn with_sites(world: World, sites: List<Site>) -> World:
  World(seed: world.seed, tick: world.tick, money: world.money, towns: world.towns, sites: sites, routes: world.routes, log: world.log, history: world.history, tech_road: world.tech_road, tech_river: world.tech_river, tech_rail: world.tech_rail)

fn with_tech(world: World, road: Bool, river: Bool, rail: Bool) -> World:
  World(seed: world.seed, tick: world.tick, money: world.money, towns: world.towns, sites: world.sites, routes: world.routes, log: world.log, history: world.history, tech_road: road, tech_river: river, tech_rail: rail)

fn record(world: World, message: Text) -> World:
  let next = list_append(world.log, message)
  let trimmed = match len(next) > max_log():
    true => list_slice(next, len(next) - max_log(), max_log())
    false => next
  with_resources(world, world.money, trimmed)

# ---------------------------------------------------------------- route geometry

fn lerp(a: Int, b: Int, num: Int, den: Int) -> Int:
  a + ((b - a) * num) / den

fn segment_length(a: Point, b: Point) -> Int:
  let dx = abs_int(b.x - a.x)
  let dy = abs_int(b.y - a.y)
  max_int(dx, dy) + min_int(dx, dy) / 2

fn path_length(path: List<Point>) -> Int:
  path_length_at(path, 0, 0)

fn path_length_at(path: List<Point>, i: Int, acc: Int) -> Int:
  match list_get(path, i):
    None => acc
    Some(p) => match list_get(path, i + 1):
      None => acc
      Some(q) => path_length_at(path, i + 1, acc + segment_length(p, q))

# Fast heuristic cost for choosing an auto-shape bend. Uses the drawn
# polyline's vertex samples (cheap) rather than the full rasterized count;
# the displayed plan cost is recomputed from the rasterized counts.
# Rasterized terrain counts for one drawn polyline:
# [water, mountain, forest], each cell counted once.
fn crossed_stats(points: List<Point>, seed: Int) -> List<Int>:
  let packed = count_crossed_all(points, seed, 0, 0)
  [mod_int(packed, 64), mod_int(packed / 64, 64), mod_int(packed / 4096, 64)]

fn plan_cost_for_offset(seed: Int, ax: Int, ay: Int, bx: Int, by: Int, off: Int) -> Int:
  let points = plan_points_offset(seed, ax, ay, bx, by, off)
  let length = path_length(points)
  let stats = crossed_stats(points, seed)
  let water = nth_int(stats, 0)
  let mountain = nth_int(stats, 1)
  8 + length + water * 5 + mountain * 8

fn pick_bend(seed: Int, ax: Int, ay: Int, bx: Int, by: Int, i: Int, best: Int, best_cost: Int) -> Int:
  match i > 6:
    true => best
    false =>
      let off = i - 3
      let cost = plan_cost_for_offset(seed, ax, ay, bx, by, off)
      match cost < best_cost:
        true => pick_bend(seed, ax, ay, bx, by, i + 1, off, cost)
        false => pick_bend(seed, ax, ay, bx, by, i + 1, best, best_cost)

fn bend_offset(seed: Int, ax: Int, ay: Int, bx: Int, by: Int) -> Int:
  pick_bend(seed, ax, ay, bx, by, 0, 0, 100000)

fn plan_points(seed: Int, ax: Int, ay: Int, bx: Int, by: Int) -> List<Point>:
  plan_points_offset(seed, ax, ay, bx, by, bend_offset(seed, ax, ay, bx, by))

fn plan_points_offset(seed: Int, ax: Int, ay: Int, bx: Int, by: Int, off: Int) -> List<Point>:
  let dx = bx - ax
  let dy = by - ay
  let px = sign(-dy)
  let py = sign(dx)
  let p1 = Point(x: clamp(lerp(ax, bx, 1, 4) + px * off * 3 / 4, 0, map_w() - 1), y: clamp(lerp(ay, by, 1, 4) + py * off * 3 / 4, 0, map_h() - 1))
  let p2 = Point(x: clamp(lerp(ax, bx, 1, 2) + px * off, 0, map_w() - 1), y: clamp(lerp(ay, by, 1, 2) + py * off, 0, map_h() - 1))
  let p3 = Point(x: clamp(lerp(ax, bx, 3, 4) + px * off * 3 / 4, 0, map_w() - 1), y: clamp(lerp(ay, by, 3, 4) + py * off * 3 / 4, 0, map_h() - 1))
  [Point(x: ax, y: ay), p1, p2, p3, Point(x: bx, y: by)]

fn wet_terrain(t: Terrain) -> Int:
  match t:
    Water => 1
    _ => 0

fn high_terrain(t: Terrain) -> Int:
  match t:
    Mountain => 1
    _ => 0

fn wooded_terrain(t: Terrain) -> Int:
  match t:
    Forest => 1
    _ => 0

fn count_water(points: List<Point>, seed: Int, i: Int) -> Int:
  match list_get(points, i):
    None => 0
    Some(p) => wet_terrain(terrain_at(seed, p.x, p.y)) + count_water(points, seed, i + 1)

fn count_mountain(points: List<Point>, seed: Int, i: Int) -> Int:
  match list_get(points, i):
    None => 0
    Some(p) => high_terrain(terrain_at(seed, p.x, p.y)) + count_mountain(points, seed, i + 1)

fn count_forest(points: List<Point>, seed: Int, i: Int) -> Int:
  match list_get(points, i):
    None => 0
    Some(p) => wooded_terrain(terrain_at(seed, p.x, p.y)) + count_forest(points, seed, i + 1)

# Count terrain cells actually crossed by the drawn line. kind: 0 water, 1
# mountain, 2 forest. Iterates every cell once, so a cell is never counted
# twice even where two segments meet. Split into a row helper so no single
# recursion exceeds the Diamond call-depth limit.
fn count_crossed_row(points: List<Point>, seed: Int, kind: Int, y: Int, x: Int, acc: Int) -> Int:
  match x >= map_w():
    true => acc
    false =>
      let add = match plan_crosses_at(points, x, y, 0):
        true => match terrain_at(seed, x, y):
          Water => match kind == 0:
            true => 1
            false => 0
          Mountain => match kind == 1:
            true => 1
            false => 0
          Forest => match kind == 2:
            true => 1
            false => 0
          _ => 0
        false => 0
      count_crossed_row(points, seed, kind, y, x + 1, acc + add)

# Single-pass tally of all three crossed terrain kinds. Returns a packed value:
# water + mountain * 64 + forest * 4096 (each count is below 64).
fn count_crossed_all_row(points: List<Point>, seed: Int, y: Int, x: Int, acc: Int) -> Int:
  match x >= map_w():
    true => acc
    false =>
      let acc2 = match plan_crosses_at(points, x, y, 0):
        true => match terrain_at(seed, x, y):
          Water => acc + 1
          Mountain => acc + 64
          Forest => acc + 4096
          _ => acc
        false => acc
      count_crossed_all_row(points, seed, y, x + 1, acc2)

fn count_crossed_all(points: List<Point>, seed: Int, y: Int, acc: Int) -> Int:
  match y >= map_h():
    true => acc
    false => count_crossed_all(points, seed, y + 1, count_crossed_all_row(points, seed, y, 0, acc))

fn min_point_y(points: List<Point>, i: Int, best: Int) -> Int:
  match list_get(points, i):
    None => best
    Some(p) => min_point_y(points, i + 1, min_int(best, p.y))

fn max_point_y(points: List<Point>, i: Int, best: Int) -> Int:
  match list_get(points, i):
    None => best
    Some(p) => max_point_y(points, i + 1, max_int(best, p.y))

export fn plan_route(world: World, a: Text, b: Text) -> RoutePlan:
  let ta = find_town(world.towns, a)
  let tb = find_town(world.towns, b)
  match ta.id == "" or tb.id == "" or ta.id == tb.id:
    true => empty_plan()
    false => plan_with_offset(world, ta, tb, bend_offset(world.seed, ta.x, ta.y, tb.x, tb.y))

export fn plan_route_bend(world: World, a: Text, b: Text, bend: Int) -> RoutePlan:
  let ta = find_town(world.towns, a)
  let tb = find_town(world.towns, b)
  match ta.id == "" or tb.id == "" or ta.id == tb.id:
    true => empty_plan()
    false => plan_with_offset(world, ta, tb, clamp(bend, -5, 5))

fn plan_with_offset(world: World, ta: Town, tb: Town, off: Int) -> RoutePlan:
  let points = plan_points_offset(world.seed, ta.x, ta.y, tb.x, tb.y, off)
  let length = path_length(points)
  let stats = crossed_stats(points, world.seed)
  let water = nth_int(stats, 0)
  let mountain = nth_int(stats, 1)
  let forest = nth_int(stats, 2)
  RoutePlan(path: points, bend: off, length: length, water: water, mountain: mountain, forest: forest, money: 8 + length + water * 5 + mountain * 8, timber: 1 + length / 14 + water, stone: 1 + length / 18 + mountain * 2, min_y: min_point_y(points, 0, map_h()), max_y: max_point_y(points, 0, 0))

# Sentinel stored in RoutePlan.bend for a kernel-planned corridor. Manual
# shaping replaces it with a normal -5..5 bend.
export fn auto_bend() -> Int:
  100

fn path_points(flat: List<Int>) -> List<Point>:
  for i in indices(len(flat) / 2):
    Point(x: nth_int(flat, i * 2), y: nth_int(flat, i * 2 + 1))

# Build a RoutePlan from the kernel's flat path and rasterized stats
# [cost, length, water, mountain, forest].
export fn plan_from_path(flat: List<Int>, stats: List<Int>) -> RoutePlan:
  let points = path_points(flat)
  let surcharge = nth_int(stats, 0)
  let length = nth_int(stats, 1)
  let water = nth_int(stats, 2)
  let mountain = nth_int(stats, 3)
  let forest = nth_int(stats, 4)
  RoutePlan(path: points, bend: auto_bend(), length: length, water: water, mountain: mountain, forest: forest, money: 8 + surcharge, timber: 1 + length / 14 + water, stone: 1 + length / 18 + mountain * 2, min_y: min_point_y(points, 0, map_h()), max_y: max_point_y(points, 0, 0))

# Persisted route plans use a fixed-width text format so a saved corridor is
# never re-derived from the current pathfinding algorithm:
# v1 | count(4) | 9 stats(8 each) | count * (x,y)(4 each).
fn zero_pad(text: Text, width: Int) -> Text:
  match len(text) >= width:
    true => text
    false => zero_pad("0" + text, width)

fn pad4(value: Int) -> Text:
  zero_pad(int_text(value), 4)

fn pad8(value: Int) -> Text:
  zero_pad(int_text(value), 8)

fn digit_value(c: Text) -> Int:
  match c == "0":
    true => 0
    false => match c == "1":
      true => 1
      false => match c == "2":
        true => 2
        false => match c == "3":
          true => 3
          false => match c == "4":
            true => 4
            false => match c == "5":
              true => 5
              false => match c == "6":
                true => 6
                false => match c == "7":
                  true => 7
                  false => match c == "8":
                    true => 8
                    false => match c == "9":
                      true => 9
                      false => 0

fn int_of_at(text: Text, i: Int, acc: Int) -> Int:
  match i >= len(text):
    true => acc
    false => int_of_at(text, i + 1, acc * 10 + digit_value(text_slice(text, i, 1)))

fn int_of(text: Text) -> Int:
  int_of_at(text, 0, 0)

export fn text_int(text: Text) -> Int:
  int_of(text)

export fn encode_plan(plan: RoutePlan) -> Text:
  let header = "v1" + pad4(len(plan.path)) + pad8(plan.length) + pad8(plan.water) + pad8(plan.mountain) + pad8(plan.forest) + pad8(plan.money) + pad8(plan.timber) + pad8(plan.stone) + pad8(plan.min_y) + pad8(plan.max_y)
  let points = for p in plan.path:
    pad4(p.x) + pad4(p.y)
  match len(header) == 78:
    true => header + join_text(points, "")
    false => ""

export fn decode_plan(text: Text, bend: Int) -> RoutePlan:
  match len(text) < 78:
    true => empty_plan()
    false => match text_slice(text, 0, 2) != "v1":
      true => empty_plan()
      false =>
        let count = int_of(text_slice(text, 2, 4))
        match count <= 0 or len(text) != 78 + count * 8:
          true => empty_plan()
          false =>
            let points = for i in indices(count):
              Point(x: int_of(text_slice(text, 78 + i * 8, 4)), y: int_of(text_slice(text, 82 + i * 8, 4)))
            RoutePlan(path: points, bend: bend, length: int_of(text_slice(text, 6, 8)), water: int_of(text_slice(text, 14, 8)), mountain: int_of(text_slice(text, 22, 8)), forest: int_of(text_slice(text, 30, 8)), money: int_of(text_slice(text, 38, 8)), timber: int_of(text_slice(text, 46, 8)), stone: int_of(text_slice(text, 54, 8)), min_y: int_of(text_slice(text, 62, 8)), max_y: int_of(text_slice(text, 70, 8)))

fn near_segment(px: Int, py: Int, a: Point, b: Point) -> Bool:
  let vx = b.x - a.x
  let vy = b.y - a.y
  let wx = px - a.x
  let wy = py - a.y
  let l2 = vx * vx + vy * vy
  let inside = px >= min_int(a.x, b.x) - 1 and px <= max_int(a.x, b.x) + 1 and py >= min_int(a.y, b.y) - 1 and py <= max_int(a.y, b.y) + 1
  match inside:
    true => match l2 == 0:
      true => wx * wx + wy * wy <= 2
      false =>
        let cross = wx * vy - wy * vx
        cross * cross * 2 <= l2
    false => false

export fn plan_crosses(plan: RoutePlan, x: Int, y: Int) -> Bool:
  plan_crosses_at(plan.path, x, y, 0)

fn plan_crosses_at(path: List<Point>, x: Int, y: Int, i: Int) -> Bool:
  match list_get(path, i):
    None => false
    Some(a) => match list_get(path, i + 1):
      None => false
      Some(b) => match near_segment(x, y, a, b):
        true => true
        false => plan_crosses_at(path, x, y, i + 1)

export fn route_mode_code(mode: RouteMode) -> Int:
  match mode:
    NoRoute => 0
    Path => 1
    Road => 2
    River => 3
    Rail => 4

fn route_cell(route: Route, x: Int, y: Int) -> Int:
  match y >= route.plan.min_y - 1 and y <= route.plan.max_y + 1 and plan_crosses(route.plan, x, y):
    true => route_mode_code(route.mode)
    false => 0

fn best_route_code(routes: List<Route>, x: Int, y: Int, i: Int, best: Int) -> Int:
  match list_get(routes, i):
    None => best
    Some(r) => best_route_code(routes, x, y, i + 1, max_int(best, route_cell(r, x, y)))

export fn route_at(world: World, x: Int, y: Int) -> Int:
  best_route_code(world.routes, x, y, 0, 0)

# ---------------------------------------------------------------- map model

fn marker_towns(towns: List<Town>, x: Int, y: Int, i: Int) -> Text:
  match list_get(towns, i):
    None => ""
    Some(t) => match t.x == x and t.y == y:
      true => t.id
      false => marker_towns(towns, x, y, i + 1)

fn marker_site_at(sites: List<Site>, x: Int, y: Int, i: Int) -> Text:
  match list_get(sites, i):
    None => ""
    Some(s) => match s.x == x and s.y == y:
      true => s.id
      false => marker_site_at(sites, x, y, i + 1)

export fn cell_marker(world: World, x: Int, y: Int) -> Text:
  marker_towns(world.towns, x, y, 0)

export fn marker_name(world: World, id: Text) -> Text:
  let t = find_town(world.towns, id)
  match t.id != "":
    true => t.name
    false => site_name_by_id(world.sites, id, 0)

fn site_name_by_id(sites: List<Site>, id: Text, i: Int) -> Text:
  match list_get(sites, i):
    None => ""
    Some(s) => match s.id == id:
      true => s.name
      false => site_name_by_id(sites, id, i + 1)

export fn marker_kind(world: World, id: Text) -> Text:
  match find_town(world.towns, id).id != "":
    true => "town"
    false => "site"

fn marker_terrain(world: World, x: Int, y: Int) -> Terrain:
  let t = find_town(world.towns, cell_marker(world, x, y))
  match t.id != "":
    true => t.terrain
    false => terrain_at(world.seed, x, y)

export fn display_terrain(world: World, x: Int, y: Int) -> Terrain:
  let id = cell_marker(world, x, y)
  match id != "":
    true => marker_terrain(world, x, y)
    false => site_terrain_at(world.sites, x, y, 0, terrain_at(world.seed, x, y))

fn site_terrain_at(sites: List<Site>, x: Int, y: Int, i: Int, base: Terrain) -> Terrain:
  match list_get(sites, i):
    None => base
    Some(s) => match s.x == x and s.y == y:
      true => match s.founded:
        true => base
        false => s.terrain
      false => site_terrain_at(sites, x, y, i + 1, base)

export fn map_cell_at(world: World, x: Int, y: Int, route_code: Int, draft: RoutePlan, draft_ready: Bool) -> MapCell:
  let markers = make_markers(world)
  let row_markers = collect_row_markers(markers, y, 0, [])
  render_cell(world.seed, row_markers, " ", x, y, route_code, draft, draft_ready)

export fn map_cell(world: World, x: Int, y: Int, draft: RoutePlan, draft_ready: Bool) -> MapCell:
  map_cell_at(world, x, y, route_at(world, x, y), draft, draft_ready)

fn map_cell_class_raw(terrain: Terrain, route: Int, draft: Bool) -> Text:
  let route_class = match route == 0:
    true => ""
    false => match route == 1:
      true => " r-path"
      false => match route == 2:
        true => " r-road"
        false => match route == 3:
          true => " r-river"
          false => " r-rail"
  let draft_class = match draft:
    true => " r-draft"
    false => ""
  terrain_class(terrain) + route_class + draft_class

export fn map_cell_class(world: World, c: MapCell) -> Text:
  map_cell_class_raw(c.terrain, c.route, c.draft)

fn empty_marker() -> MarkerInfo:
  MarkerInfo(id: "", name: "", detail: "", is_town: false, x: 0, y: 0, terrain: Plains)

fn marker_search(towns: List<Town>, sites: List<Site>, x: Int, y: Int, i: Int) -> MarkerInfo:
  match list_get(towns, i):
    Some(t) => match t.x == x and t.y == y:
      true => MarkerInfo(id: t.id, name: t.name, detail: "", is_town: true, x: t.x, y: t.y, terrain: t.terrain)
      false => marker_search(towns, sites, x, y, i + 1)
    None => site_marker_search(sites, x, y, 0)

fn site_marker_search(sites: List<Site>, x: Int, y: Int, i: Int) -> MarkerInfo:
  match list_get(sites, i):
    None => empty_marker()
    Some(s) => match s.founded:
      true => site_marker_search(sites, x, y, i + 1)
      false => match s.x == x and s.y == y:
        true => MarkerInfo(id: s.id, name: s.name, detail: good_short(s.resource) + " " + int_text(s.richness), is_town: false, x: s.x, y: s.y, terrain: s.terrain)
        false => site_marker_search(sites, x, y, i + 1)

export fn make_markers(world: World) -> List<MarkerInfo>:
  let towns = for t in world.towns:
    MarkerInfo(id: t.id, name: t.name, detail: "", is_town: true, x: t.x, y: t.y, terrain: t.terrain)
  let groups = for s in world.sites:
    match s.founded:
      true => []
      false => [MarkerInfo(id: s.id, name: s.name, detail: good_short(s.resource) + " " + int_text(s.richness), is_town: false, x: s.x, y: s.y, terrain: s.terrain)]
  let sites = flatten_markers(groups, 0, [])
  concat_markers(towns, sites)

fn flatten_markers(xs: List<List<MarkerInfo>>, i: Int, acc: List<MarkerInfo>) -> List<MarkerInfo>:
  match list_get(xs, i):
    None => acc
    Some(row) => flatten_markers(xs, i + 1, concat_markers(acc, row))

fn concat_markers(xs: List<MarkerInfo>, ys: List<MarkerInfo>) -> List<MarkerInfo>:
  match len(xs) == 0:
    true => ys
    false => concat_markers(list_slice(xs, 1, len(xs) - 1), list_append(ys, nth_marker(xs, 0)))

fn nth_marker(xs: List<MarkerInfo>, i: Int) -> MarkerInfo:
  match list_get(xs, i):
    Some(m) => m
    None => empty_marker()

fn build_base_cell(seed: Int, markers: List<MarkerInfo>, x: Int, y: Int) -> MapBaseCell:
  let marker = marker_at_markers(markers, x, y, 0)
  let terrain = match marker.id != "":
    true => marker.terrain
    false => terrain_at(seed, x, y)
  MapBaseCell(x: x, y: y, terrain: terrain, marker: marker.id, marker_name: marker.name, is_town: marker.is_town)

export fn render_map(seed: Int, markers: List<MarkerInfo>, selected: Text, draft: RoutePlan, draft_ready: Bool, route_rows: List<List<Int>>) -> List<RenderedRow>:
  for y in indices(map_h()):
    let row_markers = collect_row_markers(markers, y, 0, [])
    let row_codes = nth_int_list(route_rows, y)
    let cells = for x in indices(map_w()):
      let marker = marker_at_markers(row_markers, x, y, 0)
      let terrain = match marker.id != "":
        true => marker.terrain
        false => terrain_at(seed, x, y)
      let route_code = nth_int(row_codes, x)
      let draft_crosses = match draft_ready:
        true => plan_crosses(draft, x, y)
        false => false
      let is_selected = marker.id != "" and marker.id == selected
      let mclass = match marker.id == "":
        true => ""
        false => match marker.is_town:
          true => match is_selected:
            true => "town-marker selected"
            false => "town-marker"
          false => "site-marker"
      MapCell(x: x, y: y, terrain: terrain, route: route_code, marker: marker.id, marker_name: marker.name, marker_class: mclass, is_town: marker.is_town, selected: is_selected, draft: draft_crosses, css: map_cell_class_raw(terrain, route_code, draft_crosses), title: terrain_name(terrain))
    RenderedRow(y: y, cells: cells)

fn collect_row_markers(markers: List<MarkerInfo>, y: Int, i: Int, acc: List<MarkerInfo>) -> List<MarkerInfo>:
  match list_get(markers, i):
    None => acc
    Some(m) => match m.id != "" and m.y == y:
      true => collect_row_markers(markers, y, i + 1, list_append(acc, m))
      false => collect_row_markers(markers, y, i + 1, acc)

fn render_cell(seed: Int, markers: List<MarkerInfo>, selected: Text, x: Int, y: Int, route_code: Int, draft: RoutePlan, draft_ready: Bool) -> MapCell:
  let marker = marker_at_markers(markers, x, y, 0)
  let terrain = match marker.id != "":
    true => marker.terrain
    false => terrain_at(seed, x, y)
  let draft_crosses = match draft_ready:
    true => plan_crosses(draft, x, y)
    false => false
  let is_selected = marker.id != "" and marker.id == selected
  let mclass = match marker.id == "":
    true => ""
    false => match marker.is_town:
      true => match is_selected:
        true => "town-marker selected"
        false => "town-marker"
      false => "site-marker"
  let title = match marker.id == "":
    true => terrain_name(terrain)
    false => terrain_name(terrain) + " · " + marker.name
  MapCell(x: x, y: y, terrain: terrain, route: route_code, marker: marker.id, marker_name: marker.name, marker_class: mclass, is_town: marker.is_town, selected: is_selected, draft: draft_crosses, css: map_cell_class_raw(terrain, route_code, draft_crosses), title: title)

fn marker_at_markers(markers: List<MarkerInfo>, x: Int, y: Int, i: Int) -> MarkerInfo:
  match list_get(markers, i):
    None => empty_marker()
    Some(m) => match m.x == x and m.y == y:
      true => m
      false => marker_at_markers(markers, x, y, i + 1)

export fn route_mode_class(mode: RouteMode) -> Text:
  match mode:
    NoRoute => "m-none"
    Path => "m-path"
    Road => "m-road"
    River => "m-river"
    Rail => "m-rail"

export fn cell_title(world: World, c: MapCell) -> Text:
  let base = terrain_name(c.terrain)
  match c.marker != "":
    true => base + " · " + marker_name(world, c.marker)
    false => base

export fn site_title(s: Site) -> Text:
  s.name + " · " + good_name(s.resource) + " site · richness " + int_text(s.richness) + " · build a route nearby to found it"

export fn route_direction(r: Route) -> Text:
  r.a_name + " → " + r.b_name

export fn fee_label(r: Route) -> Text:
  "toll " + int_text(r.fee) + "/unit"

export fn income_label(r: Route) -> Text:
  int_text(r.traffic * r.fee) + " crowns/cycle"

export fn money_class(world: World) -> Text:
  match world.money < 0:
    true => "negative"
    false => "positive"

export fn settlement_row_class(sel: Selection, id: Text) -> Text:
  match sel.selected == id:
    true => "settlement-row active"
    false => "settlement-row"

export fn endow_class(t: Town, g: Good) -> Text:
  match endow_of(t, g) > 0:
    true => "on"
    false => "off"

export fn marker_button_class(sel: Selection, m: MarkerInfo) -> Text:
  match m.is_town:
    false => "site-marker"
    true => match sel.selected == m.id:
      true => "town-marker selected"
      false => "town-marker"

export fn marker_button_class_selected(selected: Text, m: MarkerInfo) -> Text:
  match m.is_town:
    false => match selected == m.id:
      true => "site-marker selected"
      false => "site-marker"
    true => match selected == m.id:
      true => "town-marker selected"
      false => "town-marker"

export fn survey_badge(sel: Selection) -> Text:
  match sel.routing:
    false => "idle"
    true => match sel.ready:
      true => "survey ready"
      false => match sel.from == "":
        true => "idle"
        false => "choose destination"

export fn tech_next_text(world: World) -> Text:
  match world.tech_rail:
    true => "All transport eras unlocked"
    false => next_tech_name(world) + " at " + int_text(next_tech_threshold(world)) + " research"

export fn signal_count(game: Game) -> Int:
  len(alerts(game.world)) + match upkeep_due(game) > 0:
    true => 1
    false => 0

export fn good_detail(t: Town, g: Good) -> Text:
  good_name(g) + ": " + int_text(stock(t, g)) + " stock · need " + int_text(need_of(t, g)) + " · endowment " + int_text(endow_of(t, g))

# ---------------------------------------------------------------- globe (RT)
#
# The rhombic triacontahedron tables live in rt_tables.dia. These wrappers keep
# the module in the project graph and give the UI and renderer a single entry
# point for globe work.

export fn rt_grid_summary() -> Text:
  int_text(rt_vertex_count()) + " vertices · " + int_text(rt_face_count()) + " faces · " + int_text(rt_seam_count()) + " directed seams"

export fn rt_face_polygon(i: Int) -> List<RtVec>:
  let f = rt_face(i)
  [rt_vertex(f.a), rt_vertex(f.b), rt_vertex(f.c), rt_vertex(f.d)]

export fn empty_inspect_view() -> InspectView:
  InspectView(ready: false, is_site: false, name: "", status: "", tone: "ok", resource: "", richness: 0, founded: false, pop: 0, prosperity: 0, research: 0, terrain: "", value: 0, insight: "", shortages: "none", connected: 0, goods: zeros(len(goods())), needs: zeros(len(goods())), endows: zeros(len(goods())))

export fn inspect_view(world: World, id: Text) -> InspectView:
  let t = find_town(world.towns, id)
  match t.id == "":
    true =>
      let s = find_site(world.sites, id)
      match s.id == "":
        true => empty_inspect_view()
        false =>
          let status = match s.founded:
            true => "founded"
            false => "unclaimed"
          let tone = match s.founded:
            true => "ok"
            false => "warn"
          let insight = match s.founded:
            true => s.name + " has already been founded."
            false => match len(world.towns) >= max_settlements():
              true => "Unclaimed " + good_name(s.resource) + " site. The frontier charter has reached its settlement limit."
              false => "Unclaimed " + good_name(s.resource) + " site. Route a line within one tile to found a settlement here."
          InspectView(ready: true, is_site: true, name: s.name, status: status, tone: tone, resource: good_name(s.resource), richness: s.richness, founded: s.founded, pop: 0, prosperity: 0, research: 0, terrain: terrain_name(s.terrain), value: s.richness, insight: insight, shortages: "none", connected: 0, goods: zeros(len(goods())), needs: zeros(len(goods())), endows: zeros(len(goods())))
    false =>
      let goods_now = for g in goods():
        stock(t, g)
      let needs = for g in goods():
        need_of(t, g)
      let endows = for g in goods():
        endow_of(t, g)
      InspectView(ready: true, is_site: false, name: t.name, status: status_text(t), tone: status_tone(t), resource: "", richness: 0, founded: false, pop: t.state.pop, prosperity: t.state.prosperity, research: t.state.research, terrain: terrain_name(t.terrain), value: market_value(t), insight: town_insight(world, t), shortages: shortage_text(t), connected: connected_routes(world, t.id), goods: goods_now, needs: needs, endows: endows)

export fn inspect_stock(iv: InspectView, g: Good) -> Int:
  nth_int(iv.goods, good_index(g))

export fn inspect_need(iv: InspectView, g: Good) -> Int:
  nth_int(iv.needs, good_index(g))

export fn inspect_endow(iv: InspectView, g: Good) -> Int:
  nth_int(iv.endows, good_index(g))

export fn inspect_good_title(iv: InspectView, g: Good) -> Text:
  good_name(g) + ": " + int_text(inspect_stock(iv, g)) + " stock · need " + int_text(inspect_need(iv, g)) + " · endowment " + int_text(inspect_endow(iv, g))

export fn upkeep_signal_text(game: Game) -> Text:
  "Upkeep due: " + int_text(upkeep_due(game)) + " crowns. " + match maintenance_text(game) == "degraded":
    true => "Capacity is degraded."
    false => "Pay it to keep routes maintained."

export fn survey_action_text(iv: InspectView) -> Text:
  match iv.ready:
    false => "Select a settlement to survey"
    true => match iv.is_site:
      true => "Select a settlement to survey"
      false => "Survey route from " + iv.name

export fn inspect_endow_text(iv: InspectView) -> Text:
  let parts = for g in goods():
    match inspect_endow(iv, g) > 0:
      true => good_short(g) + " +" + int_text(inspect_endow(iv, g))
      false => ""
  let text = join_nonempty(parts, 0, "")
  match text == "":
    true => "none"
    false => text

# ---------------------------------------------------------------- presentation

export fn route_text(mode: RouteMode) -> Text:
  match mode:
    NoRoute => "none"
    Path => "pack route"
    Road => "cart road"
    River => "river barge"
    Rail => "rail"

export fn route_short(mode: RouteMode) -> Text:
  match mode:
    NoRoute => "-"
    Path => "PATH"
    Road => "ROAD"
    River => "RIVER"
    Rail => "RAIL"

export fn mode_capacity_label(mode: RouteMode) -> Text:
  match mode:
    NoRoute => "none"
    Path => "low"
    Road => "medium"
    River => "high"
    Rail => "very high"

export fn connected_routes(world: World, id: Text) -> Int:
  let flags = for r in world.routes:
    bool_int(r.a == id or r.b == id)
  total(flags)

export fn total_pop(world: World) -> Int:
  let values = for t in world.towns:
    t.state.pop
  total(values)

export fn total_prosperity(world: World) -> Int:
  let values = for t in world.towns:
    t.state.prosperity
  total(values)

export fn max_town_research(world: World) -> Int:
  max_research(world.towns, 0)

export fn next_tech_threshold(world: World) -> Int:
  match world.tech_rail:
    true => 1
    false => match world.tech_river:
      true => rail_research()
      false => match world.tech_road:
        true => river_research()
        false => road_research()

export fn next_tech_name(world: World) -> Text:
  match world.tech_rail:
    true => "All transport tech"
    false => match world.tech_river:
      true => "Rail"
      false => match world.tech_road:
        true => "River barges"
        false => "Roads"

export fn tech_progress(world: World) -> Int:
  let best = max_town_research(world)
  clamp(best * 100 / max_int(next_tech_threshold(world), 1), 0, 100)

export fn progress_class(world: World) -> Text:
  let p = tech_progress(world)
  match p >= 100:
    true => "p100"
    false => match p >= 75:
      true => "p75"
      false => match p >= 50:
        true => "p50"
        false => match p >= 25:
          true => "p25"
          false => "p0"

export fn town_insight(world: World, t: Town) -> Text:
  match t.id == "":
    true => "Select a settlement on the map to inspect it."
    false => match food_ok(t) == 0:
      true => "Food is short. Connect a grain or fishing settlement before the population shrinks."
      false => match connected_routes(world, t.id) == 0:
        true => "Isolated. Build a route so its surplus can reach a market and new goods can arrive."
        false => match stock(t, Tools) == 0:
          true => "No tools. Deliver timber, stone, and ore together to start tool production."
          false => match t.state.prosperity < 8:
            true => "Prosperity is fragile. Diversify the goods reaching this settlement; variety matters more than volume."
            false => match t.state.prosperity >= 16:
              true => "Thriving. Growth is now limited by food and building materials, not by demand."
              false => "Stable. More variety or a cheaper route would raise prosperity and research."

export fn endow_text(t: Town) -> Text:
  let parts = for g in goods():
    match endowment(t, g) > 0:
      true => good_short(g) + " " + int_text(endowment(t, g))
      false => ""
  let text = join_nonempty(parts, 0, "")
  match text == "":
    true => "none"
    false => text

fn join_nonempty(xs: List<Text>, i: Int, acc: Text) -> Text:
  match list_get(xs, i):
    None => acc
    Some(x) => match x == "":
      true => join_nonempty(xs, i + 1, acc)
      false => match acc == "":
        true => join_nonempty(xs, i + 1, x)
        false => join_nonempty(xs, i + 1, acc + " · " + x)

export fn shortage_text(t: Town) -> Text:
  let parts = for g in goods():
    match need_of(t, g) > stock(t, g):
      true => good_short(g) + " -" + int_text(need_of(t, g) - stock(t, g))
      false => ""
  let text = join_nonempty(parts, 0, "")
  match text == "":
    true => "none"
    false => text

export fn usage_class(r: Route) -> Text:
  let p = match r.capacity <= 0:
    true => 0
    false => r.traffic * 100 / r.capacity
  match p >= 90:
    true => "usage-full"
    false => match p >= 60:
      true => "usage-high"
      false => match p >= 25:
        true => "usage-mid"
        false => "usage-low"

export fn bar_class(v: Int) -> Text:
  match v >= 110:
    true => "bar-11"
    false => match v >= 100:
      true => "bar-10"
      false => match v >= 90:
        true => "bar-9"
        false => match v >= 80:
          true => "bar-8"
          false => match v >= 70:
            true => "bar-7"
            false => match v >= 60:
              true => "bar-6"
              false => match v >= 50:
                true => "bar-5"
                false => match v >= 40:
                  true => "bar-4"
                  false => match v >= 30:
                    true => "bar-3"
                    false => match v >= 20:
                      true => "bar-2"
                      false => match v >= 10:
                        true => "bar-1"
                        false => "bar-0"

export fn log_feed(world: World) -> List<Text>:
  list_reverse(world.log)

fn any_shortage(towns: List<Town>, i: Int) -> Bool:
  match list_get(towns, i):
    None => false
    Some(t) => match food_ok(t) == 0:
      true => true
      false => any_shortage(towns, i + 1)

fn any_congested(routes: List<Route>, i: Int) -> Bool:
  match list_get(routes, i):
    None => false
    Some(r) => match r.traffic >= r.capacity and r.capacity > 0:
      true => true
      false => any_congested(routes, i + 1)

export fn alerts(world: World) -> List<Text>:
  let a = match world.money < 0:
    true => ["Treasury is negative. Upkeep is eating the network."]
    false => []
  let b = match any_shortage(world.towns, 0):
    true => list_append(a, "At least one settlement is out of food.")
    false => a
  let c = match any_congested(world.routes, 0):
    true => list_append(b, "A route is at capacity. Upgrade it or trade will stall.")
    false => b
  let d = match len(world.routes) == 0:
    true => list_append(c, "No routes built yet. Click two settlements on the map to survey one.")
    false => c
  match len(d) == 0:
    true => ["No active crises. The network is holding."]
    false => d

export fn town_status(t: Town) -> Text:
  status_text(t)

export fn market_value(t: Town) -> Int:
  total(t.state.stock) + t.state.prosperity * 2 + t.state.research

# ---------------------------------------------------------------- construction

fn combined_stock(world: World, a: Text, b: Text, g: Good) -> Int:
  stock(find_town(world.towns, a), g) + stock(find_town(world.towns, b), g)

fn pay_good(world: World, a: Text, b: Text, g: Good, amount: Int) -> List<Town>:
  pay_good_list(world.towns, a, b, g, amount)

fn pay_good_list(towns: List<Town>, a: Text, b: Text, g: Good, amount: Int) -> List<Town>:
  let ta = find_town(towns, a)
  let tb = find_town(towns, b)
  let from_a = min_int(stock(ta, g), amount)
  let left = amount - from_a
  let ta2 = with_stock(ta, g, stock(ta, g) - from_a)
  let tb2 = with_stock(tb, g, stock(tb, g) - left)
  replace_town(replace_town(towns, ta2), tb2)

fn pay_plan_list(towns: List<Town>, a: Text, b: Text, plan: RoutePlan) -> List<Town>:
  let t1 = pay_good_list(towns, a, b, Timber, plan.timber)
  pay_good_list(t1, a, b, Stone, plan.stone)

fn route_exists(routes: List<Route>, a: Text, b: Text, i: Int) -> Bool:
  match list_get(routes, i):
    None => false
    Some(r) => match (r.a == a and r.b == b) or (r.a == b and r.b == a):
      true => true
      false => route_exists(routes, a, b, i + 1)

fn base_capacity(mode: RouteMode) -> Int:
  match mode:
    NoRoute => 0
    Path => 9
    Road => 17
    River => 26
    Rail => 38

fn mode_upkeep(mode: RouteMode) -> Int:
  match mode:
    NoRoute => 0
    Path => 0
    Road => 1
    River => 2
    Rail => 3

export fn route_capacity(mode: RouteMode, plan: RoutePlan) -> Int:
  max_int(3, base_capacity(mode) - plan.length / 8 - plan.water - plan.mountain)

export fn route_upkeep(mode: RouteMode, plan: RoutePlan) -> Int:
  1 + plan.length / 16 + mode_upkeep(mode)

fn make_route(towns: List<Town>, a: Text, b: Text, plan: RoutePlan) -> Route:
  let ta = find_town(towns, a)
  let tb = find_town(towns, b)
  Route(id: a + "-" + b, a: a, b: b, a_name: ta.name, b_name: tb.name, mode: Path, plan: plan, fee: 1, traffic: 0, capacity: route_capacity(Path, plan), upkeep: route_upkeep(Path, plan))

fn site_near_plan(plan: RoutePlan, s: Site) -> Bool:
  plan_crosses(plan, s.x, s.y) or plan_crosses(plan, s.x + 1, s.y) or plan_crosses(plan, s.x - 1, s.y) or plan_crosses(plan, s.x, s.y + 1) or plan_crosses(plan, s.x, s.y - 1)

fn town_from_site(s: Site) -> Town:
  let endow = replace_int(zeros(len(goods())), good_index(s.resource), s.richness)
  Town(id: s.id, name: s.name, x: s.x, y: s.y, terrain: s.terrain, endow: endow, state: TownState(pop: 1, prosperity: 5, research: 0, stock: outpost_stock(s.resource, s.richness)))

fn mark_site_founded(sites: List<Site>, id: Text) -> List<Site>:
  for s in sites:
    match s.id == id:
      true => Site(id: s.id, name: s.name, x: s.x, y: s.y, terrain: s.terrain, resource: s.resource, richness: s.richness, founded: true)
      false => s

fn found_lists(towns: List<Town>, sites: List<Site>, log: List<Text>, plan: RoutePlan, i: Int, budget: Int) -> FoundLists:
  match list_get(sites, i):
    None => FoundLists(towns: towns, sites: sites, log: log)
    Some(s) => match s.founded or budget <= 0 or len(towns) >= max_settlements():
      true => found_lists(towns, sites, log, plan, i + 1, budget)
      false => match site_near_plan(plan, s):
        true =>
          let town = town_from_site(s)
          let towns2 = list_append(towns, town)
          let sites2 = mark_site_founded(sites, s.id)
          let log2 = append_message(log, s.name + " is founded where the new route passes.")
          found_lists(towns2, sites2, log2, plan, i + 1, budget - 1)
        false => found_lists(towns, sites, log, plan, i + 1, budget)

export fn build_route(world: World, a: Text, b: Text, plan: RoutePlan) -> BuildResult:
  match a == "" or b == "" or a == b:
    true => BuildResult(world: world, ok: false, message: "Choose two different settlements.", from: a, to: b)
    false => match route_exists(world.routes, a, b, 0):
      true => BuildResult(world: world, ok: false, message: "A route already connects these settlements.", from: a, to: b)
      false => match len(world.routes) >= max_routes():
        true => BuildResult(world: world, ok: false, message: "Three trunk routes already exist. Dismantle one before building another.", from: a, to: b)
        false => match world.money < plan.money:
          true => BuildResult(world: world, ok: false, message: "The treasury needs " + int_text(plan.money) + " crowns for this survey.", from: a, to: b)
          false => match combined_stock(world, a, b, Timber) < plan.timber or combined_stock(world, a, b, Stone) < plan.stone:
            true => BuildResult(world: world, ok: false, message: "Materials are short: " + int_text(plan.timber) + " timber and " + int_text(plan.stone) + " stone are needed.", from: a, to: b)
            false =>
              let paid = pay_plan_list(world.towns, a, b, plan)
              let route = make_route(paid, a, b, plan)
              let log1 = append_message(world.log, "Built a pack route from " + route.a_name + " to " + route.b_name + " (" + int_text(plan.length) + " leagues).")
              let found = found_lists(paid, world.sites, log1, plan, 0, 1)
              let w = World(seed: world.seed, tick: world.tick, money: world.money - plan.money, towns: found.towns, sites: found.sites, routes: list_append(world.routes, route), log: found.log, history: world.history, tech_road: world.tech_road, tech_river: world.tech_river, tech_rail: world.tech_rail)
              BuildResult(world: w, ok: true, message: "Route built. " + route.a_name + " and " + route.b_name + " are connected.", from: "", to: "")

fn empty_route() -> Route:
  Route(id: "", a: "", b: "", a_name: "", b_name: "", mode: NoRoute, plan: empty_plan(), fee: 0, traffic: 0, capacity: 0, upkeep: 0)

fn route_by_id_small(routes: List<Route>, id: Text, start: Int, count: Int) -> Route:
  match count <= 0:
    true => empty_route()
    false => match list_get(routes, start):
      None => empty_route()
      Some(r) => match r.id == id:
        true => r
        false => route_by_id_small(routes, id, start + 1, count - 1)

fn route_by_id_range(routes: List<Route>, id: Text, start: Int, count: Int) -> Route:
  match count <= 0:
    true => empty_route()
    false => match count <= 8:
      true => route_by_id_small(routes, id, start, count)
      false =>
        let half = count / 2
        let left = route_by_id_range(routes, id, start, half)
        match left.id == "":
          true => route_by_id_range(routes, id, start + half, count - half)
          false => left

fn route_by_id(routes: List<Route>, id: Text, i: Int) -> Route:
  route_by_id_range(routes, id, i, len(routes) - i)

export fn route_lookup(world: World, id: Text) -> Route:
  route_by_id(world.routes, id, 0)

fn replace_route(routes: List<Route>, route: Route) -> List<Route>:
  for r in routes:
    match r.id == route.id:
      true => route
      false => r

fn nth_route(routes: List<Route>, i: Int) -> Route:
  match list_get(routes, i):
    None => route_by_id(routes, "", 0)
    Some(r) => r

fn drop_route(routes: List<Route>, id: Text, i: Int, acc: List<Route>) -> List<Route>:
  match i >= len(routes):
    true => list_reverse(acc)
    false =>
      let current = nth_route(routes, i)
      match current.id == id:
        true => drop_route(routes, id, i + 1, acc)
        false => drop_route(routes, id, i + 1, list_append(acc, current))

export fn can_upgrade(world: World, route: Route) -> Bool:
  match route.mode:
    Path => world.tech_road and world.money >= 35 and combined_stock(world, route.a, route.b, Stone) >= 2
    Road => world.tech_river and world.money >= 60 and combined_stock(world, route.a, route.b, Timber) >= 4
    River => world.tech_rail and world.money >= 90 and combined_stock(world, route.a, route.b, Stone) >= 4 and combined_stock(world, route.a, route.b, Tools) >= 2
    _ => false

export fn upgrade_cost_text(route: Route) -> Text:
  match route.mode:
    Path => "35 crowns + 2 stone"
    Road => "60 crowns + 4 timber"
    River => "90 crowns + 4 stone + 2 tools"
    _ => "fully upgraded"

export fn upgrade_route(world: World, id: Text) -> BuildResult:
  let r = route_by_id(world.routes, id, 0)
  match r.id == "":
    true => BuildResult(world: world, ok: false, message: "Route not found.", from: "", to: "")
    false => match can_upgrade(world, r):
      false => BuildResult(world: world, ok: false, message: "Not enough technology, crowns, or materials to upgrade " + r.a_name + " to " + r.b_name + ".", from: "", to: "")
      true =>
        let next_mode = match r.mode:
          Path => Road
          Road => River
          River => Rail
          _ => Rail
        let cost = match r.mode:
          Path => 35
          Road => 60
          River => 90
          _ => 0
        let pay_good_kind = match r.mode:
          Path => Stone
          Road => Timber
          River => Stone
          _ => Stone
        let pay_good_amount = match r.mode:
          Path => 2
          Road => 4
          River => 4
          _ => 0
        let paid = pay_good(world, r.a, r.b, pay_good_kind, pay_good_amount)
        let w1 = with_towns(world, paid)
        let w2 = match r.mode:
          River => with_towns(w1, pay_good(w1, r.a, r.b, Tools, 2))
          _ => w1
        let upgraded = Route(id: r.id, a: r.a, b: r.b, a_name: r.a_name, b_name: r.b_name, mode: next_mode, plan: r.plan, fee: r.fee, traffic: r.traffic, capacity: route_capacity(next_mode, r.plan), upkeep: route_upkeep(next_mode, r.plan))
        let w3 = with_routes(w2, replace_route(w2.routes, upgraded))
        let w4 = with_resources(w3, w3.money - cost, w3.log)
        let w5 = record(w4, r.a_name + " to " + r.b_name + " upgraded to " + route_text(next_mode) + ".")
        BuildResult(world: w5, ok: true, message: "Route upgraded to " + route_text(next_mode) + ".", from: "", to: "")

export fn demolish_route(world: World, id: Text) -> BuildResult:
  let r = route_by_id(world.routes, id, 0)
  match r.id == "":
    true => BuildResult(world: world, ok: false, message: "Route not found.", from: "", to: "")
    false =>
      let towns = pay_good(world, r.a, r.b, Timber, -1)
      let towns2 = pay_good(with_towns(world, towns), r.a, r.b, Stone, -1)
      let w1 = with_towns(world, towns2)
      let w2 = with_routes(w1, drop_route(world.routes, id, 0, []))
      let w3 = with_resources(w2, w2.money + r.upkeep * 2, w2.log)
      let w4 = record(w3, "Dismantled the " + route_text(r.mode) + " between " + r.a_name + " and " + r.b_name + ".")
      BuildResult(world: w4, ok: true, message: "Route dismantled; some materials recovered.", from: "", to: "")

export fn total_upkeep(routes: List<Route>) -> Int:
  let values = for r in routes:
    r.upkeep
  total(values)

# ---------------------------------------------------------------- survey helpers (Phase A)

# Sites that a finished route with this plan would found (within one tile).
export fn survey_found_sites(world: World, plan: RoutePlan) -> List<Site>:
  let groups = for s in world.sites:
    match s.founded:
      true => []
      false => match site_near_plan(plan, s):
        true => [s]
        false => []
  flatten_sites(groups, 0, [])

fn flatten_sites(xs: List<List<Site>>, i: Int, acc: List<Site>) -> List<Site>:
  match list_get(xs, i):
    None => acc
    Some(row) => flatten_sites(xs, i + 1, concat_sites(acc, row))

fn concat_sites(xs: List<Site>, ys: List<Site>) -> List<Site>:
  match len(xs) == 0:
    true => ys
    false => concat_sites(list_slice(xs, 1, len(xs) - 1), list_append(ys, nth_site(xs, 0)))

fn nth_site(xs: List<Site>, i: Int) -> Site:
  match list_get(xs, i):
    Some(s) => s
    None => Site(id: "", name: "", x: 0, y: 0, terrain: Plains, resource: Grain, richness: 0, founded: false)

export fn survey_found_text(world: World, plan: RoutePlan) -> Text:
  let sites = survey_found_sites(world, plan)
  match len(sites) == 0:
    true => "Founds no new settlement."
    false =>
      let parts = for s in sites:
        s.name + " (" + good_name(s.resource) + ")"
      "Founds: " + join_nonempty(parts, 0, "")

# Expected trade volume per cycle along a new route built as a pack route,
# estimated from current surplus and need at the endpoints.
export fn survey_trade_volume(world: World, from: Text, to: Text, plan: RoutePlan) -> Int:
  let a = find_town(world.towns, from)
  let b = find_town(world.towns, to)
  match a.id == "" or b.id == "":
    true => 0
    false =>
      let cap = route_capacity(Path, plan)
      let moves = trade_moves(a, b, Route(id: "", a: a.id, b: b.id, a_name: a.name, b_name: b.name, mode: Path, plan: plan, fee: 1, traffic: 0, capacity: cap, upkeep: 0), cap)
      moves.moved

# How materials are split between endpoints when paying for the plan.
export fn material_split_text(world: World, from: Text, to: Text, plan: RoutePlan) -> Text:
  let a = find_town(world.towns, from)
  let b = find_town(world.towns, to)
  match a.id == "" or b.id == "":
    true => ""
    false =>
      let timber_a = min_int(stock(a, Timber), plan.timber)
      let stone_a = min_int(stock(a, Stone), plan.stone)
      let timber_b = plan.timber - timber_a
      let stone_b = plan.stone - stone_a
      let parts = []
      let t = match timber_a > 0:
        true => [a.name + " " + int_text(timber_a) + " timber"]
        false => []
      let t2 = match timber_b > 0:
        true => list_append(t, b.name + " " + int_text(timber_b) + " timber")
        false => t
      let s = match stone_a > 0:
        true => list_append(t2, a.name + " " + int_text(stone_a) + " stone")
        false => t2
      let s2 = match stone_b > 0:
        true => list_append(s, b.name + " " + int_text(stone_b) + " stone")
        false => s
      join_nonempty(s2, 0, "")

# Warning if paying for the plan would push an endpoint below its needs.
export fn material_warning(world: World, from: Text, to: Text, plan: RoutePlan) -> Text:
  let a = find_town(world.towns, from)
  let b = find_town(world.towns, to)
  match a.id == "" or b.id == "":
    true => ""
    false =>
      let timber_a = min_int(stock(a, Timber), plan.timber)
      let stone_a = min_int(stock(a, Stone), plan.stone)
      let timber_b = plan.timber - timber_a
      let stone_b = plan.stone - stone_a
      let warn_a = match stock(a, Timber) - timber_a < need_of(a, Timber) or stock(a, Stone) - stone_a < need_of(a, Stone):
        true => a.name + " is left short of timber or stone."
        false => ""
      let warn_b = match stock(b, Timber) - timber_b < need_of(b, Timber) or stock(b, Stone) - stone_b < need_of(b, Stone):
        true => b.name + " is left short of timber or stone."
        false => ""
      join_nonempty([warn_a, warn_b], 0, "")

# Upgrade preview text for a route.
export fn upgrade_preview_text(route: Route) -> Text:
  match route.mode:
    Path => "Upgrade to cart road: cap " + int_text(route_capacity(Road, route.plan)) + ", upkeep " + int_text(route_upkeep(Road, route.plan)) + "/wk"
    Road => "Upgrade to river barge: cap " + int_text(route_capacity(River, route.plan)) + ", upkeep " + int_text(route_upkeep(River, route.plan)) + "/wk"
    River => "Upgrade to rail: cap " + int_text(route_capacity(Rail, route.plan)) + ", upkeep " + int_text(route_upkeep(Rail, route.plan)) + "/wk"
    _ => "Fully upgraded"

# Salvage text for dismantling a route.
export fn salvage_text(route: Route) -> Text:
  "Recovers 1 timber, 1 stone, and " + int_text(route.upkeep * 2) + " crowns."

# Candidate corridors for a survey: the best bend in each of a few named
# families. Returns up to three distinct plans.
export fn survey_alternatives(world: World, from: Text, to: Text) -> List<RoutePlan>:
  let ta = find_town(world.towns, from)
  let tb = find_town(world.towns, to)
  match ta.id == "" or tb.id == "":
    true => []
    false =>
      let candidates = for off in [-3, 0, 3]:
        plan_route_bend(world, from, to, off)
      dedupe_plans(candidates, 0, [])

fn dedupe_plans(xs: List<RoutePlan>, i: Int, acc: List<RoutePlan>) -> List<RoutePlan>:
  match list_get(xs, i):
    None => acc
    Some(p) =>
      match plan_in_list(acc, p, 0):
        true => dedupe_plans(xs, i + 1, acc)
        false => match len(acc) >= 3:
          true => acc
          false => dedupe_plans(xs, i + 1, list_append(acc, p))

fn plan_in_list(xs: List<RoutePlan>, p: RoutePlan, i: Int) -> Bool:
  match list_get(xs, i):
    None => false
    Some(q) => match q.length == p.length and q.water == p.water and q.mountain == p.mountain and q.bend == p.bend:
      true => true
      false => plan_in_list(xs, p, i + 1)

export fn survey_alt_text(plan: RoutePlan, i: Int) -> Text:
  "Corridor " + int_text(i + 1) + ": " + int_text(plan.length) + " leagues · " + int_text(plan.money) + " crowns · " + int_text(plan.water) + " bridges"

export fn nth_plan(xs: List<RoutePlan>, i: Int) -> RoutePlan:
  match list_get(xs, i):
    Some(p) => p
    None => empty_plan()

export fn adjust_fee(world: World, id: Text, delta: Int) -> World:
  let r = route_by_id(world.routes, id, 0)
  match r.id == "":
    true => world
    false =>
      let changed = Route(id: r.id, a: r.a, b: r.b, a_name: r.a_name, b_name: r.b_name, mode: r.mode, plan: r.plan, fee: clamp(r.fee + delta, 0, 5), traffic: r.traffic, capacity: r.capacity, upkeep: r.upkeep)
      with_routes(world, replace_route(world.routes, changed))

fn empty_project() -> Project:
  empty_project()

fn mode_work(mode: RouteMode) -> Int:
  match mode:
    NoRoute => 0
    Path => 0
    Road => 6
    River => 12
    Rail => 18

fn town_build_speed(t: Town) -> Int:
  match t.state.research >= 160:
    true => 2
    false => match t.state.research >= 80:
      true => 1
      false => 0

fn construction_speed(world: World, a: Text, b: Text, mode: RouteMode) -> Int:
  let ta = find_town(world.towns, a)
  let tb = find_town(world.towns, b)
  let best = max_int(ta.state.research, tb.state.research)
  let tech = match mode:
    Path => match best >= 50:
      true => 1
      false => 0
    Road => match world.tech_road:
      true => 2
      false => 0
    River => match world.tech_river:
      true => 2
      false => 0
    Rail => match world.tech_rail:
      true => 2
      false => 0
    NoRoute => 0
  1 + town_build_speed(ta) + town_build_speed(tb) + tech

export fn construction_time(world: World, a: Text, b: Text, plan: RoutePlan, mode: RouteMode) -> Int:
  let work = plan.length + mode_work(mode) + plan.water * 3
  let speed = construction_speed(world, a, b, mode)
  max_int(1, (work + speed - 1) / speed)

fn begin_route(world: World, a: Text, b: Text, plan: RoutePlan) -> ProjectStart:
  match a == "" or b == "" or a == b:
    true => ProjectStart(world: world, project: empty_project(), ok: false, message: "Choose two different settlements.", from: a, to: b)
    false => match route_exists(world.routes, a, b, 0):
      true => ProjectStart(world: world, project: empty_project(), ok: false, message: "A route already connects these settlements.", from: a, to: b)
      false => match world.money < plan.money:
        true => ProjectStart(world: world, project: empty_project(), ok: false, message: "The treasury needs " + int_text(plan.money) + " crowns for this survey.", from: a, to: b)
        false => match combined_stock(world, a, b, Timber) < plan.timber or combined_stock(world, a, b, Stone) < plan.stone:
          true => ProjectStart(world: world, project: empty_project(), ok: false, message: "Materials are short: " + int_text(plan.timber) + " timber and " + int_text(plan.stone) + " stone are needed.", from: a, to: b)
          false =>
            let paid = pay_plan_list(world.towns, a, b, plan)
            let w1 = with_towns(world, paid)
            let w2 = with_resources(w1, world.money - plan.money, w1.log)
            let time = construction_time(world, a, b, plan, Path)
            let ta = find_town(world.towns, a)
            let tb = find_town(world.towns, b)
            let project = Project(id: a + "-" + b, kind: "route", a: a, b: b, a_name: ta.name, b_name: tb.name, mode: Path, route_id: "", plan: plan, start_tick: world.tick, ready_tick: world.tick + time)
            let message = "Construction started: " + ta.name + " to " + tb.name + ", ready in " + duration_text(time) + "."
            let w3 = record(w2, message)
            ProjectStart(world: w3, project: project, ok: true, message: message, from: "", to: "")

fn begin_upgrade(world: World, id: Text) -> ProjectStart:
  let r = route_by_id(world.routes, id, 0)
  match r.id == "":
    true => ProjectStart(world: world, project: empty_project(), ok: false, message: "Route not found.", from: "", to: "")
    false => match can_upgrade(world, r):
      false => ProjectStart(world: world, project: empty_project(), ok: false, message: "Not enough technology, crowns, or materials to upgrade " + r.a_name + " to " + r.b_name + ".", from: "", to: "")
      true =>
        let next_mode = match r.mode:
          Path => Road
          Road => River
          River => Rail
          _ => Rail
        let cost = match r.mode:
          Path => 35
          Road => 60
          River => 90
          _ => 0
        let pay_kind = match r.mode:
          Path => Stone
          Road => Timber
          River => Stone
          _ => Stone
        let pay_amount = match r.mode:
          Path => 2
          Road => 4
          River => 4
          _ => 0
        let paid = pay_good(world, r.a, r.b, pay_kind, pay_amount)
        let w1 = with_towns(world, paid)
        let w2 = match r.mode:
          River => with_towns(w1, pay_good(w1, r.a, r.b, Tools, 2))
          _ => w1
        let time = construction_time(world, r.a, r.b, r.plan, next_mode)
        let project = Project(id: r.id + "-upgrade", kind: "upgrade", a: r.a, b: r.b, a_name: r.a_name, b_name: r.b_name, mode: next_mode, route_id: r.id, plan: r.plan, start_tick: world.tick, ready_tick: world.tick + time)
        let message = "Upgrade started: " + r.a_name + " to " + r.b_name + " as " + route_text(next_mode) + ", ready in " + duration_text(time) + "."
        let w3 = record(w2, message)
        ProjectStart(world: w3, project: project, ok: true, message: message, from: "", to: "")

fn complete_project(world: World, project: Project) -> World:
  match project.kind == "route":
    true =>
      let route = Route(id: project.a + "-" + project.b, a: project.a, b: project.b, a_name: project.a_name, b_name: project.b_name, mode: project.mode, plan: project.plan, fee: 1, traffic: 0, capacity: route_capacity(project.mode, project.plan), upkeep: route_upkeep(project.mode, project.plan))
      let log1 = append_message(world.log, "Construction finished: " + project.a_name + " to " + project.b_name + " is open.")
      let found = found_lists(world.towns, world.sites, log1, project.plan, 0, 1)
      World(seed: world.seed, tick: world.tick, money: world.money, towns: found.towns, sites: found.sites, routes: list_append(world.routes, route), log: found.log, history: world.history, tech_road: world.tech_road, tech_river: world.tech_river, tech_rail: world.tech_rail)
    false =>
      let r = route_by_id(world.routes, project.route_id, 0)
      match r.id == "":
        true => record(world, project.a_name + " to " + project.b_name + " upgrade was abandoned because the route no longer exists.")
        false =>
          let upgraded = Route(id: r.id, a: r.a, b: r.b, a_name: r.a_name, b_name: r.b_name, mode: project.mode, plan: r.plan, fee: r.fee, traffic: r.traffic, capacity: route_capacity(project.mode, r.plan), upkeep: route_upkeep(project.mode, r.plan))
          record(with_routes(world, replace_route(world.routes, upgraded)), "Construction finished: " + r.a_name + " to " + r.b_name + " is now a " + route_text(project.mode) + ".")

fn complete_message(project: Project) -> Text:
  match project.kind == "route":
    true => "Construction finished: " + project.a_name + " to " + project.b_name + " is open."
    false => "Upgrade finished: " + project.a_name + " to " + project.b_name + " is now " + route_text(project.mode) + "."

export fn advance_projects(world: World, projects: List<Project>, i: Int, kept: List<Project>, messages: List<Text>) -> ProjectOutcome:
  match list_get(projects, i):
    None => ProjectOutcome(world: world, projects: kept, messages: messages)
    Some(p) => match p.ready_tick <= world.tick:
      true => advance_projects(complete_project(world, p), projects, i + 1, kept, list_append(messages, complete_message(p)))
      false => advance_projects(world, projects, i + 1, list_append(kept, p), messages)

# ---------------------------------------------------------------- simulation

fn nth_good(i: Int) -> Good:
  match i == 0:
    true => Grain
    false => match i == 1:
      true => Timber
      false => match i == 2:
        true => Stone
        false => match i == 3:
          true => Ore
          false => match i == 4:
            true => Fiber
            false => match i == 5:
              true => Tools
              false => match i == 6:
                true => Cloth
                false => Fish

fn count_positive(xs: List<Int>, i: Int) -> Int:
  match list_get(xs, i):
    None => 0
    Some(v) => match v > 0:
      true => 1 + count_positive(xs, i + 1)
      false => count_positive(xs, i + 1)

fn advance_town(t: Town) -> Town:
  let grain_at = good_index(Grain)
  let timber_at = good_index(Timber)
  let stone_at = good_index(Stone)
  let ore_at = good_index(Ore)
  let fiber_at = good_index(Fiber)
  let tools_at = good_index(Tools)
  let cloth_at = good_index(Cloth)
  let fish_at = good_index(Fish)
  let timber_base = nth_int(t.state.stock, timber_at) + endowment(t, Timber)
  let stone_base = nth_int(t.state.stock, stone_at) + endowment(t, Stone)
  let ore_base = nth_int(t.state.stock, ore_at) + endowment(t, Ore)
  let fiber_base = nth_int(t.state.stock, fiber_at) + endowment(t, Fiber)
  let can_tools = timber_base >= 1 and stone_base >= 1 and ore_base >= 1
  let can_cloth = fiber_base >= 1
  let grain_prod = nth_int(t.state.stock, grain_at) + endowment(t, Grain)
  let fish_prod = nth_int(t.state.stock, fish_at) + endowment(t, Fish)
  let cloth_prod = nth_int(t.state.stock, cloth_at) + endowment(t, Cloth) + match can_cloth:
    true => 1
    false => 0
  let need_grain = t.state.pop
  let grain_eaten = min_int(grain_prod, need_grain)
  let need_fish = t.state.pop / 3 + 1
  let fish_eaten = min_int(fish_prod, need_fish)
  let cloth_need = t.state.pop / 4
  let cloth_used = min_int(cloth_prod, cloth_need)
  let after = for i in indices(len(goods())):
    let raw = nth_int(t.state.stock, i) + endowment(t, nth_good(i))
    let prod_value = match can_tools and (i == timber_at or i == stone_at or i == ore_at):
      true => raw - 1
      false => match can_tools and i == tools_at:
        true => raw + 1
        false => match can_cloth and i == fiber_at:
          true => raw - 1
          false => match can_cloth and i == cloth_at:
            true => raw + 1
            false => raw
    match i == grain_at:
      true => max_int(prod_value - grain_eaten, 0)
      false => match i == fish_at:
        true => max_int(prod_value - fish_eaten, 0)
        false => match i == cloth_at:
          true => max_int(prod_value - cloth_used, 0)
          false => prod_value
  let fed = grain_eaten + fish_eaten * 2
  let target = need_grain + need_fish * 2
  let food = match fed >= target:
    true => 2
    false => match fed * 2 >= target:
      true => 1
      false => 0
  let score = count_positive(after, 0)
  let comfort = bool_int(nth_int(after, tools_at) > 0) + bool_int(cloth_used > 0)
  let delta = food * 2 + min_int(score, 6) / 2 + comfort - 2
  let prosperity = clamp(t.state.prosperity + delta, 0, 30)
  let research = t.state.research + t.state.pop + score + prosperity / 6 + food
  let food_now = nth_int(after, grain_at) + nth_int(after, fish_at)
  let can_grow = prosperity >= 9 and food_now >= t.state.pop * 2 + 2 and nth_int(after, timber_at) >= 1 and nth_int(after, stone_at) >= 1
  match can_grow:
    true =>
      let final = for i in indices(len(after)):
        match i == grain_at:
          true => max_int(nth_int(after, i) - 2, 0)
          false => match i == timber_at or i == stone_at:
            true => max_int(nth_int(after, i) - 1, 0)
            false => nth_int(after, i)
      Town(id: t.id, name: t.name, x: t.x, y: t.y, terrain: t.terrain, endow: t.endow, state: TownState(pop: t.state.pop + 1, prosperity: clamp(prosperity - 1, 0, 30), research: research, stock: final))
    false => match food == 0 and t.state.pop > 1 and prosperity <= 4:
      true => Town(id: t.id, name: t.name, x: t.x, y: t.y, terrain: t.terrain, endow: t.endow, state: TownState(pop: t.state.pop - 1, prosperity: clamp(prosperity - 1, 0, 30), research: research, stock: after))
      false => Town(id: t.id, name: t.name, x: t.x, y: t.y, terrain: t.terrain, endow: t.endow, state: TownState(pop: t.state.pop, prosperity: prosperity, research: research, stock: after))

fn move_ab(a: Town, b: Town, g: Good, quota: Int, fee: Int) -> Int:
  let penalty = match g:
    Grain => fee / 2
    Fish => fee / 2
    _ => fee
  let surplus_a = stock(a, g) - need_of(a, g) - 1
  let need_b = max_int(need_of(b, g) - stock(b, g) - penalty, 0)
  match surplus_a > 0 and need_b > 0:
    true => min_int(min_int(surplus_a, need_b), quota)
    false => 0

fn trade_moves(a: Town, b: Town, route: Route, capacity: Int) -> TradeMoves:
  let quota = max_int(1, capacity / len(goods()))
  let ab = for g in goods():
    move_ab(a, b, g, quota, route.fee)
  let ba = for g in goods():
    move_ab(b, a, g, quota, route.fee)
  TradeMoves(ab: ab, ba: ba, moved: total(ab) + total(ba))

fn apply_moves(a: Town, b: Town, moves: TradeMoves) -> TradeResult:
  let stock_a = for i in indices(len(goods())):
    max_int(nth_int(a.state.stock, i) - nth_int(moves.ab, i) + nth_int(moves.ba, i), 0)
  let stock_b = for i in indices(len(goods())):
    max_int(nth_int(b.state.stock, i) + nth_int(moves.ab, i) - nth_int(moves.ba, i), 0)
  TradeResult(a: with_stock_list(a, stock_a), b: with_stock_list(b, stock_b), moved: moves.moved)

fn trade_net(net: NetState, route: Route, scale: Int) -> NetState:
  let a = find_town(net.towns, route.a)
  let b = find_town(net.towns, route.b)
  match a.id == "" or b.id == "":
    true => net
    false =>
      let cap = max_int(2, route.capacity * scale / 100)
      let moves = trade_moves(a, b, route, cap)
      let result = apply_moves(a, b, moves)
      let towns = replace_town(replace_town(net.towns, result.a), result.b)
      let changed = Route(id: route.id, a: route.a, b: route.b, a_name: route.a_name, b_name: route.b_name, mode: route.mode, plan: route.plan, fee: route.fee, traffic: route.traffic + result.moved, capacity: route.capacity, upkeep: route.upkeep)
      NetState(towns: towns, routes: replace_route(net.routes, changed))

fn trade_pass(net: NetState, i: Int, scale: Int) -> NetState:
  match list_get(net.routes, i):
    None => net
    Some(r) => trade_pass(trade_net(net, r, scale), i + 1, scale)

fn max_research_small(towns: List<Town>, start: Int, count: Int) -> Int:
  match count <= 0:
    true => 0
    false => max_int(nth_town(towns, start).state.research, max_research_small(towns, start + 1, count - 1))

fn max_research_range(towns: List<Town>, start: Int, count: Int) -> Int:
  match count <= 0:
    true => 0
    false => match count <= 8:
      true => max_research_small(towns, start, count)
      false =>
        let half = count / 2
        max_int(max_research_range(towns, start, half), max_research_range(towns, start + half, count - half))

fn max_research(towns: List<Town>, i: Int) -> Int:
  max_research_range(towns, i, len(towns) - i)

fn unlock_text(world: World) -> Text:
  match world.tech_rail:
    true => "rails"
    false => match world.tech_river:
      true => "rivers"
      false => match world.tech_road:
        true => "roads"
        false => "none"

export fn tech_summary(world: World) -> Text:
  unlock_text(world)

fn tech_messages(world: World, best: Int) -> List<Text>:
  let road = world.tech_road or best >= road_research()
  let river = world.tech_river or best >= river_research()
  let rail = world.tech_rail or best >= rail_research()
  match road and not world.tech_road:
    true => ["Discovery: improved carts. Roads can now be built."]
    false => match river and not world.tech_river:
      true => ["Discovery: river navigation. Barges can now be built."]
      false => match rail and not world.tech_rail:
        true => ["Discovery: steam power. Rail can now be built."]
        false => []

fn nth_town(towns: List<Town>, i: Int) -> Town:
  match list_get(towns, i):
    None => empty_town()
    Some(t) => t

fn harvest(towns: List<Town>) -> EventOutcome:
  let next = for t in towns:
    add_stock(t, Grain, 3)
  EventOutcome(towns: next, messages: ["A generous harvest adds grain across the frontier."])

fn storm(towns: List<Town>, tick: Int, seed: Int) -> EventOutcome:
  let idx = mod_int(tick + seed, len(towns))
  let target = nth_town(towns, idx)
  let next = replace_town(towns, set_prosperity(target, target.state.prosperity - 2))
  EventOutcome(towns: next, messages: ["A storm damages stores in " + target.name + "."])

fn caravan(towns: List<Town>, tick: Int, seed: Int) -> EventOutcome:
  let idx = mod_int(tick * 3 + seed, len(towns))
  let target = nth_town(towns, idx)
  let next = replace_town(towns, add_stock(add_stock(target, Timber, 2), Stone, 1))
  EventOutcome(towns: next, messages: ["A caravan reaches " + target.name + " with timber and stone."])

fn append_message(log: List<Text>, message: Text) -> List<Text>:
  let next = list_append(log, message)
  match len(next) > max_log():
    true => list_slice(next, len(next) - max_log(), max_log())
    false => next

fn append_messages(log: List<Text>, messages: List<Text>, i: Int) -> List<Text>:
  match list_get(messages, i):
    None => log
    Some(m) => append_messages(append_message(log, m), messages, i + 1)

fn append_history_values(history: List<Int>, towns: List<Town>) -> List<Int>:
  let values = for t in towns:
    t.state.prosperity
  let next = list_append(history, total(values))
  match len(next) > max_history():
    true => list_slice(next, len(next) - max_history(), max_history())
    false => next

fn reset_traffic(routes: List<Route>) -> List<Route>:
  for r in routes:
    Route(id: r.id, a: r.a, b: r.b, a_name: r.a_name, b_name: r.b_name, mode: r.mode, plan: r.plan, fee: r.fee, traffic: 0, capacity: r.capacity, upkeep: r.upkeep)

export fn tick_scaled(world: World, scale: Int) -> World:
  let towns0 = for t in world.towns:
    advance_town(t)
  let net2 = trade_pass(NetState(towns: towns0, routes: reset_traffic(world.routes)), 0, scale)
  let best = max_research(net2.towns, 0)
  let msgs_tech = tech_messages(world, best)
  let road = world.tech_road or best >= road_research()
  let river = world.tech_river or best >= river_research()
  let rail = world.tech_rail or best >= rail_research()
  let income = for r in net2.routes:
    r.traffic * r.fee
  let money2 = world.money + total(income)
  let ev1 = match mod_int(world.tick, 6) == 0:
    true => harvest(net2.towns)
    false => EventOutcome(towns: net2.towns, messages: [])
  let ev2 = match mod_int(world.tick, 9) == 0:
    true => storm(ev1.towns, world.tick, world.seed)
    false => EventOutcome(towns: ev1.towns, messages: [])
  let ev3 = match mod_int(world.tick, 11) == 0:
    true => caravan(ev2.towns, world.tick, world.seed)
    false => EventOutcome(towns: ev2.towns, messages: [])
  let log1 = append_messages(append_messages(append_messages(world.log, ev1.messages, 0), ev2.messages, 0), ev3.messages, 0)
  let log2 = append_messages(log1, msgs_tech, 0)
  World(seed: world.seed, tick: world.tick + 1, money: money2, towns: ev3.towns, sites: world.sites, routes: net2.routes, log: log2, history: append_history_values(world.history, ev3.towns), tech_road: road, tech_river: river, tech_rail: rail)

export fn tick(world: World) -> World:
  tick_scaled(world, 100)

export fn run_ticks_scaled(world: World, n: Int, scale: Int) -> World:
  match n <= 0:
    true => world
    false => run_ticks_scaled(tick_scaled(world, scale), n - 1, scale)

export fn run_ticks(world: World, n: Int) -> World:
  run_ticks_scaled(world, n, 100)

export fn position_class(x: Int, y: Int) -> Text:
  "p-" + int_text(x) + "-" + int_text(y)

fn concat_patches(xs: List<TerrainPatch>, ys: List<TerrainPatch>) -> List<TerrainPatch>:
  match len(xs) == 0:
    true => ys
    false => concat_patches(list_slice(xs, 1, len(xs) - 1), list_append(ys, nth_patch(xs, 0)))

fn nth_patch(xs: List<TerrainPatch>, i: Int) -> TerrainPatch:
  match list_get(xs, i):
    Some(p) => p
    None => TerrainPatch(key: "", position: "", css: "")

fn flatten_patches(xs: List<List<TerrainPatch>>, i: Int, acc: List<TerrainPatch>) -> List<TerrainPatch>:
  match list_get(xs, i):
    None => acc
    Some(row) => flatten_patches(xs, i + 1, concat_patches(acc, row))

export fn terrain_rows(world: World) -> List<TerrainRow>:
  for y in indices(map_h()):
    let groups = for x in indices(map_w()):
      let t = terrain_at(world.seed, x, y)
      match is_plain(t):
        true => []
        false => [position_class(x, y) + " " + terrain_class(t)]
    let patches = flatten_texts(groups, 0, [])
    TerrainRow(y: y, patches: patches)

fn flatten_texts(xs: List<List<Text>>, i: Int, acc: List<Text>) -> List<Text>:
  match list_get(xs, i):
    None => acc
    Some(row) => flatten_texts(xs, i + 1, concat_lists(acc, row))

fn is_plain(t: Terrain) -> Bool:
  match t:
    Plains => true
    Forest => true
    _ => false

fn node_css(mode: Int) -> Text:
  match mode == 1:
    true => "rn-path"
    false => match mode == 2:
      true => "rn-road"
      false => match mode == 3:
        true => "rn-river"
        false => match mode == 4:
          true => "rn-rail"
          false => "rn-path"

fn angle_sector(ax: Int, ay: Int) -> Int:
  match ay * 5 <= ax:
    true => 0
    false => match ay * 3 <= ax * 2:
      true => 1
      false => match ay * 2 <= ax * 3:
        true => 2
        false => match ay <= ax * 5:
          true => 3
          false => 4

fn angle_class(dx: Int, dy: Int) -> Text:
  let sector = angle_sector(abs_int(dx), abs_int(dy))
  let index = match dx >= 0:
    true => match dy >= 0:
      true => sector
      false => 16 - sector
    false => match dy >= 0:
      true => 8 - sector
      false => 8 + sector
  let normalized = match index >= 16:
    true => 0
    false => index
  match normalized == 0:
    true => "a0"
    false => match normalized == 1:
      true => "a1"
      false => match normalized == 2:
        true => "a2"
        false => match normalized == 3:
          true => "a3"
          false => match normalized == 4:
            true => "a4"
            false => match normalized == 5:
              true => "a5"
              false => match normalized == 6:
                true => "a6"
                false => match normalized == 7:
                  true => "a7"
                  false => match normalized == 8:
                    true => "a8"
                    false => match normalized == 9:
                      true => "a9"
                      false => match normalized == 10:
                        true => "a10"
                        false => match normalized == 11:
                          true => "a11"
                          false => match normalized == 12:
                            true => "a12"
                            false => match normalized == 13:
                              true => "a13"
                              false => match normalized == 14:
                                true => "a14"
                                false => "a15"

fn length_class(n: Int) -> Text:
  match n <= 1:
    true => "l1"
    false => match n == 2:
      true => "l2"
      false => match n == 3:
        true => "l3"
        false => match n == 4:
          true => "l4"
          false => match n == 5:
            true => "l5"
            false => match n == 6:
              true => "l6"
              false => match n == 7:
                true => "l7"
                false => match n == 8:
                  true => "l8"
                  false => match n == 9:
                    true => "l9"
                    false => match n == 10:
                      true => "l10"
                      false => match n == 11:
                        true => "l11"
                        false => "l12"

fn delta_class(dx: Int, dy: Int) -> Text:
  "d-" + int_text(dx) + "-" + int_text(dy)

fn segment_nodes(a: Point, b: Point, seg: Int, rid: Text, css: Text) -> List<RouteNode>:
  let dx = b.x - a.x
  let dy = b.y - a.y
  match dx == 0 and dy == 0:
    true => []
    false => [RouteNode(key: rid + "-" + int_text(seg), position: position_class(a.x, a.y), css: css + " " + delta_class(dx, dy))]

fn path_nodes(path: List<Point>, seg: Int, rid: Text, css: Text) -> List<RouteNode>:
  match list_get(path, seg):
    None => []
    Some(a) => match list_get(path, seg + 1):
      None => []
      Some(b) => concat_nodes(segment_nodes(a, b, seg, rid, css), path_nodes(path, seg + 1, rid, css))

fn concat_nodes(xs: List<RouteNode>, ys: List<RouteNode>) -> List<RouteNode>:
  match len(xs) == 0:
    true => ys
    false => list_append(concat_nodes(list_slice(xs, 1, len(xs) - 1), ys), nth_node(xs, 0))

fn nth_node(xs: List<RouteNode>, i: Int) -> RouteNode:
  match list_get(xs, i):
    Some(n) => n
    None => RouteNode(key: "", position: "", css: "")

export fn route_groups(routes: List<Route>) -> List<RouteNodeGroup>:
  for r in routes:
    RouteNodeGroup(key: r.id, nodes: path_nodes(r.plan.path, 0, r.id, node_css(route_mode_code(r.mode))))

export fn draft_nodes(plan: RoutePlan, ready: Bool) -> List<RouteNode>:
  match ready:
    true => path_nodes(plan.path, 0, "draft", "rn-draft")
    false => []

# ---------------------------------------------------------------- selection and game

export fn empty_selection() -> Selection:
  Selection(selected: "", from: "", to: "", draft: empty_plan(), ready: false, routing: false, notice: "Click any settlement or site to inspect it. Use Survey route in the inspector to begin a route.")

fn selection_with(sel: Selection, selected: Text, from: Text, to: Text, draft: RoutePlan, ready: Bool, routing: Bool, notice: Text) -> Selection:
  Selection(selected: selected, from: from, to: to, draft: draft, ready: ready, routing: routing, notice: notice)

export fn selection_pick(world: World, sel: Selection, id: Text) -> Selection:
  let t = find_town(world.towns, id)
  let name = marker_name(world, id)
  match t.id == "":
    true =>
      let s = find_site(world.sites, id)
      let notice = match s.id == "":
        true => "Nothing is here."
        false => s.name + " · " + good_name(s.resource) + " site · richness " + int_text(s.richness) + ". Route a line within one tile to found it."
      selection_with(sel, id, sel.from, sel.to, sel.draft, sel.ready, sel.routing, notice)
    false => match sel.routing:
      false => selection_with(sel, id, "", "", empty_plan(), false, false, name + " selected. Use Survey route in the inspector to begin.")
      true => selection_pick_town(world, sel, id, name)

fn selection_pick_town(world: World, sel: Selection, id: Text, name: Text) -> Selection:
  match sel.from == "":
    true => selection_with(sel, id, id, "", empty_plan(), false, true, "Origin: " + name + ". Click a destination to survey a route.")
    false => match sel.from == id:
      true => selection_with(sel, id, "", "", empty_plan(), false, false, "Route selection cleared.")
      false => match sel.to == "":
        true => match len(world.routes) >= max_routes():
          true => selection_with(sel, id, "", "", empty_plan(), false, false, "Three trunk routes already exist. Dismantle one before surveying another.")
          false => selection_with(sel, id, sel.from, id, empty_plan(), false, true, "Surveying route...")
        false => selection_with(sel, id, id, "", empty_plan(), false, true, "Origin moved to " + name + ". Click a destination.")

export fn selection_start(world: World, sel: Selection) -> Selection:
  let t = find_town(world.towns, sel.selected)
  match t.id == "":
    true => selection_with(sel, sel.selected, sel.from, sel.to, sel.draft, sel.ready, sel.routing, "Select a settlement before starting a route survey.")
    false => selection_with(sel, sel.selected, sel.selected, "", empty_plan(), false, true, "Origin: " + t.name + ". Click a destination to survey a route.")

export fn selection_bend(world: World, sel: Selection, delta: Int) -> Selection:
  match sel.ready:
    false => sel
    true =>
      let base = match sel.draft.bend >= auto_bend():
        true => 0
        false => sel.draft.bend
      let bend = clamp(base + delta, -5, 5)
      let plan = plan_route_bend(world, sel.from, sel.to, bend)
      selection_with(sel, sel.selected, sel.from, sel.to, plan, plan.length > 0, true, "Route shape: bend " + int_text(bend) + ". " + int_text(plan.length) + " leagues, " + int_text(plan.money) + " crowns.")

export fn selection_auto_shape(world: World, sel: Selection) -> Selection:
  match sel.ready:
    false => sel
    true =>
      let plan = plan_route(world, sel.from, sel.to)
      selection_with(sel, sel.selected, sel.from, sel.to, plan, true, true, "Route shape reset to the terrain survey.")

export fn selection_cancel(sel: Selection) -> Selection:
  empty_selection()

fn route_project_count(projects: List<Project>) -> Int:
  let flags = for p in projects:
    bool_int(p.kind == "route")
  total(flags)

fn has_project_for(projects: List<Project>, id: Text) -> Bool:
  let flags = for p in projects:
    bool_int(p.route_id == id or p.id == id)
  total(flags) > 0

export fn can_build_plan(world: World, projects: List<Project>, from: Text, to: Text, plan: RoutePlan, ready: Bool) -> Bool:
  let slots = len(world.routes) + route_project_count(projects)
  ready and slots < max_routes() and len(projects) < max_projects() and not has_project_for(projects, from + "-" + to) and world.money >= plan.money and combined_stock(world, from, to, Timber) >= plan.timber and combined_stock(world, from, to, Stone) >= plan.stone and not route_exists(world.routes, from, to, 0)

export fn can_build_route(game: Game) -> Bool:
  can_build_plan(game.world, game.projects, game.sel.from, game.sel.to, game.sel.draft, game.sel.ready)

export fn build_blocker_plan(world: World, projects: List<Project>, from: Text, to: Text, plan: RoutePlan, ready: Bool) -> Text:
  let slots = len(world.routes) + route_project_count(projects)
  match ready:
    false => "Survey a route first."
    true => match len(projects) >= max_projects():
      true => "Two construction projects are already active. Wait for one to finish."
      false => match has_project_for(projects, from + "-" + to):
        true => "A route between these settlements is already under construction."
        false => match slots >= max_routes():
          true => "Three trunk routes are already built or under construction."
          false => match route_exists(world.routes, from, to, 0):
            true => "A route already connects these settlements."
            false => match world.money < plan.money:
              true => "Need " + int_text(plan.money) + " crowns; treasury has " + int_text(world.money) + "."
              false => match combined_stock(world, from, to, Timber) < plan.timber:
                true => "Need " + int_text(plan.timber) + " timber at the endpoints."
                false => match combined_stock(world, from, to, Stone) < plan.stone:
                  true => "Need " + int_text(plan.stone) + " stone at the endpoints."
                  false => "Ready to start construction."

export fn build_blocker(game: Game) -> Text:
  build_blocker_plan(game.world, game.projects, game.sel.from, game.sel.to, game.sel.draft, game.sel.ready)

export fn construction_preview_plan(world: World, from: Text, to: Text, plan: RoutePlan, ready: Bool) -> Text:
  match ready:
    true => duration_text(construction_time(world, from, to, plan, Path))
    false => "-"

export fn construction_preview(game: Game) -> Text:
  construction_preview_plan(game.world, game.sel.from, game.sel.to, game.sel.draft, game.sel.ready)

export fn build_button_text_plan(world: World, projects: List<Project>, from: Text, to: Text, plan: RoutePlan, ready: Bool) -> Text:
  match ready:
    true => "Start construction · " + construction_preview_plan(world, from, to, plan, ready)
    false => "Start construction"

export fn build_button_text(game: Game) -> Text:
  build_button_text_plan(game.world, game.projects, game.sel.from, game.sel.to, game.sel.draft, game.sel.ready)

export fn can_start_upgrade(game: Game, route: Route) -> Bool:
  len(game.projects) < max_projects() and not has_project_for(game.projects, route.id) and can_upgrade(game.world, route)

fn next_route_mode(mode: RouteMode) -> RouteMode:
  match mode:
    Path => Road
    Road => River
    River => Rail
    _ => Rail

export fn upgrade_time_text(game: Game, route: Route) -> Text:
  duration_text(construction_time(game.world, route.a, route.b, route.plan, next_route_mode(route.mode)))

export fn project_remaining(p: Project, tick: Int) -> Int:
  max_int(0, p.ready_tick - tick)

export fn project_title(p: Project) -> Text:
  p.a_name + " → " + p.b_name

export fn project_action_text(p: Project) -> Text:
  match p.kind == "route":
    true => "new " + route_text(p.mode)
    false => "upgrade to " + route_text(p.mode)

fn route_rows(routes: List<Route>) -> List<List<Int>>:
  for y in indices(map_h()):
    for x in indices(map_w()):
      route_at_cell(routes, x, y)

fn route_at_cell(routes: List<Route>, x: Int, y: Int) -> Int:
  best_route_code(routes, x, y, 0, 0)

fn first_selection(world: World) -> Selection:
  Selection(selected: "t0", from: "", to: "", draft: empty_plan(), ready: false, routing: false, notice: "Riverford is selected. Click any settlement or site to inspect it, or use Survey route to begin.")

export fn new_game(seed: Int) -> Game:
  let world = new_world(seed)
  Game(world: world, sel: first_selection(world), notice: "New world generated. Connect complementary settlements to start the economy.", last_ok: true, route_groups: route_groups(world.routes), auto_upkeep: false, last_paid_tick: 0, upkeep_per_cycle: total_upkeep(world.routes), projects: [], inspect: inspect_view(world, "t0"))

export fn game_pick(game: Game, id: Text) -> Game:
  let sel = selection_pick(game.world, game.sel, id)
  Game(world: game.world, sel: sel, notice: sel.notice, last_ok: game.last_ok, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: inspect_view(game.world, sel.selected))

export fn game_cancel(game: Game) -> Game:
  Game(world: game.world, sel: empty_selection(), notice: "Route selection cleared.", last_ok: game.last_ok, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: empty_inspect_view())

export fn game_start_route(game: Game) -> Game:
  let sel = selection_start(game.world, game.sel)
  Game(world: game.world, sel: sel, notice: sel.notice, last_ok: game.last_ok, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: inspect_view(game.world, sel.selected))

export fn game_bend(game: Game, delta: Int) -> Game:
  let sel = selection_bend(game.world, game.sel, delta)
  Game(world: game.world, sel: sel, notice: sel.notice, last_ok: game.last_ok, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: game.inspect)

export fn game_auto_shape(game: Game) -> Game:
  let sel = selection_auto_shape(game.world, game.sel)
  Game(world: game.world, sel: sel, notice: sel.notice, last_ok: game.last_ok, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: game.inspect)

fn drop_projects(projects: List<Project>, id: Text, i: Int, acc: List<Project>) -> List<Project>:
  match i >= len(projects):
    true => list_reverse(acc)
    false =>
      let p = match list_get(projects, i):
        Some(v) => v
        None => empty_project()
      match p.route_id == id or p.id == id:
        true => drop_projects(projects, id, i + 1, acc)
        false => drop_projects(projects, id, i + 1, list_append(acc, p))

export fn game_build(game: Game) -> Game:
  let result = begin_route(game.world, game.sel.from, game.sel.to, game.sel.draft)
  match result.ok:
    false => Game(world: game.world, sel: game.sel, notice: result.message, last_ok: false, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: game.inspect)
    true =>
      let next_sel = Selection(selected: game.sel.to, from: "", to: "", draft: empty_plan(), ready: false, routing: false, notice: "")
      Game(world: result.world, sel: next_sel, notice: result.message, last_ok: true, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: list_append(game.projects, result.project), inspect: inspect_view(result.world, next_sel.selected))

export fn game_upgrade(game: Game, id: Text) -> Game:
  let result = begin_upgrade(game.world, id)
  match result.ok:
    false => Game(world: game.world, sel: game.sel, notice: result.message, last_ok: false, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: game.inspect)
    true => Game(world: result.world, sel: game.sel, notice: result.message, last_ok: true, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: list_append(game.projects, result.project), inspect: inspect_view(result.world, game.sel.selected))

export fn game_demolish(game: Game, id: Text) -> Game:
  let result = demolish_route(game.world, id)
  let projects = drop_projects(game.projects, id, 0, [])
  Game(world: result.world, sel: game.sel, notice: result.message, last_ok: result.ok, route_groups: route_groups(result.world.routes), auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: total_upkeep(result.world.routes), projects: projects, inspect: inspect_view(result.world, game.sel.selected))

export fn game_use_alt(game: Game, idx: Int) -> Game:
  let plans = survey_alternatives(game.world, game.sel.from, game.sel.to)
  match list_get(plans, idx):
    None => game
    Some(p) =>
      let sel = selection_with(game.sel, game.sel.selected, game.sel.from, game.sel.to, p, p.length > 0, true, "Corridor " + int_text(idx + 1) + ": " + int_text(p.length) + " leagues, " + int_text(p.money) + " crowns.")
      Game(world: game.world, sel: sel, notice: sel.notice, last_ok: game.last_ok, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: game.inspect)

fn project_by_id(projects: List<Project>, id: Text, i: Int) -> Project:
  match list_get(projects, i):
    None => empty_project()
    Some(p) => match p.id == id:
      true => p
      false => project_by_id(projects, id, i + 1)

fn refund_pct(p: Project, tick: Int) -> Int:
  let total = p.ready_tick - p.start_tick
  let remaining = p.ready_tick - tick
  match total <= 0:
    true => 0
    false => clamp(remaining * 100 / total, 0, 100)

fn refund_route_project(world: World, p: Project, pct: Int) -> World:
  let money = world.money + p.plan.money * pct / 100
  let timber = p.plan.timber * pct / 100
  let stone = p.plan.stone * pct / 100
  let ta = find_town(world.towns, p.a)
  let ta2 = add_stock(ta, Timber, timber)
  let ta3 = add_stock(ta2, Stone, stone)
  let towns = replace_town(world.towns, ta3)
  set_money(with_towns(world, towns), money)

fn refund_upgrade_project(world: World, p: Project, pct: Int) -> World:
  let cost = match p.mode:
    Road => 35
    River => 60
    Rail => 90
    _ => 0
  let money = world.money + cost * pct / 100
  let towns = match p.mode:
    Road => add_stock(find_town(world.towns, p.a), Stone, 2 * pct / 100)
    River => add_stock(find_town(world.towns, p.a), Timber, 4 * pct / 100)
    Rail => add_stock(add_stock(find_town(world.towns, p.a), Stone, 4 * pct / 100), Tools, 2 * pct / 100)
    _ => find_town(world.towns, p.a)
  set_money(with_towns(world, replace_town(world.towns, towns)), money)

export fn game_cancel_project(game: Game, id: Text) -> Game:
  let p = project_by_id(game.projects, id, 0)
  match p.id == "":
    true => Game(world: game.world, sel: game.sel, notice: "Project not found.", last_ok: false, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: game.inspect)
    false => match p.ready_tick <= game.world.tick:
      true => Game(world: game.world, sel: game.sel, notice: "That project is already complete.", last_ok: false, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: game.inspect)
      false =>
        let pct = refund_pct(p, game.world.tick)
        let world2 = match p.kind == "route":
          true => refund_route_project(game.world, p, pct)
          false => refund_upgrade_project(game.world, p, pct)
        let projects = drop_projects(game.projects, id, 0, [])
        Game(world: world2, sel: game.sel, notice: "Cancelled " + p.a_name + " to " + p.b_name + ". Refunded " + int_text(pct) + "% of costs.", last_ok: true, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: projects, inspect: inspect_view(world2, game.sel.selected))

export fn game_fee(game: Game, id: Text, delta: Int) -> Game:
  Game(world: adjust_fee(game.world, id, delta), sel: game.sel, notice: "Toll adjusted on the selected route.", last_ok: true, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: game.inspect)

export fn upkeep_due(game: Game) -> Int:
  match game.auto_upkeep:
    true => 0
    false => game.upkeep_per_cycle * max_int(0, game.world.tick / hours_per_week() - game.last_paid_tick / hours_per_week())

export fn neglect_ticks(game: Game) -> Int:
  match game.auto_upkeep:
    true => 0
    false => max_int(0, game.world.tick / hours_per_week() - game.last_paid_tick / hours_per_week())

fn refresh_inspect_light(world: World, id: Text, iv: InspectView) -> InspectView:
  let t = find_town(world.towns, id)
  match t.id == "":
    true => empty_inspect_view()
    false =>
      let goods_now = for g in goods():
        stock(t, g)
      InspectView(ready: true, is_site: false, name: t.name, status: status_text(t), tone: status_tone(t), resource: "", richness: 0, founded: false, pop: t.state.pop, prosperity: t.state.prosperity, research: t.state.research, terrain: terrain_name(t.terrain), value: market_value(t), insight: iv.insight, shortages: iv.shortages, connected: connected_routes(world, t.id), goods: goods_now, needs: iv.needs, endows: iv.endows)

export fn game_tick(game: Game, n: Int) -> Game:
  let before = game.world.tick
  let unpaid = neglect_ticks(game)
  let scale = match game.auto_upkeep:
    true => 100
    false => match unpaid >= 2:
      true => 50
      false => 100
  let ticked = run_ticks_scaled(game.world, n, scale)
  let outcome = match len(game.projects) == 0:
    true => ProjectOutcome(world: ticked, projects: [], messages: [])
    false => advance_projects(ticked, game.projects, 0, [], [])
  let world_after = outcome.world
  let completed = len(outcome.messages) > 0
  let groups = match completed:
    true => route_groups(world_after.routes)
    false => game.route_groups
  let upkeep = match completed:
    true => total_upkeep(world_after.routes)
    false => game.upkeep_per_cycle
  let money2 = match game.auto_upkeep:
    true => world_after.money - game.upkeep_per_cycle * n
    false => world_after.money
  let world2 = match game.auto_upkeep:
    true => set_money(world_after, money2)
    false => world_after
  let paid_tick = match completed:
    true => world2.tick
    false => match game.auto_upkeep:
      true => world2.tick
      false => game.last_paid_tick
  let base = "Advanced " + duration_text(world_after.tick - before) + ". " + calendar_text(world_after) + "."
  let extra = match completed:
    true => " " + join_nonempty(outcome.messages, 0, "")
    false => ""
  Game(world: world2, sel: game.sel, notice: base + extra, last_ok: true, route_groups: groups, auto_upkeep: game.auto_upkeep, last_paid_tick: paid_tick, upkeep_per_cycle: upkeep, projects: outcome.projects, inspect: game.inspect)

export fn game_pay_upkeep(game: Game) -> Game:
  let due = upkeep_due(game)
  match due <= 0:
    true => Game(world: game.world, sel: game.sel, notice: "No upkeep is due.", last_ok: true, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: game.inspect)
    false => match game.world.money < due:
      true => Game(world: game.world, sel: game.sel, notice: "The treasury cannot cover " + int_text(due) + " crowns of upkeep.", last_ok: false, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: game.inspect)
      false => Game(world: set_money(game.world, game.world.money - due), sel: game.sel, notice: "Paid " + int_text(due) + " crowns of upkeep. Routes are maintained.", last_ok: true, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.world.tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: game.inspect)

export fn game_refresh(game: Game) -> Game:
  Game(world: game.world, sel: game.sel, notice: "Inspector refreshed.", last_ok: true, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: inspect_view(game.world, game.sel.selected))

export fn game_toggle_auto(game: Game) -> Game:
  let on = not game.auto_upkeep
  let notice = match on:
    true => "Automatic upkeep enabled. Future upkeep is deducted each cycle."
    false => "Automatic upkeep disabled. Pay upkeep manually to keep routes in condition."
  let paid_tick = match on:
    true => game.world.tick
    false => game.last_paid_tick
  Game(world: game.world, sel: game.sel, notice: notice, last_ok: true, route_groups: game.route_groups, auto_upkeep: on, last_paid_tick: paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: game.inspect)

export fn maintenance_text(game: Game) -> Text:
  match game.auto_upkeep:
    true => "automatic"
    false => match neglect_ticks(game) >= 2:
      true => "degraded"
      false => match upkeep_due(game) > 0:
        true => "due"
        false => "maintained"

export fn maintenance_tone(game: Game) -> Text:
  match game.auto_upkeep:
    true => "ok"
    false => match neglect_ticks(game) >= 2:
      true => "bad"
      false => match upkeep_due(game) > 0:
        true => "warn"
        false => "good"

export fn auto_text(on: Bool) -> Text:
  match on:
    true => "on"
    false => "off"

export fn game_new_seed(game: Game) -> Game:
  let seed = mod_int(game.world.seed + 1, map_count())
  let world = new_world(seed)
  Game(world: world, sel: first_selection(world), notice: "Generated world " + int_text(seed) + ".", last_ok: true, route_groups: route_groups(world.routes), auto_upkeep: false, last_paid_tick: 0, upkeep_per_cycle: total_upkeep(world.routes), projects: [], inspect: inspect_view(world, "t0"))


fn nth_int_list(xs: List<List<Int>>, i: Int) -> List<Int>:
  match list_get(xs, i):
    Some(v) => v
    None => []

# ---------------------------------------------------------------- server bridge

export fn server_game(world: World, projects: List<Project>, auto_upkeep: Bool, last_paid_tick: Int, upkeep_per_cycle: Int, sel: Selection, notice: Text, last_ok: Bool) -> Game:
  Game(world: world, sel: sel, notice: notice, last_ok: last_ok, route_groups: route_groups(world.routes), auto_upkeep: auto_upkeep, last_paid_tick: last_paid_tick, upkeep_per_cycle: upkeep_per_cycle, projects: projects, inspect: inspect_view(world, sel.selected))

export fn raw_game(world: World, projects: List<Project>, auto_upkeep: Bool, last_paid_tick: Int, upkeep_per_cycle: Int, sel: Selection, notice: Text, last_ok: Bool) -> Game:
  Game(world: world, sel: sel, notice: notice, last_ok: last_ok, route_groups: [], auto_upkeep: auto_upkeep, last_paid_tick: last_paid_tick, upkeep_per_cycle: upkeep_per_cycle, projects: projects, inspect: empty_inspect_view())

export fn survey_selection(world: World, from: Text, to: Text, bend: Int) -> Selection:
  let plan = plan_route_bend(world, from, to, bend)
  Selection(selected: to, from: from, to: to, draft: plan, ready: plan.length > 0, routing: true, notice: "")

export fn survey_selection_plan(from: Text, to: Text, plan: RoutePlan) -> Selection:
  Selection(selected: to, from: from, to: to, draft: plan, ready: plan.length > 0, routing: true, notice: "")

export fn server_apply(base: Game, fresh: Game) -> Game:
  Game(world: fresh.world, sel: base.sel, notice: fresh.notice, last_ok: fresh.last_ok, route_groups: route_groups(fresh.world.routes), auto_upkeep: fresh.auto_upkeep, last_paid_tick: fresh.last_paid_tick, upkeep_per_cycle: fresh.upkeep_per_cycle, projects: fresh.projects, inspect: inspect_view(fresh.world, base.sel.selected))

export fn server_adopt(fresh: Game) -> Game:
  Game(world: fresh.world, sel: fresh.sel, notice: fresh.notice, last_ok: fresh.last_ok, route_groups: route_groups(fresh.world.routes), auto_upkeep: fresh.auto_upkeep, last_paid_tick: fresh.last_paid_tick, upkeep_per_cycle: fresh.upkeep_per_cycle, projects: fresh.projects, inspect: inspect_view(fresh.world, fresh.sel.selected))

# Replace only the survey draft, keeping the loaded world. The preview RPC
# returns a compact RoutePlan instead of a whole Game, which keeps the browser
# event inside its managed-value budget.
export fn game_with_plan(game: Game, from: Text, to: Text, plan: RoutePlan) -> Game:
  Game(world: game.world, sel: survey_selection_plan(from, to, plan), notice: "", last_ok: true, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: game.inspect)

export fn empty_game() -> Game:
  let world = World(seed: 7, tick: 0, money: 0, towns: [], sites: [], routes: [], log: [], history: [], tech_road: false, tech_river: false, tech_rail: false)
  server_game(world, [], false, 0, 0, empty_selection(), "Sign in to load your world.", true)

# ---------------------------------------------------------------- period settlement

export fn with_tick(world: World, tick: Int) -> World:
  World(seed: world.seed, tick: tick, money: world.money, towns: world.towns, sites: world.sites, routes: world.routes, log: world.log, history: world.history, tech_road: world.tech_road, tech_river: world.tech_river, tech_rail: world.tech_rail)

fn period_good(t: Town, i: Int, days: Int, can_tools: Bool, can_cloth: Bool, grain_eaten: Int, fish_eaten: Int, cloth_used: Int) -> Int:
  let grain_at = good_index(Grain)
  let timber_at = good_index(Timber)
  let stone_at = good_index(Stone)
  let ore_at = good_index(Ore)
  let fiber_at = good_index(Fiber)
  let tools_at = good_index(Tools)
  let cloth_at = good_index(Cloth)
  let fish_at = good_index(Fish)
  let raw = nth_int(t.state.stock, i) + endowment(t, nth_good(i)) * days
  let prod_value = match can_tools and (i == timber_at or i == stone_at or i == ore_at):
    true => raw - days
    false => match can_tools and i == tools_at:
      true => raw + days
      false => match can_cloth and i == fiber_at:
        true => raw - days
        false => match can_cloth and i == cloth_at:
          true => raw + days
          false => raw
  match i == grain_at:
    true => max_int(prod_value - grain_eaten, 0)
    false => match i == fish_at:
      true => max_int(prod_value - fish_eaten, 0)
      false => match i == cloth_at:
        true => max_int(prod_value - cloth_used, 0)
        false => prod_value

fn period_after(t: Town, days: Int) -> List<Int>:
  let timber_at = good_index(Timber)
  let stone_at = good_index(Stone)
  let ore_at = good_index(Ore)
  let fiber_at = good_index(Fiber)
  let cloth_at = good_index(Cloth)
  let grain_at = good_index(Grain)
  let fish_at = good_index(Fish)
  let timber_base = nth_int(t.state.stock, timber_at) + endowment(t, Timber) * days
  let stone_base = nth_int(t.state.stock, stone_at) + endowment(t, Stone) * days
  let ore_base = nth_int(t.state.stock, ore_at) + endowment(t, Ore) * days
  let fiber_base = nth_int(t.state.stock, fiber_at) + endowment(t, Fiber) * days
  let can_tools = timber_base >= days and stone_base >= days and ore_base >= days
  let can_cloth = fiber_base >= days
  let grain_prod = nth_int(t.state.stock, grain_at) + endowment(t, Grain) * days
  let fish_prod = nth_int(t.state.stock, fish_at) + endowment(t, Fish) * days
  let cloth_prod = nth_int(t.state.stock, cloth_at) + endowment(t, Cloth) * days + match can_cloth:
    true => days
    false => 0
  let grain_eaten = min_int(grain_prod, t.state.pop * days)
  let fish_eaten = min_int(fish_prod, (t.state.pop / 3 + 1) * days)
  let cloth_used = min_int(cloth_prod, (t.state.pop / 4) * days)
  for i in indices(len(goods())):
    period_good(t, i, days, can_tools, can_cloth, grain_eaten, fish_eaten, cloth_used)

fn growth_stock(after: List<Int>) -> List<Int>:
  let grain_at = good_index(Grain)
  let timber_at = good_index(Timber)
  let stone_at = good_index(Stone)
  for i in indices(len(after)):
    match i == grain_at:
      true => max_int(nth_int(after, i) - 2, 0)
      false => match i == timber_at or i == stone_at:
        true => max_int(nth_int(after, i) - 1, 0)
        false => nth_int(after, i)

fn period_keep(t: Town, after: List<Int>, prosperity: Int, research: Int) -> Town:
  Town(id: t.id, name: t.name, x: t.x, y: t.y, terrain: t.terrain, endow: t.endow, state: TownState(pop: t.state.pop, prosperity: prosperity, research: research, stock: after))

fn period_grow(t: Town, after: List<Int>, prosperity: Int, research: Int) -> Town:
  let final = growth_stock(after)
  Town(id: t.id, name: t.name, x: t.x, y: t.y, terrain: t.terrain, endow: t.endow, state: TownState(pop: t.state.pop + 1, prosperity: clamp(prosperity - 1, 0, 30), research: research, stock: final))

fn period_shrink(t: Town, after: List<Int>, prosperity: Int, research: Int) -> Town:
  Town(id: t.id, name: t.name, x: t.x, y: t.y, terrain: t.terrain, endow: t.endow, state: TownState(pop: t.state.pop - 1, prosperity: clamp(prosperity - 1, 0, 30), research: research, stock: after))

fn period_cloth_used(t: Town, days: Int) -> Int:
  let cloth_at = good_index(Cloth)
  let fiber_at = good_index(Fiber)
  let cloth_prod = nth_int(t.state.stock, cloth_at) + endowment(t, Cloth) * days + match nth_int(t.state.stock, fiber_at) + endowment(t, Fiber) * days >= days:
    true => days
    false => 0
  min_int(cloth_prod, (t.state.pop / 4) * days)

fn advance_town_days(t: Town, days: Int) -> Town:
  match days <= 0:
    true => t
    false =>
      let grain_at = good_index(Grain)
      let fish_at = good_index(Fish)
      let tools_at = good_index(Tools)
      let after = period_after(t, days)
      let cloth_used = period_cloth_used(t, days)
      let need_grain = t.state.pop * days
      let need_fish = (t.state.pop / 3 + 1) * days
      let grain_eaten = min_int(nth_int(t.state.stock, grain_at) + endowment(t, Grain) * days, need_grain)
      let fish_eaten = min_int(nth_int(t.state.stock, fish_at) + endowment(t, Fish) * days, need_fish)
      let fed = grain_eaten + fish_eaten * 2
      let target = need_grain + need_fish * 2
      let food = match fed >= target:
        true => 2
        false => match fed * 2 >= target:
          true => 1
          false => 0
      let score = count_positive(after, 0)
      let comfort = bool_int(nth_int(after, tools_at) > 0) + bool_int(cloth_used > 0)
      let delta = (food * 2 + min_int(score, 6) / 2 + comfort - 2) * days
      let prosperity = clamp(t.state.prosperity + delta, 0, 30)
      let research = t.state.research + (t.state.pop + score + prosperity / 6 + food) * days
      let food_now = nth_int(after, grain_at) + nth_int(after, fish_at)
      let can_grow = days >= 7 and prosperity >= 9 and food_now >= t.state.pop * 2 + 2 and nth_int(after, good_index(Timber)) >= 1 and nth_int(after, good_index(Stone)) >= 1
      match can_grow:
        true => period_grow(t, after, prosperity, research)
        false => match days >= 7 and food == 0 and t.state.pop > 1 and prosperity <= 4:
          true => period_shrink(t, after, prosperity, research)
          false => period_keep(t, after, prosperity, research)

fn trade_net_days(net: NetState, route: Route, scale: Int, days: Int) -> NetState:
  let a = find_town(net.towns, route.a)
  let b = find_town(net.towns, route.b)
  match a.id == "" or b.id == "":
    true => net
    false =>
      let cap = max_int(2, route.capacity * scale / 100 * days)
      let moves = trade_moves(a, b, route, cap)
      let result = apply_moves(a, b, moves)
      let towns = replace_town(replace_town(net.towns, result.a), result.b)
      let changed = Route(id: route.id, a: route.a, b: route.b, a_name: route.a_name, b_name: route.b_name, mode: route.mode, plan: route.plan, fee: route.fee, traffic: route.traffic + result.moved, capacity: route.capacity, upkeep: route.upkeep)
      NetState(towns: towns, routes: replace_route(net.routes, changed))

fn trade_pass_days(net: NetState, i: Int, scale: Int, days: Int) -> NetState:
  match list_get(net.routes, i):
    None => net
    Some(r) => trade_pass_days(trade_net_days(net, r, scale, days), i + 1, scale, days)

export fn market_period(world: World, days: Int, scale: Int) -> World:
  match days <= 0:
    true => world
    false =>
      let towns0 = for t in world.towns:
        advance_town_days(t, days)
      let net2 = trade_pass_days(NetState(towns: towns0, routes: reset_traffic(world.routes)), 0, scale, days)
      let income = for r in net2.routes:
        r.traffic * r.fee
      World(seed: world.seed, tick: world.tick, money: world.money + total(income), towns: net2.towns, sites: world.sites, routes: net2.routes, log: world.log, history: world.history, tech_road: world.tech_road, tech_river: world.tech_river, tech_rail: world.tech_rail)

fn boundary_in_period(start: Int, days: Int, cadence: Int) -> Bool:
  let offset = mod_int(cadence - mod_int(start, cadence), cadence)
  offset < days

export fn finish_period(world: World, days: Int, from: Int) -> World:
  match days <= 0:
    true => world
    false =>
      let best = max_research(world.towns, 0)
      let msgs_tech = tech_messages(world, best)
      let road = world.tech_road or best >= road_research()
      let river = world.tech_river or best >= river_research()
      let rail = world.tech_rail or best >= rail_research()
      let start_day = from / hours_per_day()
      let ev1 = match boundary_in_period(start_day, days, 6):
        true => harvest(world.towns)
        false => EventOutcome(towns: world.towns, messages: [])
      let ev2 = match boundary_in_period(start_day, days, 9):
        true => storm(ev1.towns, start_day, world.seed)
        false => EventOutcome(towns: ev1.towns, messages: [])
      let ev3 = match boundary_in_period(start_day, days, 11):
        true => caravan(ev2.towns, start_day, world.seed)
        false => EventOutcome(towns: ev2.towns, messages: [])
      let log1 = append_messages(append_messages(append_messages(world.log, ev1.messages, 0), ev2.messages, 0), ev3.messages, 0)
      let log2 = append_messages(log1, msgs_tech, 0)
      World(seed: world.seed, tick: world.tick, money: world.money, towns: ev3.towns, sites: world.sites, routes: world.routes, log: log2, history: append_history_values(world.history, ev3.towns), tech_road: road, tech_river: river, tech_rail: rail)

export fn game_finish_period(game: Game, days: Int, from: Int) -> Game:
  let world_events = finish_period(game.world, days, from)
  let weeks = max_int(0, world_events.tick / hours_per_week() - from / hours_per_week())
  let money2 = match game.auto_upkeep:
    true => world_events.money - game.upkeep_per_cycle * weeks
    false => world_events.money
  let world2 = set_money(world_events, money2)
  let paid_tick = match game.auto_upkeep:
    true => match weeks > 0:
      true => (world_events.tick / hours_per_week()) * hours_per_week()
      false => game.last_paid_tick
    false => game.last_paid_tick
  let notice = "Settled " + int_text(days) + " day" + match days == 1:
    true => ""
    false => "s"
  + ". " + calendar_text(world2)
  Game(world: world2, sel: game.sel, notice: notice, last_ok: true, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: game.inspect)

# ---------------------------------------------------------------- staged server tick

export fn market_stage(world: World, scale: Int) -> World:
  let towns0 = for t in world.towns:
    advance_town(t)
  let net2 = trade_pass(NetState(towns: towns0, routes: reset_traffic(world.routes)), 0, scale)
  let income = for r in net2.routes:
    r.traffic * r.fee
  World(seed: world.seed, tick: world.tick, money: world.money + total(income), towns: net2.towns, sites: world.sites, routes: net2.routes, log: world.log, history: world.history, tech_road: world.tech_road, tech_river: world.tech_river, tech_rail: world.tech_rail)

export fn finish_stage(world: World) -> World:
  let best = max_research(world.towns, 0)
  let msgs_tech = tech_messages(world, best)
  let road = world.tech_road or best >= road_research()
  let river = world.tech_river or best >= river_research()
  let rail = world.tech_rail or best >= rail_research()
  let ev1 = match mod_int(world.tick, 6) == 0:
    true => harvest(world.towns)
    false => EventOutcome(towns: world.towns, messages: [])
  let ev2 = match mod_int(world.tick, 9) == 0:
    true => storm(ev1.towns, world.tick, world.seed)
    false => EventOutcome(towns: ev1.towns, messages: [])
  let ev3 = match mod_int(world.tick, 11) == 0:
    true => caravan(ev2.towns, world.tick, world.seed)
    false => EventOutcome(towns: ev2.towns, messages: [])
  let log1 = append_messages(append_messages(append_messages(world.log, ev1.messages, 0), ev2.messages, 0), ev3.messages, 0)
  let log2 = append_messages(log1, msgs_tech, 0)
  World(seed: world.seed, tick: world.tick + 1, money: world.money, towns: ev3.towns, sites: world.sites, routes: world.routes, log: log2, history: append_history_values(world.history, ev3.towns), tech_road: road, tech_river: river, tech_rail: rail)

export fn game_market(game: Game) -> Game:
  let unpaid = neglect_ticks(game)
  let scale = match game.auto_upkeep:
    true => 100
    false => match unpaid >= 2:
      true => 50
      false => 100
  let world = market_stage(game.world, scale)
  Game(world: world, sel: game.sel, notice: "Market cleared at " + calendar_text(world) + ". Treasury " + int_text(world.money) + ".", last_ok: true, route_groups: game.route_groups, auto_upkeep: game.auto_upkeep, last_paid_tick: game.last_paid_tick, upkeep_per_cycle: game.upkeep_per_cycle, projects: game.projects, inspect: game.inspect)

export fn game_finish(game: Game) -> Game:
  let before = game.world.tick
  let world_events = finish_stage(game.world)
  let outcome = match len(game.projects) == 0:
    true => ProjectOutcome(world: world_events, projects: [], messages: [])
    false => advance_projects(world_events, game.projects, 0, [], [])
  let world_after = outcome.world
  let completed = len(outcome.messages) > 0
  let groups = match completed:
    true => route_groups(world_after.routes)
    false => game.route_groups
  let upkeep = match completed:
    true => total_upkeep(world_after.routes)
    false => game.upkeep_per_cycle
  let money2 = match game.auto_upkeep:
    true => world_after.money - game.upkeep_per_cycle
    false => world_after.money
  let world2 = match game.auto_upkeep:
    true => set_money(world_after, money2)
    false => world_after
  let paid_tick = match completed:
    true => world2.tick
    false => match game.auto_upkeep:
      true => world2.tick
      false => game.last_paid_tick
  let base = "Advanced " + duration_text(world_after.tick - before) + ". " + calendar_text(world_after) + "."
  let extra = match completed:
    true => " " + join_nonempty(outcome.messages, 0, "")
    false => ""
  Game(world: world2, sel: game.sel, notice: base + extra, last_ok: true, route_groups: groups, auto_upkeep: game.auto_upkeep, last_paid_tick: paid_tick, upkeep_per_cycle: upkeep, projects: outcome.projects, inspect: game.inspect)
