# Arteries prototype: economy, routes, fees, capacity, and events.
export enum RouteMode:
  NoRoute
  Path
  Road
  River

export type Town:
  name: Text
  gEnd: Int
  tEnd: Int
  sEnd: Int
  oEnd: Int
  fEnd: Int
  grain: Int
  timber: Int
  stone: Int
  ore: Int
  tools: Int
  fiber: Int
  cloth: Int
  pop: Int
  prosperity: Int
  research: Int

export type Pair:
  a: Town
  b: Town

export type World:
  a: Town
  b: Town
  c: Town
  d: Town
  ab: RouteMode
  ac: RouteMode
  ad: RouteMode
  bc: RouteMode
  bd: RouteMode
  cd: RouteMode
  fee_ab: Int
  fee_ac: Int
  fee_ad: Int
  fee_bc: Int
  fee_bd: Int
  fee_cd: Int
  money: Int
  tech_road: Bool
  tech_river: Bool
  tick_count: Int

export fn min_int(x: Int, y: Int) -> Int:
  match x < y:
    true => x
    false => y

export fn bool_int(b: Bool) -> Int:
  match b:
    true => 1
    false => 0

export fn route_active(route: RouteMode) -> Int:
  match route:
    NoRoute => 0
    Path => 1
    Road => 1
    River => 1

export fn route_cap(route: RouteMode) -> Int:
  match route:
    NoRoute => 0
    Path => 4
    Road => 8
    River => 12

export fn produce(t: Town) -> Town:
  let grain2 = t.grain + t.gEnd
  let timber2 = t.timber + t.tEnd
  let stone2 = t.stone + t.sEnd
  let ore2 = t.ore + t.oEnd
  let fiber2 = t.fiber + t.fEnd
  let make_tools = match timber2 >= 1 and stone2 >= 1 and ore2 >= 1:
    true => 1
    false => 0
  let make_cloth = match fiber2 >= 1:
    true => 1
    false => 0
  let timber3 = timber2 - make_tools
  let stone3 = stone2 - make_tools
  let ore3 = ore2 - make_tools
  let fiber3 = fiber2 - make_cloth
  let tools3 = t.tools + make_tools
  let cloth3 = t.cloth + make_cloth
  Town(name: t.name, gEnd: t.gEnd, tEnd: t.tEnd, sEnd: t.sEnd, oEnd: t.oEnd, fEnd: t.fEnd, grain: grain2, timber: timber3, stone: stone3, ore: ore3, tools: tools3, fiber: fiber3, cloth: cloth3, pop: t.pop, prosperity: t.prosperity, research: t.research)

export fn consume(t: Town) -> Town:
  let grain2 = t.grain - t.pop
  let prosperity2 = match grain2 >= 0:
    true => t.prosperity + 1
    false => t.prosperity - 2
  Town(name: t.name, gEnd: t.gEnd, tEnd: t.tEnd, sEnd: t.sEnd, oEnd: t.oEnd, fEnd: t.fEnd, grain: grain2, timber: t.timber, stone: t.stone, ore: t.ore, tools: t.tools, fiber: t.fiber, cloth: t.cloth, pop: t.pop, prosperity: prosperity2, research: t.research)

export fn trade(a: Town, b: Town) -> Pair:
  let surplusA = a.grain - (a.pop * 2)
  let demandB = (b.pop * 2) - b.grain
  let grain_ab = match surplusA > 0 and demandB > 0:
    true => min_int(surplusA, demandB)
    false => 0
  let surplusB = b.grain - (b.pop * 2)
  let demandA = (a.pop * 2) - a.grain
  let grain_ba = match surplusB > 0 and demandA > 0:
    true => min_int(surplusB, demandA)
    false => 0
  let grainA = a.grain - grain_ab + grain_ba
  let grainB = b.grain + grain_ab - grain_ba
  let timberTotal = a.timber + b.timber
  let stoneTotal = a.stone + b.stone
  let oreTotal = a.ore + b.ore
  let toolsTotal = a.tools + b.tools
  let fiberTotal = a.fiber + b.fiber
  let clothTotal = a.cloth + b.cloth
  let timberA = timberTotal / 2
  let stoneA = stoneTotal / 2
  let oreA = oreTotal / 2
  let toolsA = toolsTotal / 2
  let fiberA = fiberTotal / 2
  let clothA = clothTotal / 2
  let a2 = Town(name: a.name, gEnd: a.gEnd, tEnd: a.tEnd, sEnd: a.sEnd, oEnd: a.oEnd, fEnd: a.fEnd, grain: grainA, timber: timberA, stone: stoneA, ore: oreA, tools: toolsA, fiber: fiberA, cloth: clothA, pop: a.pop, prosperity: a.prosperity, research: a.research)
  let b2 = Town(name: b.name, gEnd: b.gEnd, tEnd: b.tEnd, sEnd: b.sEnd, oEnd: b.oEnd, fEnd: b.fEnd, grain: grainB, timber: timberTotal - timberA, stone: stoneTotal - stoneA, ore: oreTotal - oreA, tools: toolsTotal - toolsA, fiber: fiberTotal - fiberA, cloth: clothTotal - clothA, pop: b.pop, prosperity: b.prosperity, research: b.research)
  Pair(a: a2, b: b2)

export fn trade_if(route: RouteMode, a: Town, b: Town) -> Pair:
  match route:
    NoRoute => Pair(a: a, b: b)
    _ => trade(a, b)

export fn research(t: Town) -> Town:
  let variety = bool_int(t.timber > 0) + bool_int(t.stone > 0) + bool_int(t.ore > 0) + bool_int(t.tools > 0) + bool_int(t.fiber > 0) + bool_int(t.cloth > 0)
  let gain = t.pop * (1 + variety)
  let food_ok = bool_int(t.grain >= 0)
  let comfort = bool_int(t.tools > 0)
  let aspiration = bool_int(t.tools > 2)
  let delta = (food_ok * 2) + comfort + aspiration + variety - 2
  let prosperity2 = t.prosperity + delta
  Town(name: t.name, gEnd: t.gEnd, tEnd: t.tEnd, sEnd: t.sEnd, oEnd: t.oEnd, fEnd: t.fEnd, grain: t.grain, timber: t.timber, stone: t.stone, ore: t.ore, tools: t.tools, fiber: t.fiber, cloth: t.cloth, pop: t.pop, prosperity: prosperity2, research: t.research + gain)

export fn grow(t: Town) -> Town:
  let can_grow = match t.prosperity > 6 and t.stone >= 1 and t.timber >= 1:
    true => 1
    false => 0
  let newPop = t.pop + can_grow
  let stone2 = t.stone - can_grow
  let timber2 = t.timber - can_grow
  Town(name: t.name, gEnd: t.gEnd, tEnd: t.tEnd, sEnd: t.sEnd, oEnd: t.oEnd, fEnd: t.fEnd, grain: t.grain, timber: timber2, stone: stone2, ore: t.ore, tools: t.tools, fiber: t.fiber, cloth: t.cloth, pop: newPop, prosperity: t.prosperity, research: t.research)

export fn tick(w: World) -> World:
  let a0 = consume(produce(w.a))
  let b0 = consume(produce(w.b))
  let c0 = consume(produce(w.c))
  let d0 = consume(produce(w.d))
  let p1 = trade_if(w.ab, a0, b0)
  let a1 = p1.a
  let b1 = p1.b
  let p2 = trade_if(w.ac, a1, c0)
  let a2 = p2.a
  let c1 = p2.b
  let p3 = trade_if(w.ad, a2, d0)
  let a3 = p3.a
  let d1 = p3.b
  let p4 = trade_if(w.bc, b1, c1)
  let b2 = p4.a
  let c2 = p4.b
  let p5 = trade_if(w.bd, b2, d1)
  let b3 = p5.a
  let d2 = p5.b
  let p6 = trade_if(w.cd, c2, d2)
  let c3 = p6.a
  let d3 = p6.b
  # Capacity penalties
  let pen_ab = match route_cap(w.ab) > 0 and (a3.pop + b3.pop) > route_cap(w.ab):
    true => 1
    false => 0
  let a3p = Town(name: a3.name, gEnd: a3.gEnd, tEnd: a3.tEnd, sEnd: a3.sEnd, oEnd: a3.oEnd, fEnd: a3.fEnd, grain: a3.grain, timber: a3.timber, stone: a3.stone, ore: a3.ore, tools: a3.tools, fiber: a3.fiber, cloth: a3.cloth, pop: a3.pop, prosperity: a3.prosperity - pen_ab, research: a3.research)
  let b3p = Town(name: b3.name, gEnd: b3.gEnd, tEnd: b3.tEnd, sEnd: b3.sEnd, oEnd: b3.oEnd, fEnd: b3.fEnd, grain: b3.grain, timber: b3.timber, stone: b3.stone, ore: b3.ore, tools: b3.tools, fiber: b3.fiber, cloth: b3.cloth, pop: b3.pop, prosperity: b3.prosperity - pen_ab, research: b3.research)
  let aR = grow(research(a3p))
  let bR = grow(research(b3p))
  let cR = grow(research(c3))
  let dR = grow(research(d3))
  # Events (deterministic by tick count)
  let tc = w.tick_count + 1
  let aEvt = match (tc - (tc / 5) * 5) == 0:
    true => Town(name: aR.name, gEnd: aR.gEnd, tEnd: aR.tEnd, sEnd: aR.sEnd, oEnd: aR.oEnd, fEnd: aR.fEnd, grain: aR.grain + 5, timber: aR.timber, stone: aR.stone, ore: aR.ore, tools: aR.tools, fiber: aR.fiber, cloth: aR.cloth, pop: aR.pop, prosperity: aR.prosperity, research: aR.research)
    false => aR
  let dEvt = match (tc - (tc / 7) * 7) == 0:
    true => Town(name: dR.name, gEnd: dR.gEnd, tEnd: dR.tEnd, sEnd: dR.sEnd, oEnd: dR.oEnd, fEnd: dR.fEnd, grain: dR.grain, timber: dR.timber, stone: dR.stone, ore: dR.ore, tools: dR.tools, fiber: dR.fiber, cloth: dR.cloth, pop: dR.pop, prosperity: dR.prosperity - 2, research: dR.research)
    false => dR
  # Fees and upkeep
  let built = route_active(w.ab) + route_active(w.ac) + route_active(w.ad) + route_active(w.bc) + route_active(w.bd) + route_active(w.cd)
  let fee_income = (w.fee_ab * route_active(w.ab) * (aR.pop + bR.pop)) + (w.fee_ac * route_active(w.ac) * (aR.pop + cR.pop)) + (w.fee_ad * route_active(w.ad) * (aR.pop + dR.pop)) + (w.fee_bc * route_active(w.bc) * (bR.pop + cR.pop)) + (w.fee_bd * route_active(w.bd) * (bR.pop + dR.pop)) + (w.fee_cd * route_active(w.cd) * (cR.pop + dR.pop))
  let money2 = w.money + fee_income - built
  let max_research = aR.research
  let tech_road2 = match w.tech_road or aEvt.research >= 50 or bR.research >= 50 or cR.research >= 50 or dEvt.research >= 50:
    true => true
    false => false
  let tech_river2 = match w.tech_river or aEvt.research >= 100 or bR.research >= 100 or cR.research >= 100 or dEvt.research >= 100:
    true => true
    false => false
  World(a: aEvt, b: bR, c: cR, d: dEvt, ab: w.ab, ac: w.ac, ad: w.ad, bc: w.bc, bd: w.bd, cd: w.cd, fee_ab: w.fee_ab, fee_ac: w.fee_ac, fee_ad: w.fee_ad, fee_bc: w.fee_bc, fee_bd: w.fee_bd, fee_cd: w.fee_cd, money: money2, tech_road: tech_road2, tech_river: tech_river2, tick_count: tc)

export fn run_ticks(w: World, n: Int) -> World:
  match n <= 0:
    true => w
    false => run_ticks(tick(w), n - 1)

export fn town_line(t: Town) -> Text:
  t.name + ": pop=" + int_text(t.pop) + " grain=" + int_text(t.grain) + " timber=" + int_text(t.timber) + " stone=" + int_text(t.stone) + " ore=" + int_text(t.ore) + " tools=" + int_text(t.tools) + " fiber=" + int_text(t.fiber) + " cloth=" + int_text(t.cloth) + " prosperity=" + int_text(t.prosperity) + " research=" + int_text(t.research)

export fn world_report(label: Text, w: World) -> Text:
  label + "\\n" + town_line(w.a) + "\\n" + town_line(w.b) + "\\n" + town_line(w.c) + "\\n" + town_line(w.d) + "\\nMoney: " + int_text(w.money) + " Tick: " + int_text(w.tick_count)

export fn base_world() -> World:
  World(a: Town(name: "Riverford", gEnd: 5, tEnd: 1, sEnd: 0, oEnd: 0, fEnd: 0, grain: 0, timber: 0, stone: 0, ore: 0, tools: 0, fiber: 0, cloth: 0, pop: 2, prosperity: 0, research: 0), b: Town(name: "Hillcrest", gEnd: 0, tEnd: 1, sEnd: 2, oEnd: 3, fEnd: 1, grain: 0, timber: 0, stone: 0, ore: 0, tools: 0, fiber: 0, cloth: 0, pop: 2, prosperity: 0, research: 0), c: Town(name: "Greenvale", gEnd: 2, tEnd: 4, sEnd: 1, oEnd: 0, fEnd: 2, grain: 0, timber: 0, stone: 0, ore: 0, tools: 0, fiber: 0, cloth: 0, pop: 2, prosperity: 0, research: 0), d: Town(name: "Portmere", gEnd: 1, tEnd: 0, sEnd: 0, oEnd: 0, fEnd: 0, grain: 0, timber: 0, stone: 0, ore: 0, tools: 0, fiber: 0, cloth: 0, pop: 2, prosperity: 0, research: 0), ab: NoRoute, ac: NoRoute, ad: NoRoute, bc: NoRoute, bd: NoRoute, cd: NoRoute, fee_ab: 1, fee_ac: 1, fee_ad: 1, fee_bc: 1, fee_bd: 1, fee_cd: 1, money: 100, tech_road: false, tech_river: false, tick_count: 0)

export fn connected_world() -> World:
  World(a: Town(name: "Riverford", gEnd: 5, tEnd: 1, sEnd: 0, oEnd: 0, fEnd: 0, grain: 0, timber: 0, stone: 0, ore: 0, tools: 0, fiber: 0, cloth: 0, pop: 2, prosperity: 0, research: 0), b: Town(name: "Hillcrest", gEnd: 0, tEnd: 1, sEnd: 2, oEnd: 3, fEnd: 1, grain: 0, timber: 0, stone: 0, ore: 0, tools: 0, fiber: 0, cloth: 0, pop: 2, prosperity: 0, research: 0), c: Town(name: "Greenvale", gEnd: 2, tEnd: 4, sEnd: 1, oEnd: 0, fEnd: 2, grain: 0, timber: 0, stone: 0, ore: 0, tools: 0, fiber: 0, cloth: 0, pop: 2, prosperity: 0, research: 0), d: Town(name: "Portmere", gEnd: 1, tEnd: 0, sEnd: 0, oEnd: 0, fEnd: 0, grain: 0, timber: 0, stone: 0, ore: 0, tools: 0, fiber: 0, cloth: 0, pop: 2, prosperity: 0, research: 0), ab: Path, ac: Path, ad: Path, bc: Path, bd: Path, cd: Path, fee_ab: 1, fee_ac: 1, fee_ad: 1, fee_bc: 1, fee_bd: 1, fee_cd: 1, money: 100, tech_road: false, tech_river: false, tick_count: 0)

export fn status(t: Town) -> Text:
  match t.prosperity > 6:
    true => "thriving"
    false => match t.prosperity >= 0:
      true => "stable"
      false => "stressed"

export fn bool_text(b: Bool) -> Text:
  match b:
    true => "on"
    false => "off"

export fn route_text(r: RouteMode) -> Text:
  match r:
    NoRoute => "none"
    Path => "path"
    Road => "road"
    River => "river"

export fn tech_summary(w: World) -> Text:
  match w.tech_road:
    true => match w.tech_river:
      true => "roads + rivers"
      false => "roads"
    false => "none"

# Construction helpers
export fn build_ab(w: World) -> World:
  let can = w.money >= 20 and w.a.timber >= 2 and w.a.stone >= 1
  match can:
    true => World(a: Town(name: w.a.name, gEnd: w.a.gEnd, tEnd: w.a.tEnd, sEnd: w.a.sEnd, oEnd: w.a.oEnd, fEnd: w.a.fEnd, grain: w.a.grain, timber: w.a.timber - 2, stone: w.a.stone - 1, ore: w.a.ore, tools: w.a.tools, fiber: w.a.fiber, cloth: w.a.cloth, pop: w.a.pop, prosperity: w.a.prosperity, research: w.a.research), b: w.b, c: w.c, d: w.d, ab: Path, ac: w.ac, ad: w.ad, bc: w.bc, bd: w.bd, cd: w.cd, fee_ab: w.fee_ab, fee_ac: w.fee_ac, fee_ad: w.fee_ad, fee_bc: w.fee_bc, fee_bd: w.fee_bd, fee_cd: w.fee_cd, money: w.money - 20, tech_road: w.tech_road, tech_river: w.tech_river, tick_count: w.tick_count)
    false => w

export fn remove_ab(w: World) -> World:
  World(a: Town(name: w.a.name, gEnd: w.a.gEnd, tEnd: w.a.tEnd, sEnd: w.a.sEnd, oEnd: w.a.oEnd, fEnd: w.a.fEnd, grain: w.a.grain, timber: w.a.timber + 1, stone: w.a.stone, ore: w.a.ore, tools: w.a.tools, fiber: w.a.fiber, cloth: w.a.cloth, pop: w.a.pop, prosperity: w.a.prosperity, research: w.a.research), b: w.b, c: w.c, d: w.d, ab: NoRoute, ac: w.ac, ad: w.ad, bc: w.bc, bd: w.bd, cd: w.cd, fee_ab: w.fee_ab, fee_ac: w.fee_ac, fee_ad: w.fee_ad, fee_bc: w.fee_bc, fee_bd: w.fee_bd, fee_cd: w.fee_cd, money: w.money + 10, tech_road: w.tech_road, tech_river: w.tech_river, tick_count: w.tick_count)

export fn toggle_ab(w: World) -> World:
  match w.ab:
    NoRoute => build_ab(w)
    _ => remove_ab(w)


fn main() -> Text:
  let isolated = run_ticks(base_world(), 4)
  let connected = run_ticks(connected_world(), 4)
  world_report("ISOLATED:", isolated) + "\\n\\n" + world_report("CONNECTED:", connected)

export fn build_ac(w: World) -> World:
  let can = w.money >= 20 and w.a.timber >= 2 and w.a.stone >= 1
  match can:
    true => World(a: Town(name: w.a.name, gEnd: w.a.gEnd, tEnd: w.a.tEnd, sEnd: w.a.sEnd, oEnd: w.a.oEnd, fEnd: w.a.fEnd, grain: w.a.grain, timber: w.a.timber - 2, stone: w.a.stone - 1, ore: w.a.ore, tools: w.a.tools, fiber: w.a.fiber, cloth: w.a.cloth, pop: w.a.pop, prosperity: w.a.prosperity, research: w.a.research), b: w.b, c: w.c, d: w.d, ab: w.ab, ac: Path, ad: w.ad, bc: w.bc, bd: w.bd, cd: w.cd, fee_ab: w.fee_ab, fee_ac: w.fee_ac, fee_ad: w.fee_ad, fee_bc: w.fee_bc, fee_bd: w.fee_bd, fee_cd: w.fee_cd, money: w.money - 20, tech_road: w.tech_road, tech_river: w.tech_river, tick_count: w.tick_count)
    false => w

export fn remove_ac(w: World) -> World:
  World(a: Town(name: w.a.name, gEnd: w.a.gEnd, tEnd: w.a.tEnd, sEnd: w.a.sEnd, oEnd: w.a.oEnd, fEnd: w.a.fEnd, grain: w.a.grain, timber: w.a.timber + 1, stone: w.a.stone, ore: w.a.ore, tools: w.a.tools, fiber: w.a.fiber, cloth: w.a.cloth, pop: w.a.pop, prosperity: w.a.prosperity, research: w.a.research), b: w.b, c: w.c, d: w.d, ab: w.ab, ac: NoRoute, ad: w.ad, bc: w.bc, bd: w.bd, cd: w.cd, fee_ab: w.fee_ab, fee_ac: w.fee_ac, fee_ad: w.fee_ad, fee_bc: w.fee_bc, fee_bd: w.fee_bd, fee_cd: w.fee_cd, money: w.money + 10, tech_road: w.tech_road, tech_river: w.tech_river, tick_count: w.tick_count)

