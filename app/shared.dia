# Arteries prototype: richer economy, routes, money, and construction.
export type Town:
  name: Text
  gEnd: Int
  tEnd: Int
  sEnd: Int
  oEnd: Int
  grain: Int
  timber: Int
  stone: Int
  ore: Int
  tools: Int
  pop: Int
  prosperity: Int
  research: Int

export enum RouteMode:
  NoRoute
  Path
  Road
  River

export type Pair:
  a: Town
  b: Town

export type World:
  a: Town
  b: Town
  c: Town
  d: Town
  ab: RouteMode
  ac: RouteMode
  ad: RouteMode
  bc: RouteMode
  bd: RouteMode
  cd: RouteMode
  money: Int
  tech_road: Bool
  tech_river: Bool

export fn min_int(x: Int, y: Int) -> Int:
  match x < y:
    true => x
    false => y

export fn bool_int(b: Bool) -> Int:
  match b:
    true => 1
    false => 0

export fn produce(t: Town) -> Town:
  let grain2 = t.grain + t.gEnd
  let timber2 = t.timber + t.tEnd
  let stone2 = t.stone + t.sEnd
  let ore2 = t.ore + t.oEnd
  let make_tools = match timber2 >= 1 and stone2 >= 1 and ore2 >= 1:
    true => 1
    false => 0
  let timber3 = timber2 - make_tools
  let stone3 = stone2 - make_tools
  let ore3 = ore2 - make_tools
  let tools3 = t.tools + make_tools
  Town(name: t.name, gEnd: t.gEnd, tEnd: t.tEnd, sEnd: t.sEnd, oEnd: t.oEnd, grain: grain2, timber: timber3, stone: stone3, ore: ore3, tools: tools3, pop: t.pop, prosperity: t.prosperity, research: t.research)

export fn consume(t: Town) -> Town:
  let grain2 = t.grain - t.pop
  let prosperity2 = match grain2 >= 0:
    true => t.prosperity + 1
    false => t.prosperity - 2
  Town(name: t.name, gEnd: t.gEnd, tEnd: t.tEnd, sEnd: t.sEnd, oEnd: t.oEnd, grain: grain2, timber: t.timber, stone: t.stone, ore: t.ore, tools: t.tools, pop: t.pop, prosperity: prosperity2, research: t.research)

export fn trade(a: Town, b: Town) -> Pair:
  # Grain moves only as surplus above local food need.
  let surplusA = a.grain - (a.pop * 2)
  let demandB = (b.pop * 2) - b.grain
  let grain_ab = match surplusA > 0 and demandB > 0:
    true => min_int(surplusA, demandB)
    false => 0
  let surplusB = b.grain - (b.pop * 2)
  let demandA = (a.pop * 2) - a.grain
  let grain_ba = match surplusB > 0 and demandA > 0:
    true => min_int(surplusB, demandA)
    false => 0
  let grainA = a.grain - grain_ab + grain_ba
  let grainB = b.grain + grain_ab - grain_ba
  # Share non-food goods to spread variety and inputs.
  let timberTotal = a.timber + b.timber
  let stoneTotal = a.stone + b.stone
  let oreTotal = a.ore + b.ore
  let toolsTotal = a.tools + b.tools
  let timberA = timberTotal / 2
  let stoneA = stoneTotal / 2
  let oreA = oreTotal / 2
  let toolsA = toolsTotal / 2
  let a2 = Town(name: a.name, gEnd: a.gEnd, tEnd: a.tEnd, sEnd: a.sEnd, oEnd: a.oEnd, grain: grainA, timber: timberA, stone: stoneA, ore: oreA, tools: toolsA, pop: a.pop, prosperity: a.prosperity, research: a.research)
  let b2 = Town(name: b.name, gEnd: b.gEnd, tEnd: b.tEnd, sEnd: b.sEnd, oEnd: b.oEnd, grain: grainB, timber: timberTotal - timberA, stone: stoneTotal - stoneA, ore: oreTotal - oreA, tools: toolsTotal - toolsA, pop: b.pop, prosperity: b.prosperity, research: b.research)
  Pair(a: a2, b: b2)

export fn trade_if(route: RouteMode, a: Town, b: Town) -> Pair:
  match route:
    NoRoute => Pair(a: a, b: b)
    _ => trade(a, b)

export fn research(t: Town) -> Town:
  let variety = bool_int(t.timber > 0) + bool_int(t.stone > 0) + bool_int(t.ore > 0) + bool_int(t.tools > 0)
  let gain = t.pop * (1 + variety)
  let food_ok = bool_int(t.grain >= 0)
  let comfort = bool_int(t.tools > 0)
  let aspiration = bool_int(t.tools > 2)
  let delta = (food_ok * 2) + comfort + aspiration + variety - 2
  let prosperity2 = t.prosperity + delta
  Town(name: t.name, gEnd: t.gEnd, tEnd: t.tEnd, sEnd: t.sEnd, oEnd: t.oEnd, grain: t.grain, timber: t.timber, stone: t.stone, ore: t.ore, tools: t.tools, pop: t.pop, prosperity: prosperity2, research: t.research + gain)

export fn grow(t: Town) -> Town:
  let can_grow = match t.prosperity > 6 and t.stone >= 1 and t.timber >= 1:
    true => 1
    false => 0
  let newPop = t.pop + can_grow
  let stone2 = t.stone - can_grow
  let timber2 = t.timber - can_grow
  Town(name: t.name, gEnd: t.gEnd, tEnd: t.tEnd, sEnd: t.sEnd, oEnd: t.oEnd, grain: t.grain, timber: timber2, stone: stone2, ore: t.ore, tools: t.tools, pop: newPop, prosperity: t.prosperity, research: t.research)

export fn route_active(route: RouteMode) -> Int:
  match route:
    NoRoute => 0
    Path => 1
    Road => 1
    River => 1

export fn tick(w: World) -> World:
  let a0 = consume(produce(w.a))
  let b0 = consume(produce(w.b))
  let c0 = consume(produce(w.c))
  let d0 = consume(produce(w.d))
  let p1 = trade_if(w.ab, a0, b0)
  let a1 = p1.a
  let b1 = p1.b
  let p2 = trade_if(w.ac, a1, c0)
  let a2 = p2.a
  let c1 = p2.b
  let p3 = trade_if(w.ad, a2, d0)
  let a3 = p3.a
  let d1 = p3.b
  let p4 = trade_if(w.bc, b1, c1)
  let b2 = p4.a
  let c2 = p4.b
  let p5 = trade_if(w.bd, b2, d1)
  let b3 = p5.a
  let d2 = p5.b
  let p6 = trade_if(w.cd, c2, d2)
  let c3 = p6.a
  let d3 = p6.b
  let aR = grow(research(a3))
  let bR = grow(research(b3))
  let cR = grow(research(c3))
  let dR = grow(research(d3))
  let built = route_active(w.ab) + route_active(w.ac) + route_active(w.ad) + route_active(w.bc) + route_active(w.bd) + route_active(w.cd)
  let money2 = w.money - built
  let max_research = aR.research
  let tech_road2 = match w.tech_road or aR.research >= 50 or bR.research >= 50 or cR.research >= 50 or dR.research >= 50:
    true => true
    false => false
  let tech_river2 = match w.tech_river or aR.research >= 100 or bR.research >= 100 or cR.research >= 100 or dR.research >= 100:
    true => true
    false => false
  World(a: aR, b: bR, c: cR, d: dR, ab: w.ab, ac: w.ac, ad: w.ad, bc: w.bc, bd: w.bd, cd: w.cd, money: money2, tech_road: tech_road2, tech_river: tech_river2)

export fn run_ticks(w: World, n: Int) -> World:
  match n <= 0:
    true => w
    false => run_ticks(tick(w), n - 1)

# Construction helpers (cost: 2 timber, 1 stone, 20 money)
export fn build_ab(w: World) -> World:
  let can = w.money >= 20 and w.a.timber >= 2 and w.a.stone >= 1
  match can:
    true => World(a: Town(name: w.a.name, gEnd: w.a.gEnd, tEnd: w.a.tEnd, sEnd: w.a.sEnd, oEnd: w.a.oEnd, grain: w.a.grain, timber: w.a.timber - 2, stone: w.a.stone - 1, ore: w.a.ore, tools: w.a.tools, pop: w.a.pop, prosperity: w.a.prosperity, research: w.a.research), b: w.b, c: w.c, d: w.d, ab: Path, ac: w.ac, ad: w.ad, bc: w.bc, bd: w.bd, cd: w.cd, money: w.money - 20, tech_road: w.tech_road, tech_river: w.tech_river)
    false => w

export fn remove_ab(w: World) -> World:
  World(a: Town(name: w.a.name, gEnd: w.a.gEnd, tEnd: w.a.tEnd, sEnd: w.a.sEnd, oEnd: w.a.oEnd, grain: w.a.grain, timber: w.a.timber + 1, stone: w.a.stone, ore: w.a.ore, tools: w.a.tools, pop: w.a.pop, prosperity: w.a.prosperity, research: w.a.research), b: w.b, c: w.c, d: w.d, ab: NoRoute, ac: w.ac, ad: w.ad, bc: w.bc, bd: w.bd, cd: w.cd, money: w.money + 10, tech_road: w.tech_road, tech_river: w.tech_river)

export fn build_ac(w: World) -> World:
  let can = w.money >= 20 and w.a.timber >= 2 and w.a.stone >= 1
  match can:
    true => World(a: Town(name: w.a.name, gEnd: w.a.gEnd, tEnd: w.a.tEnd, sEnd: w.a.sEnd, oEnd: w.a.oEnd, grain: w.a.grain, timber: w.a.timber - 2, stone: w.a.stone - 1, ore: w.a.ore, tools: w.a.tools, pop: w.a.pop, prosperity: w.a.prosperity, research: w.a.research), b: w.b, c: w.c, d: w.d, ab: w.ab, ac: Path, ad: w.ad, bc: w.bc, bd: w.bd, cd: w.cd, money: w.money - 20, tech_road: w.tech_road, tech_river: w.tech_river)
    false => w

export fn remove_ac(w: World) -> World:
  World(a: Town(name: w.a.name, gEnd: w.a.gEnd, tEnd: w.a.tEnd, sEnd: w.a.sEnd, oEnd: w.a.oEnd, grain: w.a.grain, timber: w.a.timber + 1, stone: w.a.stone, ore: w.a.ore, tools: w.a.tools, pop: w.a.pop, prosperity: w.a.prosperity, research: w.a.research), b: w.b, c: w.c, d: w.d, ab: w.ab, ac: NoRoute, ad: w.ad, bc: w.bc, bd: w.bd, cd: w.cd, money: w.money + 10, tech_road: w.tech_road, tech_river: w.tech_river)

