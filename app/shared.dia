export type Route:
  id: Text
  a: Text
  b: Text
  a_name: Text
  b_name: Text
  mode: RouteMode
  plan: RoutePlan
  fee: Int
  traffic: Int
  capacity: Int
  upkeep: Int
  rules: LinkRules
  pipeline: List<Int>
  flow: List<Int>

# Per-link flow rules (design doc §5.4). `allow` holds one 0/1 entry per good in
# `goods()` order and `fee` a per-good surcharge on top of the link's base fee.
# Both lists are fixed width so a route row can store the whole policy in one
# text column; an empty column decodes to the default (everything allowed, no
# surcharge) and keeps pre-rules rows valid.
export type LinkRules:
  allow: List<Int>
  fee: List<Int>

export fn default_rules() -> LinkRules:
  LinkRules(allow: [1, 1, 1, 1, 1, 1, 1, 1], fee: [0, 0, 0, 0, 0, 0, 0, 0])

export fn rule_allows(rules: LinkRules, g: Good) -> Bool:
  nth_int(rules.allow, good_index(g)) > 0

export fn rule_allows_at(rules: LinkRules, i: Int) -> Bool:
  nth_int(rules.allow, i) > 0

export fn rule_fee_at(rules: LinkRules, i: Int) -> Int:
  nth_int(rules.fee, i)

export fn good_short_at(i: Int) -> Text:
  good_short(nth_good(i))

export fn rule_label(rules: LinkRules, i: Int) -> Text:
  match rule_allows_at(rules, i):
    true => "Allowed"
    false => "Blocked"

export fn route_rules_label(r: Route) -> Text:
  "Rules · " + int_text(total(r.rules.allow)) + "/" + int_text(len(goods())) + " goods"

# The desk sends whole lists, so accept any length and normalize the values.
export fn normalize_allow(allow: List<Int>) -> List<Int>:
  for i in indices(len(goods())):
    match nth_int(allow, i) > 0:
      true => 1
      false => 0

export fn normalize_fees(fees: List<Int>) -> List<Int>:
  for i in indices(len(goods())):
    clamp(nth_int(fees, i), 0, 99)

export fn rule_fee(rules: LinkRules, g: Good) -> Int:
  nth_int(rules.fee, good_index(g))

export fn toggle_rule_allow(allow: List<Int>, g: Int) -> List<Int>:
  for i in indices(len(allow)):
    match i == g:
      true => match nth_int(allow, i) > 0:
        true => 0
        false => 1
      false => nth_int(allow, i)

export fn adjust_rule_fee(fee: List<Int>, g: Int, delta: Int) -> List<Int>:
  for i in indices(len(fee)):
    match i == g:
      true => clamp(nth_int(fee, i) + delta, 0, 99)
      false => nth_int(fee, i)

fn pad2(value: Int) -> Text:
  zero_pad(int_text(value), 2)

export fn encode_link_rules(rules: LinkRules) -> Text:
  let allow = for i in indices(len(rules.allow)):
    int_text(nth_int(rules.allow, i))
  let fee = for i in indices(len(rules.fee)):
    pad2(nth_int(rules.fee, i))
  join_text(allow, "") + join_text(fee, "")

# In-transit consignments per route, padded to the fixed kernel width. An empty
# column decodes to an empty (zeroed) pipeline, so pre-transit rows stay valid.
export fn encode_pipeline(pipeline: List<Int>) -> Text:
  let parts = for i in indices(len(pipeline)):
    pad4(nth_int(pipeline, i))
  join_text(parts, "")

export fn decode_pipeline(text: Text) -> List<Int>:
  let count = len(text) / 4
  let groups = for i in indices(count):
    [int_of(text_slice(text, i * 4, 4))]
  flatten_ints(groups, 0, [])

# Dispatched units per good from the last trade pass. Empty means "not
# recorded", so helpers fall back to the in-transit pipeline.
export fn encode_flow(flow: List<Int>) -> Text:
  let parts = for i in indices(len(goods())):
    pad4(nth_int(flow, i))
  join_text(parts, "")

export fn decode_flow(text: Text) -> List<Int>:
  match len(text) < len(goods()) * 4:
    true => []
    false =>
      let values = for i in indices(len(goods())):
        int_of(text_slice(text, i * 4, 4))
      values

export fn flow_from_result(values: List<Int>) -> List<Int>:
  match len(values) < 65 + len(goods()):
    true => []
    false => list_slice(values, 65, len(goods()))

export fn decode_link_rules(text: Text) -> LinkRules:
  match len(text) < len(goods()) * 3:
    true => default_rules()
    false =>
      let allow = for i in indices(len(goods())):
        int_of(text_slice(text, i, 1))
      let fee = for i in indices(len(goods())):
        int_of(text_slice(text, len(goods()) + i * 2, 2))
      LinkRules(allow: allow, fee: fee)

