export fn remove_bc(w: World) -> World:
  World(a: w.a, b: Town(name: w.b.name, gEnd: w.b.gEnd, tEnd: w.b.tEnd, sEnd: w.b.sEnd, oEnd: w.b.oEnd, fEnd: w.b.fEnd, grain: w.b.grain, timber: w.b.timber + 1, stone: w.b.stone, ore: w.b.ore, tools: w.b.tools, fiber: w.b.fiber, cloth: w.b.cloth, pop: w.b.pop, prosperity: w.b.prosperity, research: w.b.research), c: w.c, d: w.d, ab: w.ab, ac: w.ac, ad: w.ad, bc: NoRoute, bd: w.bd, cd: w.cd, fee_ab: w.fee_ab, fee_ac: w.fee_ac, fee_ad: w.fee_ad, fee_bc: w.fee_bc, fee_bd: w.fee_bd, fee_cd: w.fee_cd, money: w.money + 10, tech_road: w.tech_road, tech_river: w.tech_river, tick_count: w.tick_count)

export fn toggle_bc(w: World) -> World:
  match w.bc:
    NoRoute => build_bc(w)
    _ => remove_bc(w)

export fn build_bd(w: World) -> World:
  let can = w.money >= 20 and w.b.timber >= 2 and w.b.stone >= 1
  match can:
    true => World(a: w.a, b: Town(name: w.b.name, gEnd: w.b.gEnd, tEnd: w.b.tEnd, sEnd: w.b.sEnd, oEnd: w.b.oEnd, fEnd: w.b.fEnd, grain: w.b.grain, timber: w.b.timber - 2, stone: w.b.stone - 1, ore: w.b.ore, tools: w.b.tools, fiber: w.b.fiber, cloth: w.b.cloth, pop: w.b.pop, prosperity: w.b.prosperity, research: w.b.research), c: w.c, d: w.d, ab: w.ab, ac: w.ac, ad: w.ad, bc: w.bc, bd: Path, cd: w.cd, fee_ab: w.fee_ab, fee_ac: w.fee_ac, fee_ad: w.fee_ad, fee_bc: w.fee_bc, fee_bd: w.fee_bd, fee_cd: w.fee_cd, money: w.money - 20, tech_road: w.tech_road, tech_river: w.tech_river, tick_count: w.tick_count)
    false => w

export fn remove_bd(w: World) -> World:
  World(a: w.a, b: Town(name: w.b.name, gEnd: w.b.gEnd, tEnd: w.b.tEnd, sEnd: w.b.sEnd, oEnd: w.b.oEnd, fEnd: w.b.fEnd, grain: w.b.grain, timber: w.b.timber + 1, stone: w.b.stone, ore: w.b.ore, tools: w.b.tools, fiber: w.b.fiber, cloth: w.b.cloth, pop: w.b.pop, prosperity: w.b.prosperity, research: w.b.research), c: w.c, d: w.d, ab: w.ab, ac: w.ac, ad: w.ad, bc: w.bc, bd: NoRoute, cd: w.cd, fee_ab: w.fee_ab, fee_ac: w.fee_ac, fee_ad: w.fee_ad, fee_bc: w.fee_bc, fee_bd: w.fee_bd, fee_cd: w.fee_cd, money: w.money + 10, tech_road: w.tech_road, tech_river: w.tech_river, tick_count: w.tick_count)

export fn toggle_bd(w: World) -> World:
  match w.bd:
    NoRoute => build_bd(w)
    _ => remove_bd(w)

export fn build_cd(w: World) -> World:
  let can = w.money >= 20 and w.c.timber >= 2 and w.c.stone >= 1
  match can:
    true => World(a: w.a, b: w.b, c: Town(name: w.c.name, gEnd: w.c.gEnd, tEnd: w.c.tEnd, sEnd: w.c.sEnd, oEnd: w.c.oEnd, fEnd: w.c.fEnd, grain: w.c.grain, timber: w.c.timber - 2, stone: w.c.stone - 1, ore: w.c.ore, tools: w.c.tools, fiber: w.c.fiber, cloth: w.c.cloth, pop: w.c.pop, prosperity: w.c.prosperity, research: w.c.research), d: w.d, ab: w.ab, ac: w.ac, ad: w.ad, bc: w.bc, bd: w.bd, cd: Path, fee_ab: w.fee_ab, fee_ac: w.fee_ac, fee_ad: w.fee_ad, fee_bc: w.fee_bc, fee_bd: w.fee_bd, fee_cd: w.fee_cd, money: w.money - 20, tech_road: w.tech_road, tech_river: w.tech_river, tick_count: w.tick_count)
    false => w

export fn remove_cd(w: World) -> World:
  World(a: w.a, b: w.b, c: Town(name: w.c.name, gEnd: w.c.gEnd, tEnd: w.c.tEnd, sEnd: w.c.sEnd, oEnd: w.c.oEnd, fEnd: w.c.fEnd, grain: w.c.grain, timber: w.c.timber + 1, stone: w.c.stone, ore: w.c.ore, tools: w.c.tools, fiber: w.c.fiber, cloth: w.c.cloth, pop: w.c.pop, prosperity: w.c.prosperity, research: w.c.research), d: w.d, ab: w.ab, ac: w.ac, ad: w.ad, bc: w.bc, bd: w.bd, cd: NoRoute, fee_ab: w.fee_ab, fee_ac: w.fee_ac, fee_ad: w.fee_ad, fee_bc: w.fee_bc, fee_bd: w.fee_bd, fee_cd: w.fee_cd, money: w.money + 10, tech_road: w.tech_road, tech_river: w.tech_river, tick_count: w.tick_count)

export fn toggle_cd(w: World) -> World:
  match w.cd:
    NoRoute => build_cd(w)
    _ => remove_cd(w)
