# Desk edit modes. They are only ever carried by the browser: the server
# receives the whole staged list and re-snaps it, so a stale draft can never
# merge with an edit the player did not make.
export fn waypoint_mode_add() -> Int:
  -2

export fn waypoint_mode_move_last() -> Int:
  -4

export fn waypoint_marker_name(markers: List<MarkerInfo>, step: Int) -> Text:
  let count = len(markers)
  match count <= 0:
    true => ""
    false => nth_marker(markers, mod_int(step, count)).name

export fn waypoint_marker_x(markers: List<MarkerInfo>, step: Int) -> Int:
  let count = len(markers)
  match count <= 0:
    true => -1
    false => nth_marker(markers, mod_int(step, count)).x

export fn waypoint_marker_y(markers: List<MarkerInfo>, step: Int) -> Int:
  let count = len(markers)
  match count <= 0:
    true => -1
    false => nth_marker(markers, mod_int(step, count)).y

# One staged waypoint as the desk renders it: its position, a human label, and
# the index used by the per-row move and remove buttons.
export type WaypointRow:
  key: Text
  index: Int
  label: Text
  name: Text

fn marker_near_markers(markers: List<MarkerInfo>, x: Int, y: Int, i: Int) -> MarkerInfo:
  match list_get(markers, i):
    None => empty_marker()
    Some(m) => match abs_int(m.x - x) <= 1 and abs_int(m.y - y) <= 1:
      true => m
      false => marker_near_markers(markers, x, y, i + 1)

export fn waypoint_point_label(markers: List<MarkerInfo>, x: Int, y: Int) -> Text:
  let near = marker_near_markers(markers, x, y, 0)
  match near.id != "":
    true => near.name
    false => int_text(x) + "," + int_text(y)

export fn waypoint_rows(via: List<Int>, markers: List<MarkerInfo>) -> List<WaypointRow>:
  let points = via_from_flat(via)
  for i in indices(len(points)):
    let p = nth_point(points, i)
    WaypointRow(key: "wp-" + int_text(i), index: i, label: int_text(i + 1), name: waypoint_point_label(markers, p.x, p.y))

export type WaypointState:
  count: Int
  ok: Bool
  via: List<Int>
  plan: RoutePlan

export fn empty_waypoint_state() -> WaypointState:
  WaypointState(count: 0, ok: false, via: [], plan: empty_plan())

export fn encode_waypoints(via: List<Int>) -> Text:
  let parts = for i in indices(len(via) / 2):
    pad4(nth_int(via, i * 2)) + pad4(nth_int(via, i * 2 + 1))
  join_text(parts, "")

export fn decode_waypoints(text: Text) -> List<Int>:
  let count = len(text) / 8
  let groups = for i in indices(count):
    [int_of(text_slice(text, i * 8, 4)), int_of(text_slice(text, i * 8 + 4, 4))]
  flatten_ints(groups, 0, [])

