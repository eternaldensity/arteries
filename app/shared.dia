export fn build_bc(w: World) -> World:
  let can = w.money >= 20 and w.b.timber >= 2 and w.b.stone >= 1
  match can:
    true => World(a: w.a, b: Town(name: w.b.name, gEnd: w.b.gEnd, tEnd: w.b.tEnd, sEnd: w.b.sEnd, oEnd: w.b.oEnd, fEnd: w.b.fEnd, grain: w.b.grain, timber: w.b.timber - 2, stone: w.b.stone - 1, ore: w.b.ore, tools: w.b.tools, fiber: w.b.fiber, cloth: w.b.cloth, pop: w.b.pop, prosperity: w.b.prosperity, research: w.b.research), c: w.c, d: w.d, ab: w.ab, ac: w.ac, ad: w.ad, bc: Path, bd: w.bd, cd: w.cd, fee_ab: w.fee_ab, fee_ac: w.fee_ac, fee_ad: w.fee_ad, fee_bc: w.fee_bc, fee_bd: w.fee_bd, fee_cd: w.fee_cd, money: w.money - 20, tech_road: w.tech_road, tech_river: w.tech_river, tick_count: w.tick_count)
