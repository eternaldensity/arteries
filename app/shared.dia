  let can = w.money >= 20 and w.c.timber >= 2 and w.c.stone >= 1
  match can:
    true => World(a: w.a, b: w.b, c: Town(name: w.c.name, gEnd: w.c.gEnd, tEnd: w.c.tEnd, sEnd: w.c.sEnd, oEnd: w.c.oEnd, grain: w.c.grain, timber: w.c.timber - 2, stone: w.c.stone - 1, ore: w.c.ore, tools: w.c.tools, pop: w.c.pop, prosperity: w.c.prosperity, research: w.c.research), d: w.d, ab: w.ab, ac: w.ac, ad: w.ad, bc: w.bc, bd: w.bd, cd: Path, money: w.money - 20, tech_road: w.tech_road, tech_river: w.tech_river)
    false => w

export fn remove_cd(w: World) -> World:
  World(a: w.a, b: w.b, c: Town(name: w.c.name, gEnd: w.c.gEnd, tEnd: w.c.tEnd, sEnd: w.c.sEnd, oEnd: w.c.oEnd, grain: w.c.grain, timber: w.c.timber + 1, stone: w.c.stone, ore: w.c.ore, tools: w.c.tools, pop: w.c.pop, prosperity: w.c.prosperity, research: w.c.research), d: w.d, ab: w.ab, ac: w.ac, ad: w.ad, bc: w.bc, bd: w.bd, cd: NoRoute, money: w.money + 10, tech_road: w.tech_road, tech_river: w.tech_river)

export fn town_line(t: Town) -> Text:
  t.name + ": pop=" + int_text(t.pop) + " grain=" + int_text(t.grain) + " timber=" + int_text(t.timber) + " stone=" + int_text(t.stone) + " ore=" + int_text(t.ore) + " tools=" + int_text(t.tools) + " prosperity=" + int_text(t.prosperity) + " research=" + int_text(t.research)

export fn world_report(label: Text, w: World) -> Text:
  label + "\\n" + town_line(w.a) + "\\n" + town_line(w.b) + "\\n" + town_line(w.c) + "\\n" + town_line(w.d) + "\\nMoney: " + int_text(w.money)

export fn base_world() -> World:
  World(a: Town(name: "Riverford", gEnd: 5, tEnd: 1, sEnd: 0, oEnd: 0, grain: 0, timber: 0, stone: 0, ore: 0, tools: 0, pop: 2, prosperity: 0, research: 0), b: Town(name: "Hillcrest", gEnd: 0, tEnd: 1, sEnd: 2, oEnd: 3, grain: 0, timber: 0, stone: 0, ore: 0, tools: 0, pop: 2, prosperity: 0, research: 0), c: Town(name: "Greenvale", gEnd: 2, tEnd: 4, sEnd: 1, oEnd: 0, grain: 0, timber: 0, stone: 0, ore: 0, tools: 0, pop: 2, prosperity: 0, research: 0), d: Town(name: "Portmere", gEnd: 1, tEnd: 0, sEnd: 0, oEnd: 0, grain: 0, timber: 0, stone: 0, ore: 0, tools: 0, pop: 2, prosperity: 0, research: 0), ab: NoRoute, ac: NoRoute, ad: NoRoute, bc: NoRoute, bd: NoRoute, cd: NoRoute, money: 100, tech_road: false, tech_river: false)

export fn connected_world() -> World:
  World(a: Town(name: "Riverford", gEnd: 5, tEnd: 1, sEnd: 0, oEnd: 0, grain: 0, timber: 0, stone: 0, ore: 0, tools: 0, pop: 2, prosperity: 0, research: 0), b: Town(name: "Hillcrest", gEnd: 0, tEnd: 1, sEnd: 2, oEnd: 3, grain: 0, timber: 0, stone: 0, ore: 0, tools: 0, pop: 2, prosperity: 0, research: 0), c: Town(name: "Greenvale", gEnd: 2, tEnd: 4, sEnd: 1, oEnd: 0, grain: 0, timber: 0, stone: 0, ore: 0, tools: 0, pop: 2, prosperity: 0, research: 0), d: Town(name: "Portmere", gEnd: 1, tEnd: 0, sEnd: 0, oEnd: 0, grain: 0, timber: 0, stone: 0, ore: 0, tools: 0, pop: 2, prosperity: 0, research: 0), ab: Path, ac: Path, ad: Path, bc: Path, bd: Path, cd: Path, money: 100, tech_road: false, tech_river: false)

export fn status(t: Town) -> Text:
  match t.prosperity > 6:
    true => "thriving"
    false => match t.prosperity >= 0:
      true => "stable"
      false => "stressed"

export fn bool_text(b: Bool) -> Text:
  match b:
    true => "on"
    false => "off"

fn main() -> Text:
  let isolated = run_ticks(base_world(), 8)
  let connected = run_ticks(connected_world(), 8)
  world_report("ISOLATED (no routes):", isolated) + "\\n\\n" + world_report("CONNECTED:", connected)


export fn toggle_ab(w: World) -> World:
  match w.ab:
    NoRoute => build_ab(w)
    _ => remove_ab(w)

export fn toggle_ac(w: World) -> World:
  match w.ac:
    NoRoute => build_ac(w)
    _ => remove_ac(w)

export fn toggle_ad(w: World) -> World:
  match w.ad:
    NoRoute => build_ad(w)
    _ => remove_ad(w)

export fn toggle_bc(w: World) -> World:
  match w.bc:
    NoRoute => build_bc(w)
    _ => remove_bc(w)

export fn toggle_bd(w: World) -> World:
  match w.bd:
    NoRoute => build_bd(w)
    _ => remove_bd(w)

export fn toggle_cd(w: World) -> World:
  match w.cd:
    NoRoute => build_cd(w)
    _ => remove_cd(w)

export fn tech_summary(w: World) -> Text:
  match w.tech_road:
    true => match w.tech_river:
      true => "roads + rivers"
      false => "roads"
    false => "none"

export fn route_text(r: RouteMode) -> Text:
  match r:
    NoRoute => "none"
    Path => "path"
    Road => "road"
    River => "river"
