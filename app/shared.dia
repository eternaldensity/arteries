# Arteries - transport economy simulation core.
#
# The map is implicit: terrain is a pure function of (seed, x, y), so every
# seed produces a different world without storing thousands of tiles. Routes are
# polylines in map space and the browser rasterises them per row.

# ---------------------------------------------------------------- types

export enum Terrain:
  Plains
  Forest
  Hills
  Mountain
  Water
  Coast
  Marsh

export enum Good:
  Grain
  Timber
  Stone
  Ore
  Fiber
  Tools
  Cloth
  Fish

export enum RouteMode:
  NoRoute
  Path
  Road
  River
  Rail

export type Point:
  x: Int
  y: Int

export type TownState:
  pop: Int
