  let can = w.money >= 20 and w.a.timber >= 2 and w.a.stone >= 1
  match can:
    true => World(a: Town(name: w.a.name, gEnd: w.a.gEnd, tEnd: w.a.tEnd, sEnd: w.a.sEnd, oEnd: w.a.oEnd, grain: w.a.grain, timber: w.a.timber - 2, stone: w.a.stone - 1, ore: w.a.ore, tools: w.a.tools, pop: w.a.pop, prosperity: w.a.prosperity, research: w.a.research), b: w.b, c: w.c, d: w.d, ab: w.ab, ac: w.ac, ad: Path, bc: w.bc, bd: w.bd, cd: w.cd, money: w.money - 20, tech_road: w.tech_road, tech_river: w.tech_river)
    false => w

export fn remove_ad(w: World) -> World:
  World(a: Town(name: w.a.name, gEnd: w.a.gEnd, tEnd: w.a.tEnd, sEnd: w.a.sEnd, oEnd: w.a.oEnd, grain: w.a.grain, timber: w.a.timber + 1, stone: w.a.stone, ore: w.a.ore, tools: w.a.tools, pop: w.a.pop, prosperity: w.a.prosperity, research: w.a.research), b: w.b, c: w.c, d: w.d, ab: w.ab, ac: w.ac, ad: NoRoute, bc: w.bc, bd: w.bd, cd: w.cd, money: w.money + 10, tech_road: w.tech_road, tech_river: w.tech_river)

