export component Root:
  state world: World = connected_world()
  derived report: Text = world_report("Current network", world)
  derived active_links: Int = bool_int(world.ab) + bool_int(world.ac) + bool_int(world.ad) + bool_int(world.bc) + bool_int(world.bd) + bool_int(world.cd)
  derived total_prosperity: Int = world.a.prosperity + world.b.prosperity + world.c.prosperity + world.d.prosperity
  derived total_research: Int = world.a.research + world.b.research + world.c.research + world.d.research

  on tick_once:
    world = tick(world)

  on run_twelve:
    world = run_ticks(world, 12)

  on toggle_ab:
    world = World(a: world.a, b: world.b, c: world.c, d: world.d, ab: not world.ab, ac: world.ac, ad: world.ad, bc: world.bc, bd: world.bd, cd: world.cd)

  on toggle_ac:
    world = World(a: world.a, b: world.b, c: world.c, d: world.d, ab: world.ab, ac: not world.ac, ad: world.ad, bc: world.bc, bd: world.bd, cd: world.cd)

  on toggle_ad:
    world = World(a: world.a, b: world.b, c: world.c, d: world.d, ab: world.ab, ac: world.ac, ad: not world.ad, bc: world.bc, bd: world.bd, cd: world.cd)

  on toggle_cd:
    world = World(a: world.a, b: world.b, c: world.c, d: world.d, ab: world.ab, ac: world.ac, ad: world.ad, bc: world.bc, bd: world.bd, cd: not world.cd)

  on toggle_bc:
    world = World(a: world.a, b: world.b, c: world.c, d: world.d, ab: world.ab, ac: world.ac, ad: world.ad, bc: not world.bc, bd: world.bd, cd: world.cd)

  on toggle_bd:
    world = World(a: world.a, b: world.b, c: world.c, d: world.d, ab: world.ab, ac: world.ac, ad: world.ad, bc: world.bc, bd: not world.bd, cd: world.cd)

  on reset_connected:
    world = connected_world()

  on reset_isolated:
    world = base_world()

  html:
    <main>
      <header>
        <h1>Arteries</h1>
        <p>Steer a small economy through transport links alone. Toggle links, run time, and watch settlements respond.</p>
      </header>

      <section class="metrics">
        <div class="metric"><span class="label">Active links</span><strong>{active_links}</strong></div>
        <div class="metric"><span class="label">Total prosperity</span><strong>{total_prosperity}</strong></div>
        <div class="metric"><span class="label">Total research</span><strong>{total_research}</strong></div>
      </section>

      <section class="controls">
        <div class="control-group">
          <h2>Links</h2>
          <button type="button" on-click={toggle_ab}>A-B: {bool_text(world.ab)}</button>
          <button type="button" on-click={toggle_ac}>A-C: {bool_text(world.ac)}</button>
          <button type="button" on-click={toggle_ad}>A-D: {bool_text(world.ad)}</button>
          <button type="button" on-click={toggle_bc}>B-C: {bool_text(world.bc)}</button>
          <button type="button" on-click={toggle_bd}>B-D: {bool_text(world.bd)}</button>
          <button type="button" on-click={toggle_cd}>C-D: {bool_text(world.cd)}</button>
        </div>
        <div class="control-group">
          <h2>Time</h2>
          <button type="button" on-click={tick_once}>Run 1 tick</button>
          <button type="button" on-click={run_twelve}>Run 12 ticks</button>
        </div>
        <div class="control-group">
          <h2>Scenarios</h2>
          <button type="button" on-click={reset_connected}>Connected</button>
          <button type="button" on-click={reset_isolated}>Isolated</button>
        </div>
      </section>

      <section class="map">
        <h2>Landscape map</h2>
        <div class="map-canvas">
          <when test={world.ab}><div class="route route-ab"></div></when>
          <when test={world.ac}><div class="route route-ac"></div></when>
          <when test={world.ad}><div class="route route-ad"></div></when>
          <when test={world.bc}><div class="route route-bc"></div></when>
          <when test={world.bd}><div class="route route-bd"></div></when>
          <when test={world.cd}><div class="route route-cd"></div></when>

          <div class="node node-a"><strong>Riverford</strong><br>plains</div>
          <div class="node node-b"><strong>Hillcrest</strong><br>hills</div>
          <div class="node node-c"><strong>Greenvale</strong><br>forest</div>
          <div class="node node-d"><strong>Portmere</strong><br>coast</div>
        </div>
        <p class="legend">Lines show built transport routes between settlements across the landscape.</p>
      </section>

      <section class="settlements">
        <article class="settlement">
          <h2>{world.a.name} <span class="status">{status(world.a)}</span></h2>
          <p>Pop {world.a.pop} · Prosperity {world.a.prosperity} · Research {world.a.research}</p>
          <p>Grain {world.a.grain} · Timber {world.a.timber} · Ore {world.a.ore}</p>
          <p>Endowments: grain {world.a.gEnd}, timber {world.a.tEnd}, ore {world.a.oEnd}</p>
        </article>
        <article class="settlement">
          <h2>{world.b.name} <span class="status">{status(world.b)}</span></h2>
          <p>Pop {world.b.pop} · Prosperity {world.b.prosperity} · Research {world.b.research}</p>
          <p>Grain {world.b.grain} · Timber {world.b.timber} · Ore {world.b.ore}</p>
          <p>Endowments: grain {world.b.gEnd}, timber {world.b.tEnd}, ore {world.b.oEnd}</p>
        </article>
        <article class="settlement">
          <h2>{world.c.name} <span class="status">{status(world.c)}</span></h2>
          <p>Pop {world.c.pop} · Prosperity {world.c.prosperity} · Research {world.c.research}</p>
          <p>Grain {world.c.grain} · Timber {world.c.timber} · Ore {world.c.ore}</p>
          <p>Endowments: grain {world.c.gEnd}, timber {world.c.tEnd}, ore {world.c.oEnd}</p>
        </article>
        <article class="settlement">
          <h2>{world.d.name} <span class="status">{status(world.d)}</span></h2>
          <p>Pop {world.d.pop} · Prosperity {world.d.prosperity} · Research {world.d.research}</p>
          <p>Grain {world.d.grain} · Timber {world.d.timber} · Ore {world.d.ore}</p>
          <p>Endowments: grain {world.d.gEnd}, timber {world.d.tEnd}, ore {world.d.oEnd}</p>
        </article>
      </section>

      <section class="report">
        <h2>Full text report</h2>
        <pre>{report}</pre>
      </section>
    </main>
