export component MapCanvas(seed: Int, groups: List<RouteNodeGroup>, draft: List<RouteNode>, markers: List<MarkerInfo>, selected: Text):
  output picked(value: Text)

  on pick(id: Text):
    emit picked(id)

  html:
    <div class="map-grid">
      <when test={seed == 0}><img class="map-image" src="asset:map0" alt=""></when>
      <when test={seed == 1}><img class="map-image" src="asset:map1" alt=""></when>
      <when test={seed == 2}><img class="map-image" src="asset:map2" alt=""></when>
      <when test={seed == 3}><img class="map-image" src="asset:map3" alt=""></when>
      <when test={seed == 4}><img class="map-image" src="asset:map4" alt=""></when>
      <when test={seed == 5}><img class="map-image" src="asset:map5" alt=""></when>
      <when test={seed == 6}><img class="map-image" src="asset:map6" alt=""></when>
      <when test={seed == 7}><img class="map-image" src="asset:map7" alt=""></when>
      <when test={seed == 8}><img class="map-image" src="asset:map8" alt=""></when>
      <when test={seed == 9}><img class="map-image" src="asset:map9" alt=""></when>
      <when test={seed == 10}><img class="map-image" src="asset:map10" alt=""></when>
      <when test={seed == 11}><img class="map-image" src="asset:map11" alt=""></when>
      <when test={seed == 12}><img class="map-image" src="asset:map12" alt=""></when>
      <when test={seed == 13}><img class="map-image" src="asset:map13" alt=""></when>
      <when test={seed == 14}><img class="map-image" src="asset:map14" alt=""></when>
      <when test={seed == 15}><img class="map-image" src="asset:map15" alt=""></when>
      <each items={groups} as="group" key={group.key}>
        <each items={group.nodes} as="node" key={node.key}>
          <span class={"route-cell " + node.position + " " + node.css}></span>
        </each>
      </each>
      <each items={draft} as="node" key={node.key}>
        <span class={"route-cell draft-node " + node.position + " " + node.css}></span>
      </each>
      <each items={markers} as="m" key={m.id}>
        <span class={"marker " + position_class(m.x, m.y)}>
          <button class={marker_button_class_selected(selected, m)} type="button" on-click={pick(m.id)} title={m.name}>
            <when test={m.is_town}><span class="town-dot"></span><span class="town-label">{m.name}</span></when>
            <when test={not m.is_town}><span class="site-diamond"></span><span class="site-label">{m.name} · {m.detail}</span></when>
          </button>
        </span>
      </each>
    </div>

export component SurveyPreviewPanel(from: Text, to: Text, plan: RoutePlan, road: Bool, river: Bool, rail: Bool):
  output choose(value: Int)
  state options: List<SurveyOption> = []
  state preview: SurveyPreview = empty_survey_preview()
  on mount:
    options = rpc.survey_options(from, to)
    preview = rpc.survey_preview(from, to, plan.bend)
  on pick(chosen: Int):
    emit choose(chosen)
  html:
    <div class="survey-preview" id="survey-preview">
      <div class="plan-grid">
        <div><span>Capacity</span><strong>{preview.capacity}</strong></div>
        <div><span>Upkeep/wk</span><strong>{preview.upkeep}</strong></div>
        <div><span>Trade/cycle</span><strong>{preview.trade}</strong></div>
        <div><span>Bridges</span><strong>{plan.water}</strong></div>
        <div><span>Forest</span><strong>{plan.forest}</strong></div>
      </div>
      <p class="helper">{preview.found}</p>
      <p class="helper">{preview.material}</p>
      <when test={preview.warning != ""}><p class="helper">{preview.warning}</p></when>
      <when test={len(options) > 0}>
        <div class="shape-row">
          <span>Corridors</span>
          <each items={options} as="o" key={int_text(o.index)}>
            <button class="tiny" type="button" on-click={pick(o.bend)} title={o.label}>Corridor {o.index + 1}</button>
          </each>
        </div>
      </when>
      <div class="shape-row">
        <span>Modes</span>
        <when test={road}><span class="mono">Road cap {route_capacity(Road, plan)} · {route_upkeep(Road, plan)}/wk</span></when>
        <when test={river}><span class="mono">River cap {route_capacity(River, plan)} · {route_upkeep(River, plan)}/wk</span></when>
        <when test={rail}><span class="mono">Rail cap {route_capacity(Rail, plan)} · {route_upkeep(Rail, plan)}/wk</span></when>
      </div>
    </div>

export component WaypointDesk(from: Text, to: Text, markers: List<MarkerInfo>, plan: RoutePlan):
  # Every edit sends the whole staged list and replies with the snapped result
  # plus the surveyed corridor, so the desk and the map can never disagree about
  # what construction will charge.
  output planned(value: RoutePlan)
  state reply: WaypointState = empty_waypoint_state()
  state step: Int = -1
  state mode: Int = waypoint_mode_add()
  state cell: Text = ""
  state notice: Text = ""

  # `plan` is the corridor Root draws. It matches what this desk surveyed until
  # something else replaces it (a manual re-shape abandons staged waypoints
  # server-side), so a mismatch means the staged list describes a corridor that
  # will never be built: read the rows as empty until the player stages again.
  # Doing this here keeps the epoch out of Root, whose per-step environment is
  # the browser budget's scarcest resource.
  derived synced: Bool = same_plan(reply.plan, plan)
  derived via: List<Int> = match synced:
    true => reply.via
    false => []

  on add_mode:
    mode = waypoint_mode_add()
    step = 0
    notice = ""

  on next_marker:
    step = match step + 1 >= len(markers):
      true => 0
      false => step + 1

  on place:
    reply = match step >= 0 and len(markers) > 0:
      true => rpc.survey_waypoint_edit(from, to, waypoint_edit(via, mode, waypoint_marker_x(markers, step), waypoint_marker_y(markers, step)))
      false => reply
    mode = waypoint_mode_add()
    step = -1
    notice = ""
    emit planned(reply.plan)

  on cancel_mode:
    mode = waypoint_mode_add()
    step = -1
    notice = ""

  on move_last:
    mode = waypoint_mode_move_last()
    step = 0
    notice = ""

  on move_at(index: Int):
    mode = index
    step = 0
    notice = ""

  on remove_last:
    reply = rpc.survey_waypoint_edit(from, to, waypoint_remove(via, waypoint_last_index(via)))
    mode = waypoint_mode_add()
    step = -1
    notice = ""
    emit planned(reply.plan)

  on remove_at(index: Int):
    reply = rpc.survey_waypoint_edit(from, to, waypoint_remove(via, index))
    mode = waypoint_mode_add()
    step = -1
    notice = ""
    emit planned(reply.plan)

  on clear:
    reply = rpc.survey_waypoint_edit(from, to, [])
    mode = waypoint_mode_add()
    step = -1
    notice = ""
    emit planned(reply.plan)

  on place_cell:
    notice = match len(cell_edit(via, cell)) == len(via):
      true => "No cell added. Use a cell like 3,2, up to 6 waypoints."
      false => ""
    reply = rpc.survey_waypoint_edit(from, to, cell_edit(via, cell))
    emit planned(reply.plan)

  html:
    <when test={len(via) > 0}>
      <div class="shape-row waypoint-line">
        <span>Waypoint staged · {int_text(len(via) / 2)} of {int_text(via_max())}</span>
        <button class="ghost tiny" type="button" on-click={add_mode}>Add</button>
        <button class="ghost tiny" type="button" on-click={move_last}>Move last</button>
        <button class="ghost tiny" type="button" on-click={remove_last}>Remove last</button>
        <button class="ghost tiny" type="button" on-click={clear}>Clear</button>
      </div>
      <ul class="waypoint-list">
        <each items={waypoint_rows(via, markers)} as="row" key={row.key}>
          <li class="waypoint-row">
            <span class="waypoint-index">{row.label}</span>
            <span class="waypoint-name">{row.name}</span>
            <button class="tiny" type="button" on-click={move_at(row.index)}>Move</button>
            <button class="tiny" type="button" on-click={remove_at(row.index)}>Remove</button>
          </li>
        </each>
      </ul>
      <when test={step < 0}>
        <div class="shape-row waypoint-cell">
          <input id="waypoint-cell" bind-value={cell} maxlength="16" placeholder="cell x,y">
          <button class="ghost tiny" type="button" on-click={place_cell}>Place here</button>
        </div>
      </when>
      <when test={notice != ""}><p class="helper">{notice}</p></when>
      <p class="helper">Waypoints steer the corridor; the plan above lists exactly the cells construction charges.</p>
    </when>
    <when test={len(via) == 0 and step < 0}>
      <div class="shape-row">
        <button class="ghost tiny" type="button" on-click={add_mode}>Add waypoint</button>
        <div class="waypoint-cell">
          <input id="waypoint-cell" bind-value={cell} maxlength="16" placeholder="cell x,y">
          <button class="ghost tiny" type="button" on-click={place_cell}>Place here</button>
        </div>
      </div>
      <when test={notice != ""}><p class="helper">{notice}</p></when>
    </when>
    <when test={step >= 0}>
      <div class="shape-row">
        <span>Waypoint marker <strong>{waypoint_marker_name(markers, step)}</strong></span>
        <button class="ghost tiny" type="button" on-click={next_marker}>Next</button>
        <button class="ghost tiny" type="button" on-click={place}>Place</button>
        <button class="ghost tiny" type="button" on-click={cancel_mode}>Cancel</button>
      </div>
    </when>

export component LinkRulesDesk(link: Text, rules: LinkRules):
  # The desk sends the whole policy on every change, so the browser never merges
  # a partial rule set into the authoritative one. Root adopts the returned Game.
  output changed(value: Game)
  state reply: Game = empty_game()

  on toggle(good: Int):
    reply = rpc.set_route_rules(link, toggle_rule_allow(rules.allow, good), rules.fee)
    emit changed(reply)

  on fee_up(good: Int):
    reply = rpc.set_route_rules(link, rules.allow, adjust_rule_fee(rules.fee, good, 1))
    emit changed(reply)

  on fee_down(good: Int):
    reply = rpc.set_route_rules(link, rules.allow, adjust_rule_fee(rules.fee, good, -1))
    emit changed(reply)

  on allow_all:
    reply = rpc.set_route_rules(link, default_rules().allow, rules.fee)
    emit changed(reply)

  html:
    <div class="rules-desk">
      <div class="rules-head">
        <span>Link policy</span>
        <button class="ghost tiny" type="button" on-click={allow_all}>Allow all goods</button>
      </div>
      <each items={indices(len(goods()))} as="good" key={int_text(good)}>
        <div class="rules-row">
          <span class="rules-good">{good_short_at(good)}</span>
          <button class="tiny" type="button" on-click={toggle(good)}>{rule_label(rules, good)}</button>
          <span class="rules-fee">{int_text(rule_fee_at(rules, good))}</span>
          <button class="tiny" type="button" on-click={fee_down(good)} aria-label="Lower good toll">−</button>
          <button class="tiny" type="button" on-click={fee_up(good)} aria-label="Raise good toll">+</button>
        </div>
      </each>
      <p class="helper">Blocked goods cannot use this link. A surcharge is added to the base toll when routing that good.</p>
    </div>

export component Root:
  state game: Game = empty_game()
  state signed_in: Text = ""
  state loaded: Bool = false
  state username: Text = "yria"
  state password: Text = ""
  state auth_notice: Text = "Sign in to load the authoritative world."
  state pending_dismantle: Text = ""
  state rules_open: Text = ""
  state scale_mode: Bool = false
  state scale_active: Bool = false
  state scale_summary: ScaleSummary = ScaleSummary(seed: 7, tick: 0, money: 0, towns: 0, routes: 0, phase: 0)
  state scale_step: ScaleStep = ScaleStep(phase: 0, cursor: "", tick: 0, money: 0, pop: 0, prosperity: 0, max_research: 0, traffic: 0, finish: 0, status: "Choose Run to start a compact cycle.")
  state forecast: Forecast = empty_forecast()
  state planet_summary: PlanetSummary = PlanetSummary(seed: 7, detail: 0, faces: 0, cells: 0, checksum: 0)
  state region_from: Int = 0
  state region_to: Int = 1
  state region_path: List<Int> = []
  state region_map: RegionMap = empty_region_map()
  state region_mode: Int = 0
  state region_lanes: List<Int> = []
  state region_trade: RegionTrade = empty_region_trade()
  state globe: List<GlobeRow> = []
  state globe_view: Int = 0
  state worldgen: WorldgenSummary = empty_worldgen_summary()
  state show_preview: Bool = false
  state draft_plan: RoutePlan = empty_plan()

  # Root re-evaluates every derived on each step of each handler, while the
  # template is only evaluated when it renders. Values the handlers never read
  # (marker names, stat headlines, plan stats) are therefore rendered inline
  # instead of being carried as deriveds; what stays here is either read by a
  # handler, repeated across the template, or costly enough to be worth one
  # shared evaluation.
  derived world: World = game.world
  derived iv: InspectView = game.inspect
  derived sel: Selection = game.sel
  derived prosperity: Int = total_prosperity(world)
  derived routes_count: Int = len(world.routes)
  derived alert_items: List<Text> = alerts(world)
  derived alert_idx: List<Int> = indices(len(alert_items))
  derived upkeep_flag: Int = match upkeep_due(game) > 0:
    true => 1
    false => 0
  derived signal_count: Int = len(alert_items) + upkeep_flag
  derived feed_items: List<Text> = log_feed(world)
  derived feed_idx: List<Int> = indices(len(feed_items))
  derived build_check: BuildCheck = build_check_plan(world, game.projects, sel.from, sel.to, draft_plan, sel.ready)
  derived build_duration: Text = construction_preview_plan(world, sel.from, sel.to, draft_plan, sel.ready)
  derived scale_button: Text = match scale_active:
    true => "Continue cycle"
    false => "Run 1 day"
  derived scale_req_phase: Int = match scale_active:
    true => scale_step.phase
    false => 0
  derived scale_req_cursor: Text = match scale_active:
    true => scale_step.cursor
    false => ""
  derived scale_req_pop: Int = match scale_active:
    true => scale_step.pop
    false => 0
  derived scale_req_prosperity: Int = match scale_active:
    true => scale_step.prosperity
    false => 0
  derived scale_req_max: Int = match scale_active:
    true => scale_step.max_research
    false => 0
  derived scale_req_traffic: Int = match scale_active:
    true => scale_step.traffic
    false => 0
  derived scale_req_finish: Int = match scale_active:
    true => scale_step.finish
    false => 0

  on mount:
    signed_in = session.user()

  on sign_in:
    signed_in = session.login(username, password)
    password = ""
    scale_summary = rpc.load_compact()
    scale_mode = scale_summary.towns > 20
    game = match scale_mode:
      true => game
      false => server_adopt(rpc.load_game())
    loaded = true
    draft_plan = game.sel.draft
    scale_active = false
    scale_step = ScaleStep(phase: scale_summary.phase, cursor: "", tick: scale_summary.tick, money: scale_summary.money, pop: 0, prosperity: 0, max_research: 0, traffic: 0, finish: 0, status: "Compact view ready.")
    auth_notice = match scale_mode:
      true => "Signed in. Compact view loaded."
      false => "Signed in. The world is authoritative on the server."

  on resume:
    scale_summary = rpc.load_compact()
    scale_mode = scale_summary.towns > 20
    game = match scale_mode:
      true => game
      false => server_adopt(rpc.load_game())
    loaded = true
    draft_plan = game.sel.draft
    scale_active = false
    scale_step = ScaleStep(phase: scale_summary.phase, cursor: "", tick: scale_summary.tick, money: scale_summary.money, pop: 0, prosperity: 0, max_research: 0, traffic: 0, finish: 0, status: "Compact view ready.")
    auth_notice = match scale_mode:
      true => "Compact world loaded."
      false => "World loaded."

  on sign_out:
    signed_in = session.logout()
    loaded = false
    game = empty_game()
    scale_active = false
    scale_summary = ScaleSummary(seed: 7, tick: 0, money: 0, towns: 0, routes: 0, phase: 0)
    draft_plan = empty_plan()
    scale_step = ScaleStep(phase: 0, cursor: "", tick: 0, money: 0, pop: 0, prosperity: 0, max_research: 0, traffic: 0, finish: 0, status: "Choose Run to start a compact cycle.")
    auth_notice = "Signed out."

  on pick(id: Text):
    game = game_pick(game, id)
    show_preview = false
    game = match game.sel.from != "" and game.sel.to != "":
      true => game_with_plan(game, game.sel.from, game.sel.to, rpc.survey_path_plan(game.sel.from, game.sel.to))
      false => game
    draft_plan = game.sel.draft

  on start_route:
    game = game_start_route(game)
    draft_plan = game.sel.draft
    show_preview = false

  on preview_details:
    show_preview = true

  on use_corridor(bend: Int):
    draft_plan = rpc.survey_corridor_plan(sel.from, sel.to, bend)
    show_preview = false

  on bend_left:
    game = game_bend(game, -1)
    # Shaping by hand abandons staged waypoints, so survey the bend through the
    # server: that clears the draft in the same step that replaces it.
    draft_plan = match game.sel.ready:
      true => rpc.survey_corridor_plan(game.sel.from, game.sel.to, game.sel.draft.bend)
      false => draft_plan
    show_preview = false

  on bend_right:
    game = game_bend(game, 1)
    draft_plan = match game.sel.ready:
      true => rpc.survey_corridor_plan(game.sel.from, game.sel.to, game.sel.draft.bend)
      false => draft_plan
    show_preview = false

  on shape_auto:
    show_preview = false
    draft_plan = match sel.ready:
      true => rpc.survey_path_plan(sel.from, sel.to)
      false => draft_plan

  on waypoint_planned(plan: RoutePlan):
    draft_plan = plan

  on cancel_route:
    game = game_cancel(game)
    draft_plan = empty_plan()
    show_preview = false

  on build_route:
    show_preview = false
    game = server_adopt(rpc.start_route(sel.from, sel.to, draft_plan.bend))
    draft_plan = game.sel.draft

  on request_dismantle(id: Text):
    pending_dismantle = id

  on confirm_dismantle:
    game = server_apply(game, rpc.dismantle(pending_dismantle))
    pending_dismantle = ""

  on cancel_dismantle:
    pending_dismantle = ""

  on cancel_project(id: Text):
    game = server_apply(game, rpc.cancel_project(id))

  on step_hour:
    game = server_apply(game, rpc.advance_market(1, "daily"))
    game = server_apply(game, rpc.advance_finish())

  on step_six_hours:
    game = server_apply(game, rpc.advance_market(6, "daily"))
    game = server_apply(game, rpc.advance_finish())

  on step_day:
    game = server_apply(game, rpc.advance_market(24, "daily"))
    game = server_apply(game, rpc.advance_finish())

  on step_three_days:
    game = server_apply(game, rpc.advance_market(72, "daily"))
    game = server_apply(game, rpc.advance_finish())

  on step_week:
    game = server_apply(game, rpc.advance_market(168, "weekly"))
    game = server_apply(game, rpc.advance_finish())

  on step_month:
    game = server_apply(game, rpc.advance_market(672, "monthly"))
    game = server_apply(game, rpc.advance_finish())

  on new_seed:
    game = server_adopt(rpc.new_seed())
    draft_plan = game.sel.draft

  on upgrade(id: Text):
    game = server_apply(game, rpc.order_upgrade(id))

  on dismantle(id: Text):
    game = server_apply(game, rpc.dismantle(id))

  on fee_up(id: Text):
    game = server_apply(game, rpc.set_fee(id, 1))

  on toggle_rules(id: Text):
    rules_open = match rules_open == id:
      true => ""
      false => id

  on rules_changed(fresh: Game):
    game = server_apply(game, fresh)

  on fee_down(id: Text):
    game = server_apply(game, rpc.set_fee(id, -1))

  on pay_upkeep:
    game = server_apply(game, rpc.pay_upkeep())

  on toggle_auto:
    game = server_apply(game, rpc.toggle_auto())

  on refresh_inspect:
    game = game_refresh(game)

  on scale_continue:
    scale_step = rpc.advance_scale(24, "daily", scale_req_phase, scale_req_cursor, scale_req_pop, scale_req_prosperity, scale_req_max, scale_req_traffic, scale_req_finish)
    scale_active = scale_step.phase != 0
    scale_summary = ScaleSummary(seed: scale_summary.seed, tick: scale_step.tick, money: scale_step.money, towns: scale_summary.towns, routes: scale_summary.routes, phase: scale_step.phase)

  on forecast_day:
    forecast = rpc.forecast_market(24, "daily")

  on forecast_week:
    forecast = rpc.forecast_market(168, "weekly")

  on scale_refresh:
    scale_summary = rpc.load_compact()
    scale_step = ScaleStep(phase: scale_summary.phase, cursor: "", tick: scale_summary.tick, money: scale_summary.money, pop: scale_step.pop, prosperity: scale_step.prosperity, max_research: scale_step.max_research, traffic: scale_step.traffic, finish: scale_step.finish, status: "Refreshed.")

  on scale_enter:
    scale_summary = rpc.load_compact()
    scale_mode = true
    scale_active = false
    scale_step = ScaleStep(phase: scale_summary.phase, cursor: "", tick: scale_summary.tick, money: scale_summary.money, pop: 0, prosperity: 0, max_research: 0, traffic: 0, finish: 0, status: "Compact view ready.")

  on scale_exit:
    scale_mode = false

  on planet_generate:
    planet_summary = rpc.planet_summary(scale_summary.seed, 8)

  on region_from_pick(i: Int):
    region_from = match region_mode == 0:
      true => i
      false => region_from
    region_to = match region_mode == 0:
      true => region_to
      false => i
    region_mode = 1 - region_mode

  on region_to_pick(i: Int):
    region_to = i

  on region_plan:
    region_path = rpc.face_path(region_from, region_to)

  on region_survey:
    region_map = rpc.region_map(scale_summary.seed, 4)

  on region_add_lane:
    region_lanes = add_region_lane(region_lanes, region_from, region_to)

  on region_run_trade:
    region_trade = rpc.region_trade(scale_summary.seed, region_lanes)

  on region_clear_lanes:
    region_lanes = []
    region_trade = empty_region_trade()

  on globe_front:
    globe_view = 0
    globe = rpc.globe_raster(scale_summary.seed, 0)

  on globe_side:
    globe_view = 2
    globe = rpc.globe_raster(scale_summary.seed, 2)

  on globe_pole:
    globe_view = 4
    globe = rpc.globe_raster(scale_summary.seed, 4)

  on generate_terrain:
    worldgen = rpc.worldgen_summary(scale_summary.seed, 16, 12)

  html:
    <when test={scale_mode and signed_in != "" and loaded}>
      <section class="scale-overlay">
        <div class="scale-card">
          <header class="scale-head">
            <div>
              <p class="eyebrow">Scale mode</p>
              <h1>Compact frontier</h1>
              <p>Server-authoritative chunks without loading the whole world into the browser.</p>
            </div>
            <when test={scale_summary.towns <= 20}>
              <button class="ghost" type="button" on-click={scale_exit}>Exit scale view</button>
            </when>
            <when test={scale_summary.towns > 20}>
              <button class="ghost" type="button" on-click={sign_out}>Sign out</button>
            </when>
          </header>
          <div class="scale-grid">
            <div><span>Tick</span><strong>{int_text(scale_summary.tick)}</strong></div>
            <div><span>Crowns</span><strong>{int_text(scale_summary.money)}</strong></div>
            <div><span>Settlements</span><strong>{int_text(scale_summary.towns)}</strong></div>
            <div><span>Routes</span><strong>{int_text(scale_summary.routes)}</strong></div>
            <div><span>Phase</span><strong>{int_text(scale_summary.phase)}</strong></div>
          </div>
          <div class="scale-cycle">
            <div class="scale-cycle-head">
              <div>
                <h2>Cycle</h2>
                <p>{scale_step.status}</p>
              </div>
              <div class="actions">
                <button class="primary" type="button" on-click={scale_continue}>{scale_button}</button>
                <button class="ghost" type="button" on-click={scale_refresh}>Refresh</button>
              </div>
            </div>
            <div class="scale-stats">
              <span>Market pop <strong>{int_text(scale_step.pop)}</strong></span>
              <span>Market prosperity <strong>{int_text(scale_step.prosperity)}</strong></span>
              <span>Trade traffic <strong>{int_text(scale_step.traffic)}</strong></span>
              <span>Finish prosperity <strong>{int_text(scale_step.finish)}</strong></span>
              <span>Max research <strong>{int_text(scale_step.max_research)}</strong></span>
            </div>
            <div class="actions">
              <button class="ghost" type="button" on-click={forecast_day}>Forecast 1 day</button>
              <button class="ghost" type="button" on-click={forecast_week}>Forecast 1 week</button>
            </div>
            <when test={forecast.days > 0}>
              <div class="scale-stats" id="forecast-panel">
                <span>Treasury <strong>{int_text(forecast.money)}→{int_text(forecast.money_after)}</strong></span>
                <span>Prosperity <strong>{int_text(forecast.prosperity)}→{int_text(forecast.prosperity_after)}</strong></span>
                <span>Traffic <strong>{int_text(forecast.traffic)}→{int_text(forecast.traffic_after)}</strong></span>
              </div>
              <p class="scale-hint">Market forecast for {int_text(forecast.days)} day(s); no events or upkeep charged.</p>
              <when test={len(forecast.towns) > 0}>
                <p class="scale-hint">{forecast_towns_text(forecast.towns)}</p>
              </when>
              <when test={len(forecast.routes) > 0}>
                <p class="scale-hint">Links: {forecast_routes_text(forecast.routes)}</p>
              </when>
            </when>
            <p class="scale-hint">Each click advances one bounded chunk. Repeat until the status says Cycle complete; the browser never loads the full frontier.</p>
          </div>
          <div class="scale-planet">
            <div class="scale-cycle-head">
              <div>
                <h2>Planet</h2>
                <p>{int_text(planet_summary.faces)} faces · {int_text(planet_summary.cells)} cells · checksum {int_text(planet_summary.checksum)}</p>
              </div>
              <button class="primary" type="button" on-click={planet_generate}>Generate planet</button>
            </div>
          </div>
          <div class="scale-planet" id="region-map">
            <div class="scale-cycle-head">
              <div>
                <h2>Region map</h2>
                <p>30 faces; click two to plan a sea lane.</p>
              </div>
              <button class="primary" type="button" on-click={region_plan}>Plan sea lane</button>
            </div>
            <div class="actions">
              <button class="ghost" type="button" on-click={region_survey}>Survey regions</button>
              <button class="ghost" type="button" on-click={region_add_lane}>Add lane</button>
              <button class="ghost" type="button" on-click={region_run_trade}>Run region trade</button>
              <button class="ghost" type="button" on-click={region_clear_lanes}>Clear lanes</button>
              <button class="ghost" type="button" on-click={globe_front}>Globe equator</button>
              <button class="ghost" type="button" on-click={globe_side}>Globe side</button>
              <button class="ghost" type="button" on-click={globe_pole}>Globe pole</button>
            </div>
            <div class="region-grid">
              <each items={indices(30)} as="i" key={int_text(i)}>
                <button class={"region-cell " + region_tile_class(region_map, i) + " " + region_class(i, region_path) + region_lane_class(i, region_lanes)} type="button" on-click={region_from_pick(i)}>{int_text(i)}</button>
              </each>
            </div>
            <when test={len(region_map.tiles) > 0}>
              <p class="scale-hint">{int_text(region_map.land)} land · {int_text(region_map.ocean)} ocean faces · {int_text(region_map.continents)} continents (largest {int_text(region_map.largest)}) · {int_text(region_climate_count(region_map.tiles, 1))} cold · {int_text(region_climate_count(region_map.tiles, 2))} hot</p>
            </when>
            <when test={len(region_path) > 0}>
              <p class="scale-hint">Sea lane: {region_path_text(region_path)}</p>
            </when>
            <when test={len(globe) > 0}>
              <div class="globe" id="globe-view">
                <each items={globe} as="row" key={int_text(row.index)}>
                  <div class="globe-row">
                    <each items={indices(len(row.codes))} as="c" key={int_text(c)}>
                      <span class={"globe-cell " + globe_code_class(nth_int(row.codes, c), region_path)}></span>
                    </each>
                  </div>
                </each>
              </div>
              <p class="scale-hint">Orthographic view {int_text(globe_view)} · 24×24</p>
            </when>
            <p class="scale-hint">{int_text(len(region_trade.markets))} region markets · {int_text(len(region_lanes) / 2)} lanes · {int_text(region_trade.traffic)} units dispatched</p>
            <when test={len(region_trade.lanes) > 0}>
              <p class="scale-hint">Lane traffic: {region_lanes_text(region_trade.lanes)}</p>
            </when>
          </div>
          <div class="scale-planet" id="worldgen-panel">
            <div class="scale-cycle-head">
              <div>
                <h2>Terrain</h2>
                <p>{int_text(worldgen.width)}×{int_text(worldgen.height)} · {int_text(worldgen.water)} water · {int_text(worldgen.rivers)} rivers · {int_text(worldgen.passes)} passes · {int_text(worldgen.fords)} fords · {int_text(worldgen.harbors)} harbors</p>
                <p class="scale-hint">Valid {worldgen.valid} · checksum {int_text(worldgen.checksum)} · forest {int_text(worldgen.forest)} · dry {int_text(worldgen.dry)} · cold {int_text(worldgen.cold)}</p>
              </div>
              <button class="primary" type="button" on-click={generate_terrain}>Generate terrain</button>
            </div>
          </div>
        </div>
      </section>
    </when>

    <when test={signed_in == ""}>
      <main class="app login-shell">
        <section class="login-card">
          <h1>ARTERIES</h1>
          <p>A server-authoritative transport economy. Sign in to load your world.</p>
          <form on-submit={sign_in}>
            <label for="username">Account</label>
            <input id="username" bind-value={username} maxlength="128">
            <label for="password">Password</label>
            <input id="password" type="password" bind-value={password} maxlength="256">
            <button class="primary" type="submit" disabled={username == "" or password == ""}>Sign in</button>
          </form>
          <p class="notice">{auth_notice}</p>
        </section>
      </main>
    </when>

    <when test={signed_in != "" and not loaded}>
      <main class="app login-shell">
        <section class="login-card">
          <h1>ARTERIES</h1>
          <p>Signed in as <strong>{signed_in}</strong>. Resume the saved world to continue.</p>
          <button class="primary" type="button" on-click={resume}>Resume world</button>
          <button class="ghost" type="button" on-click={sign_out}>Sign out</button>
          <p class="notice">Your saved world is stored on the server.</p>
        </section>
      </main>
    </when>

    <when test={signed_in != "" and loaded and not scale_mode}>
    <main class="app">
      <header class="topbar">
        <div class="brand">
          <span class="brand-mark"></span>
          <div>
            <h1>ARTERIES</h1>
            <p>A living transport economy · world <span class="mono">{world.seed}</span> · <span class="mono">{calendar_text(world)}</span></p>
          </div>
        </div>
        <div class="topbar-actions">
          <div class="treasury">
            <span class="label">Treasury</span>
            <strong class={money_class(world)}>{world.money}</strong>
          </div>
          <button class="ghost" type="button" on-click={new_seed}>New world</button>
          <button class="ghost" type="button" on-click={scale_enter}>Scale view</button>
          <button class="ghost" type="button" on-click={sign_out}>Sign out</button>
        </div>
      </header>

      <section class="stats">
        <article class="stat">
          <span class="stat-label">Population</span>
          <strong>{total_pop(world)}</strong>
          <span class="stat-sub">{len(world.towns)} settlements</span>
        </article>
        <article class="stat">
          <span class="stat-label">Prosperity</span>
          <strong>{prosperity}</strong>
          <span class="stat-sub">network total</span>
        </article>
        <article class="stat">
          <span class="stat-label">Best research</span>
          <strong>{max_town_research(world)}</strong>
          <span class="stat-sub">next: {next_tech_name(world)}</span>
        </article>
        <article class="stat">
          <span class="stat-label">Routes</span>
          <strong>{routes_count}</strong>
          <span class="stat-sub">{tech_summary(world)} unlocked</span>
        </article>
        <article class="stat wide">
          <div class="stat-head"><span class="stat-label">Technology</span><span class="mono">{tech_progress(world)}%</span></div>
          <div class={"track " + progress_class(world)}><span></span></div>
          <span class="stat-sub">{tech_next_text(world)}</span>
        </article>
      </section>

      <div class="workspace">
        <section class="map-panel">
          <div class="panel-head">
            <div>
              <h2>Frontier survey</h2>
              <p>Click any settlement or site to inspect it. Use Survey route to begin a route; the survey follows the cheapest terrain corridor.</p>
            </div>
            <div class="time-controls">
              <button class="primary" type="button" on-click={step_hour}>Advance 1 hour</button>
              <button type="button" on-click={step_six_hours}>6 hours</button>
              <button type="button" on-click={step_day}>1 day</button>
              <button type="button" on-click={step_three_days}>3 days</button>
              <button type="button" on-click={step_week}>1 week</button>
              <button type="button" on-click={step_month}>1 month</button>
            </div>
          </div>

          <div class="map-frame">
            <use component="MapCanvas" seed={world.seed} groups={game.route_groups} draft={draft_nodes(draft_plan, sel.ready)} markers={make_markers(world)} selected={sel.selected} on-picked={pick}></use>
            <div class="compass"><span>N</span><span class="north-needle"></span></div>
          </div>

          <div class="legend">
            <span class="legend-title">Terrain</span>
            <span class="key t-plains"><span class="swatch"></span>Plains</span>
            <span class="key t-forest"><span class="swatch"></span>Forest</span>
            <span class="key t-hills"><span class="swatch"></span>Hills</span>
            <span class="key t-mountain"><span class="swatch"></span>Mountain</span>
            <span class="key t-water"><span class="swatch"></span>Water</span>
            <span class="key t-coast"><span class="swatch"></span>Coast</span>
            <span class="key t-marsh"><span class="swatch"></span>Marsh</span>
            <span class="legend-gap"></span>
            <span class="key r-path"><span class="swatch"></span>Pack</span>
            <span class="key r-road"><span class="swatch"></span>Road</span>
            <span class="key r-river"><span class="swatch"></span>River</span>
            <span class="key r-rail"><span class="swatch"></span>Rail</span>
            <span class="key site-key"><span class="swatch"></span>Unclaimed site</span>
            <span class="key f-pass"><span class="swatch"></span>Pass</span>
            <span class="key f-ford"><span class="swatch"></span>Ford</span>
            <span class="key f-harbor"><span class="swatch"></span>Harbor</span>
            <span class="legend-gap"></span>
            <span class="legend-note">Link weight = traffic · colour = dominant cargo</span>
          </div>
        </section>

        <section class="sidebar">
          <section class="card action-card">
            <div class="card-head">
              <h2>Route desk</h2>
              <span class="badge">{survey_badge(sel)}</span>
            </div>
            <p class="notice">{game.notice}</p>
            <when test={not sel.routing}>
              <div class="empty-state">
                <strong>No survey in progress</strong>
                <p>Select a settlement to inspect it, then use <em>Survey route</em>. Sites can be inspected at any time without cancelling a survey.</p>
                <div class="actions">
                  <button class="primary" type="button" on-click={start_route} disabled={not iv.ready or iv.is_site}>{survey_action_text(iv)}</button>
                </div>
              </div>
            </when>
            <when test={sel.routing}>
              <div class="route-draft">
                <div class="endpoints">
                  <span><span class="origin-dot"></span>{marker_name(world, sel.from)}</span>
                  <span class="arrow">→</span>
                  <span>
                    <when test={sel.to == ""}><em>choose destination</em></when>
                    <when test={sel.to != ""}>{marker_name(world, sel.to)}</when>
                  </span>
                </div>
                <when test={iv.is_site and sel.to != ""}>
                  <p class="helper">This route ends at {iv.name} and founds it when construction completes.</p>
                </when>
                <when test={sel.ready}>
                  <div class="plan-grid">
                    <div><span>Length</span><strong>{draft_plan.length}</strong></div>
                    <div><span>Crowns</span><strong>{draft_plan.money}</strong></div>
                    <div><span>Timber</span><strong>{draft_plan.timber}</strong></div>
                    <div><span>Stone</span><strong>{draft_plan.stone}</strong></div>
                    <div><span>Bridges</span><strong>{draft_plan.water}</strong></div>
                    <div><span>Forest</span><strong>{draft_plan.forest}</strong></div>
                    <div><span>Build time</span><strong>{build_duration}</strong></div>
                  </div>
                  <div class="shape-row">
                    <span>Shape <strong>{draft_plan.bend}</strong></span>
                    <button class="tiny" type="button" on-click={bend_left} aria-label="Bend route left">←</button>
                    <button class="tiny" type="button" on-click={bend_right} aria-label="Bend route right">→</button>
                    <button class="ghost tiny" type="button" on-click={shape_auto}>Auto shape</button>
                    <button class="ghost tiny" type="button" on-click={preview_details}>Preview details</button>
                  </div>
                  <each items={[sel.from + "-" + sel.to]} as="survey_key" key={survey_key}>
                    <use component="WaypointDesk" from={sel.from} to={sel.to} markers={make_markers(world)} plan={draft_plan} on-planned={waypoint_planned}></use>
                  </each>
                                    <p class="helper">Water crossings become bridges; they add cost, lower capacity, and lengthen construction.</p>
                  <when test={show_preview}>
                    <use component="SurveyPreviewPanel" from={sel.from} to={sel.to} plan={draft_plan} road={world.tech_road} river={world.tech_river} rail={world.tech_rail} on-choose={use_corridor}></use>
                  </when>
                  <p class="blocker">{build_check.reason}</p>
                  <div class="actions">
                    <button class="primary" type="button" on-click={build_route} disabled={not build_check.ok}>{build_button_text_with(sel.ready, build_duration)}</button>
                    <button class="ghost" type="button" on-click={cancel_route}>Cancel</button>
                  </div>
                </when>
                <when test={not sel.ready}>
                  <div class="actions"><button class="ghost" type="button" on-click={cancel_route}>Cancel</button></div>
                </when>
              </div>
            </when>
          </section>

          <section class="card">
            <div class="card-head"><h2>Settlements</h2><span class="badge">{len(world.towns)}</span></div>
            <div class="settlement-list">
              <each items={world.towns} as="t" key={t.id}>
                <button class={settlement_row_class(sel, t.id)} type="button" on-click={pick(t.id)}>
                  <span class={"status-dot " + status_tone(t)}></span>
                  <span class="settlement-name">{t.name}</span>
                  <span class="settlement-meta">{t.state.pop} pop · {t.state.prosperity} pros</span>
                </button>
              </each>
            </div>
          </section>

          <section class="card">
            <div class="card-head"><h2>Signals</h2><span class="badge warn">{signal_count}</span></div>
            <ul class="alerts">
              <each items={alert_idx} as="i" key={int_text(i)}>
                <li>{nth_text(alert_items, i)}</li>
              </each>
              <when test={upkeep_due(game) > 0}><li>{upkeep_signal_text(game)}</li></when>
            </ul>
          </section>
        </section>
      </div>

      <div class="lower">
        <section class="card inspector">
          <div class="card-head">
            <h2>Inspector</h2>
            <div class="head-actions">
              <button class="tiny" type="button" on-click={refresh_inspect}>Refresh</button>
              <when test={iv.ready}><span class={"status " + iv.tone}>{iv.status}</span></when>
            </div>
          </div>
          <when test={iv.ready}>
            <div class="inspector-title">
              <div>
                <h3>{iv.name}</h3>
                <p>
                  <when test={iv.is_site}>{iv.resource} site · richness {iv.richness} · {iv.terrain}</when>
                  <when test={not iv.is_site}>{iv.connected} routes · {iv.terrain} · site value {iv.value}</when>
                </p>
              </div>
              <div class="inspector-numbers">
                <when test={not iv.is_site}>
                  <div><span>Pop</span><strong>{iv.pop}</strong></div>
                  <div><span>Prosperity</span><strong>{iv.prosperity}</strong></div>
                  <div><span>Research</span><strong>{iv.research}</strong></div>
                  <div><span>Climate</span><strong>{iv.climate}</strong></div>
                </when>
              </div>
            </div>
            <p class="insight">{iv.insight}</p>
            <when test={not iv.is_site and town_hub_text(world, sel.selected) != ""}>
              <p class="helper">{town_hub_text(world, sel.selected)}</p>
            </when>
            <when test={not iv.is_site}>
              <p class="endow-line">Natural production per day: <strong>{inspect_endow_text(iv)}</strong></p>
            </when>
            <when test={iv.is_site}>
              <div class="site-inspect">
                <div><span>Resource</span><strong>{iv.resource}</strong></div>
                <div><span>Richness</span><strong>{iv.richness}</strong></div>
                <div><span>Terrain</span><strong>{iv.terrain}</strong></div>
                <div><span>Status</span><strong>{iv.status}</strong></div>
              </div>
              <p class="helper">Choose this site as a route destination, or route through it, and a settlement is founded when construction completes.</p>
            </when>
            <when test={not iv.is_site}>
              <div class="goods">
                <each items={goods()} as="g" key={good_name(g)}>
                  <span class="good-chip" title={inspect_good_title(iv, g)}>{good_short(g)} <strong>{inspect_stock(iv, g)}</strong></span>
                </each>
              </div>
              <div class="inspector-foot">
                <span>Shortages: <strong>{iv.shortages}</strong></span>
                <span>Connected routes: <strong>{iv.connected}</strong></span>
              </div>
            </when>
          </when>
          <when test={not iv.ready}>
            <div class="empty-state">
              <strong>No settlement selected</strong>
              <p>Pick a settlement on the map or in the list. The inspector explains what is limiting it.</p>
            </div>
          </when>
        </section>

        <section class="card routes-card">
          <div class="card-head"><h2>Network</h2><span class="badge">{routes_count} / {max_routes()} routes</span></div>
          <div class="maintenance">
            <div class="maint-block"><span>Upkeep due</span><strong>{upkeep_due(game)}</strong></div>
            <div class="maint-block"><span>Condition</span><strong class={"status " + maintenance_tone(game)}>{maintenance_text(game)}</strong></div>
            <div class="maint-block"><span>Per week</span><strong>{game.upkeep_per_cycle}</strong></div>
            <div class="maint-actions">
              <button type="button" on-click={pay_upkeep} disabled={upkeep_due(game) <= 0}>Pay upkeep</button>
              <button class="ghost" type="button" on-click={toggle_auto}>Auto upkeep: {auto_text(game.auto_upkeep)}</button>
            </div>
          </div>
          <when test={len(game.projects) > 0}>
            <div class="projects">
              <div class="projects-head">Under construction <span class="badge">{len(game.projects)}</span></div>
              <each items={game.projects} as="p" key={p.id}>
                <div class="project-row">
                  <div><strong>{project_title(p)}</strong><span>{project_action_text(p)} · {duration_text(project_remaining(p, world.tick))} left</span></div>
                  <div class="project-actions">
                     <span class="project-tick">{world.tick} / {p.ready_tick}</span>
                     <button class="tiny danger" type="button" on-click={cancel_project(p.id)} disabled={project_remaining(p, world.tick) <= 0}>Cancel</button>
                   </div>
                </div>
              </each>
            </div>
          </when>
          <when test={routes_count == 0}>
            <div class="empty-state">
              <strong>The frontier is disconnected</strong>
              <p>Build your first route. Goods only move along links you create, and traffic pays your tolls.</p>
            </div>
          </when>
          <when test={pending_dismantle != ""}>
            <div class="confirm-dismantle">
              <p>Dismantle {route_direction(route_lookup(world, pending_dismantle))}? {salvage_text(route_lookup(world, pending_dismantle))}</p>
              <p class="helper">{route_dependency_text(world, route_lookup(world, pending_dismantle))}</p>
              <div class="actions">
                <button class="small danger" type="button" on-click={confirm_dismantle}>Confirm dismantle</button>
                <button class="ghost small" type="button" on-click={cancel_dismantle}>Cancel</button>
              </div>
            </div>
          </when>
          <div class="route-list">
            <each items={world.routes} as="r" key={r.id}>
              <article class="route-card">
                <div class="route-top">
                  <div>
                    <strong>{route_direction(r)}</strong>
                    <p>{r.plan.length} leagues · cap {r.capacity} · upkeep {r.upkeep}/wk</p>
                  </div>
                  <span class={"mode-chip " + route_mode_class(r.mode)}>{route_short(r.mode)}</span>
                </div>
                <div class="usage-row">
                  <div class={"usage " + usage_class(r)}><span></span></div>
                  <span class="usage-text">{r.traffic}/{r.capacity} used</span>
                </div>
                <when test={in_transit(r) > 0}>
                  <p class="helper">In transit: {int_text(in_transit(r))} units{route_cargo_text(r)}</p>
                </when>
                <p class="helper">{route_dependency_text(world, r)}</p>

                <div class="route-bottom">
                  <span>{fee_label(r)} · {income_label(r)}</span>
                  <div class="route-actions">
                    <button class="tiny" type="button" on-click={fee_down(r.id)} aria-label="Lower toll">−</button>
                    <button class="tiny" type="button" on-click={fee_up(r.id)} aria-label="Raise toll">+</button>
                    <button class="small" type="button" on-click={upgrade(r.id)} disabled={not can_start_upgrade(game, r)} title={upgrade_preview_text(r)}>Upgrade</button>
                    <button class="small danger" type="button" on-click={request_dismantle(r.id)} title={salvage_text(r)}>Dismantle</button>
                  </div>
                </div>
                <div class="route-rules">
                  <button class="ghost tiny" type="button" on-click={toggle_rules(r.id)}>{route_rules_label(r)}</button>
                  <when test={rules_open == r.id}>
                    <use component="LinkRulesDesk" link={r.id} rules={r.rules} on-changed={rules_changed}></use>
                  </when>
                </div>
              </article>
            </each>
          </div>
        </section>

        <section class="card log-card">
          <div class="card-head"><h2>Chronicle</h2><span class="badge">{calendar_text(world)}</span></div>
          <ul class="chronicle">
            <each items={feed_idx} as="i" key={int_text(i)}>
              <li>{nth_text(feed_items, i)}</li>
            </each>
          </ul>
        </section>
      </div>

      <footer class="footer">
        <span>Arteries prototype · every seed produces a different frontier</span>
        <span class="mono">seed {world.seed} · {calendar_text(world)} · {tech_summary(world)}</span>
      </footer>
    </main>
    </when>
