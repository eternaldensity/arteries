export component Root:
  state world: World = connected_world()
  state curved_routes: Bool = false
  derived report: Text = world_report("Current network", world)
  derived active_links: Int = bool_int(world.ab) + bool_int(world.ac) + bool_int(world.ad) + bool_int(world.bc) + bool_int(world.bd) + bool_int(world.cd)
  derived total_prosperity: Int = world.a.prosperity + world.b.prosperity + world.c.prosperity + world.d.prosperity
  derived total_research: Int = world.a.research + world.b.research + world.c.research + world.d.research

  on tick_once:
    world = tick(world)

  on run_twelve:
    world = run_ticks(world, 12)

  on toggle_ab:
    world = toggle_ab(world)

  on toggle_ac:
    world = toggle_ac(world)

  on toggle_ad:
    world = toggle_ad(world)

  on toggle_bc:
    world = toggle_bc(world)

  on toggle_bd:
    world = toggle_bd(world)

  on toggle_cd:
    world = toggle_cd(world)

  on toggle_curve:
    curved_routes = curved_routes == false

  on reset_connected:
    world = connected_world()

  on reset_isolated:
    world = base_world()

  html:
    <main>
      <header>
        <h1>Arteries</h1>
        <p>Steer a small economy through transport routes. Build or remove routes, run time, and watch settlements respond.</p>
      </header>

      <section class="metrics">
        <div class="metric"><span class="label">Money</span><strong>{world.money}</strong></div>
        <div class="metric"><span class="label">Active routes</span><strong>{active_links}</strong></div>
        <div class="metric"><span class="label">Total prosperity</span><strong>{total_prosperity}</strong></div>
        <div class="metric"><span class="label">Total research</span><strong>{total_research}</strong></div>
      </section>

      <section class="controls">
        <div class="control-group">
          <h2>Routes</h2>
          <button type="button" on-click={toggle_ab}>A-B: {bool_text(world.ab)}</button>
          <button type="button" on-click={toggle_ac}>A-C: {bool_text(world.ac)}</button>
          <button type="button" on-click={toggle_ad}>A-D: {bool_text(world.ad)}</button>
          <button type="button" on-click={toggle_bc}>B-C: {bool_text(world.bc)}</button>
          <button type="button" on-click={toggle_bd}>B-D: {bool_text(world.bd)}</button>
          <button type="button" on-click={toggle_cd}>C-D: {bool_text(world.cd)}</button>
        </div>
        <div class="control-group">
          <h2>Time</h2>
          <button type="button" on-click={tick_once}>Run 1 tick</button>
          <button type="button" on-click={run_twelve}>Run 12 ticks</button>
          <button type="button" on-click={toggle_curve}>Route style: {bool_text(curved_routes)}</button>
        </div>
        <div class="control-group">
          <h2>Scenarios</h2>
          <button type="button" on-click={reset_connected}>Connected</button>
          <button type="button" on-click={reset_isolated}>Isolated</button>
        </div>
      </section>

      <section class="map">
        <h2>Landscape map</h2>
        <div class="map-canvas">
          <when test={world.ab and curved_routes == false}><div class="route route-ab straight"></div></when>
          <when test={world.ac and curved_routes == false}><div class="route route-ac straight"></div></when>
          <when test={world.ad and curved_routes == false}><div class="route route-ad straight"></div></when>
          <when test={world.bc and curved_routes == false}><div class="route route-bc straight"></div></when>
          <when test={world.bd and curved_routes == false}><div class="route route-bd straight"></div></when>
          <when test={world.cd and curved_routes == false}><div class="route route-cd straight"></div></when>

          <when test={world.ab and curved_routes}><div class="route route-ab curved"></div></when>
          <when test={world.ac and curved_routes}><div class="route route-ac curved"></div></when>
          <when test={world.ad and curved_routes}><div class="route route-ad curved"></div></when>
          <when test={world.bc and curved_routes}><div class="route route-bc curved"></div></when>
          <when test={world.bd and curved_routes}><div class="route route-bd curved"></div></when>
          <when test={world.cd and curved_routes}><div class="route route-cd curved"></div></when>

          <div class="feature feature-river"></div>
          <div class="feature feature-lake"></div>
          <div class="feature feature-mountain"></div>

          <div class="node node-a"><strong>Riverford</strong><br>plains</div>
          <div class="node node-b"><strong>Hillcrest</strong><br>hills</div>
          <div class="node node-c"><strong>Greenvale</strong><br>forest</div>
          <div class="node node-d"><strong>Portmere</strong><br>coast</div>
        </div>
        <p class="legend">Routes cost 20 money, 2 timber, 1 stone to build; upkeep is 1 money per route per tick. Remove refunds 10 money and 1 timber.</p>
      </section>

      <section class="settlements">
        <article class="settlement">
          <h2>{world.a.name} <span class="status">{status(world.a)}</span></h2>
          <p>Pop {world.a.pop} · Prosperity {world.a.prosperity} · Research {world.a.research}</p>
          <p>Grain {world.a.grain} · Timber {world.a.timber} · Stone {world.a.stone} · Ore {world.a.ore} · Tools {world.a.tools}</p>
          <p>Endowments: grain {world.a.gEnd}, timber {world.a.tEnd}, stone {world.a.sEnd}, ore {world.a.oEnd}</p>
        </article>
        <article class="settlement">
          <h2>{world.b.name} <span class="status">{status(world.b)}</span></h2>
          <p>Pop {world.b.pop} · Prosperity {world.b.prosperity} · Research {world.b.research}</p>
          <p>Grain {world.b.grain} · Timber {world.b.timber} · Stone {world.b.stone} · Ore {world.b.ore} · Tools {world.b.tools}</p>
          <p>Endowments: grain {world.b.gEnd}, timber {world.b.tEnd}, stone {world.b.sEnd}, ore {world.b.oEnd}</p>
        </article>
        <article class="settlement">
          <h2>{world.c.name} <span class="status">{status(world.c)}</span></h2>
          <p>Pop {world.c.pop} · Prosperity {world.c.prosperity} · Research {world.c.research}</p>
          <p>Grain {world.c.grain} · Timber {world.c.timber} · Stone {world.c.stone} · Ore {world.c.ore} · Tools {world.c.tools}</p>
          <p>Endowments: grain {world.c.gEnd}, timber {world.c.tEnd}, stone {world.c.sEnd}, ore {world.c.oEnd}</p>
        </article>
        <article class="settlement">
          <h2>{world.d.name} <span class="status">{status(world.d)}</span></h2>
          <p>Pop {world.d.pop} · Prosperity {world.d.prosperity} · Research {world.d.research}</p>
          <p>Grain {world.d.grain} · Timber {world.d.timber} · Stone {world.d.stone} · Ore {world.d.ore} · Tools {world.d.tools}</p>
          <p>Endowments: grain {world.d.gEnd}, timber {world.d.tEnd}, stone {world.d.sEnd}, ore {world.d.oEnd}</p>
        </article>
      </section>

      <section class="report">
        <h2>Full text report</h2>
        <pre>{report}</pre>
      </section>
    </main>
