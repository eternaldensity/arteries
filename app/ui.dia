export component Root:
  state world: World = connected_world()
  state curved_routes: Bool = false
  derived report: Text = world_report("Current network", world)
  derived active_links: Int = route_active(world.ab) + route_active(world.ac) + route_active(world.ad) + route_active(world.bc) + route_active(world.bd) + route_active(world.cd)
  derived total_prosperity: Int = world.a.prosperity + world.b.prosperity + world.c.prosperity + world.d.prosperity
  derived total_research: Int = world.a.research + world.b.research + world.c.research + world.d.research
  derived alerts: Text = alert_text(world)
  derived tech_text: Text = tech_summary(world)

  on tick_once:
    world = tick(world)

  on run_twelve:
    world = run_ticks(world, 12)

  on toggle_ab:
    world = toggle_ab(world)

  on toggle_ac:
    world = toggle_ac(world)

  on toggle_ad:
    world = toggle_ad(world)

  on toggle_bc:
    world = toggle_bc(world)

  on toggle_bd:
    world = toggle_bd(world)

  on toggle_cd:
    world = toggle_cd(world)

  on toggle_curve:
    curved_routes = curved_routes == false

  on upgrade_ab:
    world = upgrade_ab(world)

  on upgrade_ac:
    world = upgrade_ac(world)

  on upgrade_ad:
    world = upgrade_ad(world)

  on upgrade_bc:
    world = upgrade_bc(world)

  on upgrade_bd:
    world = upgrade_bd(world)

  on upgrade_cd:
    world = upgrade_cd(world)

  on reset_connected:
    world = connected_world()

  on reset_isolated:
    world = base_world()

  html:
    <main>
      <header>
        <h1>Arteries</h1>
        <p>Steer a small economy through transport routes. Build or remove routes, run time, and watch settlements respond.</p>
      </header>

      <section class="metrics">
        <div class="metric"><span class="label">Money</span><strong>{world.money}</strong></div>
        <div class="metric"><span class="label">Active routes</span><strong>{active_links}</strong></div>
        <div class="metric"><span class="label">Total prosperity</span><strong>{total_prosperity}</strong></div>
        <div class="metric"><span class="label">Total research</span><strong>{total_research}</strong></div>
        <div class="metric"><span class="label">Tech</span><strong>{tech_text}</strong></div>
      </section>

      <section class="controls">
        <div class="control-group">
          <h2>Routes</h2>
          <button type="button" on-click={toggle_ab}>A-B: {route_text(world.ab)}</button>
          <button type="button" on-click={toggle_ac}>A-C: {route_text(world.ac)}</button>
          <button type="button" on-click={toggle_ad}>A-D: {route_text(world.ad)}</button>
          <button type="button" on-click={toggle_bc}>B-C: {route_text(world.bc)}</button>
          <button type="button" on-click={toggle_bd}>B-D: {route_text(world.bd)}</button>
          <button type="button" on-click={toggle_cd}>C-D: {route_text(world.cd)}</button>
          <button type="button" on-click={upgrade_ab}>Upgrade A-B</button>
          <button type="button" on-click={upgrade_ac}>Upgrade A-C</button>
          <button type="button" on-click={upgrade_ad}>Upgrade A-D</button>
          <button type="button" on-click={upgrade_bc}>Upgrade B-C</button>
          <button type="button" on-click={upgrade_bd}>Upgrade B-D</button>
          <button type="button" on-click={upgrade_cd}>Upgrade C-D</button>
        </div>
        <div class="control-group">
          <h2>Time</h2>
          <button type="button" on-click={tick_once}>Run 1 tick</button>
          <button type="button" on-click={run_twelve}>Run 12 ticks</button>
          <button type="button" on-click={toggle_curve}>Route style: {bool_text(curved_routes)}</button>
        </div>
        <div class="control-group">
          <h2>Scenarios</h2>
          <button type="button" on-click={reset_connected}>Connected</button>
          <button type="button" on-click={reset_isolated}>Isolated</button>
        </div>
      </section>

      <section class="map">
        <h2>Landscape map</h2>
        <div class="map-canvas">
          <div class="terrain-layer terrain-base"></div>
          <div class="terrain-layer terrain-contours"></div>
          <div class="terrain-feature river-main"></div>
          <div class="terrain-feature river-branch"></div>
          <div class="terrain-feature lake"></div>
          <div class="terrain-feature mountain"></div>
          <div class="terrain-feature forest"></div>

          <when test={route_active(world.ab) == 1 and curved_routes == false}><div class="route-seg seg-ab-1"></div><div class="route-seg seg-ab-2"></div></when>
          <when test={route_active(world.ac) == 1 and curved_routes == false}><div class="route-seg seg-ac-1"></div><div class="route-seg seg-ac-2"></div></when>
          <when test={route_active(world.ad) == 1 and curved_routes == false}><div class="route-seg seg-ad-1"></div><div class="route-seg seg-ad-2"></div></when>
          <when test={route_active(world.bc) == 1 and curved_routes == false}><div class="route-seg seg-bc-1"></div><div class="route-seg seg-bc-2"></div></when>
          <when test={route_active(world.bd) == 1 and curved_routes == false}><div class="route-seg seg-bd-1"></div><div class="route-seg seg-bd-2"></div></when>
          <when test={route_active(world.cd) == 1 and curved_routes == false}><div class="route-seg seg-cd-1"></div><div class="route-seg seg-cd-2"></div></when>

          <when test={route_active(world.ab) == 1 and curved_routes}><div class="route-seg seg-ab-1 curved"></div><div class="route-seg seg-ab-2 curved"></div></when>
          <when test={route_active(world.ac) == 1 and curved_routes}><div class="route-seg seg-ac-1 curved"></div><div class="route-seg seg-ac-2 curved"></div></when>
          <when test={route_active(world.ad) == 1 and curved_routes}><div class="route-seg seg-ad-1 curved"></div><div class="route-seg seg-ad-2 curved"></div></when>
          <when test={route_active(world.bc) == 1 and curved_routes}><div class="route-seg seg-bc-1 curved"></div><div class="route-seg seg-bc-2 curved"></div></when>
          <when test={route_active(world.bd) == 1 and curved_routes}><div class="route-seg seg-bd-1 curved"></div><div class="route-seg seg-bd-2 curved"></div></when>
          <when test={route_active(world.cd) == 1 and curved_routes}><div class="route-seg seg-cd-1 curved"></div><div class="route-seg seg-cd-2 curved"></div></when>

          <div class="node node-a"><strong>Riverford</strong><span>plains</span></div>
          <div class="node node-b"><strong>Hillcrest</strong><span>hills</span></div>
          <div class="node node-c"><strong>Greenvale</strong><span>forest</span></div>
          <div class="node node-d"><strong>Portmere</strong><span>coast</span></div>
        </div>
        <p class="legend">Terrain: plains, forest, hills, river, coast, lake, mountain. Routes are multi-segment paths.</p>
      </section>

      <section class="settlements">
        <article class="settlement">
          <h2>{world.a.name} <span class="status">{status(world.a)}</span></h2>
          <p>Pop {world.a.pop} · Prosperity {world.a.prosperity} · Research {world.a.research}</p>
          <p>Grain {world.a.grain} · Timber {world.a.timber} · Stone {world.a.stone} · Ore {world.a.ore} · Tools {world.a.tools}</p>
          <p>Endowments: grain {world.a.gEnd}, timber {world.a.tEnd}, stone {world.a.sEnd}, ore {world.a.oEnd}</p>
        </article>
        <article class="settlement">
          <h2>{world.b.name} <span class="status">{status(world.b)}</span></h2>
          <p>Pop {world.b.pop} · Prosperity {world.b.prosperity} · Research {world.b.research}</p>
          <p>Grain {world.b.grain} · Timber {world.b.timber} · Stone {world.b.stone} · Ore {world.b.ore} · Tools {world.b.tools}</p>
          <p>Endowments: grain {world.b.gEnd}, timber {world.b.tEnd}, stone {world.b.sEnd}, ore {world.b.oEnd}</p>
        </article>
        <article class="settlement">
          <h2>{world.c.name} <span class="status">{status(world.c)}</span></h2>
          <p>Pop {world.c.pop} · Prosperity {world.c.prosperity} · Research {world.c.research}</p>
          <p>Grain {world.c.grain} · Timber {world.c.timber} · Stone {world.c.stone} · Ore {world.c.ore} · Tools {world.c.tools}</p>
          <p>Endowments: grain {world.c.gEnd}, timber {world.c.tEnd}, stone {world.c.sEnd}, ore {world.c.oEnd}</p>
        </article>
        <article class="settlement">
          <h2>{world.d.name} <span class="status">{status(world.d)}</span></h2>
          <p>Pop {world.d.pop} · Prosperity {world.d.prosperity} · Research {world.d.research}</p>
          <p>Grain {world.d.grain} · Timber {world.d.timber} · Stone {world.d.stone} · Ore {world.d.ore} · Tools {world.d.tools}</p>
          <p>Endowments: grain {world.d.gEnd}, timber {world.d.tEnd}, stone {world.d.sEnd}, ore {world.d.oEnd}</p>
        </article>
      </section>

      <section class="alerts">
        <h2>Alerts</h2>
        <p>{alerts}</p>
      </section>

      <section class="report">
        <h2>Full text report</h2>
        <pre>{report}</pre>
      </section>
    </main>
